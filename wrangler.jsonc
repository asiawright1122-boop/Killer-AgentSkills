{
  "name": "killer-skills",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "pages_build_output_dir": "dist",
  "observability": {
    "enabled": true
  },
  "kv_namespaces": [
    {
      "binding": "TRANSLATIONS",
      "id": "db9a790f497b40afa9720993d7ea2fe4"
    },
    {
      "binding": "SKILLS_CACHE",
      "id": "eb71984285c54c3488c17a32391b9fe5"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "killer-skills-db",
      "database_id": "b20fd9ef-6628-4a78-abd0-59aac064b5d6"
    }
  ],
  "services": [
    {
      "binding": "WORKFLOWS_SERVICE",
      "service": "killer-skills-workflows"
    }
  ],
  "vars": {
    "PUBLIC_OG_SERVER_URL": "http://localhost:3000",
    "ADMIN_USER": "admin_placeholder",
    "SILICONFLOW_API_KEY": ""
  }
}