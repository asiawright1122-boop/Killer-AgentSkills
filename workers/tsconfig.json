{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "lib": [
            "ES2022"
        ],
        "moduleResolution": "Bundler",
        "types": [
            "@cloudflare/workers-types/2023-07-01",
            "node"
        ],
        "resolveJsonModule": true,
        "allowJs": true,
        "checkJs": false,
        "noEmit": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "~/*": [
                "./*"
            ]
        }
    },
    "include": [
        "**/*.ts"
    ]
}