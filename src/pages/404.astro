---
import Layout from '../layouts/Layout.astro';
import { SUPPORTED_LOCALES, type Locale } from '../i18n';

const pathLocale = Astro.url.pathname.split('/').filter(Boolean)[0];
const locale: Locale = SUPPORTED_LOCALES.includes(pathLocale as Locale) ? (pathLocale as Locale) : 'en';
const isZhCopy = locale === 'zh';
const robotsContent = 'noindex, nofollow';
const title = isZhCopy ? '404 - 页面不存在' : '404 - Page Not Found';
const description = isZhCopy ? '这个页面不存在。' : 'The page you are looking for does not exist.';
---

<Layout locale={locale} title={title} description={description} noindex={true} robots={robotsContent}>
  <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-6 relative py-20">
    <div class="skill-detail-surface p-8 md:p-12 max-w-xl w-full">
      <p class="market-chip px-3 py-1 mb-6">404</p>
      <h1 class="text-4xl md:text-5xl font-bold text-[var(--foreground)] mb-4">
        {isZhCopy ? '页面不存在' : 'Page Not Found'}
      </h1>
      <p class="text-base text-[var(--muted-foreground)] font-medium mb-8 max-w-md mx-auto leading-relaxed">
        {
          isZhCopy
            ? '这个页面已经不可用。回到首页，或进入 Skills 目录继续筛选。'
            : 'This page is no longer available. Start from home or continue in the Skills directory.'
        }
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
        <a href={`/${locale}`} class="market-button w-full sm:w-auto px-5 py-3">
          {isZhCopy ? '返回首页' : 'Return home'}
        </a>
        <a
          href={`/${locale}/skills`}
          class="w-full sm:w-auto px-5 py-3 rounded-md border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] font-bold hover:bg-[var(--muted)] transition-colors"
        >
          {isZhCopy ? '进入 Skills' : 'Open Skills'}
        </a>
      </div>
    </div>
  </div>
</Layout>
