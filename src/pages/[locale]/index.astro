---
import Layout from '../../layouts/Layout.astro';
import MarketplaceHero from '../../components/MarketplaceHero.astro';
import MarketplaceSection from '../../components/MarketplaceSection.astro';
import MarketplaceSkillList from '../../components/MarketplaceSkillList.astro';
import { SUPPORTED_LOCALES, loadMessages, useTranslations, type Locale } from '../../i18n';
import { getAuthoritySurfaceEntries } from '../../lib/authority-surfaces';
import type { Env } from '../../lib/kv';
import { getMarketplaceSkills, sortSkillsLatest, sortSkillsPopular } from '../../lib/marketplace-filters';
import { buildOccupationSummaries } from '../../lib/occupations';
import { getLightweightSkillsTop, type UnifiedSkill } from '../../lib/public-skill-catalog';
import { getRuntimeEnv } from '../../lib/runtime-env';
import { buildKeywordString } from '../../lib/seo-keywords';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=86400');

const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const isZhCopy = typedLocale.startsWith('zh');
const env = (await getRuntimeEnv<Env>(Astro.locals)) as Env;
const [messages, skillsFetched] = await Promise.all([
  loadMessages(typedLocale),
  getLightweightSkillsTop(env, 120).catch(() => [] as UnifiedSkill[]),
]);
const t = useTranslations(messages);
const marketplaceSkills = getMarketplaceSkills(skillsFetched);
const popularSkills = sortSkillsPopular(marketplaceSkills).slice(0, 8);
const latestSkills = sortSkillsLatest(marketplaceSkills).slice(0, 8);
const occupationSummaries = buildOccupationSummaries(marketplaceSkills, typedLocale)
  .filter((occupation) => occupation.skillCount > 0)
  .slice(0, 8);
const featuredCollections = getAuthoritySurfaceEntries(typedLocale, { placement: 'collections' })
  .filter((surface) => surface.surfaceClass === 'collection' && (surface.tier === 'P0' || surface.tier === 'P1'))
  .slice(0, 6);

const pageTitle = isZhCopy
  ? 'Killer-Skills - AI Agent Skills / AI 智能体技能市场'
  : 'Killer-Skills - AI Agent Skills Marketplace';
const pageDescription = isZhCopy
  ? '发现、筛选并安装通过基础审查的 AI Agent Skills，按榜单、职业和精选合集快速进入，适合在 Claude Code、Cursor 与 Windsurf 中对比使用。'
  : 'Discover, filter, and install baseline-reviewed AI agent skills by rankings, occupations, and curated collections.';
const pageKeywords = buildKeywordString(t, 'core', 'installSetup', 'ideCompat', 'developerExperience');
const countLabel = isZhCopy
  ? `${marketplaceSkills.length} 个已收录 Skills`
  : `${marketplaceSkills.length} listed skills`;
const canonicalUrl = `https://killer-skills.com/${locale}`;
const pageJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': 'https://killer-skills.com/#website',
      name: 'Killer-Skills',
      url: 'https://killer-skills.com',
      inLanguage: typedLocale,
      description: pageDescription,
    },
    {
      '@type': 'CollectionPage',
      '@id': `${canonicalUrl}#webpage`,
      url: canonicalUrl,
      name: pageTitle,
      description: pageDescription,
      inLanguage: typedLocale,
      isPartOf: {
        '@id': 'https://killer-skills.com/#website',
      },
      about: {
        '@type': 'Thing',
        name: 'AI Agent Skills',
      },
    },
  ],
};
---

<Layout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  appendBrand={false}
  customCanonical={canonicalUrl}
  jsonLd={pageJsonLd}
>
  <main>
    <MarketplaceHero
      locale={locale}
      eyebrow={isZhCopy ? 'AI Agent Skills 市场' : 'AI Agent Skills Marketplace'}
      title="Killer-Skills"
      description={pageDescription}
      searchPlaceholder={isZhCopy ? '搜索 Skill、MCP、Claude Code、Cursor' : 'Search Skill, MCP, Claude Code, Cursor'}
      searchAction={`/${locale}/search`}
      countLabel={countLabel}
      actions={[
        { href: `/${locale}/skills`, label: 'Skills' },
        { href: `/${locale}/popular`, label: isZhCopy ? '榜单' : 'Rankings' },
        { href: `/${locale}/occupations`, label: isZhCopy ? '职业' : 'Occupations' },
      ]}
    />

    <MarketplaceSection
      title={isZhCopy ? '热门 Skills' : 'Popular Skills'}
      description={isZhCopy
        ? '按审查分、安装可用性、维护信号和社区热度排序。'
        : 'Ranked by review score, installability, maintenance signals, and community traction.'}
      actionHref={`/${locale}/popular`}
      actionLabel={isZhCopy ? '查看榜单' : 'View rankings'}
    >
      <MarketplaceSkillList skills={popularSkills} locale={locale} messages={messages} />
    </MarketplaceSection>

    <MarketplaceSection
      title={isZhCopy ? '按职业进入' : 'Browse By Occupation'}
      description={isZhCopy
        ? '从你的工作场景进入，直接看到对应任务和可安装 Skills。'
        : 'Start from the job context, then compare matching tasks and installable skills.'}
      actionHref={`/${locale}/occupations`}
      actionLabel={isZhCopy ? '全部职业' : 'All occupations'}
    >
      <div class="marketplace-card-grid">
        {
          occupationSummaries.map((occupation) => (
            <a class="marketplace-card-link" href={occupation.href}>
              <div class="marketplace-meta-row">
                <span>{isZhCopy ? `${occupation.skillCount} 个 Skills` : `${occupation.skillCount} skills`}</span>
              </div>
              <h3>{occupation.label}</h3>
              <p>{occupation.description}</p>
              <div class="marketplace-pill-list">
                {occupation.tasks.slice(0, 3).map((task) => (
                  <span class="market-chip px-2 py-1">{task}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </MarketplaceSection>

    <MarketplaceSection
      title={isZhCopy ? '最新收录' : 'Latest Additions'}
      description={isZhCopy
        ? '只展示通过基础准入的最新 Skills。'
        : 'Newest skills that pass the baseline admission check.'}
      actionHref={`/${locale}/popular?rank=latest`}
      actionLabel={isZhCopy ? '查看最新' : 'View latest'}
    >
      <MarketplaceSkillList skills={latestSkills} locale={locale} messages={messages} />
    </MarketplaceSection>

    <MarketplaceSection
      title={isZhCopy ? '精选合集' : 'Curated Collections'}
      description={isZhCopy
        ? '按官方来源、Agent 工作流、IDE 和语言栈进入更短的选型路径。'
        : 'Start from official sources, agent workflows, IDEs, and language stacks for shorter decisions.'}
      actionHref={`/${locale}/collections`}
      actionLabel={isZhCopy ? '全部合集' : 'All collections'}
    >
      <div class="marketplace-card-grid">
        {
          featuredCollections.map((surface) => (
            <a class="marketplace-card-link" href={surface.href}>
              <div class="marketplace-meta-row">
                <span>{surface.tier}</span>
                <span>{isZhCopy ? '精选' : 'curated'}</span>
              </div>
              <h3>{surface.title}</h3>
              <p>{surface.description}</p>
            </a>
          ))
        }
      </div>
    </MarketplaceSection>
  </main>
</Layout>
