---
import Layout from '../../../layouts/Layout.astro';
import { SUPPORTED_LOCALES, loadMessages, useTranslations, type Locale } from '../../../i18n';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

// Validate locale
const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const isZhCopy = typedLocale.startsWith('zh');

// Load translations
const messages = await loadMessages(typedLocale);
const t = useTranslations(messages);

const privacyDescriptions = {
  en: 'Review how Killer-Skills handles privacy, local preferences, analytics, third-party links, and user-controlled browser data.',
  zh: '了解 Killer-Skills 如何处理隐私、本地偏好、匿名分析、第三方链接以及由用户掌控的浏览器数据。',
  ja: 'Killer-Skills のプライバシー、ローカル設定、匿名分析、外部リンク、ユーザー管理のブラウザデータの扱いを確認できます。',
  ko: 'Killer-Skills의 개인정보 처리, 로컬 설정, 익명 분석, 외부 링크, 사용자가 관리하는 브라우저 데이터를 확인하세요.',
  es: 'Consulta cómo Killer-Skills gestiona privacidad, preferencias locales, analítica anónima, enlaces externos y datos del navegador.',
  fr: 'Découvrez comment Killer-Skills gère la confidentialité, les préférences locales, les mesures anonymes et les données du navigateur.',
  de: 'Erfahre, wie Killer-Skills Datenschutz, lokale Einstellungen, anonyme Analysen, externe Links und Browserdaten behandelt.',
  pt: 'Veja como o Killer-Skills trata privacidade, preferências locais, métricas anônimas, links externos e dados do navegador.',
  ru: 'Узнайте, как Killer-Skills обрабатывает конфиденциальность, локальные настройки, анонимную аналитику, внешние ссылки и данные браузера.',
  ar: 'راجع كيف يتعامل Killer-Skills مع الخصوصية والتفضيلات المحلية والتحليلات المجهولة والروابط الخارجية وبيانات المتصفح.',
} satisfies Record<Locale, string>;

const pageTitle = t('Footer.privacy');
const pageDescription = privacyDescriptions[typedLocale];
---

<Layout locale={locale} title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-[var(--background)]">
    <div class="border-b border-[var(--border)] bg-transparent pt-12 pb-8 md:pt-16 md:pb-12">
      <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl md:text-4xl font-bold text-[var(--foreground)] mb-4">
          {pageTitle}
        </h1>
        <p class="text-sm text-[var(--muted-foreground)]">Last updated: July 16, 2026</p>
      </div>
    </div>

    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <article
        class="prose prose-lg dark:prose-invert max-w-none prose-headings:text-[var(--foreground)] prose-p:text-[var(--muted-foreground)] prose-li:text-[var(--muted-foreground)] prose-a:text-[var(--accent)] prose-a:font-bold prose-a:underline prose-a:decoration-2 prose-a:underline-offset-4 prose-strong:text-[var(--foreground)]"
      >
        <h2>1. Information We Collect</h2>
        <p>Killer-Skills collects minimal information to provide and improve the Service:</p>
        <ul>
          <li><strong>Usage Data:</strong> Anonymous analytics about page visits and feature usage</li>
          <li><strong>Cookies:</strong> Language preference and theme settings stored locally</li>
          <li>
            <strong>IP Address:</strong> Used for language detection via Cloudflare's CF-IPCountry header (not stored)
          </li>
        </ul>

        <h2>2. How We Use Information</h2>
        <p>We use collected information to:</p>
        <ul>
          <li>Provide language-appropriate content based on your location</li>
          <li>Remember your language and theme preferences</li>
          <li>Improve the Service through anonymous usage analytics</li>
        </ul>

        <h2>3. Data Storage</h2>
        <p>
          Killer-Skills stores user preferences (favorites, browsing history) locally in your browser using
          localStorage. This data never leaves your device and is not transmitted to our servers.
        </p>

        <h2>{isZhCopy ? '4. 匿名安装与操作统计' : '4. Anonymous Install And Action Statistics'}</h2>
        <p>
          {
            isZhCopy
              ? 'Killer-Skills 保存每日匿名安装次数和安装操作次数，用于生成 7 天趋势榜单。成功的 CLI 安装与网站命令复制分别统计，网站复制不会被称为安装。'
              : 'Killer-Skills stores daily anonymous install and install-action counts for seven-day rankings. Successful CLI installs and website command copies are counted separately; website copies are not labeled as installs.'
          }
        </p>
        <p>
          {
            isZhCopy
              ? '服务器使用每日轮换的加密摘要进行去重，最多保留 35 天事件。我们不保留原始 IP 地址、完整 User-Agent、本地路径、文件内容、凭证或稳定设备标识符。'
              : 'The server deduplicates events with a daily rotating cryptographic digest and retains events for no more than 35 days. We do not retain raw IP addresses, full user agents, local paths, file contents, credentials, or stable device identifiers.'
          }
        </p>
        <p>
          {
            isZhCopy
              ? 'CLI 用户可在安装前设置 KILLER_SKILLS_TELEMETRY=0 或 DO_NOT_TRACK=1 关闭此统计。遥测失败不会影响安装。'
              : 'CLI users can opt out before installation with KILLER_SKILLS_TELEMETRY=0 or DO_NOT_TRACK=1. Telemetry failures do not affect installation.'
          }
        </p>

        <h2>5. Third-Party Services</h2>
        <p>
          The Service is hosted on Cloudflare Workers. Skills listed on the platform link to third-party repositories
          (primarily GitHub). Please review the privacy policies of these services separately.
        </p>
        <p>
          Killer-Skills may use Google AdSense to serve ads. Google and its partners may use cookies or similar
          technologies to deliver, measure, and personalize ads depending on your region, browser settings, and consent
          choices. You can review Google's advertising privacy practices and controls at
          <a href="https://policies.google.com/technologies/ads">Google Advertising</a>.
        </p>

        <h2>6. Data Retention</h2>
        <p>
          Browser-based data (localStorage) persists until you clear your browser data or manually remove it. Anonymous
          interaction events are removed on the bounded retention schedule described above.
        </p>

        <h2>7. Your Rights</h2>
        <p>You have the right to:</p>
        <ul>
          <li>Clear your local data at any time through your browser settings</li>
          <li>Disable cookies through your browser preferences</li>
          <li>Request information about any data we may hold</li>
        </ul>

        <h2>8. Changes to This Policy</h2>
        <p>
          We may update this Privacy Policy from time to time. Changes will be posted on this page with an updated
          revision date.
        </p>

        <h2>9. Contact</h2>
        <p>
          For privacy-related inquiries, please contact us through our
          <a href="https://github.com/asiawright1122-boop/Killer-AgentSkills/issues">GitHub repository</a>.
        </p>
      </article>
    </div>
  </div>
</Layout>
