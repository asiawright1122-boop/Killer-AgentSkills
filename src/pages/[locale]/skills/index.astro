---
import Layout from '../../../layouts/Layout.astro';
import SkillCard from '../../../components/SkillCard.astro';
import CollectionCard from '../../../components/CollectionCard.astro';
import SkillsSidebar from '../../../components/SkillsSidebar.astro';
import Pagination from '../../../components/Pagination.astro';
import { SUPPORTED_LOCALES, loadMessages, useTranslations, type Locale } from '../../../i18n';
import { getCollection } from 'astro:content';
import { searchSkills, filterByCategory } from '../../../lib/search';
import { OFFICIAL_REPOS, FEATURED_SCORE_THRESHOLD } from '../../../lib/skills-config';
import type { UnifiedSkill } from '../../../lib/skills';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=3600');
// Validate locale
const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;

// ⚡ PARALLEL: Load skills + translations concurrently
const t0 = performance.now();
const [rawCollection, messages] = await Promise.all([
  getCollection('skills'),
  loadMessages(typedLocale),
]);
let skills: UnifiedSkill[] = rawCollection.map(entry => ({
  ...(entry.data as any),
  id: entry.id,
})) as UnifiedSkill[];
skills.sort((a, b) => (b.stars || 0) - (a.stars || 0));
const t1 = performance.now();
console.log(`[SSR Profiler] Content Collection: ${Math.round(t1 - t0)}ms (${skills.length} skills)`);

// Get URL search params for filtering
const url = Astro.url;
const query = url.searchParams.get('q') || '';
const category = url.searchParams.get('category') || '';
const view = url.searchParams.get('view') || '';
const owner = url.searchParams.get('owner') || '';
const page = parseInt(url.searchParams.get('page') || '1', 10);
const ITEMS_PER_PAGE = 12;

// Identify Official Skills
const officialOwners = Object.values(OFFICIAL_REPOS)
    .filter(r => r.type === 'official')
    .map(r => r.owner);

// Apply view filter
if (view === 'official') {
    skills = skills.filter(s => officialOwners.includes(s.owner));
} else if (view === 'featured') {
    // 精选 = 官方仓库 OR qualityScore >= 阈值
    const allOfficialOwners = Object.values(OFFICIAL_REPOS).map(r => r.owner);
    skills = skills
        .filter(s => allOfficialOwners.includes(s.owner) || (s.qualityScore || 0) >= FEATURED_SCORE_THRESHOLD)
        .sort((a, b) => (b.qualityScore || 0) - (a.qualityScore || 0));
} else if (view === 'latest') {
    skills = [...skills].sort((a, b) => 
        new Date(b.updatedAt || 0).getTime() - new Date(a.updatedAt || 0).getTime()
    );
}

// Apply owner filter
if (owner) {
  skills = skills.filter(s => s.owner === owner);
}

// Apply search filter
if (query) {
  skills = searchSkills(skills, query, typedLocale);
}

// Apply category filter (skip 'all' since it means show everything)
if (category && category !== 'all') {
  skills = filterByCategory(skills, category);
}

// Calculate collections if needed (Moved up for pagination)
let skillsByOwner: Record<string, number> = {};
if (view === 'official' && !owner) {
    skillsByOwner = skills.reduce((acc, skill) => {
        const skillOwner = skill.owner;
        acc[skillOwner] = (acc[skillOwner] || 0) + 1;
        return acc;
    }, {} as Record<string, number>);
}

// Calculate pagination
// For 'Official' view (without owner filter), we paginate based on COLLECTIONS (owners), not skills
let totalItems = skills.length;
let paginatedCollections: [string, number][] = [];

if (view === 'official' && !owner) {
    const owners = Object.entries(skillsByOwner);
    totalItems = owners.length;
    
    const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
    const currentPage = Math.max(1, Math.min(page, totalPages || 1));
    
    // Slice the collections
    paginatedCollections = owners.slice((currentPage - 1) * ITEMS_PER_PAGE, currentPage * ITEMS_PER_PAGE);
    
    // For template compatibility, we'll keep paginatedSkills empty or unused in this mode
} 

const totalSkills = skills.length; // Keep for display stats
const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
const currentPage = Math.max(1, Math.min(page, totalPages || 1));
const paginatedSkills = skills.slice((currentPage - 1) * ITEMS_PER_PAGE, currentPage * ITEMS_PER_PAGE);

// translations already loaded in parallel above
const t = useTranslations(messages);

// Page title
let pageTitle = t('Metadata.Skills.title');
if (query) pageTitle = `${t('Marketplace.searchPrefix').replace('{query}', query)}`;
else if (category) pageTitle = `${t(`Sidebar.categories.${category}` as any) || category} ${t('Common.skillsMarket')}`;
else if (view === 'official') pageTitle = t('Sidebar.views.official');
else if (view === 'featured') pageTitle = t('Sidebar.views.featured');
else if (view === 'latest') pageTitle = t('Sidebar.views.latest');

if (owner) {
    const vendorConfig = Object.values(OFFICIAL_REPOS).find(v => v.owner === owner);
    pageTitle = vendorConfig ? `${vendorConfig.name} Skills` : `${owner} Skills`;
}

const pageDescription = t('Metadata.Skills.description');

// Pagination SEO: build rel prev/next URLs
const buildPaginationUrl = (p: number) => {
  const params = new URLSearchParams({
    ...(query && { q: query }),
    ...(category && { category }),
    ...(view && { view }),
    ...(owner && { owner }),
    page: String(p),
  });
  return `https://killer-skills.com/${locale}/skills?${params.toString()}`;
};
const prevPageUrl = currentPage > 1 ? buildPaginationUrl(currentPage - 1) : null;
const nextPageUrl = currentPage < totalPages ? buildPaginationUrl(currentPage + 1) : null;

// Category list for sidebar
const categories = [];
---

<Layout locale={locale} title={pageTitle} description={pageDescription}>
  {/* Pagination SEO: rel prev/next */}
  <Fragment slot="head">
    {prevPageUrl && <link rel="prev" href={prevPageUrl} />}
    {nextPageUrl && <link rel="next" href={nextPageUrl} />}
  </Fragment>
  {/* CollectionPage + ItemList JSON-LD */}
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": pageTitle,
    "description": pageDescription,
    "url": `https://killer-skills.com/${locale}/skills/`,
    "isPartOf": {
      "@type": "WebSite",
      "name": "Killer-Skills",
      "url": "https://killer-skills.com"
    },
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": totalSkills,
      "itemListElement": paginatedSkills.slice(0, 12).map((s: any, i: number) => ({
        "@type": "ListItem",
        "position": (currentPage - 1) * ITEMS_PER_PAGE + i + 1,
        "name": s.name || s.repo,
        "url": `https://killer-skills.com/${locale}/skills/${s.owner}/${s.repo}/`
      }))
    }
  })} />
  <div class="bg-slate-50/50 dark:bg-slate-950/50 min-h-screen">

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <div class="flex flex-col md:flex-row gap-8 lg:gap-10">

        <!-- Sidebar (Left) -->
        <SkillsSidebar activeCategory={category} activeView={view} />

        <!-- Main Content (Right) -->
        <div class="flex-1 min-w-0">
          
          <!-- Page Header & Search (Integrated) -->
          <div class="mb-10 border-[3px] border-[var(--border)] p-5 md:p-7 bg-[var(--background)] shadow-[8px_8px_0px_0px_var(--border)]">
             <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 gap-6 overflow-visible">
                <div class="flex-1 space-y-2">
                   <h1 class="text-4xl md:text-5xl font-black text-[var(--foreground)] tracking-tight uppercase mb-2 leading-none">
                     {query 
                        ? t('Marketplace.browsing') 
                        : category 
                            ? t(`Sidebar.categories.${category}` as any) || category 
                            : owner
                                ? `${Object.values(OFFICIAL_REPOS).find(v => v.owner === owner)?.name || owner} Skills`
                                : view === 'official'
                                    ? t('Sidebar.views.official')
                                    : view === 'featured'
                                        ? t('Sidebar.views.featured')
                                        : view === 'latest'
                                            ? t('Sidebar.views.latest')
                                            : t('Common.explore')}
                   </h1>
                   <p class="text-[var(--muted-foreground)] font-mono text-lg font-bold opacity-80">
                      {t('Metadata.Skills.description')}
                   </p>
                </div>
                
                <div class="hidden md:block group">
                   <div class="bg-[var(--background)] text-[var(--foreground)] py-3 px-5 border-[3px] border-[var(--border)] shadow-[4px_4px_0px_0px_var(--primary)] group-hover:shadow-[7px_7px_0px_0px_var(--primary)] group-hover:translate-x-[-1px] group-hover:translate-y-[-1px] transition-all min-w-[150px] flex flex-col items-center justify-center relative">
                      <!-- Compact Status & Live Bar -->
                      <div class="w-full flex items-center justify-between mb-2">
                         <div class="flex gap-1">
                            <div class="w-1.5 h-1.5 bg-[var(--foreground)]"></div>
                            <div class="w-1.5 h-1.5 bg-[var(--foreground)] opacity-20"></div>
                         </div>
                         <div class="px-1.5 py-0.5 bg-[var(--primary)] text-[var(--primary-foreground)] text-[9px] font-black tracking-widest uppercase flex items-center gap-1 border border-[var(--border)]">
                            <span class="relative flex h-1.5 w-1.5">
                               <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75"></span>
                               <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-600"></span>
                            </span>
                            LIVE
                         </div>
                      </div>
                      
                      <!-- Refined Number -->
                      <div class="text-5xl font-black tracking-tighter tabular-nums leading-none mb-2">
                         {skills.length}
                      </div>
                      
                      <!-- Label tight to the number -->
                      <div class="w-full border-t border-[var(--border)] border-dotted pt-1.5 text-center">
                         <span class="text-xs font-black uppercase tracking-widest text-[var(--foreground)] leading-none">
                            {t('Marketplace.availableSkills')}
                         </span>
                      </div>
                   </div>
                </div>
             </div>

             <!-- Pro Search Bar -->
             <form method="get" action={`/${locale}/skills`} class="relative group">
                <div class="relative flex items-center bg-[var(--background)] border-4 border-[var(--border)] shadow-[4px_4px_0px_0px_var(--border)] focus-within:translate-x-[-2px] focus-within:translate-y-[-2px] focus-within:shadow-[6px_6px_0px_0px_var(--primary)] transition-all">
                   <div class="pl-4 text-[var(--foreground)]">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="square" stroke-linejoin="miter" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
                   </div>
                   <input
                     type="text"
                     name="q"
                     value={query}
                     placeholder={t('Common.searchPlaceholder')}
                     class="flex-1 bg-transparent border-none focus:ring-0 text-[var(--foreground)] placeholder:text-[var(--muted-foreground)] h-14 px-4 text-xl font-bold font-mono tracking-tight uppercase"
                   />
                   <button type="submit" class="bg-[var(--primary)] text-[var(--primary-foreground)] px-8 py-3.5 border-l-4 border-[var(--border)] font-black uppercase tracking-widest hover:bg-[var(--foreground)] hover:text-[var(--background)] transition-colors text-lg h-full">
                     {t('Common.search')}
                   </button>
                </div>
             </form>

             <!-- Hot Tags -->
             <div class="mt-6 flex items-center gap-3 text-sm font-mono font-bold text-[var(--foreground)] uppercase overflow-x-auto pb-2">
                <span class="shrink-0 text-[var(--muted-foreground)]">// {t('Marketplace.popular')}:</span>
                {['PDF Processing', 'Data Analysis', 'Web Scraping', 'Code Review'].map(tag => (
                   <a href={`/${locale}/skills?q=${tag}`} class="px-2 border-b-2 border-transparent hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors whitespace-nowrap">
                      [{tag}]
                   </a>
                ))}
             </div>
          </div>

          <!-- Skills Grid -->
          <div class="mb-6 flex items-center justify-between md:hidden">
             <div class="text-sm text-slate-500">
                {totalSkills} {t('Marketplace.availableSkills').toLowerCase()}
             </div>
          </div>

          {(view === 'official' && !owner ? paginatedCollections.length > 0 : paginatedSkills.length > 0) ? (
            view === 'official' && !owner ? (
                /* Official Collections View */
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    {paginatedCollections.map(([ownerName, count]) => (
                        <CollectionCard owner={ownerName} count={count} locale={locale} />
                    ))}
                </div>
            ) : (
                /* Standard Skill Grid */
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {paginatedSkills.map(skill => (
                    <div class="h-full">
                      <SkillCard skill={skill} locale={locale} t={t} />
                    </div>
                  ))}
                </div>
            )
          ) : (
            <div class="text-center py-24 bg-[var(--background)] border-[3px] border-[var(--border)] shadow-[8px_8px_0px_0px_var(--border)]">
              <div class="w-20 h-20 mx-auto bg-[var(--foreground)] border-2 border-[var(--border)] flex items-center justify-center text-4xl mb-6 shadow-[4px_4px_0px_0px_var(--border)] text-white">
                 🔍
              </div>
              <h3 class="text-3xl font-black text-[var(--foreground)] mb-2 uppercase tracking-tight">{t('Marketplace.noSkills')}</h3>
              <p class="text-[var(--muted-foreground)] font-mono max-w-md mx-auto mb-8 font-bold">{t('Marketplace.noSkillsHint')}</p>
              <a
                href={`/${locale}/skills`}
                class="inline-block px-8 py-4 bg-[var(--primary)] hover:bg-[var(--foreground)] text-[var(--foreground)] hover:text-[var(--background)] border-2 border-[var(--border)] font-black uppercase tracking-widest transition-colors shadow-[4px_4px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_0px_var(--border)]"
              >
                {t('Marketplace.viewAll')}
              </a>
            </div>
          )}

          {/* Pagination Controls */}
          {totalPages > 1 && (
            <Pagination
              currentPage={currentPage}
              totalPages={totalPages}
              baseUrl={`/${locale}/skills`}
              searchParams={{
                ...(query && { q: query }),
                ...(category && { category }),
                ...(view && { view }),
                ...(owner && { owner }),
              }}
              t={t}
            />
          )}
        </div>


      </div>
    </div>

      </div>
    </div>
  </div>
</Layout>

{/* ⚡ Prefetch on hover — preload detail pages before user clicks */}
<script is:inline>
  const prefetched = new Set();
  document.addEventListener('pointerenter', (e) => {
    const link = e.target?.closest?.('a[href*="/skills/"]');
    if (!link) return;
    const href = link.getAttribute('href');
    if (!href || prefetched.has(href) || href.endsWith('/skills') || href.includes('?')) return;
    prefetched.add(href);
    const l = document.createElement('link');
    l.rel = 'prefetch';
    l.href = href;
    document.head.appendChild(l);
  }, { capture: true, passive: true });
</script>
