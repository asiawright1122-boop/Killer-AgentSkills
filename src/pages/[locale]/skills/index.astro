---
import Layout from '../../../layouts/Layout.astro';
import SkillCard from '../../../components/SkillCard.astro';
import CollectionCard from '../../../components/CollectionCard.astro';
import SkillsSidebar from '../../../components/SkillsSidebar.astro';
import Pagination from '../../../components/Pagination.astro';
import { SUPPORTED_LOCALES, loadMessages, useTranslations, type Locale } from '../../../i18n';

import { searchSkills, filterByCategory } from '../../../lib/search';
import { getCategoryLabel, getCategorySeoDescription, normalizeCategoryId } from '../../../lib/category-taxonomy';
import { OFFICIAL_REPOS, FEATURED_SCORE_THRESHOLD } from '../../../lib/skills-config';
import { getLightweightSkills, type UnifiedSkill } from '../../../lib/skills';
import { resolveQueryIntent } from '../../../lib/query-intent';
import { buildKeywordString, getCategoryKeywordClusters, getIntentKeywordClusters } from '../../../lib/seo-keywords';
import type { Env } from '../../../lib/kv';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=3600');
// Validate locale
const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;

// Get env from Cloudflare runtime
const env = Astro.locals.runtime?.env as Env;

// ⚡ PARALLEL: Load lightweight skills + translations concurrently
// Wrap D1 call in try-catch to prevent 5xx when database is unavailable
const [skillsFetched, messages] = await Promise.all([
  getLightweightSkills(env).catch(() => [] as Awaited<ReturnType<typeof getLightweightSkills>>),
  loadMessages(typedLocale),
]);

let skills: UnifiedSkill[] = skillsFetched;

// If D1/KV returned no skills, show empty state gracefully
if (skills.length === 0) {
  console.warn('[SSR] No skills found from D1/KV. Returning empty list.');
}

skills.sort((a, b) => (b.stars || 0) - (a.stars || 0));

// Get URL search params for filtering
const url = Astro.url;
const query = url.searchParams.get('q') || url.searchParams.get('query') || '';
const category = normalizeCategoryId(url.searchParams.get('category') || '');
const view = url.searchParams.get('view') || '';
const owner = url.searchParams.get('owner') || '';
const page = parseInt(url.searchParams.get('page') || '1', 10);
const ITEMS_PER_PAGE = 12;

// Identify Official Skills
const officialOwners = Object.values(OFFICIAL_REPOS)
  .filter((r) => r.type === 'official')
  .map((r) => r.owner);

// Apply view filter
if (view === 'official') {
  skills = skills.filter((s) => officialOwners.includes(s.owner));
} else if (view === 'featured') {
  // 精选 = 官方仓库 OR qualityScore >= 阈值
  const allOfficialOwners = Object.values(OFFICIAL_REPOS).map((r) => r.owner);
  skills = skills
    .filter((s) => allOfficialOwners.includes(s.owner) || (s.qualityScore || 0) >= FEATURED_SCORE_THRESHOLD)
    .sort((a, b) => (b.qualityScore || 0) - (a.qualityScore || 0));
} else if (view === 'latest') {
  skills = [...skills].sort((a, b) => new Date(b.updatedAt || 0).getTime() - new Date(a.updatedAt || 0).getTime());
}

// Apply owner filter
if (owner) {
  skills = skills.filter((s) => s.owner === owner);
}

// Apply search filter
if (query) {
  skills = searchSkills(skills, query, typedLocale);
}

// Apply category filter (skip 'all' since it means show everything)
if (category && category !== 'all') {
  skills = filterByCategory(skills, category);
}

// Calculate collections if needed (Moved up for pagination)
let skillsByOwner: Record<string, number> = {};
if (view === 'official' && !owner) {
  skillsByOwner = skills.reduce(
    (acc, skill) => {
      const skillOwner = skill.owner;
      acc[skillOwner] = (acc[skillOwner] || 0) + 1;
      return acc;
    },
    {} as Record<string, number>,
  );
}

// Calculate pagination
// For 'Official' view (without owner filter), we paginate based on COLLECTIONS (owners), not skills
let totalItems = skills.length;
let paginatedCollections: [string, number][] = [];

if (view === 'official' && !owner) {
  const owners = Object.entries(skillsByOwner);
  totalItems = owners.length;

  const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
  const currentPage = Math.max(1, Math.min(page, totalPages || 1));

  // Slice the collections
  paginatedCollections = owners.slice((currentPage - 1) * ITEMS_PER_PAGE, currentPage * ITEMS_PER_PAGE);

  // For template compatibility, we'll keep paginatedSkills empty or unused in this mode
}

const totalSkills = skills.length; // Keep for display stats
const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
const currentPage = Math.max(1, Math.min(page, totalPages || 1));
const paginatedSkills = skills.slice((currentPage - 1) * ITEMS_PER_PAGE, currentPage * ITEMS_PER_PAGE);

// translations already loaded in parallel above
const t = useTranslations(messages);
const isZh = typedLocale === 'zh';
const cleanQuery = query.trim().slice(0, 60);
const queryIntent = cleanQuery ? resolveQueryIntent(cleanQuery, typedLocale) : null;
const workflowEntryLinks = [
  'workflow automation',
  'process automation',
  'document automation',
  'browser automation',
  'data extraction',
  'agent workflow',
];

// Page title
let pageTitle = isZh ? 'AI Agent Skills 与 MCP Servers 市场' : 'AI Agent Skills & MCP Servers Marketplace';
if (cleanQuery) pageTitle = isZh ? `${cleanQuery} 相关 AI Agent Skills` : `${cleanQuery} AI Agent Skills & MCP Servers`;
else if (category && category !== 'all')
  pageTitle = `${getCategoryLabel(category, t) || category} ${isZh ? 'AI Agent Skills' : 'AI Agent Skills & MCP Servers'}`;
else if (view === 'official')
  pageTitle = isZh ? '官方与认证 AI Agent Skills 列表' : 'Official & Verified AI Agent Skills';
else if (view === 'featured')
  pageTitle = isZh ? '精选 AI Agent Skills 与 MCP Servers' : 'Featured AI Agent Skills & MCP Servers';
else if (view === 'latest')
  pageTitle = isZh ? '最新 AI Agent Skills 与 MCP Servers' : 'Latest AI Agent Skills & MCP Servers';

if (owner) {
  const vendorConfig = Object.values(OFFICIAL_REPOS).find((v) => v.owner === owner);
  const ownerName = vendorConfig?.name || owner;
  pageTitle = isZh ? `${ownerName} AI Agent Skills` : `${ownerName} AI Agent Skills & MCP Servers`;
}
if (queryIntent) {
  pageTitle = isZh
    ? `${queryIntent.displayTerm}：可安装 AI Agent Skills`
    : `${queryIntent.displayTerm}: Installable AI Agent Skills`;
}

let pageDescription = t('Metadata.Skills.description');
if (cleanQuery) {
  pageDescription = isZh
    ? `查找与“${cleanQuery}”相关的 AI Agent Skills 与 MCP Servers。支持 Claude Code、Cursor、Windsurf，一键安装。`
    : `Find AI agent skills and MCP servers for "${cleanQuery}". Compare options and install in Claude Code, Cursor, and Windsurf with one command.`;
} else if (owner) {
  pageDescription = isZh
    ? `浏览 ${owner} 发布的 AI Agent Skills 与 MCP Servers，查看功能、评分与安装方式。`
    : `Browse AI agent skills and MCP servers published by ${owner}, with use cases, quality signals, and one-command installation.`;
} else if (category && category !== 'all') {
  pageDescription = getCategorySeoDescription(category, typedLocale) || t('Metadata.Skills.description');
} else if (view === 'official') {
  pageDescription = isZh
    ? '浏览官方与认证仓库发布的 AI Agent Skills，优先发现高质量、可长期维护的 MCP Servers。'
    : 'Browse official and verified AI agent skills from trusted repositories, with reliable maintenance and quality signals.';
} else if (view === 'featured') {
  pageDescription = isZh
    ? '查看社区精选的 AI Agent Skills 与 MCP Servers，按评分与热度快速发现高价值工具。'
    : 'Discover community featured AI agent skills and MCP servers selected by quality score, popularity, and practical value.';
} else if (view === 'latest') {
  pageDescription = isZh
    ? '追踪最新收录与更新的 AI Agent Skills，第一时间获取新的 MCP Servers 与能力。'
    : 'Track newly indexed and recently updated AI agent skills to find fresh MCP servers and capabilities early.';
}
if (queryIntent) {
  pageDescription = queryIntent.description;
}

const pageKeywords = buildKeywordString(
  typedLocale,
  'core',
  'mcp',
  'ideCompat',
  ...(queryIntent ? getIntentKeywordClusters(queryIntent.id) : ['workflowAutomation', 'processAutomation']),
  ...(category && category !== 'all' ? getCategoryKeywordClusters(category) : []),
  owner ? ['developerExperience'] : [],
  view === 'official' ? ['enterpriseWorkflows'] : [],
  view === 'featured' ? ['workflowAutomation'] : [],
  view === 'latest' ? ['developerExperience'] : [],
  cleanQuery,
  queryIntent?.displayTerm,
  queryIntent?.keywords || [],
  category && category !== 'all' ? [category, `${category} mcp server`] : [],
  owner,
  view,
  'Killer-Skills',
);

// Pagination SEO: build rel prev/next URLs
const buildPaginationUrl = (p: number) => {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (category) params.set('category', category);
  if (view) params.set('view', view);
  if (owner) params.set('owner', owner);
  if (p > 1) params.set('page', String(p));

  const serialized = params.toString().replace(/\+/g, '%20');
  return serialized
    ? `https://killer-skills.com/${locale}/skills?${serialized}`
    : `https://killer-skills.com/${locale}/skills`;
};
const prevPageUrl = currentPage > 1 ? buildPaginationUrl(currentPage - 1) : null;
const nextPageUrl = currentPage < totalPages ? buildPaginationUrl(currentPage + 1) : null;
const currentCanonicalUrl =
  currentPage > 1 || query || category || view || owner ? buildPaginationUrl(currentPage) : undefined;

// Category list for sidebar
---

<Layout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  customCanonical={currentCanonicalUrl}
  noindex={Boolean(cleanQuery)}
>
  {/* Pagination SEO: rel prev/next */}
  <Fragment slot="head">
    {prevPageUrl && <link rel="prev" href={prevPageUrl} />}
    {nextPageUrl && <link rel="next" href={nextPageUrl} />}
  </Fragment>
  {/* BreadcrumbList JSON-LD */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Home', item: `https://killer-skills.com/${locale}` },
        { '@type': 'ListItem', position: 2, name: pageTitle, item: `https://killer-skills.com/${locale}/skills/` },
      ],
    })}
  />
  {/* GEO: Speakable Schema for AI citation */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: pageTitle,
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.seo-intro-paragraph', 'h2'],
      },
      url: currentCanonicalUrl || `https://killer-skills.com/${locale}/skills/`,
    })}
  />
  {/* CollectionPage + ItemList JSON-LD */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: pageTitle,
      description: pageDescription,
      url: currentCanonicalUrl || `https://killer-skills.com/${locale}/skills/`,
      isPartOf: {
        '@type': 'WebSite',
        name: 'Killer-Skills',
        url: 'https://killer-skills.com',
      },
      mainEntity: {
        '@type': 'ItemList',
        numberOfItems: totalSkills,
        itemListElement: paginatedSkills.slice(0, 12).map((s: any, i: number) => ({
          '@type': 'ListItem',
          position: (currentPage - 1) * ITEMS_PER_PAGE + i + 1,
          name: s.name || s.repo,
          url: `https://killer-skills.com/${locale}/skills/${s.owner}/${s.repo}/`,
        })),
      },
    })}
  />
  <div class="bg-slate-50/50 dark:bg-slate-950/50 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12">
      <div class="flex flex-col md:flex-row gap-8 lg:gap-10">
        <!-- Sidebar (Left) -->
        <SkillsSidebar activeCategory={category} activeView={view} />

        <!-- Main Content (Right) -->
        <div class="flex-1 min-w-0">
          <!-- Page Header & Search (Integrated) -->
          <div
            class="mb-10 border-[3px] border-[var(--border)] p-5 md:p-7 bg-[var(--background)] shadow-[8px_8px_0px_0px_var(--border)]"
          >
            <div class="flex flex-col md:flex-row md:items-end justify-between mb-6 gap-6 overflow-visible">
              <div class="flex-1 space-y-2">
                <h1
                  class="text-4xl md:text-5xl font-black text-[var(--foreground)] tracking-tight uppercase mb-2 leading-none"
                >
                  {
                    query
                      ? t('Marketplace.browsing')
                      : category
                        ? getCategoryLabel(category, t) || category
                        : owner
                          ? `${Object.values(OFFICIAL_REPOS).find((v) => v.owner === owner)?.name || owner} Skills`
                          : view === 'official'
                            ? t('Sidebar.views.official')
                            : view === 'featured'
                              ? t('Sidebar.views.featured')
                              : view === 'latest'
                                ? t('Sidebar.views.latest')
                                : t('Common.explore')
                  }
                </h1>
                <p
                  class="text-[var(--muted-foreground)] font-mono text-base md:text-lg font-bold opacity-80 leading-relaxed max-w-4xl mt-3"
                >
                  {
                    category
                      ? getCategorySeoDescription(category, typedLocale) || t('Metadata.Skills.description')
                      : t('Metadata.Skills.description')
                  }
                </p>

                {/* SEO Context Injection for Topical Authority */}
                {
                  !query && !owner && (
                    <div class="mt-6 text-sm text-[var(--foreground)] leading-relaxed max-w-4xl font-mono border-l-4 border-[var(--primary)] pl-4 py-2 bg-[var(--foreground)]/5 dark:bg-[var(--foreground)]/10">
                      {locale === 'zh' ? (
                        <p>
                          探索全球最大的 <strong>AI Agent Skills (大模型插件技能)</strong> 与{' '}
                          <strong>MCP Servers (Model Context Protocol 服务器)</strong> 开源生态目录。为您的 Claude
                          Desktop、Cursor 或自定义智能体发现并安装高质量的开发者工具。无论是系统运维、API
                          集成还是自动化数据查询，这里都有最全的经过验证的 MCP 开源实践。
                        </p>
                      ) : (
                        <p>
                          Discover the world's most comprehensive directory for <strong>AI Agent Skills</strong> and
                          community-driven <strong>MCP Servers (Model Context Protocol)</strong>. Seamlessly find and
                          install high-quality developer integrations for your Claude Desktop, Cursor, or custom AI
                          agents. From cloud operations to API integrations, explore verified open-source MCP practices
                          to supercharge your AI workflows.
                        </p>
                      )}
                    </div>
                  )
                }

                {
                  !cleanQuery && !category && !view && !owner && (
                    <div class="mt-5 flex flex-wrap gap-2">
                      {workflowEntryLinks.map((term) => (
                        <a
                          href={`/${locale}/skills?q=${encodeURIComponent(term)}`}
                          class="inline-flex items-center px-3 py-1.5 border-2 border-[var(--border)] bg-white text-[var(--foreground)] text-xs font-black uppercase tracking-wide hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-all"
                        >
                          {term}
                        </a>
                      ))}
                    </div>
                  )
                }
              </div>

              <div class="hidden md:block group">
                <div
                  class="bg-[var(--background)] text-[var(--foreground)] py-3 px-5 border-[3px] border-[var(--border)] shadow-[4px_4px_0px_0px_var(--primary)] group-hover:shadow-[7px_7px_0px_0px_var(--primary)] group-hover:translate-x-[-1px] group-hover:translate-y-[-1px] transition-all min-w-[150px] flex flex-col items-center justify-center relative"
                >
                  <!-- Compact Status & Live Bar -->
                  <div class="w-full flex items-center justify-between mb-2">
                    <div class="flex gap-1">
                      <div class="w-1.5 h-1.5 bg-[var(--foreground)]"></div>
                      <div class="w-1.5 h-1.5 bg-[var(--foreground)] opacity-20"></div>
                    </div>
                    <div
                      class="px-1.5 py-0.5 bg-[var(--primary)] text-[var(--primary-foreground)] text-[9px] font-black tracking-widest uppercase flex items-center gap-1 border border-[var(--border)]"
                    >
                      <span class="relative flex h-1.5 w-1.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-500 opacity-75"
                        ></span>
                        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-red-600"></span>
                      </span>
                      LIVE
                    </div>
                  </div>

                  <!-- Refined Number -->
                  <div class="text-5xl font-black tracking-tighter tabular-nums leading-none mb-2">
                    {skills.length}
                  </div>

                  <!-- Label tight to the number -->
                  <div class="w-full border-t border-[var(--border)] border-dotted pt-1.5 text-center">
                    <span class="text-xs font-bold text-[var(--foreground)] leading-none">
                      {t('Marketplace.availableSkills')}
                    </span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Pro Search Bar -->
            <form method="get" action={`/${locale}/skills`} class="relative group">
              <div
                class="relative flex items-center bg-[var(--background)] border-4 border-[var(--border)] shadow-[4px_4px_0px_0px_var(--border)] focus-within:translate-x-[-2px] focus-within:translate-y-[-2px] focus-within:shadow-[6px_6px_0px_0px_var(--primary)] transition-all"
              >
                <div class="pl-4 text-[var(--foreground)]">
                  <svg
                    class="w-6 h-6"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="3"
                    aria-hidden="true"
                    ><path
                      stroke-linecap="square"
                      stroke-linejoin="miter"
                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg
                  >
                </div>
                <input
                  type="text"
                  name="q"
                  value={query}
                  placeholder={t('Common.searchPlaceholder')}
                  aria-label={t('Common.searchPlaceholder')}
                  class="flex-1 bg-transparent border-none focus:ring-0 text-[var(--foreground)] placeholder:text-[var(--muted-foreground)] h-14 px-4 text-xl font-bold font-mono tracking-tight uppercase"
                />
                <button
                  type="submit"
                  class="bg-[var(--primary)] text-[var(--primary-foreground)] px-8 py-3.5 border-l-4 border-[var(--border)] font-bold uppercase hover:bg-[var(--foreground)] hover:text-[var(--background)] transition-colors text-lg h-full"
                >
                  {t('Common.search')}
                </button>
              </div>
            </form>

            <!-- Hot Tags -->
            <div
              class="mt-6 flex items-center gap-3 text-sm font-mono font-bold text-[var(--foreground)] uppercase overflow-x-auto pb-2"
            >
              <span class="shrink-0 text-[var(--muted-foreground)]">// {t('Marketplace.popular')}:</span>
              {
                ['PDF Processing', 'Data Analysis', 'Web Scraping', 'Code Review'].map((tag) => (
                  <a
                    href={`/${locale}/skills?q=${tag}`}
                    class="px-2 border-b-2 border-transparent hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors whitespace-nowrap"
                  >
                    [{tag}]
                  </a>
                ))
              }
            </div>
          </div>

          <!-- Skills Grid -->
          <div class="mb-6 flex items-center justify-between md:hidden">
            <div class="text-sm text-slate-500">
              {totalSkills}
              {t('Marketplace.availableSkills').toLowerCase()}
            </div>
          </div>

          {
            (view === 'official' && !owner ? paginatedCollections.length > 0 : paginatedSkills.length > 0) ? (
              view === 'official' && !owner ? (
                /* Official Collections View */
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {paginatedCollections.map(([ownerName, count]) => (
                    <CollectionCard owner={ownerName} count={count} locale={locale} />
                  ))}
                </div>
              ) : (
                /* Standard Skill Grid */
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                  {paginatedSkills.map((skill) => (
                    <div class="h-full">
                      <SkillCard skill={skill} locale={locale} t={t} />
                    </div>
                  ))}
                </div>
              )
            ) : (
              <div class="text-center py-24 bg-[var(--background)] border-[3px] border-[var(--border)] shadow-[8px_8px_0px_0px_var(--border)]">
                <div class="w-20 h-20 mx-auto bg-[var(--foreground)] border-2 border-[var(--border)] flex items-center justify-center text-4xl mb-6 shadow-[4px_4px_0px_0px_var(--border)] text-white">
                  🔍
                </div>
                <h3 class="text-3xl font-black text-[var(--foreground)] mb-2 uppercase tracking-tight">
                  {t('Marketplace.noSkills')}
                </h3>
                <p class="text-[var(--muted-foreground)] font-mono max-w-md mx-auto mb-8 font-bold">
                  {t('Marketplace.noSkillsHint')}
                </p>
                <a
                  href={`/${locale}/skills`}
                  class="inline-block px-8 py-4 bg-[var(--primary)] hover:bg-[var(--foreground)] text-[var(--primary-foreground)] hover:text-[var(--background)] border-2 border-[var(--border)] font-bold uppercase transition-colors shadow-[4px_4px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_0px_var(--border)]"
                >
                  {t('Marketplace.viewAll')}
                </a>
              </div>
            )
          }

          {/* Pagination Controls */}
          {
            totalPages > 1 && (
              <Pagination
                currentPage={currentPage}
                totalPages={totalPages}
                baseUrl={`/${locale}/skills`}
                searchParams={{
                  ...(query && { q: query }),
                  ...(category && { category }),
                  ...(view && { view }),
                  ...(owner && { owner }),
                }}
                t={t}
              />
            )
          }
        </div>
      </div>
    </div>
  </div>
</Layout>

{/* ⚡ Prefetch on hover — preload detail pages before user clicks */}
<script is:inline>
  const prefetched = new Set();
  document.addEventListener(
    'pointerenter',
    (e) => {
      const link = e.target?.closest?.('a[href*="/skills/"]');
      if (!link) return;
      const href = link.getAttribute('href');
      if (!href || prefetched.has(href) || href.endsWith('/skills') || href.includes('?')) return;
      prefetched.add(href);
      const l = document.createElement('link');
      l.rel = 'prefetch';
      l.href = href;
      document.head.appendChild(l);
    },
    { capture: true, passive: true },
  );
</script>
