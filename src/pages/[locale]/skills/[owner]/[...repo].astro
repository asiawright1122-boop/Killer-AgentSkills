---
import Layout from '../../../../layouts/Layout.astro';
import { SUPPORTED_LOCALES, loadMessages, translateOr, useTranslations, type Locale } from '../../../../i18n';
import {
  getSkillById,
  getLocalizedDescription,
  getLightweightSkillsByRefs,
  type UnifiedSkill,
} from '../../../../lib/public-skill-catalog';
import { OFFICIAL_REPOS } from '../../../../lib/skills-config';
import { getCategoryLabel } from '../../../../lib/category-taxonomy';
import { buildLocalizedSkillPath, getSkillRoutePath } from '../../../../lib/skill-route-paths';
import { resolveSkillDetailLocale } from '../../../../lib/skill-locale-link';
import { getSitemapSkills } from '../../../../lib/sitemap-skills-runtime';
import { getRelatedSkillsLookup } from '../../../../lib/related-skills-runtime';
import { getSkillCollectionLookup } from '../../../../lib/skill-collection-lookup-runtime';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import SkillInstall from '../../../../components/SkillInstall.astro';
import SkillFaq from '../../../../components/SkillFaq.astro';
import SkillRelated from '../../../../components/SkillRelated.astro';
import { buildBreadcrumbTrail } from '../../../../lib/site/breadcrumbs';
import { extractMarkdownHeadings } from '../../../../lib/markdown-headings';
import {
  formatSkillNameForSeo,
  isLowValueSkillSeoDescription,
  isLowValueSkillSeoTitle,
  normalizeSkillSeoTitleCasing,
  resolveSkillSeoIntent,
  sanitizeSkillKeywords,
} from '../../../../lib/skill-seo-intent';
import {
  buildSkillKeywordSeed,
  resolveSkillSeoDescription,
  resolveSkillSeoTitle,
} from '../../../../lib/skill-seo-meta';
import { buildSkillSoftwareApplicationSchema } from '../../../../lib/skill-schema';
import { buildSkillIndexabilityAssessment } from '../../../../lib/skill-indexability';
import { getSkillSeoLocaleGovernance } from '../../../../lib/seo-locales';
import { isSitemapSkillBlocked } from '../../../../lib/sitemap-blocklist';
import { getSitemapBlocklist } from '../../../../lib/sitemap-blocklist-runtime';
import {
  sanitizePublicSkillCopy,
  sanitizePublicSkillCopyList,
  sanitizePublicSkillSourceExcerpt,
} from '../../../../lib/public-skill-copy';
import type { Env, SkillListingItem } from '../../../../lib/kv';
import { getRuntimeEnv } from '../../../../lib/runtime-env';
import { translateString, translateArray } from '../../../../lib/i18n-dynamic';
import SkillActions from '../../../../islands/SkillActions';
import SkillReadme from '../../../../islands/SkillReadme';
import SkillFileManager from '../../../../islands/SkillFileManager';
import SkillCard from '../../../../components/SkillCard.astro';
import '../../../../styles/prism-tokens.css';
import { Star, GitFork, Calendar, CheckCircle2, Zap, Bot, ChevronRight } from 'lucide-react';
import Github from '../../../../icons/GithubIcon';
import { trackDirectoryView } from '../../../../lib/analytics';
import { getCollectionsFromRuntime } from '../../../../lib/collections-runtime';

const { locale, owner, repo: repoRest } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (!owner || !repoRest) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// repoRest is a catch-all: could be "skills" or "skills/algorithmic-art"
const repoParts = repoRest.split('/');
const repo = repoParts[0]; // The actual repo name
const subSkillName = repoParts.length > 1 ? repoParts.slice(1).join('/') : undefined;
const requestedSkillId = subSkillName ? `${owner}/${repo}/${subSkillName}` : `${owner}/${repo}`;
const canonicalRoutePath = getSkillRoutePath({
  id: requestedSkillId,
  owner,
  repo,
});

if (!canonicalRoutePath) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Get env from Cloudflare runtime (needed for blocklist + skill data below)
const env = (await getRuntimeEnv<Env>(Astro.locals)) as Env;
const sitemapBlocklist = await getSitemapBlocklist(env);
const isBlocked = isSitemapSkillBlocked(owner, canonicalRoutePath, sitemapBlocklist);

const requestedSkillPath = buildLocalizedSkillPath(locale, owner, canonicalRoutePath);
const requestedSkillUrl = `https://killer-skills.com${requestedSkillPath}`;

// SEO: Limit catch-all depth — only repo (1) and repo/sub-skill (2) are valid.
// Aligns with middleware crawl-trap guard which blocks 2+ extra segments after owner/repo.
if (repoParts.length > 2) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400');
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const isZhLocale = typedLocale.startsWith('zh');

// env already resolved above for blocklist; reuse it here (no second getRuntimeEnv call)
const runtimeEnv = env as unknown as Record<string, unknown>;
type RepoDirectorySkill = UnifiedSkill | SkillListingItem;

const normalizeFlag = (value: unknown) =>
  String(value ?? '')
    .trim()
    .toLowerCase();
const parsePositiveInt = (value: unknown, fallback: number) => {
  const parsed = Number.parseInt(String(value ?? ''), 10);
  return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;
};
const userAgent = normalizeFlag(Astro.request.headers.get('user-agent'));
const isCrawlerRequest =
  /(googlebot|bingbot|slurp|duckduckbot|yandexbot|baiduspider|petalbot|applebot|bytespider|killer-skills-warmup-bot)/.test(
    userAgent,
  );
const maxHeavyLocalizationReadmeBytes = parsePositiveInt(runtimeEnv.SSR_HEAVY_LOCALIZATION_MAX_README_BYTES, 12000);
const maxReadmeRenderBytes = parsePositiveInt(runtimeEnv.SSR_MAX_README_RENDER_BYTES, 90000);
const maxReadmeRenderBytesCrawler = parsePositiveInt(runtimeEnv.SSR_MAX_README_RENDER_BYTES_CRAWLER, 24000);
const truncateMarkdownForSsr = (markdown: string, maxBytes: number) => {
  if (!markdown || maxBytes <= 0) {
    return { content: '', truncated: false };
  }

  const encoder = new TextEncoder();
  const markdownBytes = encoder.encode(markdown).length;
  if (markdownBytes <= maxBytes) {
    return { content: markdown, truncated: false };
  }

  const safeTargetBytes = Math.max(Math.floor(maxBytes * 0.9), 512);
  let end = Math.max(200, Math.floor(markdown.length * (safeTargetBytes / markdownBytes)));
  let candidate = markdown.slice(0, end);
  let candidateBytes = encoder.encode(candidate).length;

  while (candidateBytes > safeTargetBytes && end > 200) {
    end = Math.max(200, Math.floor(end * 0.85));
    candidate = markdown.slice(0, end);
    candidateBytes = encoder.encode(candidate).length;
  }

  const trimmed = candidate.replace(/\n[^\n]*$/, '').trimEnd();
  const suffix = '\n\n> Content trimmed for stable page rendering.';
  return { content: `${trimmed}${suffix}`, truncated: true };
};

// Load skill data - use full ID for sub-skills
const fullId = requestedSkillId;
const seoForceTemplate = ['1', 'true', 'yes', 'on'].includes(normalizeFlag(runtimeEnv.SEO_FORCE_TEMPLATE));
const useStaticFallback = Astro.locals.useStaticFallback === true;

// ⚡ PARALLEL: fetch skill data + translations + related skills concurrently
// Wrap D1 calls in try-catch to prevent 5xx when database is unavailable
const [skillResult, messages] = await Promise.all([
  useStaticFallback ? Promise.resolve(null) : getSkillById(env, fullId).catch(() => null),
  loadMessages(typedLocale),
]);

const rawSitemapSkillsData = await getSitemapSkills(env);
const rawSitemapSkills = Array.isArray(rawSitemapSkillsData)
  ? (rawSitemapSkillsData as Array<{ owner?: string; routePath?: string; updatedAt?: string }>)
  : ((rawSitemapSkillsData as { skills?: Array<{ owner?: string; routePath?: string; updatedAt?: string }> }).skills ??
    []);
const exactSitemapSkill =
  !skillResult && (subSkillName || useStaticFallback)
    ? rawSitemapSkills.find((entry) => {
        const entryOwner = String(entry.owner || '').trim();
        const routePath = String(entry.routePath || '').trim();
        if (!entryOwner || !routePath) return false;
        if (entryOwner.toLowerCase() !== owner.toLowerCase()) return false;
        return routePath.toLowerCase() === canonicalRoutePath.toLowerCase();
      })
    : null;
const sitemapSkillFallback =
  exactSitemapSkill && (subSkillName || useStaticFallback)
    ? {
        id: `${owner}/${canonicalRoutePath}`,
        name: subSkillName || repo,
        skillName: subSkillName || repo,
        owner,
        repo,
        description: '',
        category: 'developer',
        topics: [],
        stars: 0,
        source: 'cache' as const,
        updatedAt: String(exactSitemapSkill.updatedAt || new Date().toISOString()),
        qualityScore: 0,
        forks: 0,
        skillMd: {
          name: subSkillName || repo,
          description: '',
          version: '1.0.0',
          tags: [],
          body: `# ${subSkillName || repo}\n\nSource repository listing available. Detailed cache payload is unavailable in this environment.`,
          bodyPreview: `# ${subSkillName || repo}\n\nSource repository listing available.`,
        },
      }
    : null;

const hasSkill = Boolean(skillResult || sitemapSkillFallback);
const skill = skillResult || sitemapSkillFallback || ({} as any);

const repoListingCandidates =
  !hasSkill && !subSkillName ? await getLightweightSkillsByRefs(env, [`${owner}/${repo}`]).catch(() => []) : [];
const repoSubskills = repoListingCandidates.filter((item) => {
  const id = String(item?.id || '').trim();
  const parts = id.split('/').filter(Boolean);
  return parts.length >= 3;
});
let repoDirectorySkills: RepoDirectorySkill[] = repoSubskills.sort((a, b) => (b.stars || 0) - (a.stars || 0));
let usedSitemapFallback = false;

if (!repoDirectorySkills.length && !hasSkill && !subSkillName) {
  const ownerLower = owner.toLowerCase();
  const repoLower = repo.toLowerCase();

  const fallback: RepoDirectorySkill[] = rawSitemapSkills
    .filter((entry) => {
      const entryOwner = String(entry.owner || '').trim();
      const routePath = String(entry.routePath || '').trim();
      if (!entryOwner || !routePath) return false;
      if (entryOwner.toLowerCase() !== ownerLower) return false;
      const segments = routePath.split('/').filter(Boolean);
      if (segments.length < 2) return false;
      const routeRepo = segments[0];
      return routeRepo?.toLowerCase() === repoLower;
    })
    .map((entry) => {
      const routePath = String(entry.routePath || '').trim();
      const segments = routePath.split('/').filter(Boolean);
      const subSkill = segments[1] || routePath;
      return {
        id: `${owner}/${routePath}`,
        owner,
        repo,
        name: subSkill,
        skillName: subSkill,
        description: '',
        category: 'developer',
        stars: 0,
        source: 'cache',
        updatedAt: new Date().toISOString(),
        qualityScore: 0,
        forks: 0,
        topics: [],
      };
    });

  if (fallback.length > 0) {
    repoDirectorySkills = fallback;
    usedSitemapFallback = true;
  }
}

const renderRepoDirectory = !hasSkill && !subSkillName && repoDirectorySkills.length > 1;
const redirectSingleRepoSkill = !hasSkill && !subSkillName && repoDirectorySkills.length === 1;

if (usedSitemapFallback) {
  console.warn(`[SSR] Repo directory fallback used for ${owner}/${repo}.`);
}

if (!hasSkill && !renderRepoDirectory) {
  // SEO: If this was a sub-skill path, 301 redirect to parent skill page
  // to recover link equity instead of returning empty 404
  if (subSkillName) {
    return new Response(null, {
      status: 301,
      headers: {
        Location: buildLocalizedSkillPath(locale, owner, repo),
        'Cache-Control': 'public, s-maxage=86400',
      },
    });
  }
  if (redirectSingleRepoSkill) {
    const onlySkill = repoDirectorySkills[0];
    const onlyRoutePath = getSkillRoutePath({
      id: onlySkill?.id,
      owner: onlySkill?.owner || owner,
      repo: onlySkill?.repo || repo,
    });
    if (onlyRoutePath) {
      return new Response(null, {
        status: 301,
        headers: {
          Location: buildLocalizedSkillPath(locale, owner, onlyRoutePath),
          'Cache-Control': 'public, s-maxage=86400',
        },
      });
    }
  }
  // Cache 404 responses to prevent Googlebot from re-crawling
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600');
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (renderRepoDirectory) {
  trackDirectoryView(Astro.locals, Astro.request, locale, owner, repo);
}

// Build related collections from the skill-collection lookup (parallel KV reads)
const [allCollections, skillCollectionLookup] = await Promise.all([
  getCollectionsFromRuntime(env),
  getSkillCollectionLookup(env),
]);
const skillRefKey = `${owner}/${repo}`;
const skillPathRefKey = canonicalRoutePath ? `${owner}/${canonicalRoutePath}` : skillRefKey;
const collectionSlugs =
  (skillCollectionLookup as Record<string, string[]>)[skillPathRefKey] ||
  (skillCollectionLookup as Record<string, string[]>)[skillRefKey] ||
  [];
const relatedCollections = collectionSlugs
  .map((slug) =>
    allCollections.find((c) => {
      const cSlug =
        (c.data as any).canonicalSlug ||
        c.id
          .split('/')
          .pop()
          ?.replace(/\.json$/, '');
      return cSlug === slug;
    }),
  )
  .filter((c): c is NonNullable<typeof c> => Boolean(c))
  .slice(0, 5);

// Determine verified status (mirrors SkillCard.astro logic)
const officialConfig = Object.values(OFFICIAL_REPOS).find((v) => v.owner === owner);
const isVerified = (skill as any).verified ?? officialConfig?.verified ?? false;

const t = useTranslations(messages);
const tr = (key: string, fallback?: string) => translateOr(messages, key, fallback || '');
const verifiedLabel = tr('Detail.verified', 'Verified');
const updatedLabel = tr('Detail.updated', 'Updated');
const installNowLabel = tr('Detail.installNow', 'Install Now');
const platformSupportLabel = tr('Detail.platformSupport', 'Supports 19+ Platforms');
const plusMoreLabel = tr('Detail.plusMore', '+12 more');
const faqInstallTitle = tr('Detail.faqInstallTitle', 'FAQ & Installation Steps');
const faqTitle = tr('Detail.faqTitle', 'Frequently Asked Questions');
const howToInstallTitle = tr('Detail.howToInstallTitle', 'How To Install');
const defaultMetaDescription = tr(
  'Metadata.description',
  'Discover installable AI agent skills with use cases, limitations, and setup guidance for real developer workflows.',
);
const defaultNoResultsLabel = tr('Skills.noResults', 'No skills found');
const firstNonEmpty = (...values: Array<string | undefined>) =>
  values.find((value) => typeof value === 'string' && value.trim().length > 0) || '';
const repoDisplayName = `${owner}/${repo}`;
const repoDirectorySkillCount = repoDirectorySkills.length;
const repoDirectoryTitle = isZhLocale ? `${repoDisplayName} 技能目录` : `${repoDisplayName} Skills Directory`;
const repoDirectoryDescription = isZhLocale
  ? `该仓库包含多个子技能。先选择与你当前工作流匹配的技能，再查看适用场景与安装路径。`
  : `This repository contains multiple skills. Choose the one that matches your workflow before opening the installation path.`;
const repoDirectoryIntro = isZhLocale
  ? `该仓库共有 ${repoDirectorySkillCount} 个技能。`
  : `This repository contains ${repoDirectorySkillCount} skills.`;
const repoDirectoryKeywords = sanitizeSkillKeywords(
  [
    repo,
    owner,
    `${repo} skills`,
    `${repo} AI agent skills`,
    'AI agent skill',
    'skill installation',
    'developer workflow',
  ],
  { max: 10 },
).join(', ');
const repoDirectoryMetaDescription = firstNonEmpty(repoDirectoryDescription, defaultMetaDescription);

// Extract localized agentAnalysis fields (supports both old string and new Record<locale, string> format)
const localizedSuitabilityRaw: string | undefined = skill.agentAnalysis?.suitability
  ? typeof skill.agentAnalysis.suitability === 'object'
    ? (skill.agentAnalysis.suitability as Record<string, string>)[typedLocale] ||
      (skill.agentAnalysis.suitability as Record<string, string>)['en']
    : (skill.agentAnalysis.suitability as string)
  : undefined;
const localizedRecommendationRaw: string | undefined = skill.agentAnalysis?.recommendation
  ? typeof skill.agentAnalysis.recommendation === 'object'
    ? (skill.agentAnalysis.recommendation as Record<string, string>)[typedLocale] ||
      (skill.agentAnalysis.recommendation as Record<string, string>)['en']
    : (skill.agentAnalysis.recommendation as string)
  : undefined;
const localizedUseCasesRaw: string[] = skill.agentAnalysis?.useCases
  ? Array.isArray(skill.agentAnalysis.useCases)
    ? (skill.agentAnalysis.useCases as string[])
    : (skill.agentAnalysis.useCases as Record<string, string[]>)[typedLocale] ||
      (skill.agentAnalysis.useCases as Record<string, string[]>)['en'] ||
      []
  : [];
const localizedLimitationsRaw: string[] = skill.agentAnalysis?.limitations
  ? Array.isArray(skill.agentAnalysis.limitations)
    ? (skill.agentAnalysis.limitations as string[])
    : (skill.agentAnalysis.limitations as Record<string, string[]>)[typedLocale] ||
      (skill.agentAnalysis.limitations as Record<string, string[]>)['en'] ||
      []
  : [];
const localizedSuitability = sanitizePublicSkillCopy(localizedSuitabilityRaw);
const localizedRecommendation = sanitizePublicSkillCopy(localizedRecommendationRaw);
const localizedUseCases = sanitizePublicSkillCopyList(localizedUseCasesRaw);
const localizedLimitations = sanitizePublicSkillCopyList(localizedLimitationsRaw);

// Get localized description
const rawDescription = sanitizePublicSkillCopy(
  getLocalizedDescription(skill.description, typedLocale),
  defaultMetaDescription,
);
// Prefer SEO definition if available for the specific locale, otherwise fall back to standard description
const baseDescription = sanitizePublicSkillCopy(skill.seo?.definition?.[typedLocale] || rawDescription, rawDescription);
// Prepend the Agent Analysis "Suitability" hook if available for better CTR
let description = baseDescription;
if (localizedSuitability) {
  description = `${localizedSuitability} ${baseDescription}`;
}

// Get key features
const features = sanitizePublicSkillCopyList(skill.seo?.features?.[typedLocale] || skill.seo?.features?.['en'] || []);

const truncateText = (text: string, maxLen: number) => {
  const normalized = text.replace(/\s+/g, ' ').trim();
  if (normalized.length <= maxLen) return normalized;
  const sliced = normalized.slice(0, maxLen + 1);
  const boundary = Math.max(sliced.lastIndexOf(' '), sliced.lastIndexOf(','), sliced.lastIndexOf('、'));
  const end = boundary > maxLen * 0.6 ? boundary : maxLen;
  return `${normalized.slice(0, end).trim()}...`;
};

// Get SEO Keywords
const rawKeywordsList = skill.seo?.keywords?.[typedLocale] || skill.seo?.keywords?.['en'] || [];
const sanitizedSeoKeywords = sanitizeSkillKeywords(rawKeywordsList, { max: 12 });
const fallbackTopicKeywords = sanitizeSkillKeywords(skill.topics || [], { max: 12 });
const keywordsList = sanitizedSeoKeywords.length > 0 ? sanitizedSeoKeywords : fallbackTopicKeywords;
const skillSeoIntent = resolveSkillSeoIntent(skill.category, keywordsList, t);

// Construct SEO Title
const category = getCategoryLabel(skill.category, t);
const skillName = (skill.name || repo).trim();
const isN8nRepoPage = owner === 'n8n-io' && repo === 'n8n';
const isN8nRootPage = isN8nRepoPage && !subSkillName;
const isN8nLoomTranscriptPage = isN8nRepoPage && subSkillName === 'loom-transcript';
const tagline = skillSeoIntent.supportTerm || keywordsList[0] || category || 'AI Skill';
const SKILL_METADATA_OVERRIDES: Record<string, Record<string, { title?: string; description?: string }>> = {
  'Yorick-Ryu/deep-share': {
    en: {
      title: 'deep-share: Convert Markdown to Word (DOCX) in Claude Code',
      description:
        'Use the deep-share skill in Claude Code, Cursor, or Windsurf to convert Markdown files to styled Word documents (.docx) with one command.',
    },
    ja: {
      title: 'deep-share: MarkdownをWord (docx) に変換するClaude Codeスキル',
      description:
        'Claude CodeやCursor、Windsurf環境で、コマンド1つでMarkdownファイルをWord（.docx形式）に変換して出力できる検証済みツール。',
    },
  },
  'akiojin/llmlb': {
    en: {
      title: 'llmlb: LLM Load Balancer & Routing Proxy for Claude Code',
      description:
        'Configure and run llmlb load balancer to route LLM requests efficiently across backup providers in Claude Code, Cursor, and Windsurf.',
    },
    ru: {
      title: 'llmlb: Балансировщик нагрузки LLM для Claude Code',
      description:
        'Инструмент llmlb для балансировки и проксирования запросов к моделям ИИ в окружении Claude Code, Cursor и Windsurf.',
    },
  },
  'agentjido/jido_signal': {
    en: {
      title: 'jido_signal: Event Signals & PubSub for Elixir AI Agents',
      description:
        'Integrate event-driven PubSub signals into your Elixir agents. Verified setup for jido_signal in Claude Code, Cursor, and Windsurf.',
    },
    de: {
      title: 'jido_signal: Ereignissignale für Elixir KI-Agenten',
      description:
        'Installieren Sie jido_signal, um ereignisgesteuerte PubSub-Signale in Ihre Elixir-Agenten in Claude Code, Cursor und Windsurf zu integrieren.',
    },
  },
  'takuto-tanaka-4digit/excel-unidiff-cli': {
    en: {
      title: 'excel-unidiff-cli: Compare Excel Sheets via Diff in Claude Code',
      description:
        'Run excel-unidiff-cli in Claude Code, Cursor, or Windsurf to compare Excel sheets, highlighting data deltas in unified diff format.',
    },
    ja: {
      title: 'excel-unidiff-cli: Excelシートの差分をCLIで比較・確認',
      description:
        'Claude CodeやCursor、Windsurf从Excelファイルを直接読み込み、データの差分を unified diff 形式で確認できる便利ツール。',
    },
  },
};

const specialOverride = SKILL_METADATA_OVERRIDES[requestedSkillId]?.[typedLocale];

const seoTitleRaw = skill.seo?.title?.[typedLocale] || skill.seo?.title?.['en'];
const skillDisplayName = formatSkillNameForSeo(skillName) || skillName;
const templateTitle = `${skillDisplayName} ${skillSeoIntent.titleLabel}`;
const n8nTitleOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'n8n Workflow Automation Skill for Claude Code'
      : isN8nLoomTranscriptPage
        ? 'n8n Loom Transcript Workflow Skill for Claude Code'
        : ''
    : '';
const titleResolution = resolveSkillSeoTitle({
  rawSeoTitle: seoTitleRaw,
  skillDisplayName,
  skillName,
  intent: skillSeoIntent,
  category,
  override: specialOverride?.title || n8nTitleOverride || undefined,
  forceTemplate: seoForceTemplate,
});
const pageTitle = truncateText(normalizeSkillSeoTitleCasing(titleResolution.title || templateTitle), 60);

// SEO Description: prioritize explicit SEO description, otherwise use an install-focused snippet
const seoDescriptionRaw = sanitizePublicSkillCopy(
  skill.seo?.description?.[typedLocale] || skill.seo?.description?.['en'],
);
const templateDescription =
  typedLocale === 'zh'
    ? `${skillDisplayName} 适用于${skillSeoIntent.useCaseLabel}。查看它能自动化什么、适合哪些任务，以及如何在 Claude Code、Cursor 和 Windsurf 中落地。`
    : `${skillDisplayName} helps with ${skillSeoIntent.useCaseLabel}. See what it automates, which developer tasks it fits, and how to use it in Claude Code, Cursor, and Windsurf.`;
const n8nDescriptionOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'Use this n8n skill to automate workflows in Claude Code. Review key automations, setup steps, and the fastest path to shipping repeatable n8n jobs.'
      : isN8nLoomTranscriptPage
        ? 'Use this n8n Loom transcript skill to turn Loom recordings into transcripts, structured notes, and follow-up workflow actions in Claude Code.'
        : ''
    : '';
const n8nHeroTaglineOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'workflow automation patterns for Claude Code'
      : isN8nLoomTranscriptPage
        ? 'loom transcript automation for n8n workflows'
        : ''
    : '';
const n8nHeroIntroOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'Use this n8n skill in Claude Code to plan, install, and ship workflow automation faster. It surfaces n8n-specific setup context, practical automation patterns, and a one-command install path.'
      : isN8nLoomTranscriptPage
        ? 'Use this n8n Loom transcript skill in Claude Code to turn Loom videos into transcripts, structured notes, and downstream workflow actions with a faster install path.'
        : ''
    : '';
const hasLowValuePublicDescription = isLowValueSkillSeoDescription(description, skillName);
const descriptionResolution = resolveSkillSeoDescription({
  rawSeoDescription:
    !seoDescriptionRaw || isLowValueSkillSeoDescription(seoDescriptionRaw, skillName) ? undefined : seoDescriptionRaw,
  composedDescription: hasLowValuePublicDescription ? undefined : description,
  templateDescription,
  intent: skillSeoIntent,
  tagline,
