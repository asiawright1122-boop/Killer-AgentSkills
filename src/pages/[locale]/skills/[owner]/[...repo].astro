                              href={`/${locale}/skills?q=${encodeURIComponent(keyword)}`}
                              rel="nofollow"
                              class="px-2.5 py-1 bg-[var(--background)] border-2 border-[var(--border)] text-xs font-bold text-[var(--foreground)] font-mono hover:bg-[var(--foreground)] hover:text-[var(--background)] hover:shadow-[2px_2px_0px_0px_var(--border)] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all"
                            >
                              {keyword}
                            </a>
                          ))}
                        </div>
                      </section>
                    )}

                    <div class="flex items-center flex-wrap gap-y-4 gap-x-6 text-sm font-black uppercase tracking-wider font-mono text-[var(--foreground)] pt-6 w-full max-w-4xl border-t-4 border-[var(--border)]">
                      <div class="flex items-center gap-3 group cursor-pointer">
                        <img
                          src={`https://github.com/${owner}.png`}
                          alt={owner}
                          width="28"
                          height="28"
                          class="w-10 h-10 rounded-none border-[3px] border-[var(--border)] group-hover:shadow-[4px_4px_0px_0px_var(--border)] group-hover:-translate-y-1 transition-all grayscale group-hover:grayscale-0"
                          loading="lazy"
                          decoding="async"
                        />
                        <span class="group-hover:text-[var(--primary)] group-hover:bg-[var(--foreground)] px-2 py-0.5 text-base transition-colors font-black">
                          {owner}
                        </span>
                      </div>
                      <div class="w-1 h-6 bg-[var(--border)]" />
                      <div class="flex items-center gap-2 group cursor-help">
                        <Star size={18} strokeWidth={3} className="text-[var(--foreground)]" />
                        <span class="border-b-2 border-transparent group-hover:border-[var(--foreground)]">
                          [{starsDisplay}]
                        </span>
                      </div>
                      <div class="flex items-center gap-2 group cursor-help">
                        <GitFork size={18} strokeWidth={3} className="text-[var(--foreground)]" />
                        <span class="border-b-2 border-transparent group-hover:border-[var(--foreground)]">
                          [{skill.forks || 0}]
                        </span>
                      </div>
                      <div class="flex items-center gap-2 group cursor-help">
                        <Calendar size={18} strokeWidth={3} className="text-[var(--foreground)]" />
                        <span class="border-b-2 border-transparent group-hover:border-[var(--foreground)]">
                          {updatedLabel}: {new Date(skill.updatedAt).toLocaleDateString()}
                        </span>
                      </div>
                    </div>
                  </div>

                  {/* Actions Column - Hidden on mobile, shown on lg screens */}
                  <div class="hidden lg:flex items-center gap-4 shrink-0 self-start mt-4 lg:mt-0">
                    <div class="border-2 border-[var(--border)] shadow-[4px_4px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_0px_var(--border)] transition-all">
                      <SkillActions
                        client:visible
                        skillId={fullId}
                        skillName={skill.name || repo}
                        owner={owner}
                        repo={repo}
                        description={description && typeof description === 'string' ? description : ''}
                        locale={locale}
                        variant="button"
                      />
                    </div>
                    <a
                      href={githubUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="group flex items-center gap-3 px-6 py-3 border-2 border-[var(--border)] bg-[var(--background)] hover:bg-[var(--foreground)] hover:text-[var(--background)] transition-colors text-[var(--foreground)] text-sm font-black uppercase tracking-widest shadow-[4px_4px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_0px_var(--border)]"
                    >
                      <Github size={18} strokeWidth={3} className="text-current" />
                      <span>GitHub</span>
                    </a>
                  </div>
                </div>
              </div>
            </div>

            {/* Main Layout: Sticky Sidebar + Flow Content */}
            <div class="flex flex-col lg:flex-row gap-8 lg:gap-10 items-start mt-4 pb-16">
              {/* Left: Sticky Sidebar (Tools & Metadata) */}
              <aside class="w-full lg:w-[320px] shrink-0 space-y-5 lg:sticky lg:top-8 z-10 cv-auto">
                {/* Quality Score */}
                <div class="brut-card p-4 md:p-6 relative overflow-hidden group border-[3px] border-[var(--border)] shadow-[8px_8px_0px_0px_var(--border)] bg-[var(--background)] hover:-translate-y-1 hover:shadow-[10px_10px_0px_0px_var(--border)] transition-all">
                  <div class="flex items-center justify-between mb-6 relative z-10">
                    <h3 class="text-sm font-black text-[var(--foreground)] uppercase tracking-widest font-mono">
                      <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-2">↓</span>
                      {t('Detail.qualityScore')}
                    </h3>
                    <div class="px-2 py-1 bg-[var(--primary)] border-2 border-[var(--border)] text-[var(--primary-foreground)] text-xs font-black uppercase tracking-widest shadow-[2px_2px_0px_0px_var(--border)]">
                      {scoreBadgeLabel}
                    </div>
                  </div>

                  <div class="flex items-center gap-6 border-t-4 border-[var(--border)] pt-6">
                    <div class="relative w-20 h-20 shrink-0">
                      <div class="absolute inset-0 border-4 border-[var(--border)] bg-[var(--foreground)] rotate-3" />
                      <div class="absolute inset-0 border-4 border-[var(--border)] bg-[var(--primary)] -rotate-3 transition-transform group-hover:rotate-0" />
                      <div class="absolute inset-0 flex items-center justify-center bg-[var(--background)] border-4 border-[var(--border)]">
                        <span class="text-3xl font-black text-[var(--foreground)]">{skill.qualityScore || 85}</span>
                      </div>
                    </div>
                    <div>
                      <div class="text-3xl font-black text-[var(--foreground)] uppercase tracking-tight mb-1">
                        {t('Detail.excellent')}
                      </div>
                      <div class="text-sm font-bold font-mono text-[var(--muted-foreground)] uppercase">
                        {t('Detail.qualityDesc')}
                      </div>
                    </div>
                  </div>
                </div>

                {/* Install Card */}
                <SkillInstall
                  installCommand={installCommand}
                  installationLabel={t('Detail.installation')}
                  installNowLabel={installNowLabel}
                  universalInstallLabel={tr('Detail.universalInstall', 'Universal Install (Auto-Detect)')}
                  platformSupportLabel={platformSupportLabel}
                  plusMoreLabel={plusMoreLabel}
                />

                {/* File Manager */}
                <div class="brut-card border-[3px] border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] bg-[var(--background)]">
                  <SkillFileManager
                    client:idle
                    files={files}
                    selectedFile="SKILL.md"
                    labels={{
                      explorer: t('Detail.explorer'),
                      project: t('Detail.project'),
                    }}
                  />
                </div>

                {/* Tags */}
                <div>
                  <h3 class="text-xs font-black text-[var(--foreground)] uppercase tracking-widest mb-4 font-mono">
                    <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-2">#</span>
                    {t('Detail.tags')}
                  </h3>
                  <div class="flex flex-wrap gap-2">
                    {rawTopics.length > 0 ? (
                      rawTopics.map((rawTopic, index) => {
                        const translatedTopic = topics[index] || rawTopic;
                        return (
                          <a
                            href={`/${locale}/skills?topic=${encodeURIComponent(rawTopic)}`}
                            class="px-2.5 py-1 bg-[var(--background)] border-2 border-[var(--border)] text-xs font-bold text-[var(--foreground)] font-mono hover:bg-[var(--foreground)] hover:text-[var(--background)] hover:shadow-[2px_2px_0px_0px_var(--border)] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all"
                          >
                            [{translatedTopic}]
                          </a>
                        );
                      })
                    ) : (
                      <span class="text-xs text-[var(--muted-foreground)] font-mono font-bold">
                        [{t('Detail.noTags')}]
                      </span>
                    )}
                  </div>
                </div>
              </aside>

              {/* Right Main Content Stream */}
              <article class="flex-1 min-w-0 w-full max-w-4xl space-y-6">
                {/* Public skill overview */}
                {!renderRepoDirectory && skillIndexability && (
                  <section class="brut-card border-[3px] border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] bg-[var(--background)] p-5 relative overflow-hidden">
                    <div
                      class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]"
                      style="background-image: var(--background-pattern)"
                    />

                    <div class="relative z-10 space-y-6">
                      <div class="flex items-center gap-3 border-b-4 border-[var(--border)] pb-4">
                        <div class="p-2 bg-[var(--primary)] text-[var(--primary-foreground)] border-2 border-[var(--border)] shadow-[2px_2px_0px_0px_var(--border)]">
                          <Bot size={28} strokeWidth={3} />
                        </div>
                        <div>
                          <h2 class="text-2xl font-black text-[var(--foreground)] uppercase tracking-tight">
                            {tr('Detail.skillOverview', typedLocale === 'zh' ? '技能概览' : 'Skill Overview')}
                          </h2>
                          <p class="text-xs font-mono font-bold uppercase tracking-widest text-[var(--muted-foreground)] mt-1">
                            {tr(
                              'Detail.skillOverviewSub',
                              typedLocale === 'zh'
                                ? '先看适用场景、限制条件和安装路径，再决定是否继续深入。'
                                : 'Start with fit, limitations, and setup before diving into the repository.',
                            )}
                          </p>
                        </div>
                      </div>

                      <p class="seo-intro-paragraph text-sm md:text-base text-[var(--muted-foreground)] font-mono leading-relaxed border-l-4 border-[var(--primary)] pl-4 py-2 bg-[var(--foreground)]/5 dark:bg-[var(--foreground)]/10">
                        {heroIntro}
                      </p>

                      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="border-l-4 border-[var(--primary)] pl-4 py-1">
                          <h3 class="text-sm font-black text-[var(--foreground)] uppercase tracking-widest mb-2 font-mono">
                            {tr('Detail.recommendation', typedLocale === 'zh' ? '核心价值' : 'Recommendation')}
                          </h3>
                          <p class="text-[var(--foreground)] leading-relaxed font-bold">{renderedRecommendation}</p>
                        </div>

                        <div class="border-l-4 border-purple-500 pl-4 py-1">
                          <h3 class="text-sm font-black text-[var(--foreground)] uppercase tracking-widest mb-2 font-mono">
                            {tr('Detail.suitability', 'Ideal Agent Persona')}
                          </h3>
                          <p class="text-[var(--foreground)] font-bold leading-relaxed">{renderedSuitability}</p>
                        </div>
                      </div>

                      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t-2 border-dashed border-[var(--border)]">
                        <div>
                          <h3 class="text-xs font-black text-[var(--muted-foreground)] uppercase tracking-widest mb-3 font-mono">
                            <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-1">↓</span>
                            {typedLocale === 'zh'
                              ? `${tr('Detail.useCases', '赋予的主要能力')} · ${skill.name || repo}`
                              : `${tr('Detail.useCases', 'Use Cases')} for ${skill.name || repo}`}
                          </h3>
                          <div class="flex flex-wrap gap-2">
                            {renderedUseCases.map((useCase) => (
                              <div class="px-2.5 py-1 bg-[var(--background)] border-2 border-[var(--border)] text-xs font-bold text-[var(--foreground)] shadow-[2px_2px_0px_0px_var(--border)]">
                                {useCase}
                              </div>
                            ))}
                          </div>
                        </div>

                        <div>
                          <h3 class="text-xs font-black text-rose-600 dark:text-rose-500 uppercase tracking-widest mb-3 font-mono">
                            <span class="text-rose-600 bg-[var(--foreground)] dark:text-rose-500 px-1 mr-1">!</span>
                            {tr('Detail.limitations', typedLocale === 'zh' ? '使用限制与门槛' : 'Limitations')}
                          </h3>
                          <ul class="space-y-2">
                            {renderedLimitations.map((limitation) => (
                              <li class="flex items-start gap-2 text-sm font-bold text-[var(--foreground)] border-l-2 border-rose-500 pl-2">
                                <span>{limitation}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      </div>

                      <div class="border-t-2 border-dashed border-[var(--border)] pt-4">
                        <h3 class="text-xs font-black uppercase tracking-widest text-[var(--muted-foreground)] font-mono mb-2">
                          {tr('Detail.sourceBoundaryTitle', typedLocale === 'zh' ? '关于来源内容' : 'About The Source')}
                        </h3>
                        <p class="text-sm font-mono font-bold text-[var(--foreground)] leading-relaxed">
                          {sourceEvidenceDescription}
                        </p>
                      </div>
                    </div>
                  </section>
                )}

                {/* Interactive Hub: Dynamic Try Sandbox */}
                <div class="w-full">
                  <SkillTryBox skillId={fullId} skillRef={`${owner}/${repo}`} locale={typedLocale} />
                </div>

                {/* FAQ & Installation Steps */}
                <SkillFaq
                  locale={locale}
                  faqInstallTitle={faqInstallTitle}
                  faqTitle={faqTitle}
                  howToInstallTitle={howToInstallTitle}
                  faqItems={faqItems}
                  howToSteps={howToSteps}
                />

                {/* Supporting repository material */}
                {!skillIndexability?.isIndexable && (
                  <div class="brut-card border-2 border-amber-500 dark:border-amber-600 bg-amber-50 dark:bg-amber-950/30 p-4">
                    <h3 class="text-sm font-black text-amber-700 dark:text-amber-500 uppercase tracking-widest mb-1 font-mono">
                      <span class="bg-amber-700 dark:bg-amber-500 text-white dark:text-black px-1 mr-2 tracking-tighter">
                        !
                      </span>
                      {tr('Detail.sourceNotesWarning', typedLocale === 'zh' ? '来源说明' : 'Source Notes')}
                    </h3>
                    <p class="text-sm text-amber-900 dark:text-amber-400/90 font-medium font-mono leading-relaxed mt-2">
                      {typedLocale === 'zh'
                        ? '此页面仍可作为安装与查阅参考。继续使用前，请结合上方适用场景、限制条件和上游仓库说明一起判断。'
                        : 'This page is still useful for installation and source reference. Before using it, compare the fit, limitations, and upstream repository notes above.'}
                    </p>
                    {isThinContent && (
                      <p class="text-xs text-amber-900 dark:text-amber-300 font-mono font-bold leading-relaxed mt-3">
                        {typedLocale === 'zh'
                          ? '补充提示：该仓库提供的源材料本身也偏薄，继续使用前建议仔细查看上游说明。'
                          : 'Additional note: the upstream repository material is also relatively thin, so check the upstream notes carefully before using it.'}
                      </p>
                    )}
                  </div>
                )}

                <section class="space-y-3">
                  <div class="flex items-center justify-between gap-3 flex-wrap">
                    <div>
                      <h2 class="text-xl md:text-2xl font-black uppercase tracking-tight text-[var(--foreground)]">
                        {sourceEvidenceTitle}
                      </h2>
                      <p class="text-sm font-mono font-bold text-[var(--muted-foreground)] mt-2 max-w-3xl">
                        {sourceEvidenceDescription}
                      </p>
                    </div>
                    <span class="px-3 py-1 border-2 border-[var(--border)] bg-[var(--background)] text-xs font-black uppercase tracking-widest shadow-[3px_3px_0px_0px_var(--border)]">
                      {tr('Detail.supportingEvidenceBadge', 'Upstream Source')}
                    </span>
                  </div>
                  <TutorialShell
                    title={skillDisplayName}
                    description={resolvedMetaDescription}
                    tocItems={tutorialTocItems}
                  >
                    <div class="min-w-0 brut-card border-[3px] border-[var(--border)] shadow-[8px_8px_0px_0px_var(--border)] bg-[var(--background)] p-1 overflow-hidden">
                      <SkillReadme
                        client:idle
                        initialContent={readmeContent}
                        initialFiles={{
                          'SKILL.md': readmeContent,
                          '.cursorrules': `# Skill: ${skill.name}\n\n// Auto-generated by Killer-Skills Universal CLI\n// Import this skill into your Cursor AI context\n\n@import "skills/${owner}/${repo}/SKILL.md";\n\n// Usage:\n// Run 'npx killer-skills add ${owner}/${repo}' to install automatically.`,
                          'package.json': JSON.stringify(
                            {
                              name: `${owner}-${repo}-skill`,
                              version: version,
                              description: `Killer Skill: ${description && typeof description === 'string' ? description : ''}`,
                              keywords: topics,
                              author: owner,
                              license: 'MIT',
                              homepage: canonicalSkillUrl,
                              repository: {
                                type: 'git',
                                url: `https://github.com/${owner}/${repo}`,
                              },
                            },
                            null,
                            2,
                          ),
                        }}
                        name="SKILL.md"
                        headerTitle={sourceEvidenceTitle}
                        headerDescription={sourceEvidenceDescription}
                        headerBadge={tr('Detail.upstreamSourceBadge', 'Upstream Source')}
                        sourceRepositoryOwner={owner}
                        sourceRepositoryRepo={repo}
                        sourceFilePath={skill.filePath || 'SKILL.md'}
                      />
                    </div>
                  </TutorialShell>
                </section>
              </article>
            </div>
          </Fragment>
        )
      }
    </main>

    {/* Related Skills + Collections */}
    {
      !renderRepoDirectory && (
        <SkillRelated
          locale={locale}
          typedLocale={typedLocale}
          relatedSkills={relatedSkills}
          relatedCollections={relatedCollections}
          skillName={skill.name || repo}
          repo={repo}
          category={category}
          messages={messages}
          t={t}
          tr={tr}
        />
      )
    }
  </div>

  <!-- Install / Copy handlers are in Layout.astro (event delegation for View Transitions) -->
</Layout>
