---
import Layout from '../../../../layouts/Layout.astro';
import { SUPPORTED_LOCALES, loadMessages, translateOr, useTranslations, type Locale } from '../../../../i18n';
import { getSkillByOwnerRepo, getSkillById, getLocalizedDescription } from '../../../../lib/skills';
import { getRelatedSkillsFast } from '../../../../lib/kv';
import { OFFICIAL_REPOS } from '../../../../lib/skills-config';
import { getCategoryLabel } from '../../../../lib/category-taxonomy';
import { getCanonicalCollections } from '../../../../lib/collection-slugs';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import SkillInstall from '../../../../components/SkillInstall.astro';
import SkillFaq from '../../../../components/SkillFaq.astro';
import SkillRelated from '../../../../components/SkillRelated.astro';
import SkillTryBox from '../../../../components/SkillTryBox.astro';
import { buildBreadcrumbTrail } from '../../../../lib/site/breadcrumbs';
import { resolveSkillSeoIntent, sanitizeSkillKeywords } from '../../../../lib/skill-seo-intent';
import { buildSkillSoftwareApplicationSchema } from '../../../../lib/skill-schema';
import type { Env } from '../../../../lib/kv';
import { getCollection } from 'astro:content';
import { translateString, translateArray } from '../../../../lib/i18n-dynamic';
import SkillActions from '../../../../islands/SkillActions';
import SkillReadme from '../../../../islands/SkillReadme';
import SkillFileManager from '../../../../islands/SkillFileManager';
import Github from 'lucide-react/dist/esm/icons/github';
import Star from 'lucide-react/dist/esm/icons/star';
import GitFork from 'lucide-react/dist/esm/icons/git-fork';
import Calendar from 'lucide-react/dist/esm/icons/calendar';
import CheckCircle2 from 'lucide-react/dist/esm/icons/check-circle-2';
import Zap from 'lucide-react/dist/esm/icons/zap';
import Bot from 'lucide-react/dist/esm/icons/bot';
import ChevronRight from 'lucide-react/dist/esm/icons/chevron-right';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=86400');

const { locale, owner, repo: repoRest } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (!owner || !repoRest) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// repoRest is a catch-all: could be "skills" or "skills/algorithmic-art"
const repoParts = repoRest.split('/');
const repo = repoParts[0]; // The actual repo name
const subSkillName = repoParts.length > 1 ? repoParts.slice(1).join('/') : undefined;
const canonicalSkillPath = `/${locale}/skills/${owner}/${repo}`;
const canonicalSkillUrl = `https://killer-skills.com${canonicalSkillPath}`;

// SEO: Limit catch-all depth — only repo (1) and repo/sub-skill (2) are valid.
// Aligns with middleware crawl-trap guard which blocks 2+ extra segments after owner/repo.
if (repoParts.length > 2) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400');
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;

// Get env from Cloudflare runtime
const env = Astro.locals.runtime?.env as Env;
const runtimeEnv = (Astro.locals.runtime?.env || {}) as Record<string, unknown>;

const normalizeFlag = (value: unknown) =>
  String(value ?? '')
    .trim()
    .toLowerCase();
const stableHash = (input: string) => {
  let hash = 0;
  for (let i = 0; i < input.length; i++) {
    hash = (hash * 31 + input.charCodeAt(i)) >>> 0;
  }
  return hash;
};

// Load skill data - use full ID for sub-skills
const fullId = subSkillName ? `${owner}/${repo}/${subSkillName}` : `${owner}/${repo}`;
const seoVariantMode = normalizeFlag(runtimeEnv.SEO_TITLE_VARIANT).toUpperCase();
const seoVariant =
  seoVariantMode === 'B' ? 'B' : seoVariantMode === 'AUTO' ? (stableHash(fullId) % 2 === 0 ? 'A' : 'B') : 'A';
const seoForceTemplate = ['1', 'true', 'yes', 'on'].includes(normalizeFlag(runtimeEnv.SEO_FORCE_TEMPLATE));

// ⚡ PARALLEL: fetch skill data + translations + related skills concurrently
// Wrap D1 calls in try-catch to prevent 5xx when database is unavailable
const [skillResult, messages] = await Promise.all([
  getSkillById(env, fullId).catch(() => null),
  loadMessages(typedLocale),
]);

// Load collections that contain this skill
const allCollections = getCanonicalCollections(await getCollection('collections'));
const skillKey = `${owner}/${repo}`;
const relatedCollections = allCollections.filter((col) => col.data.skills.includes(skillKey));

let skill = skillResult;
if (!skill && !subSkillName) {
  // Keep owner/repo fallback only for parent skill pages.
  // Sub-skill URLs must resolve by exact ID to avoid false-positive 200 pages.
  skill = await getSkillByOwnerRepo(env, owner, repo).catch(() => null);
}

if (!skill) {
  // SEO: If this was a sub-skill path, 301 redirect to parent skill page
  // to recover link equity instead of returning empty 404
  if (subSkillName) {
    return new Response(null, {
      status: 301,
      headers: {
        Location: canonicalSkillPath,
        'Cache-Control': 'public, s-maxage=86400',
      },
    });
  }
  // Cache 404 responses to prevent Googlebot from re-crawling
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600');
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Determine verified status (mirrors SkillCard.astro logic)
const officialConfig = Object.values(OFFICIAL_REPOS).find((v) => v.owner === owner);
const isVerified = (skill as any).verified ?? officialConfig?.verified ?? false;

const t = useTranslations(messages);
const tr = (key: string, fallback?: string) => translateOr(messages, key, fallback || '');
const verifiedLabel = tr('Detail.verified', 'Verified');
const updatedLabel = tr('Detail.updated', 'Updated');
const scoreBadgeLabel = tr('Detail.top5Percent', 'Top 5%');
const installNowLabel = tr('Detail.installNow', 'Install Now');
const platformSupportLabel = tr('Detail.platformSupport', 'Supports 19+ Platforms');
const plusMoreLabel = tr('Detail.plusMore', '+12 more');
const faqInstallTitle = tr('Detail.faqInstallTitle', 'FAQ & Installation Steps');
const faqTitle = tr('Detail.faqTitle', 'Frequently Asked Questions');
const howToInstallTitle = tr('Detail.howToInstallTitle', 'How To Install');
const defaultMetaDescription = tr(
  'Metadata.description',
  'Discover, install, and manage AI Agent Skills. Support for Claude Code, Cursor, Windsurf, Antigravity, etc. One-click install to boost your AI coding capabilities.',
);
const defaultNoResultsLabel = tr('Skills.noResults', 'No skills found');
const firstNonEmpty = (...values: Array<string | undefined>) =>
  values.find((value) => typeof value === 'string' && value.trim().length > 0) || '';

// Extract localized agentAnalysis fields (supports both old string and new Record<locale, string> format)
const localizedSuitability: string | undefined = skill.agentAnalysis?.suitability
  ? typeof skill.agentAnalysis.suitability === 'object'
    ? (skill.agentAnalysis.suitability as Record<string, string>)[typedLocale] ||
      (skill.agentAnalysis.suitability as Record<string, string>)['en']
    : (skill.agentAnalysis.suitability as string)
  : undefined;
const localizedRecommendation: string | undefined = skill.agentAnalysis?.recommendation
  ? typeof skill.agentAnalysis.recommendation === 'object'
    ? (skill.agentAnalysis.recommendation as Record<string, string>)[typedLocale] ||
      (skill.agentAnalysis.recommendation as Record<string, string>)['en']
    : (skill.agentAnalysis.recommendation as string)
  : undefined;
const localizedUseCases: string[] = skill.agentAnalysis?.useCases
  ? Array.isArray(skill.agentAnalysis.useCases)
    ? (skill.agentAnalysis.useCases as string[])
    : (skill.agentAnalysis.useCases as Record<string, string[]>)[typedLocale] ||
      (skill.agentAnalysis.useCases as Record<string, string[]>)['en'] ||
      []
  : [];
const localizedLimitations: string[] = skill.agentAnalysis?.limitations
  ? Array.isArray(skill.agentAnalysis.limitations)
    ? (skill.agentAnalysis.limitations as string[])
    : (skill.agentAnalysis.limitations as Record<string, string[]>)[typedLocale] ||
      (skill.agentAnalysis.limitations as Record<string, string[]>)['en'] ||
      []
  : [];

// Get localized description
const rawDescription = getLocalizedDescription(skill.description, typedLocale);
// Prefer SEO definition if available for the specific locale, otherwise fall back to standard description
const baseDescription = skill.seo?.definition?.[typedLocale] || rawDescription;
// Prepend the Agent Analysis "Suitability" hook if available for better CTR
let description = baseDescription;
if (localizedSuitability) {
  description = `${localizedSuitability} ${baseDescription}`;
}

// Get key features
const features = skill.seo?.features?.[typedLocale] || skill.seo?.features?.['en'] || [];

const normalizeSpace = (text: string) => text.replace(/\s+/g, ' ').trim();
const normalizeForMatch = (text: string) => normalizeSpace(text).toLowerCase();
const truncateText = (text: string, maxLen: number) => {
  const normalized = normalizeSpace(text);
  if (normalized.length <= maxLen) return normalized;
  const sliced = normalized.slice(0, maxLen + 1);
  const boundary = Math.max(sliced.lastIndexOf(' '), sliced.lastIndexOf(','), sliced.lastIndexOf('、'));
  const end = boundary > maxLen * 0.6 ? boundary : maxLen;
  return `${normalized.slice(0, end).trim()}...`;
};

// Get SEO Keywords
const rawKeywordsList = skill.seo?.keywords?.[typedLocale] || skill.seo?.keywords?.['en'] || [];
const sanitizedSeoKeywords = sanitizeSkillKeywords(rawKeywordsList, { max: 12 });
const fallbackTopicKeywords = sanitizeSkillKeywords(skill.topics || [], { max: 12 });
const keywordsList = sanitizedSeoKeywords.length > 0 ? sanitizedSeoKeywords : fallbackTopicKeywords;
const skillSeoIntent = resolveSkillSeoIntent(skill.category, keywordsList, t);
const matchesIntentSignals = (text: string | undefined, signals: string[]) => {
  if (!text) return false;
  const normalizedText = normalizeForMatch(text);
  return signals.some((signal) => signal && normalizedText.includes(normalizeForMatch(signal)));
};

// Construct SEO Title
const category = getCategoryLabel(skill.category, t);
const skillName = (skill.name || repo).trim();
const isN8nRepoPage = owner === 'n8n-io' && repo === 'n8n';
const isN8nRootPage = isN8nRepoPage && !subSkillName;
const isN8nLoomTranscriptPage = isN8nRepoPage && subSkillName === 'loom-transcript';
const tagline = skillSeoIntent.supportTerm || keywordsList[0] || category || 'AI Skill';
const seoTitleRaw = skill.seo?.title?.[typedLocale] || skill.seo?.title?.['en'];
const templateTitleA = `${skillName} ${skillSeoIntent.titleLabel}`;
const templateTitleB =
  typedLocale === 'zh'
    ? `${skillName}：${skillSeoIntent.titleLabel}，支持 Claude Code`
    : `${skillName}: ${skillSeoIntent.titleLabel} for Claude Code`;
const selectedTemplateTitle = seoVariant === 'B' ? templateTitleB : templateTitleA;
const titleIntentSignals = [
  skillSeoIntent.titleLabel,
  category,
  skillSeoIntent.supportTerm,
  ...skillSeoIntent.keywords,
];
const shouldUseTitleTemplate =
  seoForceTemplate || !seoTitleRaw || !matchesIntentSignals(seoTitleRaw, titleIntentSignals);
const n8nTitleOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'n8n Workflow Automation Skill for Claude Code'
      : isN8nLoomTranscriptPage
        ? 'n8n Loom Transcript Workflow Skill for Claude Code'
        : ''
    : '';
const pageTitle = truncateText(n8nTitleOverride || (shouldUseTitleTemplate ? selectedTemplateTitle : seoTitleRaw), 60);

// SEO Description: prioritize explicit SEO description, otherwise use an install-focused snippet
const seoDescriptionRaw = skill.seo?.description?.[typedLocale] || skill.seo?.description?.['en'];
const intentUseCase = skillSeoIntent.supportTerm || skillSeoIntent.useCaseLabel;
const templateDescriptionA =
  typedLocale === 'zh'
    ? `安装 ${skillName}，这是一款面向${skillSeoIntent.useCaseLabel}的 AI Agent Skill。支持 Claude Code、Cursor、Windsurf，一键安装。`
    : `Install ${skillName}, an AI agent skill for ${skillSeoIntent.useCaseLabel}. Works with Claude Code, Cursor, and Windsurf with one-command setup.`;
const templateDescriptionB =
  typedLocale === 'zh'
    ? `${skillName} 适合${intentUseCase}场景，支持 Claude Code、Cursor、Windsurf，查看功能、使用场景与安装命令。`
    : `${skillName} helps with ${intentUseCase}. Explore features, use cases, and one-command setup for Claude Code, Cursor, and Windsurf.`;
const selectedTemplateDescription = seoVariant === 'B' ? templateDescriptionB : templateDescriptionA;
const descriptionIntentSignals = [
  skillSeoIntent.useCaseLabel,
  skillSeoIntent.supportTerm,
  tagline,
  ...skillSeoIntent.keywords,
];
const shouldUseDescriptionTemplate =
  seoForceTemplate || !seoDescriptionRaw || !matchesIntentSignals(seoDescriptionRaw, descriptionIntentSignals);
const n8nDescriptionOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'Install this n8n workflow automation skill for Claude Code. Build faster automations with setup steps, key features, and one-command install.'
      : isN8nLoomTranscriptPage
        ? 'Install the n8n Loom transcript workflow skill for Claude Code. Turn Loom recordings into structured notes and automated actions in one setup.'
        : ''
    : '';
const n8nHeroTaglineOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'workflow automation patterns for Claude Code'
      : isN8nLoomTranscriptPage
        ? 'loom transcript automation for n8n workflows'
        : ''
    : '';
const n8nHeroIntroOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'Use this n8n skill in Claude Code to plan, install, and ship workflow automation faster. It surfaces n8n-specific setup context, practical automation patterns, and a one-command install path.'
      : isN8nLoomTranscriptPage
        ? 'Use this n8n Loom transcript skill in Claude Code to turn Loom videos into transcripts, structured notes, and downstream workflow actions with a faster install path.'
        : ''
    : '';
const heroTagline = n8nHeroTaglineOverride || tagline;
const heroIntroRaw = firstNonEmpty(n8nHeroIntroOverride, description, defaultNoResultsLabel);

// --- SSR Dynamic Translation Interception ---
const [t_description, t_heroIntro, t_features, t_topics, t_useCases, t_limitations] = await Promise.all([
  translateString(env, typeof description === 'string' ? description : '', typedLocale, 'text'),
  translateString(env, heroIntroRaw, typedLocale, 'text'),
  translateArray(env, features, typedLocale),
  translateArray(env, keywordsList, typedLocale),
  translateArray(env, localizedUseCases, typedLocale),
  translateArray(env, localizedLimitations, typedLocale),
]);

const heroIntro = t_heroIntro;
description = t_description;
const renderedFeatures = t_features;
const renderedTopics = t_topics;
const renderedUseCases = t_useCases;
const renderedLimitations = t_limitations;
// --------------------------------------------
const n8nInternalLinks = isN8nRepoPage
  ? [
      ...(isN8nLoomTranscriptPage
        ? [
            {
              href: `/${locale}/skills/${owner}/${repo}`,
              label: tr('Detail.openMainN8n', 'Open the main n8n skill page'),
              description: tr(
                'Detail.seeMainN8n',
                'See the main n8n skill page, install command, and broader workflow automation context.',
              ),
            },
          ]
        : []),
      {
        href: `/${locale}/solutions/workflow-automation`,
        label: tr('Detail.browseWorkflowSolutions', 'Browse workflow automation solutions'),
        description: tr(
          'Detail.exploreWorkflowUseCases',
          'Explore workflow automation use cases, related skills, and install-ready solution paths.',
        ),
      },
      {
        href: `/${locale}/cli`,
        label: tr('Detail.seeCliInstall', 'See CLI install and management'),
        description: tr(
          'Detail.learnHowToInstall',
          'Learn how to install, sync, and manage this skill through the Killer-Skills CLI.',
        ),
      },
      {
        href: `/${locale}/integrations`,
        label: tr('Detail.checkIdeSupport', 'Check IDE integration support'),
        description: tr(
          'Detail.confirmHowThisSkill',
          'Confirm how this skill fits Claude Code, Cursor, Windsurf, and other supported IDEs.',
        ),
      },
    ]
  : [];
const metaDescription = truncateText(
  n8nDescriptionOverride
    ? n8nDescriptionOverride
    : shouldUseDescriptionTemplate
      ? selectedTemplateDescription
      : seoDescriptionRaw || description || selectedTemplateDescription,
  158,
);
const resolvedMetaDescription = firstNonEmpty(metaDescription, defaultMetaDescription);

// Limit keyword set to avoid stuffing while keeping entity + intent terms
const seoKeywordSeed = [
  skillName,
  repo,
  category,
  ...(isN8nRepoPage ? ['n8n', 'n8n workflow automation', 'n8n skill'] : []),
  ...(isN8nLoomTranscriptPage ? ['loom transcript automation'] : []),
  skillSeoIntent.supportTerm,
  ...skillSeoIntent.keywords,
  ...keywordsList.slice(0, 8),
];
const sanitizedKeywordSeed = sanitizeSkillKeywords(seoKeywordSeed.map((k) => k?.toString().trim()).filter(Boolean), {
  max: 10,
});
const platformKeywords = ['Claude Code', 'Cursor', 'Windsurf'];
const seoKeywords = Array.from(new Set([...sanitizedKeywordSeed, ...platformKeywords]))
  .slice(0, 11)
  .join(', ');

// Structured Data (JSON-LD) — SoftwareApplication
const schema = buildSkillSoftwareApplicationSchema({
  name: skill.name || repo,
  category,
  description: description && typeof description === 'string' ? description : '',
  canonicalUrl: canonicalSkillUrl,
  owner,
  updatedAt: skill.updatedAt,
  lastSynced: skill.lastSynced,
});
const breadcrumb = buildBreadcrumbTrail(
  [
    { label: tr('Common.home', 'Home'), href: `/${locale}` },
    { label: tr('Common.skillsMarket', 'Skills'), href: `/${locale}/skills` },
    ...(skill.category && category ? [{ label: category, href: `/${locale}/skills?category=${skill.category}` }] : []),
    { label: skill.name || repo },
  ],
  { currentUrl: canonicalSkillUrl },
);

// Install command - use full path for sub-skills (declared early for FAQ/HowTo schemas)
const installPath = subSkillName ? `${owner}/${repo}/${subSkillName}` : `${owner}/${repo}`;
const installCommand = `npx killer-skills add ${installPath}`;
const isZhLocale = typedLocale === 'zh';

// FAQ JSON-LD — dynamically generated from skill data
const faqItems: { question: string; answer: string }[] = [];

const skillDisplayName = skill.name || repo;
const tpl = (key: string, vars: Record<string, string>, fallback: string) =>
  tr(key, fallback).replace(/\{\{(\w+)\}\}/g, (_, k) => vars[k] ?? '');

// Q1: What is this skill?
faqItems.push({
  question: tpl('Detail.faqWhatIs', { name: skillDisplayName }, `What is ${skillDisplayName}?`),
  answer:
    description && typeof description === 'string'
      ? description
      : tpl(
          'Detail.faqWhatIsAnswer',
          { name: skillDisplayName },
          `${skillDisplayName} is an AI agent skill available on Killer-Skills.`,
        ),
});

// Q2: How to install?
faqItems.push({
  question: tpl('Detail.faqHowInstall', { name: skillDisplayName }, `How do I install ${skillDisplayName}?`),
  answer: tpl(
    'Detail.faqHowInstallAnswer',
    { name: skillDisplayName, installCommand },
    `Run the command: ${installCommand}. It works with Cursor, Windsurf, VS Code, Claude Code, and 19+ other IDEs.`,
  ),
});

// Q3: Use cases (from agentAnalysis)
if (renderedUseCases.length > 0) {
  faqItems.push({
    question: tpl('Detail.faqUseCases', { name: skillDisplayName }, `What are the use cases for ${skillDisplayName}?`),
    answer: tpl(
      'Detail.faqUseCasesAnswer',
      { name: skillDisplayName, useCases: renderedUseCases.join(isZhLocale ? '、' : ', ') },
      `Key use cases include: ${renderedUseCases.join(', ')}.`,
    ),
  });
}

// Q4: IDE compatibility
const supportedPlatforms =
  'Cursor, Windsurf, VS Code, Trae, Claude Code, OpenClaw, Aider, Codex, OpenCode, Goose, Cline, Roo Code, Kiro, Augment Code, Continue, GitHub Copilot, Sourcegraph Cody, and Amazon Q Developer';
faqItems.push({
  question: tpl('Detail.faqIDEs', { name: skillDisplayName }, `Which IDEs are compatible with ${skillDisplayName}?`),
  answer: tpl(
    'Detail.faqIDEsAnswer',
    { name: skillDisplayName, supportedPlatforms },
    `This skill is compatible with ${supportedPlatforms}. Use the Killer-Skills CLI for universal one-command installation.`,
  ),
});

// Q5: Limitations (from agentAnalysis)
if (renderedLimitations.length > 0) {
  faqItems.push({
    question: tpl(
      'Detail.faqLimitations',
      { name: skillDisplayName },
      `Are there any limitations for ${skillDisplayName}?`,
    ),
    answer: renderedLimitations.join(isZhLocale ? '；' : '. ') + (isZhLocale ? '。' : '.'),
  });
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};

// HowTo JSON-LD — installation steps
const howToSteps = [
  {
    name: tr('Detail.howToName1', 'Open your terminal'),
    text: tr('Detail.howToText1', 'Open the terminal or command line in your project directory.'),
  },
  {
    name: tr('Detail.howToName2', 'Run the install command'),
    text: tpl(
      'Detail.howToText2',
      { installCommand },
      `Run: ${installCommand}. The CLI will automatically detect your IDE or AI agent and configure the skill.`,
    ),
  },
  {
    name: tr('Detail.howToName3', 'Start using the skill'),
    text: tpl(
      'Detail.howToText3',
      { name: skillDisplayName },
      `The skill is now active. Your AI agent can use ${skillDisplayName} immediately in the current project.`,
    ),
  },
];

const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: `${tr('Detail.howToInstallTitle', 'How To Install')} ${skillDisplayName} AI Skill`,
  description: tpl(
    'Detail.howToDescription',
    { name: skillDisplayName },
    `Install the ${skillDisplayName} skill for your AI coding agent in seconds using the Killer-Skills CLI.`,
  ),
  totalTime: 'PT1M',
  tool: {
    '@type': 'HowToTool',
    name: tr('Detail.howToName1', 'Terminal / Command Line'),
  },
  step: howToSteps.map((step, index) => ({
    '@type': 'HowToStep',
    position: index + 1,
    name: step.name,
    text: step.text,
  })),
};

// OG image URL pointing to static fallback until external CDN is established
const ogImageUrl = new URL(`/og-image.webp`, Astro.url).toString();

// Format stars
const starsDisplay =
  (skill.stars || 0) > 1000 ? ((skill.stars || 0) / 1000).toFixed(1) + 'k' : String(skill.stars || 0);

// GitHub URL
const githubUrl = `https://github.com/${owner}/${repo}`;

// Topics
const rawTopics = skill.topics || [];

// Prepare file list
const textEncoder = new TextEncoder();
const rawReadmeContent = skill.skillMd?.body || skill.skillMd?.bodyPreview || '';
const rawReadmeSize = textEncoder.encode(rawReadmeContent).length;
const fallbackReadmeContent = `# ${skill.name || repo}\n\n${description}`;
const readmeContentSource =
  rawReadmeContent && rawReadmeSize >= 250
    ? rawReadmeContent
    : [rawReadmeContent, fallbackReadmeContent].filter((part) => part && part.trim().length > 0).join('\n\n');

// ⚡ Related skills runs AFTER we have skill.category (can't be fully parallelized)
const relatedSkillsSource = await getRelatedSkillsFast(env, `${owner}/${repo}`, skill.category || '', 4);

// --- Phase 11: Deep SSR Localization (Markdown Content & Related Skills) ---
let readmeContent = readmeContentSource;
let relatedSkills = relatedSkillsSource;
let topics = rawTopics;

if (typedLocale !== 'en') {
  const relatedNames = relatedSkillsSource.map((s) => s.skillName || s.name);
  const relatedDesc = relatedSkillsSource.map((s) =>
    typeof s.description === 'string'
      ? s.description
      : (s.description as any)?.[typedLocale] || (s.description as any)?.['en'] || '',
  );

  const [t_readme, t_relatedNames, t_relatedDesc, t_topics] = await Promise.all([
    translateString(env, readmeContentSource, typedLocale, 'text'),
    translateArray(env, relatedNames, typedLocale),
    translateArray(env, relatedDesc, typedLocale),
    translateArray(env, rawTopics, typedLocale),
  ]);

  readmeContent = t_readme;
  topics = t_topics;
  relatedSkills = relatedSkillsSource.map((s, index) => ({
    ...s,
    skillName: t_relatedNames[index] || s.skillName,
    description: t_relatedDesc[index] || s.description,
  }));
}
// --------------------------------------------------------------------------

const readmeSize = textEncoder.encode(readmeContent).length;
const isThinContent = readmeSize < 250; // Block indexing if extremely short (Thin Content penalty)
const formatSize = (bytes: number) => {
  if (bytes < 1024) return bytes + ' B';
  return (bytes / 1024).toFixed(1) + ' KB';
};

const files = [
  { name: 'SKILL.md', size: formatSize(readmeSize), type: 'file' as const },
  { name: '.cursorrules', size: '1.2 KB', type: 'file' as const },
  { name: 'package.json', size: '240 B', type: 'file' as const },
];

const version = skill.skillMd?.version || '1.0.0';
---

<Layout
  locale={locale}
  title={pageTitle}
  description={resolvedMetaDescription}
  keywords={seoKeywords}
  image={ogImageUrl}
  ogType="product"
  noindex={isThinContent}
  customCanonical={canonicalSkillUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb.jsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
    {/* GEO: Speakable Schema for AI citation engines */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: pageTitle,
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['h1', '.seo-intro-paragraph', 'h2'],
        },
        url: canonicalSkillUrl,
      })}
    />
  </Fragment>
  <div
    class="min-h-screen bg-gray-50 dark:bg-[#050505] text-gray-900 dark:text-white font-sans selection:bg-cyan-500/30 selection:text-cyan-900 dark:selection:text-cyan-200 overflow-x-hidden transition-colors duration-300"
  >
    {/* Ambient Glows - Adjusted for Light Mode */}
    <div
      class="fixed top-[-20%] left-[-10%] w-[50%] h-[50%] bg-purple-500/5 dark:bg-purple-900/10 blur-[150px] pointer-events-none rounded-full"
    >
    </div>
    <div
      class="fixed bottom-[-20%] right-[-10%] w-[50%] h-[50%] bg-cyan-500/5 dark:bg-cyan-900/10 blur-[150px] pointer-events-none rounded-full"
    >
    </div>

    <main class="max-w-7xl mx-auto px-3 sm:px-6 py-6 md:py-8 relative z-10">
      <Breadcrumb items={breadcrumb.items} />

      {/* Header Section */}
      <div class="relative pt-2 pb-6 border-b-[3px] border-[var(--border)] mb-6 md:mb-8">
        {/* Info */}
        <div class="w-full">
          <div class="flex items-start justify-between gap-3 md:gap-4 mb-3 flex-wrap relative">
            <div class="flex items-center gap-2 md:gap-3 flex-wrap w-full md:w-auto">
              <h1
                class="text-3xl md:text-5xl font-black text-[var(--foreground)] tracking-tight break-words uppercase w-full md:w-auto flex flex-col gap-1 leading-none"
              >
                <span>{skill.name || repo}</span>
                {/* SEO: Dynamic H1 Sub-heading for Topical Authority */}
                {
                  heroTagline && (
                    <span class="text-base md:text-xl font-mono text-[var(--muted-foreground)] tracking-widest normal-case opacity-80">
                      — {heroTagline}
                    </span>
                  )
                }
                {/* Hidden actual keywords for deeper matching if not inside tagline */}
                <span class="sr-only">{seoKeywords}</span>
              </h1>
              <div class="flex items-center gap-2 mt-1 md:mt-0 font-mono">
                {
                  isVerified && (
                    <div class="px-2 py-1 bg-[var(--primary)] text-[var(--primary-foreground)] border-2 border-[var(--border)] text-xs font-bold uppercase tracking-widest flex items-center gap-1 shadow-[2px_2px_0px_0px_var(--border)]">
                      <CheckCircle2 size={14} strokeWidth={3} className="w-3.5 h-3.5" />
                      {verifiedLabel}
                    </div>
                  )
                }
                <span
                  class="px-2 py-1 bg-[var(--background)] text-[var(--foreground)] border-2 border-[var(--border)] text-xs font-bold shadow-[2px_2px_0px_0px_var(--border)] uppercase"
                >
                  v{version}
                </span>
              </div>
            </div>
          </div>

          {/* Mobile Actions (Under Title) */}
          <div class="flex lg:hidden items-center gap-3 mb-6 flex-wrap w-full mt-4">
            <div class="border-2 border-[var(--border)] shadow-[4px_4px_0px_0px_var(--border)]">
              <SkillActions
                client:visible
                skillId={`${owner}/${repo}`}
                skillName={skill.name || repo}
                owner={owner}
                repo={repo}
                description={description && typeof description === 'string' ? description : ''}
                locale={locale}
                labels={{
                  addToFavorites: t('Aria.addToFavorites'),
                  removeFromFavorites: t('Aria.removeFromFavorites'),
                  shareSkill: t('Aria.shareSkill'),
                }}
                variant="button"
              />
            </div>
            <a
              href={githubUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 px-4 py-2 border-2 border-[var(--border)] bg-[var(--background)] hover:bg-[var(--foreground)] hover:text-[var(--background)] transition-colors text-[var(--foreground)] text-sm font-black uppercase tracking-wider shadow-[4px_4px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px]"
            >
              <Github size={16} className="text-current" />
              <span>GitHub</span>
            </a>
          </div>

          <div class="flex flex-col lg:flex-row items-start justify-between gap-4 lg:gap-6 mt-4">
            <div class="flex-1 w-full min-w-0">
              <h2 class="sr-only">{t('Detail.about')}</h2>

              {/* GEO: AI-quotable intro paragraph with seo-intro-paragraph class for Speakable schema */}

              <p
                class="seo-intro-paragraph text-lg md:text-xl text-[var(--foreground)] font-mono font-bold leading-snug max-w-4xl mb-5 break-words"
              >
                {heroIntro}
              </p>

              {
                n8nInternalLinks.length > 0 && (
                  <section class="mb-6 border-[3px] border-[var(--border)] bg-[var(--background)] shadow-[6px_6px_0px_0px_var(--border)] p-4">
                    <h2 class="text-xs font-black text-[var(--muted-foreground)] uppercase tracking-widest mb-3 font-mono">
                      <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-2">→</span>
                      {tr('Detail.relatedPaths', 'Related Paths')}
                    </h2>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                      {n8nInternalLinks.map((item) => (
                        <a
                          href={item.href}
                          class="group block border-2 border-[var(--border)] bg-[var(--background)] px-4 py-4 hover:bg-[var(--foreground)] hover:text-[var(--background)] transition-all shadow-[3px_3px_0px_0px_var(--border)] hover:translate-x-[-1px] hover:translate-y-[-1px]"
                        >
                          <div class="flex items-start justify-between gap-3 mb-2">
                            <span class="text-sm font-black uppercase tracking-wide leading-tight">{item.label}</span>
                            <ChevronRight size={16} strokeWidth={3} className="shrink-0 mt-0.5" />
                          </div>
                          <p class="text-xs font-mono leading-relaxed opacity-80">{item.description}</p>
                        </a>
                      ))}
                    </div>
                  </section>
                )
              }

              {/* AI Features */}
              {
                features.length > 0 && (
                  <section class="mb-10">
                    <h2 class="sr-only">{t('Detail.features')}</h2>
                    <div class="flex flex-wrap gap-2">
                      {renderedFeatures.map((feature: string) => (
                        <div class="flex items-center gap-1.5 text-xs font-bold text-[var(--primary-foreground)] bg-[var(--primary)] px-2.5 py-1.5 border-2 border-[var(--border)] shadow-[2px_2px_0px_0px_var(--border)]">
                          <Zap size={12} strokeWidth={3} className="shrink-0" />
                          <span>{feature}</span>
                        </div>
                      ))}
                    </div>
                  </section>
                )
              }

              {/* SEO: On-Page Keyword Tag Cloud (Dominant Topic Signals) */}
              {
                keywordsList.length > 0 && (
                  <section class="mb-10">
                    <h2 class="text-xs font-black text-[var(--muted-foreground)] uppercase tracking-widest mb-3 font-mono">
                      <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-1">#</span>
                      {tr('Detail.coreTopics', 'Core Topics')}
                    </h2>
                    <div class="flex flex-wrap gap-2">
                      {renderedTopics.slice(0, 6).map((keyword: string) => (
                        <a
                          href={`/${locale}/skills?q=${encodeURIComponent(keyword)}`}
                          class="px-2.5 py-1 bg-[var(--background)] border-2 border-[var(--border)] text-xs font-bold text-[var(--foreground)] font-mono hover:bg-[var(--foreground)] hover:text-[var(--background)] hover:shadow-[2px_2px_0px_0px_var(--border)] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all"
                        >
                          {keyword}
                        </a>
                      ))}
                    </div>
                  </section>
                )
              }

              <div
                class="flex items-center flex-wrap gap-y-4 gap-x-6 text-sm font-black uppercase tracking-wider font-mono text-[var(--foreground)] pt-6 w-full max-w-4xl border-t-4 border-[var(--border)]"
              >
                <div class="flex items-center gap-3 group cursor-pointer">
                  <img
                    src={`https://github.com/${owner}.png`}
                    alt={owner}
                    width="28"
                    height="28"
                    class="w-8 h-8 rounded-none border-2 border-[var(--border)] group-hover:shadow-[2px_2px_0px_0px_var(--border)] transition-all grayscale group-hover:grayscale-0"
                    loading="lazy"
                    decoding="async"
                  />
                  <span
                    class="group-hover:text-[var(--primary)] group-hover:bg-[var(--foreground)] px-1 transition-colors"
                    >{owner}</span
                  >
                </div>
                <div class="w-1 h-6 bg-[var(--border)]"></div>
                <div class="flex items-center gap-2 group cursor-help">
                  <Star size={18} strokeWidth={3} className="text-[var(--foreground)]" />
                  <span class="border-b-2 border-transparent group-hover:border-[var(--foreground)]"
                    >[{starsDisplay}]</span
                  >
                </div>
                <div class="flex items-center gap-2 group cursor-help">
                  <GitFork size={18} strokeWidth={3} className="text-[var(--foreground)]" />
                  <span class="border-b-2 border-transparent group-hover:border-[var(--foreground)]"
                    >[{skill.forks || 0}]</span
                  >
                </div>
                <div class="flex items-center gap-2 group cursor-help">
                  <Calendar size={18} strokeWidth={3} className="text-[var(--foreground)]" />
                  <span class="border-b-2 border-transparent group-hover:border-[var(--foreground)]"
                    >{updatedLabel}: {new Date(skill.updatedAt).toLocaleDateString()}</span
                  >
                </div>
              </div>
            </div>

            {/* Actions Column - Hidden on mobile, shown on lg screens */}
            <div class="hidden lg:flex items-center gap-4 shrink-0 self-start mt-4 lg:mt-0">
              <div
                class="border-2 border-[var(--border)] shadow-[4px_4px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_0px_var(--border)] transition-all"
              >
                <SkillActions
                  client:visible
                  skillId={`${owner}/${repo}`}
                  skillName={skill.name || repo}
                  owner={owner}
                  repo={repo}
                  description={description && typeof description === 'string' ? description : ''}
                  locale={locale}
                  variant="button"
                />
              </div>
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group flex items-center gap-3 px-6 py-3 border-2 border-[var(--border)] bg-[var(--background)] hover:bg-[var(--foreground)] hover:text-[var(--background)] transition-colors text-[var(--foreground)] text-sm font-black uppercase tracking-widest shadow-[4px_4px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_0px_var(--border)]"
              >
                <Github size={18} strokeWidth={3} className="text-current" />
                <span>GitHub</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      {/* Main Layout: Sticky Sidebar + Flow Content */}
      <div class="flex flex-col lg:flex-row gap-6 items-start mt-6 pb-12">
        {/* Left: Sticky Sidebar (Tools & Metadata) */}
        <aside class="w-full lg:w-[320px] shrink-0 space-y-5 lg:sticky lg:top-8 z-10 cv-auto">
          {/* Quality Score */}
          <div
            class="brut-card p-4 md:p-5 relative overflow-hidden group border-[3px] border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] bg-[var(--background)]"
          >
            <div class="flex items-center justify-between mb-6 relative z-10">
              <h3 class="text-sm font-black text-[var(--foreground)] uppercase tracking-widest font-mono">
                <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-2">↓</span>
                {t('Detail.qualityScore')}
              </h3>
              <div
                class="px-2 py-1 bg-[var(--primary)] border-2 border-[var(--border)] text-[var(--primary-foreground)] text-xs font-black uppercase tracking-widest shadow-[2px_2px_0px_0px_var(--border)]"
              >
                {scoreBadgeLabel}
              </div>
            </div>

            <div class="flex items-center gap-6 border-t-4 border-[var(--border)] pt-6">
              <div class="relative w-20 h-20 shrink-0">
                <div class="absolute inset-0 border-4 border-[var(--border)] bg-[var(--foreground)] rotate-3"></div>
                <div
                  class="absolute inset-0 border-4 border-[var(--border)] bg-[var(--primary)] -rotate-3 transition-transform group-hover:rotate-0"
                >
                </div>
                <div
                  class="absolute inset-0 flex items-center justify-center bg-[var(--background)] border-4 border-[var(--border)]"
                >
                  <span class="text-3xl font-black text-[var(--foreground)]">{skill.qualityScore || 85}</span>
                </div>
              </div>
              <div>
                <div class="text-3xl font-black text-[var(--foreground)] uppercase tracking-tight mb-1">
                  {t('Detail.excellent')}
                </div>
                <div class="text-sm font-bold font-mono text-[var(--muted-foreground)] uppercase">
                  {t('Detail.qualityDesc')}
                </div>
              </div>
            </div>
          </div>

          {/* Install Card */}
          <SkillInstall
            installCommand={installCommand}
            installationLabel={t('Detail.installation')}
            installNowLabel={installNowLabel}
            universalInstallLabel={tr('Detail.universalInstall', 'Universal Install (Auto-Detect)')}
            platformSupportLabel={platformSupportLabel}
            plusMoreLabel={plusMoreLabel}
          />

          {/* File Manager */}
          <div
            class="brut-card border-[3px] border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] bg-[var(--background)]"
          >
            <SkillFileManager
              client:idle
              files={files}
              selectedFile="SKILL.md"
              labels={{
                explorer: t('Detail.explorer'),
                project: t('Detail.project'),
              }}
            />
          </div>

          {/* Tags */}
          <div>
            <h3 class="text-xs font-black text-[var(--foreground)] uppercase tracking-widest mb-4 font-mono">
              <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-2">#</span>
              {t('Detail.tags')}
            </h3>
            <div class="flex flex-wrap gap-2">
              {
                rawTopics.length > 0 ? (
                  rawTopics.map((rawTopic, index) => {
                    const translatedTopic = topics[index] || rawTopic;
                    return (
                      <a
                        href={`/${locale}/skills?topic=${encodeURIComponent(rawTopic)}`}
                        class="px-2.5 py-1 bg-[var(--background)] border-2 border-[var(--border)] text-xs font-bold text-[var(--foreground)] font-mono hover:bg-[var(--foreground)] hover:text-[var(--background)] hover:shadow-[2px_2px_0px_0px_var(--border)] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all"
                      >
                        [{translatedTopic}]
                      </a>
                    );
                  })
                ) : (
                  <span class="text-xs text-[var(--muted-foreground)] font-mono font-bold">[{t('Detail.noTags')}]</span>
                )
              }
            </div>
          </div>
        </aside>

        {/* Right Main Content Stream */}
        <article class="flex-1 min-w-0 w-full max-w-4xl space-y-6">
          {/* Agent Analysis */}
          {
            skill.agentAnalysis && (
              <div class="brut-card border-[3px] border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] bg-[var(--background)] p-5 relative overflow-hidden">
                {/* Background Pattern */}
                <div
                  class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05]"
                  style="background-image: var(--background-pattern)"
                />

                <div class="relative z-10">
                  <div class="flex items-center gap-3 mb-6 border-b-4 border-[var(--border)] pb-4">
                    <div class="p-2 bg-[var(--primary)] text-[var(--primary-foreground)] border-2 border-[var(--border)] shadow-[2px_2px_0px_0px_var(--border)]">
                      <Bot size={28} strokeWidth={3} />
                    </div>
                    <h2 class="text-2xl font-black text-[var(--foreground)] uppercase tracking-tight">
                      {tr('Detail.agentAnalysis', 'Agent Capability Analysis')}
                    </h2>
                  </div>

                  {/* SEO Dynamic Intro Paragraph */}
                  <p class="seo-intro-paragraph text-sm md:text-base text-[var(--muted-foreground)] mb-6 font-mono leading-relaxed border-l-4 border-[var(--primary)] pl-4 py-2 bg-[var(--foreground)]/5 dark:bg-[var(--foreground)]/10">
                    {locale === 'zh' ? (
                      <span>
                        <strong>{skill.name || repo}</strong> 是一款由 <strong>{owner}</strong> 维护的开源{' '}
                        <strong>{category || '自动化'}</strong> AI Agent Skill。它可用于 Claude Code、Cursor、Windsurf
                        等环境，帮助你的智能体获得更稳定的任务流程与领域能力。
                        {keywordsList.length > 0 && (
                          <span class="text-[var(--foreground)]">
                            此工具针对 <strong>{keywordsList.slice(0, 3).join('、')}</strong> 进行了深度优化。
                          </span>
                        )}
                      </span>
                    ) : (
                      <span>
                        The <strong>{skill.name || repo}</strong> skill by <strong>{owner}</strong> is an open-source{' '}
                        <strong>{category ? category.replace('-', ' ') : 'automation'}</strong> AI agent skill for
                        Claude Code and other IDE workflows, helping agents execute tasks with better context,
                        repeatability, and domain-specific guidance.
                        {keywordsList.length > 0 && (
                          <span class="text-[var(--foreground)]">
                            Optimized for <strong>{keywordsList.slice(0, 3).join(', ')}</strong>.
                          </span>
                        )}
                      </span>
                    )}
                  </p>

                  <div class="space-y-6">
                    {localizedSuitability && (
                      <div class="border-l-4 border-[var(--primary)] pl-4 py-1">
                        <h3 class="text-sm font-black text-[var(--foreground)] uppercase tracking-widest mb-2 font-mono">
                          {tr('Detail.suitability', 'Ideal Agent Persona')}
                        </h3>
                        <p class="text-[var(--foreground)] font-bold leading-relaxed">{localizedSuitability}</p>
                      </div>
                    )}

                    {localizedRecommendation && (
                      <div class="border-l-4 border-purple-500 pl-4 py-1">
                        <h3 class="text-sm font-black text-[var(--foreground)] uppercase tracking-widest mb-2 font-mono">
                          {tr('Detail.recommendation', typedLocale === 'zh' ? '核心价值' : 'Recommendation')}
                        </h3>
                        <p class="text-[var(--foreground)] leading-relaxed font-bold">{localizedRecommendation}</p>
                      </div>
                    )}

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-4 border-t-2 border-dashed border-[var(--border)]">
                      {localizedUseCases.length > 0 && (
                        <div>
                          <h2 class="text-xs font-black text-[var(--muted-foreground)] uppercase tracking-widest mb-3 font-mono">
                            <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-1">↓</span>
                            {typedLocale === 'zh'
                              ? `${tr('Detail.useCases', '赋予的主要能力')} · ${skill.name || repo}`
                              : `${tr('Detail.useCases', 'Use Cases')} for ${skill.name || repo}`}
                          </h2>
                          <div class="flex flex-wrap gap-2">
                            {localizedUseCases.map((useCase) => (
                              <div class="px-2.5 py-1 bg-[var(--background)] border-2 border-[var(--border)] text-xs font-bold text-[var(--foreground)] shadow-[2px_2px_0px_0px_var(--border)]">
                                {useCase}
                              </div>
                            ))}
                          </div>
                        </div>
                      )}

                      {localizedLimitations.length > 0 && (
                        <div>
                          <h3 class="text-xs font-black text-rose-600 dark:text-rose-500 uppercase tracking-widest mb-3 font-mono">
                            <span class="text-rose-600 bg-[var(--foreground)] dark:text-rose-500 px-1 mr-1">!</span>
                            {tr('Detail.limitations', typedLocale === 'zh' ? '使用限制与门槛' : 'Limitations')}
                          </h3>
                          <ul class="space-y-2">
                            {localizedLimitations.map((limitation) => (
                              <li class="flex items-start gap-2 text-sm font-bold text-[var(--foreground)] border-l-2 border-rose-500 pl-2">
                                <span>{limitation}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            )
          }

          {/* Interactive Hub: Dynamic Try Sandbox */}
          <div class="w-full">
            <SkillTryBox skillId={fullId} skillRef={`${owner}/${repo}`} locale={typedLocale} />
          </div>

          {/* SKILL.md Preview */}
          {
            isThinContent && (
              <div class="mb-6 brut-card border-2 border-amber-500 dark:border-amber-600 bg-amber-50 dark:bg-amber-950/30 p-4">
                <h3 class="text-sm font-black text-amber-700 dark:text-amber-500 uppercase tracking-widest mb-1 font-mono">
                  <span class="bg-amber-700 dark:bg-amber-500 text-white dark:text-black px-1 mr-2 tracking-tighter">
                    !
                  </span>
                  {typedLocale === 'zh' ? '内容质量警告 (Thin Content)' : 'Thin Content Warning'}
                </h3>
                <p class="text-sm text-amber-900 dark:text-amber-400/90 font-medium font-mono leading-relaxed mt-2">
                  {typedLocale === 'zh'
                    ? '此技能仓库未提供详实的 README 描述，目前已被搜索引擎防火墙拦截。建议直接前往 GitHub 审查源码后再决定是否安装。'
                    : 'This skill repository lacks comprehensive documentation and has been blocked from search indexing. Double check the source code before installing.'}
                </p>
              </div>
            )
          }
          <div
            class="min-w-0 brut-card border-[3px] border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] bg-[var(--background)] p-1"
          >
            <SkillReadme
              client:idle
              initialContent={readmeContent}
              initialFiles={{
                'SKILL.md': readmeContent,
                '.cursorrules': `# Skill: ${skill.name}\n\n// Auto-generated by Killer-Skills Universal CLI\n// Import this skill into your Cursor AI context\n\n@import "skills/${owner}/${repo}/SKILL.md";\n\n// Usage:\n// Run 'npx killer-skills add ${owner}/${repo}' to install automatically.`,
                'package.json': JSON.stringify(
                  {
                    name: `${owner}-${repo}-skill`,
                    version: version,
                    description: `Killer Skill: ${description && typeof description === 'string' ? description : ''}`,
                    keywords: topics,
                    author: owner,
                    license: 'MIT',
                    homepage: `https://killer-skills.com/${locale}/skills/${owner}/${repo}`,
                    repository: {
                      type: 'git',
                      url: `https://github.com/${owner}/${repo}`,
                    },
                  },
                  null,
                  2,
                ),
              }}
              name="SKILL.md"
            />
          </div>

          {/* FAQ & Installation Steps */}
          <SkillFaq
            locale={locale}
            faqInstallTitle={faqInstallTitle}
            faqTitle={faqTitle}
            howToInstallTitle={howToInstallTitle}
            faqItems={faqItems}
            howToSteps={howToSteps}
          />
        </article>
      </div>
    </main>

    {/* Related Skills + Collections */}
    <SkillRelated
      locale={locale}
      typedLocale={typedLocale}
      relatedSkills={relatedSkills}
      relatedCollections={relatedCollections}
      skillName={skill.name || repo}
      repo={repo}
      category={category}
      messages={messages}
      t={t}
      tr={tr}
    />
  </div>

  <!-- Install / Copy handlers are in Layout.astro (event delegation for View Transitions) -->
</Layout>
