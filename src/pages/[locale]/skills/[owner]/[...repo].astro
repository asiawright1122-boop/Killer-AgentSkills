---
import Layout from '../../../../layouts/Layout.astro';
import { SUPPORTED_LOCALES, loadMessages, translateOr, useTranslations, type Locale } from '../../../../i18n';
import { getSkillById, getLocalizedDescription } from '../../../../lib/skills';
import { getSkillsListingByRefs } from '../../../../lib/kv';
import { getRelatedSkillsFast } from '../../../../lib/kv';
import { OFFICIAL_REPOS } from '../../../../lib/skills-config';
import { getCategoryLabel } from '../../../../lib/category-taxonomy';
import { getCanonicalCollections } from '../../../../lib/collection-slugs';
import { buildLocalizedSkillPath, getSkillRoutePath } from '../../../../lib/skill-route-paths';
import { resolveSkillDetailLocale } from '../../../../lib/skill-locale-link';
import sitemapSkillsData from '../../../../../data/sitemap-skills.json';
import sitemapBlocklistData from '../../../../../data/seo-sitemap-blocklist.json';
import { compileSitemapBlocklist, isSitemapSkillBlocked } from '../../../../lib/sitemap-blocklist';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import SkillInstall from '../../../../components/SkillInstall.astro';
import SkillFaq from '../../../../components/SkillFaq.astro';
import SkillRelated from '../../../../components/SkillRelated.astro';
import SkillTryBox from '../../../../components/SkillTryBox.astro';
import TutorialShell from '../../../../components/TutorialShell.astro';
import { buildBreadcrumbTrail } from '../../../../lib/site/breadcrumbs';
import { extractMarkdownHeadings } from '../../../../lib/markdown-headings';
import { resolveSkillSeoIntent, sanitizeSkillKeywords } from '../../../../lib/skill-seo-intent';
import { buildSkillSoftwareApplicationSchema } from '../../../../lib/skill-schema';
import { buildSkillIndexabilityAssessment } from '../../../../lib/skill-indexability';
import { getSkillSeoLocaleGovernance } from '../../../../lib/seo-locales';
import type { Env, SkillListingItem } from '../../../../lib/kv';
import { getCollection } from 'astro:content';
import { translateString, translateArray } from '../../../../lib/i18n-dynamic';
import SkillActions from '../../../../islands/SkillActions';
import SkillReadme from '../../../../islands/SkillReadme';
import SkillFileManager from '../../../../islands/SkillFileManager';
import SkillCard from '../../../../components/SkillCard.astro';
import Github from 'lucide-react/dist/esm/icons/github';
import Star from 'lucide-react/dist/esm/icons/star';
import GitFork from 'lucide-react/dist/esm/icons/git-fork';
import Calendar from 'lucide-react/dist/esm/icons/calendar';
import CheckCircle2 from 'lucide-react/dist/esm/icons/check-circle-2';
import Zap from 'lucide-react/dist/esm/icons/zap';
import Bot from 'lucide-react/dist/esm/icons/bot';
import ChevronRight from 'lucide-react/dist/esm/icons/chevron-right';
export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=86400');

const { locale, owner, repo: repoRest } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (!owner || !repoRest) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// repoRest is a catch-all: could be "skills" or "skills/algorithmic-art"
const repoParts = repoRest.split('/');
const repo = repoParts[0]; // The actual repo name
const subSkillName = repoParts.length > 1 ? repoParts.slice(1).join('/') : undefined;
const requestedSkillId = subSkillName ? `${owner}/${repo}/${subSkillName}` : `${owner}/${repo}`;
const canonicalRoutePath = getSkillRoutePath({
  id: requestedSkillId,
  owner,
  repo,
});

if (!canonicalRoutePath) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const requestedSkillPath = buildLocalizedSkillPath(locale, owner, canonicalRoutePath);
const requestedSkillUrl = `https://killer-skills.com${requestedSkillPath}`;

// SEO: Limit catch-all depth — only repo (1) and repo/sub-skill (2) are valid.
// Aligns with middleware crawl-trap guard which blocks 2+ extra segments after owner/repo.
if (repoParts.length > 2) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400');
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const isZhLocale = typedLocale.startsWith('zh');

// Get env from Cloudflare runtime
const env = Astro.locals.runtime?.env as Env;
const runtimeEnv = (Astro.locals.runtime?.env || {}) as Record<string, unknown>;

const normalizeFlag = (value: unknown) =>
  String(value ?? '')
    .trim()
    .toLowerCase();
const parsePositiveInt = (value: unknown, fallback: number) => {
  const parsed = Number.parseInt(String(value ?? ''), 10);
  return Number.isFinite(parsed) && parsed > 0 ? parsed : fallback;
};
const userAgent = normalizeFlag(Astro.request.headers.get('user-agent'));
const isCrawlerRequest =
  /(googlebot|bingbot|slurp|duckduckbot|yandexbot|baiduspider|petalbot|applebot|bytespider)/.test(userAgent);
const maxHeavyLocalizationReadmeBytes = parsePositiveInt(runtimeEnv.SSR_HEAVY_LOCALIZATION_MAX_README_BYTES, 12000);
const maxReadmeRenderBytes = parsePositiveInt(runtimeEnv.SSR_MAX_README_RENDER_BYTES, 90000);
const maxReadmeRenderBytesCrawler = parsePositiveInt(runtimeEnv.SSR_MAX_README_RENDER_BYTES_CRAWLER, 24000);
const truncateMarkdownForSsr = (markdown: string, maxBytes: number) => {
  if (!markdown || maxBytes <= 0) {
    return { content: '', truncated: false };
  }

  const encoder = new TextEncoder();
  const markdownBytes = encoder.encode(markdown).length;
  if (markdownBytes <= maxBytes) {
    return { content: markdown, truncated: false };
  }

  const safeTargetBytes = Math.max(Math.floor(maxBytes * 0.9), 512);
  let end = Math.max(200, Math.floor(markdown.length * (safeTargetBytes / markdownBytes)));
  let candidate = markdown.slice(0, end);
  let candidateBytes = encoder.encode(candidate).length;

  while (candidateBytes > safeTargetBytes && end > 200) {
    end = Math.max(200, Math.floor(end * 0.85));
    candidate = markdown.slice(0, end);
    candidateBytes = encoder.encode(candidate).length;
  }

  const trimmed = candidate.replace(/\n[^\n]*$/, '').trimEnd();
  const suffix = '\n\n> Content trimmed for stable page rendering.';
  return { content: `${trimmed}${suffix}`, truncated: true };
};

// Load skill data - use full ID for sub-skills
const fullId = requestedSkillId;
const seoForceTemplate = ['1', 'true', 'yes', 'on'].includes(normalizeFlag(runtimeEnv.SEO_FORCE_TEMPLATE));

// ⚡ PARALLEL: fetch skill data + translations + related skills concurrently
// Wrap D1 calls in try-catch to prevent 5xx when database is unavailable
const [skillResult, messages] = await Promise.all([
  getSkillById(env, fullId).catch(() => null),
  loadMessages(typedLocale),
]);

const blocklist = compileSitemapBlocklist(sitemapBlocklistData);
const rawSitemapSkills = Array.isArray(sitemapSkillsData)
  ? (sitemapSkillsData as Array<{ owner?: string; routePath?: string; updatedAt?: string }>)
  : ((sitemapSkillsData as { skills?: Array<{ owner?: string; routePath?: string; updatedAt?: string }> }).skills ??
    []);
const exactSitemapSkill =
  !skillResult && subSkillName
    ? rawSitemapSkills.find((entry) => {
        const entryOwner = String(entry.owner || '').trim();
        const routePath = String(entry.routePath || '').trim();
        if (!entryOwner || !routePath) return false;
        if (entryOwner.toLowerCase() !== owner.toLowerCase()) return false;
        if (isSitemapSkillBlocked(entryOwner, routePath, blocklist)) return false;
        return routePath.toLowerCase() === canonicalRoutePath.toLowerCase();
      })
    : null;
const sitemapSkillFallback =
  exactSitemapSkill && subSkillName
    ? {
        id: `${owner}/${canonicalRoutePath}`,
        name: subSkillName,
        skillName: subSkillName,
        owner,
        repo,
        description: '',
        category: 'developer',
        topics: [],
        stars: 0,
        source: 'cache' as const,
        updatedAt: String(exactSitemapSkill.updatedAt || new Date().toISOString()),
        qualityScore: 0,
        forks: 0,
        skillMd: {
          name: subSkillName,
          description: '',
          version: '1.0.0',
          tags: [],
          body: `# ${subSkillName}\n\nSource repository listing available. Detailed cache payload is unavailable in this environment.`,
          bodyPreview: `# ${subSkillName}\n\nSource repository listing available.`,
        },
      }
    : null;

const hasSkill = Boolean(skillResult || sitemapSkillFallback);
const skill = skillResult || sitemapSkillFallback || ({} as any);

const repoListingCandidates =
  !hasSkill && !subSkillName ? await getSkillsListingByRefs(env, [`${owner}/${repo}`]).catch(() => []) : [];
const repoSubskills = repoListingCandidates.filter((item) => {
  const id = String(item?.id || '').trim();
  const parts = id.split('/').filter(Boolean);
  return parts.length >= 3;
});
let repoDirectorySkills = repoSubskills.sort((a, b) => (b.stars || 0) - (a.stars || 0));
let usedSitemapFallback = false;

if (!repoDirectorySkills.length && !hasSkill && !subSkillName) {
  const ownerLower = owner.toLowerCase();
  const repoLower = repo.toLowerCase();

  const fallback: SkillListingItem[] = rawSitemapSkills
    .filter((entry) => {
      const entryOwner = String(entry.owner || '').trim();
      const routePath = String(entry.routePath || '').trim();
      if (!entryOwner || !routePath) return false;
      if (entryOwner.toLowerCase() !== ownerLower) return false;
      if (isSitemapSkillBlocked(entryOwner, routePath, blocklist)) return false;
      const segments = routePath.split('/').filter(Boolean);
      if (segments.length < 2) return false;
      const routeRepo = segments[0];
      return routeRepo?.toLowerCase() === repoLower;
    })
    .map((entry) => {
      const routePath = String(entry.routePath || '').trim();
      const segments = routePath.split('/').filter(Boolean);
      const subSkill = segments[1] || routePath;
      return {
        id: `${owner}/${routePath}`,
        owner,
        repo,
        name: subSkill,
        skillName: subSkill,
        description: '',
        category: 'developer',
        stars: 0,
        source: 'cache',
        updatedAt: new Date().toISOString(),
        qualityScore: 0,
        forks: 0,
        topics: [],
      };
    });

  if (fallback.length > 0) {
    repoDirectorySkills = fallback;
    usedSitemapFallback = true;
  }
}

const renderRepoDirectory = !hasSkill && !subSkillName && repoDirectorySkills.length > 1;
const redirectSingleRepoSkill = !hasSkill && !subSkillName && repoDirectorySkills.length === 1;

if (usedSitemapFallback) {
  console.warn(`[SSR] Repo directory fallback used for ${owner}/${repo}.`);
}

if (!hasSkill && !renderRepoDirectory) {
  // SEO: If this was a sub-skill path, 301 redirect to parent skill page
  // to recover link equity instead of returning empty 404
  if (subSkillName) {
    return new Response(null, {
      status: 301,
      headers: {
        Location: buildLocalizedSkillPath(locale, owner, repo),
        'Cache-Control': 'public, s-maxage=86400',
      },
    });
  }
  if (redirectSingleRepoSkill) {
    const onlySkill = repoDirectorySkills[0];
    const onlyRoutePath = getSkillRoutePath({
      id: onlySkill?.id,
      owner: onlySkill?.owner || owner,
      repo: onlySkill?.repo || repo,
    });
    if (onlyRoutePath) {
      return new Response(null, {
        status: 301,
        headers: {
          Location: buildLocalizedSkillPath(locale, owner, onlyRoutePath),
          'Cache-Control': 'public, s-maxage=86400',
        },
      });
    }
  }
  // Cache 404 responses to prevent Googlebot from re-crawling
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600');
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Load collections only after skill is resolved.
// This keeps invalid bot-hit URLs cheap while valid pages still expose useful skill details.
const relatedCollections = await (async () => {
  if (renderRepoDirectory) {
    return [];
  }

  try {
    const allCollections = getCanonicalCollections(await getCollection('collections'));
    const collectionSkillKeys = new Set([`${owner}/${repo}`, fullId]);
    return allCollections.filter((col) => col.data.skills.some((skillRef) => collectionSkillKeys.has(skillRef)));
  } catch (error) {
    console.warn('[SSR] Failed to load related collections for skill detail page:', error);
    return [];
  }
})();

// Determine verified status (mirrors SkillCard.astro logic)
const officialConfig = Object.values(OFFICIAL_REPOS).find((v) => v.owner === owner);
const isVerified = (skill as any).verified ?? officialConfig?.verified ?? false;

const t = useTranslations(messages);
const tr = (key: string, fallback?: string) => translateOr(messages, key, fallback || '');
const verifiedLabel = tr('Detail.verified', 'Verified');
const updatedLabel = tr('Detail.updated', 'Updated');
const scoreBadgeLabel = tr('Detail.top5Percent', 'Top 5%');
const installNowLabel = tr('Detail.installNow', 'Install Now');
const platformSupportLabel = tr('Detail.platformSupport', 'Supports 19+ Platforms');
const plusMoreLabel = tr('Detail.plusMore', '+12 more');
const faqInstallTitle = tr('Detail.faqInstallTitle', 'FAQ & Installation Steps');
const faqTitle = tr('Detail.faqTitle', 'Frequently Asked Questions');
const howToInstallTitle = tr('Detail.howToInstallTitle', 'How To Install');
const defaultMetaDescription = tr(
  'Metadata.description',
  'Discover installable AI agent skills with use cases, limitations, and setup guidance for real developer workflows.',
);
const defaultNoResultsLabel = tr('Skills.noResults', 'No skills found');
const firstNonEmpty = (...values: Array<string | undefined>) =>
  values.find((value) => typeof value === 'string' && value.trim().length > 0) || '';
const repoDisplayName = `${owner}/${repo}`;
const repoDirectorySkillCount = repoDirectorySkills.length;
const repoDirectoryTitle = isZhLocale ? `${repoDisplayName} 技能目录` : `${repoDisplayName} Skills Directory`;
const repoDirectoryDescription = isZhLocale
  ? `该仓库包含多个子技能。先选择与你当前工作流匹配的技能，再查看适用场景与安装路径。`
  : `This repository contains multiple skills. Choose the one that matches your workflow before opening the installation path.`;
const repoDirectoryIntro = isZhLocale
  ? `该仓库共有 ${repoDirectorySkillCount} 个技能。`
  : `This repository contains ${repoDirectorySkillCount} skills.`;
const repoDirectoryKeywords = sanitizeSkillKeywords(
  [
    repo,
    owner,
    `${repo} skills`,
    `${repo} AI agent skills`,
    'AI agent skill',
    'skill installation',
    'developer workflow',
  ],
  { max: 10 },
).join(', ');
const repoDirectoryMetaDescription = firstNonEmpty(repoDirectoryDescription, defaultMetaDescription);

// Extract localized agentAnalysis fields (supports both old string and new Record<locale, string> format)
const localizedSuitability: string | undefined = skill.agentAnalysis?.suitability
  ? typeof skill.agentAnalysis.suitability === 'object'
    ? (skill.agentAnalysis.suitability as Record<string, string>)[typedLocale] ||
      (skill.agentAnalysis.suitability as Record<string, string>)['en']
    : (skill.agentAnalysis.suitability as string)
  : undefined;
const localizedRecommendation: string | undefined = skill.agentAnalysis?.recommendation
  ? typeof skill.agentAnalysis.recommendation === 'object'
    ? (skill.agentAnalysis.recommendation as Record<string, string>)[typedLocale] ||
      (skill.agentAnalysis.recommendation as Record<string, string>)['en']
    : (skill.agentAnalysis.recommendation as string)
  : undefined;
const localizedUseCases: string[] = skill.agentAnalysis?.useCases
  ? Array.isArray(skill.agentAnalysis.useCases)
    ? (skill.agentAnalysis.useCases as string[])
    : (skill.agentAnalysis.useCases as Record<string, string[]>)[typedLocale] ||
      (skill.agentAnalysis.useCases as Record<string, string[]>)['en'] ||
      []
  : [];
const localizedLimitations: string[] = skill.agentAnalysis?.limitations
  ? Array.isArray(skill.agentAnalysis.limitations)
    ? (skill.agentAnalysis.limitations as string[])
    : (skill.agentAnalysis.limitations as Record<string, string[]>)[typedLocale] ||
      (skill.agentAnalysis.limitations as Record<string, string[]>)['en'] ||
      []
  : [];

// Get localized description
const rawDescription = getLocalizedDescription(skill.description, typedLocale);
// Prefer SEO definition if available for the specific locale, otherwise fall back to standard description
const baseDescription = skill.seo?.definition?.[typedLocale] || rawDescription;
// Prepend the Agent Analysis "Suitability" hook if available for better CTR
let description = baseDescription;
if (localizedSuitability) {
  description = `${localizedSuitability} ${baseDescription}`;
}

// Get key features
const features = skill.seo?.features?.[typedLocale] || skill.seo?.features?.['en'] || [];

const normalizeSpace = (text: string) => text.replace(/\s+/g, ' ').trim();
const normalizeForMatch = (text: string) => normalizeSpace(text).toLowerCase();
const truncateText = (text: string, maxLen: number) => {
  const normalized = normalizeSpace(text);
  if (normalized.length <= maxLen) return normalized;
  const sliced = normalized.slice(0, maxLen + 1);
  const boundary = Math.max(sliced.lastIndexOf(' '), sliced.lastIndexOf(','), sliced.lastIndexOf('、'));
  const end = boundary > maxLen * 0.6 ? boundary : maxLen;
  return `${normalized.slice(0, end).trim()}...`;
};

// Get SEO Keywords
const rawKeywordsList = skill.seo?.keywords?.[typedLocale] || skill.seo?.keywords?.['en'] || [];
const sanitizedSeoKeywords = sanitizeSkillKeywords(rawKeywordsList, { max: 12 });
const fallbackTopicKeywords = sanitizeSkillKeywords(skill.topics || [], { max: 12 });
const keywordsList = sanitizedSeoKeywords.length > 0 ? sanitizedSeoKeywords : fallbackTopicKeywords;
const skillSeoIntent = resolveSkillSeoIntent(skill.category, keywordsList, t);
const matchesIntentSignals = (text: string | undefined, signals: string[]) => {
  if (!text) return false;
  const normalizedText = normalizeForMatch(text);
  return signals.some((signal) => signal && normalizedText.includes(normalizeForMatch(signal)));
};

// Construct SEO Title
const category = getCategoryLabel(skill.category, t);
const skillName = (skill.name || repo).trim();
const isN8nRepoPage = owner === 'n8n-io' && repo === 'n8n';
const isN8nRootPage = isN8nRepoPage && !subSkillName;
const isN8nLoomTranscriptPage = isN8nRepoPage && subSkillName === 'loom-transcript';
const tagline = skillSeoIntent.supportTerm || keywordsList[0] || category || 'AI Skill';
const seoTitleRaw = skill.seo?.title?.[typedLocale] || skill.seo?.title?.['en'];
const templateTitle = `${skillName} ${skillSeoIntent.titleLabel}`;
const titleIntentSignals = [
  skillSeoIntent.titleLabel,
  category,
  skillSeoIntent.supportTerm,
  ...skillSeoIntent.keywords,
];
const shouldUseTitleTemplate =
  seoForceTemplate || !seoTitleRaw || !matchesIntentSignals(seoTitleRaw, titleIntentSignals);
const n8nTitleOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'n8n Workflow Automation Skill for Claude Code'
      : isN8nLoomTranscriptPage
        ? 'n8n Loom Transcript Workflow Skill for Claude Code'
        : ''
    : '';
const pageTitle = truncateText(n8nTitleOverride || (shouldUseTitleTemplate ? templateTitle : seoTitleRaw), 60);

// SEO Description: prioritize explicit SEO description, otherwise use an install-focused snippet
const seoDescriptionRaw = skill.seo?.description?.[typedLocale] || skill.seo?.description?.['en'];
const intentUseCase = skillSeoIntent.supportTerm || skillSeoIntent.useCaseLabel;
const templateDescription =
  typedLocale === 'zh'
    ? `安装 ${skillName}，这是一款面向${skillSeoIntent.useCaseLabel}的 AI Agent Skill。查看功能、使用场景、限制条件与安装命令。`
    : `Install ${skillName}, an AI agent skill for ${skillSeoIntent.useCaseLabel}. Explore features, use cases, limitations, and setup guidance.`;
const descriptionIntentSignals = [
  skillSeoIntent.useCaseLabel,
  skillSeoIntent.supportTerm,
  tagline,
  ...skillSeoIntent.keywords,
];
const shouldUseDescriptionTemplate =
  seoForceTemplate || !seoDescriptionRaw || !matchesIntentSignals(seoDescriptionRaw, descriptionIntentSignals);
const n8nDescriptionOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'Install this n8n workflow automation skill for Claude Code. Build faster automations with setup steps, key features, and one-command install.'
      : isN8nLoomTranscriptPage
        ? 'Install the n8n Loom transcript workflow skill for Claude Code. Turn Loom recordings into structured notes and automated actions in one setup.'
        : ''
    : '';
const n8nHeroTaglineOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'workflow automation patterns for Claude Code'
      : isN8nLoomTranscriptPage
        ? 'loom transcript automation for n8n workflows'
        : ''
    : '';
const n8nHeroIntroOverride =
  typedLocale === 'en'
    ? isN8nRootPage
      ? 'Use this n8n skill in Claude Code to plan, install, and ship workflow automation faster. It surfaces n8n-specific setup context, practical automation patterns, and a one-command install path.'
      : isN8nLoomTranscriptPage
        ? 'Use this n8n Loom transcript skill in Claude Code to turn Loom videos into transcripts, structured notes, and downstream workflow actions with a faster install path.'
        : ''
    : '';
const heroTagline = n8nHeroTaglineOverride || tagline;
const heroIntroRaw = firstNonEmpty(n8nHeroIntroOverride, description, defaultNoResultsLabel);
const recommendationRaw = localizedRecommendation || '';
const suitabilityRaw = localizedSuitability || '';
const suitabilityFallback = tr(
  'Detail.suitabilityFallback',
  'A strong fit when you want clearer setup steps, practical limits, and faster installation decisions.',
);

// --- SSR Dynamic Translation Interception ---
const shouldRunLightLocalization = typedLocale !== 'en' && !isCrawlerRequest && !renderRepoDirectory;
const [t_description, t_heroIntro, t_features, t_topics, t_useCases, t_limitations, t_recommendation, t_suitability] =
  shouldRunLightLocalization
    ? await Promise.all([
        translateString(env, typeof description === 'string' ? description : '', typedLocale, 'text'),
        translateString(env, heroIntroRaw, typedLocale, 'text'),
        translateArray(env, features, typedLocale),
        translateArray(env, keywordsList, typedLocale),
        translateArray(env, localizedUseCases, typedLocale),
        translateArray(env, localizedLimitations, typedLocale),
        translateString(env, recommendationRaw, typedLocale, 'text'),
        translateString(env, suitabilityRaw, typedLocale, 'text'),
      ])
    : [
        description,
        heroIntroRaw,
        features,
        keywordsList,
        localizedUseCases,
        localizedLimitations,
        recommendationRaw,
        suitabilityRaw,
      ];

const heroIntro = t_heroIntro;
description = t_description;
const renderedFeatures = t_features;
const renderedTopics = t_topics;
const renderedUseCases = t_useCases;
const renderedLimitations = t_limitations;
const renderedRecommendation = t_recommendation || localizedRecommendation || heroIntro;
const renderedSuitability = t_suitability || localizedSuitability || suitabilityFallback;
// --------------------------------------------
const n8nInternalLinks = isN8nRepoPage
  ? [
      ...(isN8nLoomTranscriptPage
        ? [
            {
              href: `/${locale}/skills/${owner}/${repo}`,
              label: tr('Detail.openMainN8n', 'Open the main n8n skill page'),
              description: tr(
                'Detail.seeMainN8n',
                'See the main n8n skill page, install command, and broader workflow automation context.',
              ),
            },
          ]
        : []),
      {
        href: `/${locale}/solutions/workflow-automation`,
        label: tr('Detail.browseWorkflowSolutions', 'Browse workflow automation solutions'),
        description: tr(
          'Detail.exploreWorkflowUseCases',
          'Explore workflow automation use cases, related skills, and install-ready solution paths.',
        ),
      },
      {
        href: `/${locale}/cli`,
        label: tr('Detail.seeCliInstall', 'See CLI install and management'),
        description: tr(
          'Detail.learnHowToInstall',
          'Learn how to install, sync, and manage this skill through the Killer-Skills CLI.',
        ),
      },
      {
        href: `/${locale}/integrations`,
        label: tr('Detail.checkIdeSupport', 'Check IDE integration support'),
        description: tr(
          'Detail.confirmHowThisSkill',
          'Confirm how this skill fits Claude Code, Cursor, Windsurf, and other supported IDEs.',
        ),
      },
    ]
  : [];
const metaDescription = truncateText(
  n8nDescriptionOverride
    ? n8nDescriptionOverride
    : shouldUseDescriptionTemplate
      ? templateDescription
      : seoDescriptionRaw || description || templateDescription,
  158,
);
const resolvedMetaDescription = firstNonEmpty(metaDescription, defaultMetaDescription);

// Limit keyword set to avoid stuffing while keeping entity + intent terms
const seoKeywordSeed = [
  skillName,
  repo,
  category,
  ...(isN8nRepoPage ? ['n8n', 'n8n workflow automation', 'n8n skill'] : []),
  ...(isN8nLoomTranscriptPage ? ['loom transcript automation'] : []),
  skillSeoIntent.supportTerm,
  ...skillSeoIntent.keywords,
  ...keywordsList.slice(0, 8),
];
const sanitizedKeywordSeed = sanitizeSkillKeywords(seoKeywordSeed.map((k) => k?.toString().trim()).filter(Boolean), {
  max: 10,
});
const seoKeywords = sanitizedKeywordSeed.join(', ');

// Detect locale governance from crawler-visible metadata and README content.
const textEncoder = new TextEncoder();
const rawReadmeContent = skill.skillMd?.body || skill.skillMd?.bodyPreview || '';
const rawReadmeSize = textEncoder.encode(rawReadmeContent).length;
const fallbackReadmeContent = `# ${skill.name || repo}\n\n${description}`;
const readmeContentSource =
  rawReadmeContent && rawReadmeSize >= 250
    ? rawReadmeContent
    : [rawReadmeContent, fallbackReadmeContent].filter((part) => part && part.trim().length > 0).join('\n\n');
const skillLocaleGovernance = renderRepoDirectory
  ? null
  : getSkillSeoLocaleGovernance(
      {
        title: skill.seo?.title || skill.name || repo,
        description: skill.seo?.description || skill.description || skill.seo?.definition,
        body: readmeContentSource,
      },
      typedLocale,
      SUPPORTED_LOCALES,
    );
const skillAvailableLocales = skillLocaleGovernance?.publishedLocales;
const skillXDefaultLocale = skillLocaleGovernance?.canonicalLocale;
const skillIndexability = renderRepoDirectory
  ? null
  : buildSkillIndexabilityAssessment(
      {
        qualityScore: skill.qualityScore,
        verified: isVerified,
        description: skill.description,
        agentAnalysis: skill.agentAnalysis,
        seo: {
          features: skill.seo?.features,
        },
        readmeContent: readmeContentSource,
        localeGovernance: skillLocaleGovernance,
      },
      typedLocale,
    );
const canonicalSkillPath =
  renderRepoDirectory || !skillXDefaultLocale
    ? requestedSkillPath
    : buildLocalizedSkillPath(skillXDefaultLocale, owner, canonicalRoutePath);
const canonicalSkillUrl = `https://killer-skills.com${canonicalSkillPath}`;
const sourceEvidenceTitle = tr('Detail.sourceEvidenceTitle', 'Upstream Repository Material');
const sourceEvidenceDescription = tr(
  'Detail.sourceEvidenceDescription',
  'The section below comes from the upstream repository. Use it as supporting material alongside the fit, use-case, and installation summary on this page.',
);

// Structured Data (JSON-LD) — SoftwareApplication
const schema = buildSkillSoftwareApplicationSchema({
  name: skill.name || repo,
  category,
  description: description && typeof description === 'string' ? description : '',
  canonicalUrl: canonicalSkillUrl,
  owner,
  updatedAt: skill.updatedAt,
  lastSynced: skill.lastSynced,
});
const buildRepoSkillUrl = (item: { id?: string; owner?: string; repo?: string }) => {
  const itemOwner = item.owner || owner;
  const itemRepo = item.repo || repo;
  const routePath = getSkillRoutePath({ id: item.id, owner: itemOwner, repo: itemRepo });
  if (!routePath) return requestedSkillUrl;
  const itemLocale = resolveSkillDetailLocale(itemOwner, routePath, locale);
  return `https://killer-skills.com${buildLocalizedSkillPath(itemLocale, itemOwner, routePath)}`;
};
const repoDirectoryItemList = repoDirectorySkills.slice(0, 20).map((item, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: item.name || item.skillName || item.repo || repo,
  url: buildRepoSkillUrl(item),
}));
const repoDirectorySchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: repoDirectoryTitle,
  description: repoDirectoryDescription,
  url: requestedSkillUrl,
  itemListElement: repoDirectoryItemList,
};
const breadcrumb = buildBreadcrumbTrail(
  [
    { label: tr('Common.home', 'Home'), href: `/${locale}` },
    { label: tr('Common.skillsMarket', 'Skills'), href: `/${locale}/skills` },
    ...(skill.category && category ? [{ label: category, href: `/${locale}/skills?category=${skill.category}` }] : []),
    { label: skill.name || repo },
  ],
  { currentUrl: canonicalSkillUrl },
);
const repoDirectoryBreadcrumb = buildBreadcrumbTrail(
  [
    { label: tr('Common.home', 'Home'), href: `/${locale}` },
    { label: tr('Common.skillsMarket', 'Skills'), href: `/${locale}/skills` },
    { label: repoDisplayName },
  ],
  { currentUrl: requestedSkillUrl },
);
const activeBreadcrumb = renderRepoDirectory ? repoDirectoryBreadcrumb : breadcrumb;

// Install command - use full path for sub-skills (declared early for FAQ/HowTo schemas)
const installPath = subSkillName ? `${owner}/${repo}/${subSkillName}` : `${owner}/${repo}`;
const installCommand = `npx killer-skills add ${installPath}`;

// FAQ JSON-LD — dynamically generated from skill data
const faqItems: { question: string; answer: string }[] = [];

const skillDisplayName = skill.name || repo;
const tpl = (key: string, vars: Record<string, string>, fallback: string) =>
  tr(key, fallback).replace(/\{\{(\w+)\}\}/g, (_, k) => vars[k] ?? '');

// Q1: What is this skill?
faqItems.push({
  question: tpl('Detail.faqWhatIs', { name: skillDisplayName }, `What is ${skillDisplayName}?`),
  answer:
    description && typeof description === 'string'
      ? description
      : tpl(
          'Detail.faqWhatIsAnswer',
          { name: skillDisplayName },
          `${skillDisplayName} is an AI agent skill available on Killer-Skills.`,
        ),
});

// Q2: How to install?
faqItems.push({
  question: tpl('Detail.faqHowInstall', { name: skillDisplayName }, `How do I install ${skillDisplayName}?`),
  answer: tpl(
    'Detail.faqHowInstallAnswer',
    { name: skillDisplayName, installCommand },
    `Run the command: ${installCommand}. It works with Cursor, Windsurf, VS Code, Claude Code, and 19+ other IDEs.`,
  ),
});

// Q3: Use cases (from agentAnalysis)
if (renderedUseCases.length > 0) {
  faqItems.push({
    question: tpl('Detail.faqUseCases', { name: skillDisplayName }, `What are the use cases for ${skillDisplayName}?`),
    answer: tpl(
      'Detail.faqUseCasesAnswer',
      { name: skillDisplayName, useCases: renderedUseCases.join(isZhLocale ? '、' : ', ') },
      `Key use cases include: ${renderedUseCases.join(', ')}.`,
    ),
  });
}

// Q4: IDE compatibility
const supportedPlatforms =
  'Cursor, Windsurf, VS Code, Trae, Claude Code, OpenClaw, Aider, Codex, OpenCode, Goose, Cline, Roo Code, Kiro, Augment Code, Continue, GitHub Copilot, Sourcegraph Cody, and Amazon Q Developer';
faqItems.push({
  question: tpl('Detail.faqIDEs', { name: skillDisplayName }, `Which IDEs are compatible with ${skillDisplayName}?`),
  answer: tpl(
    'Detail.faqIDEsAnswer',
    { name: skillDisplayName, supportedPlatforms },
    `This skill is compatible with ${supportedPlatforms}. Use the Killer-Skills CLI for universal one-command installation.`,
  ),
});

// Q5: Limitations (from agentAnalysis)
if (renderedLimitations.length > 0) {
  faqItems.push({
    question: tpl(
      'Detail.faqLimitations',
      { name: skillDisplayName },
      `Are there any limitations for ${skillDisplayName}?`,
    ),
    answer: renderedLimitations.join(isZhLocale ? '；' : '. ') + (isZhLocale ? '。' : '.'),
  });
}

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
