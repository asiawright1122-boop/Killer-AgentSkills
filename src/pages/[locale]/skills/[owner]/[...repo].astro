};

// OG image URL pointing to static fallback until external CDN is established
const ogImageUrl = new URL(`/og-image.webp`, Astro.url).toString();
const speakableSelectors = renderRepoDirectory
  ? ['h1', '.repo-directory-intro', 'h2']
  : ['h1', '.seo-intro-paragraph', 'h2'];

// Format stars
const starsDisplay =
  (skill.stars || 0) > 1000 ? ((skill.stars || 0) / 1000).toFixed(1) + 'k' : String(skill.stars || 0);

// GitHub URL
const githubUrl = `https://github.com/${owner}/${repo}`;

// Topics
const rawTopics: string[] = skill.topics || [];

const maxReadmeRenderBudget = isCrawlerRequest ? maxReadmeRenderBytesCrawler : maxReadmeRenderBytes;
const readmeRenderBudget = truncateMarkdownForSsr(readmeContentSource, maxReadmeRenderBudget);
if (readmeRenderBudget.truncated) {
  console.warn(
    `[SSR] Trimmed readme for stable render (locale=${typedLocale}, crawler=${isCrawlerRequest}, rawReadmeBytes=${rawReadmeSize}, budgetBytes=${maxReadmeRenderBudget})`,
  );
}

// ⚡ Related skills runs AFTER we have skill.category (can't be fully parallelized)
const relatedSkillsSource =
  isCrawlerRequest || renderRepoDirectory
    ? []
    : await getRelatedSkillsFast(env, `${owner}/${repo}`, skill.category || '', 4);

// --- Phase 11: Deep SSR Localization (Markdown Content & Related Skills) ---
let readmeContent = readmeRenderBudget.content;
let relatedSkills = relatedSkillsSource;
let topics = rawTopics;

const shouldRunHeavyLocalization =
  typedLocale !== 'en' && !isCrawlerRequest && !renderRepoDirectory && rawReadmeSize <= maxHeavyLocalizationReadmeBytes;

if (typedLocale !== 'en' && shouldRunHeavyLocalization) {
  const relatedNames = relatedSkillsSource.map((s) => s.skillName || s.name);
  const relatedDesc = relatedSkillsSource.map((s) =>
    typeof s.description === 'string'
      ? s.description
      : (s.description as any)?.[typedLocale] || (s.description as any)?.['en'] || '',
  );

  const [t_readme, t_relatedNames, t_relatedDesc, t_topics] = await Promise.all([
    translateString(env, readmeRenderBudget.content, typedLocale, 'text'),
    Promise.all(relatedNames.map((n) => translateString(env, n, typedLocale, 'text'))),
    Promise.all(relatedDesc.map((d) => translateString(env, d, typedLocale, 'text'))),
    Promise.all(rawTopics.map((t) => translateString(env, t, typedLocale, 'text'))),
  ]);

  readmeContent = t_readme;
  topics = t_topics;
  relatedSkills = relatedSkillsSource.map((s, index) => ({
    ...s,
    skillName: t_relatedNames[index] || s.skillName,
    description: t_relatedDesc[index] || s.description,
  }));
} else if (typedLocale !== 'en') {
  console.warn(
    `[SSR] Skipping heavy detail localization (locale=${typedLocale}, crawler=${isCrawlerRequest}, readmeBytes=${rawReadmeSize})`,
  );
}
// --------------------------------------------------------------------------

const readmeSize = textEncoder.encode(readmeContent).length;
const isThinContent = readmeSize < 250; // Block indexing if extremely short (Thin Content penalty)
const tutorialTocItems = isCrawlerRequest ? [] : extractMarkdownHeadings(readmeContent, [2, 3]).slice(0, 12);
const formatSize = (bytes: number) => {
  if (bytes < 1024) return bytes + ' B';
  return (bytes / 1024).toFixed(1) + ' KB';
};

const files = [
