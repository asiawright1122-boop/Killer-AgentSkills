                        <div>
                          <h3 class="text-xs font-black text-rose-600 dark:text-rose-500 uppercase tracking-widest mb-3 font-mono">
                            <span class="text-rose-600 bg-[var(--foreground)] dark:text-rose-500 px-1 mr-1">!</span>
                            {t('Detail.limitations') || 'Limitations'}
                          </h3>
                          <ul class="space-y-2">
                            {localizedLimitations.map((limitation: string) => (
                              <li class="flex items-start gap-2 text-sm font-bold text-[var(--foreground)] border-l-2 border-rose-500 pl-2">
                                <span>{limitation}</span>
                              </li>
                            ))}
                          </ul>
                        </div>
                      )}
                    </div>
                  </div>
                </div>
              </div>
            )
          }
        </div>
      </div>

      {/* Bottom Row: File Manager | SKILL.md Preview */}
      <div class="grid grid-cols-1 lg:grid-cols-[380px_1fr] gap-12 items-start mt-8 cv-auto">
        {/* Left: File Manager + Tags */}
        <div class="space-y-8 lg:sticky lg:top-8">
          {/* File Manager */}
          <div
            class="brut-card border-[3px] border-[var(--border)] shadow-[8px_8px_0px_0px_var(--border)] bg-[var(--background)]"
          >
            <SkillFileManager
              client:idle
              files={files}
              selectedFile="SKILL.md"
              labels={{
                explorer: t('Detail.explorer'),
                project: t('Detail.project'),
              }}
            />
          </div>

          {/* Tags */}
          <div>
            <h3 class="text-xs font-black text-[var(--foreground)] uppercase tracking-widest mb-4 font-mono">
              <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-2">#</span>
              {t('Detail.tags')}
            </h3>
            <div class="flex flex-wrap gap-2">
              {
                topics.length > 0 ? (
                  topics.map((topic: string) => (
                    <a
                      href={`/${locale}/skills?topic=${encodeURIComponent(topic)}`}
                      class="px-2.5 py-1 bg-[var(--background)] border-2 border-[var(--border)] text-xs font-bold text-[var(--foreground)] font-mono hover:bg-[var(--foreground)] hover:text-[var(--background)] hover:shadow-[2px_2px_0px_0px_var(--border)] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all"
                    >
                      [{topic}]
                    </a>
                  ))
                ) : (
                  <span class="text-xs text-[var(--muted-foreground)] font-mono font-bold">[{t('Detail.noTags')}]</span>
                )
              }
            </div>
          </div>
        </div>

        {/* Right: SKILL.md Preview */}
        <div
          class="min-w-0 brut-card border-[3px] border-[var(--border)] shadow-[8px_8px_0px_0px_var(--border)] bg-[var(--background)] p-1"
        >
          <SkillReadme
            client:idle
            initialContent={readmeContent}
            initialFiles={{
              'SKILL.md': readmeContent,
              '.cursorrules': `# Skill: ${skill.name}\n\n// Auto-generated by Killer-Skills Universal CLI\n// Import this skill into your Cursor AI context\n\n@import "skills/${owner}/${repo}/SKILL.md";\n\n// Usage:\n// Run 'npx killer-skills add ${owner}/${repo}' to install automatically.`,
              'package.json': JSON.stringify(
                {
                  name: `${owner}-${repo}-skill`,
                  version: version,
                  description: `Killer Skill: ${description && typeof description === 'string' ? description : ''}`,
                  keywords: topics,
                  author: owner,
                  license: 'MIT',
                  homepage: `https://killer-skills.com/${locale}/skills/${owner}/${repo}`,
                  repository: {
                    type: 'git',
                    url: `https://github.com/${owner}/${repo}`,
                  },
                },
                null,
                2,
              ),
            }}
            name="SKILL.md"
          />
        </div>
      </div>

      {/* Visible FAQ & Installation Steps (align with structured data for rich results trust) */}
      <section
        class="mt-12 border-[3px] border-[var(--border)] bg-[var(--background)] shadow-[8px_8px_0px_0px_var(--border)] p-6 md:p-8"
      >
        <div class="flex flex-col gap-2 mb-6 border-b-4 border-[var(--border)] pb-4">
          <h2 class="text-2xl md:text-3xl font-black text-[var(--foreground)] uppercase tracking-tight">
            {locale === 'zh' ? '常见问题与安装步骤' : 'FAQ & Installation Steps'}
          </h2>
          <p class="text-sm font-mono text-[var(--muted-foreground)]">
            {
              locale === 'zh'
                ? '以下问题与步骤与页面结构化数据保持一致，便于搜索引擎理解页面内容。'
                : 'These questions and steps mirror the structured data on this page for better search understanding.'
            }
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div>
            <h3 class="text-xs font-black text-[var(--foreground)] uppercase tracking-widest mb-4 font-mono">
              <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-2">?</span>
              {locale === 'zh' ? 'FAQ' : 'Frequently Asked Questions'}
            </h3>
            <div class="space-y-4">
              {
                faqItems.map((item) => (
                  <article class="border-2 border-[var(--border)] p-4 bg-[var(--background)]">
                    <h4 class="font-black text-sm md:text-base text-[var(--foreground)] mb-2">{item.question}</h4>
                    <p class="text-sm md:text-base text-[var(--foreground)]/90 leading-relaxed">{item.answer}</p>
                  </article>
                ))
              }
            </div>
          </div>

          <div>
            <h3 class="text-xs font-black text-[var(--foreground)] uppercase tracking-widest mb-4 font-mono">
              <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-2">↓</span>
              {locale === 'zh' ? '安装步骤' : 'How To Install'}
            </h3>
            <ol class="space-y-3">
              {
                howToSteps.map((step, index) => (
                  <li class="border-2 border-[var(--border)] p-4 bg-[var(--background)]">
                    <p class="font-black text-sm md:text-base text-[var(--foreground)] mb-1">
                      {index + 1}. {step.name}
                    </p>
                    <p class="text-sm md:text-base text-[var(--foreground)]/90 leading-relaxed">{step.text}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>
    </main>

    {/* Related Skills Section */}
    {
      relatedSkills.length > 0 && (
        <section class="border-t-4 border-[var(--border)] bg-[var(--foreground)] text-[var(--background)] py-16 relative overflow-hidden">
          {/* Decorative Grid SVG on Dark Background */}
          <div
            class="absolute inset-0 opacity-10 pointer-events-none"
            style="background-image: radial-gradient(var(--background) 1px, transparent 1px); background-size: 24px 24px;"
          />

          <div class="max-w-[1400px] mx-auto px-6 relative z-10">
            <div class="flex items-center justify-between mb-10 pb-4 border-b-4 border-[var(--background)]">
              <div class="flex flex-col gap-2">
                <h2 class="text-3xl font-black text-[var(--background)] flex items-center gap-3 uppercase tracking-tight">
                  <Layers className="text-[var(--primary)]" strokeWidth={3} />
                  {t('Detail.relatedSkills') || 'Related Skills'}
                </h2>
                {/* Long-Tail Competitive SEO Header */}
                <h3 class="text-[var(--background)]/80 font-mono text-sm max-w-2xl font-normal">
                  {locale === 'zh'
                    ? `寻找 ${skill.name || repo} 的替代方案 (Alternative) 或可搭配使用的同类 ${category || 'AI'} Skill？探索以下相关开源技能。`
                    : `Looking for an alternative to ${skill.name || repo} or another ${category || 'custom'} skill for your workflow? Explore these related open-source skills.`}
                </h3>
              </div>
              <a
                href={`/${locale}/skills`}
                class="text-sm font-black text-[var(--background)] hover:text-[var(--primary)] hover:translate-x-1 transition-all flex items-center gap-2 uppercase tracking-widest mt-1 md:mt-0"
              >
                {t('Common.viewAll')} <ChevronRight size={18} strokeWidth={3} />
              </a>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
              {relatedSkills.map((skill) => (
                <div class="h-full transform hover:scale-[1.02] transition-transform">
                  <SkillCard skill={skill} locale={locale} t={t} />
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }
  </div>

  {/* Related Collections Section */}
  {
    relatedCollections.length > 0 && (
      <section class="py-12 border-t-[3px] border-[var(--border)] bg-[var(--background)]">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between mb-6">
            <h2 class="text-xl font-black text-[var(--foreground)] uppercase tracking-tight">
              {t('Collections.relatedCollections')}
            </h2>
            <a
              href={`/${locale}/collections`}
              class="text-xs font-black text-[var(--muted-foreground)] hover:text-[var(--primary)] uppercase tracking-widest transition-colors"
            >
              {t('Collections.viewAllCollections')} →
            </a>
          </div>
          <div class="flex flex-wrap gap-3">
            {relatedCollections.map((col) => {
              const colTitle =
                typeof col.data.title === 'object'
                  ? col.data.title[typedLocale] || col.data.title['en'] || 'Collection'
                  : col.data.title;
              const cleanSlug = getCollectionCanonicalSlug(col);
              return (
                <a
                  href={`/${locale}/collections/${cleanSlug}`}
                  class="inline-flex items-center gap-2 px-3 py-2 bg-[var(--card)] border-2 border-[var(--border)] font-bold text-xs text-[var(--foreground)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:border-[var(--primary)] shadow-[2px_2px_0px_0px_var(--border)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all"
                >
                  <span class="text-[var(--primary)] text-[10px]">■</span>
                  {colTitle}
                  <span class="opacity-50">[{col.data.skills.length}]</span>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )
  }

  <!-- Install / Copy handlers are in Layout.astro (event delegation for View Transitions) -->
</Layout>
