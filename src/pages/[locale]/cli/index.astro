---
import Layout from '../../../layouts/Layout.astro';
import { SUPPORTED_LOCALES, loadMessages, useTranslations, translateOr, type Locale } from '../../../i18n';
import { buildKeywordString } from '../../../lib/seo-keywords';
import docsCache from '../../../../data/docs-cache.json';
import { Sparkles, RefreshCw, Bot, Shield, Check, X, Minus } from 'lucide-react';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=86400');

// Validate locale
const { locale } = Astro.params;
const typedLocale = locale as Locale;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const canonicalUrl = `https://killer-skills.com/${locale}/cli`;

// Load translations
const messages = await loadMessages(typedLocale);
const t = useTranslations(messages);
const tr = (key: string, fallback: string) => translateOr(messages, key, fallback);

const pageTitle = tr('CLI.pageTitle', 'AI Skills CLI: Install & Sync for Claude Code, Cursor');
const pageDescription = tr(
  'CLI.pageDescription',
  'Install, manage, and sync AI agent skills in Claude Code, Cursor, Windsurf, and VS Code. One-command setup with no global install required.',
);
const pageKeywords = buildKeywordString(
  t,
  'cli',
  'installSetup',
  'compatibility',
  'ideCompat',
  'docs',
  'workflowAutomation',
  'processAutomation',
  'templates',
  ['npx killer-skills add', 'skill sync', 'CLI commands', 'Killer-Skills'],
);
const primaryCommand = 'npx killer-skills add anthropics/skills/pdf';
const installInstruction = 'npx killer-skills add owner/repo';
const quickLinks = [
  {
    title: tr('CLI.quickLinks.install.title', 'Install a Skill'),
    description: tr('CLI.quickLinks.install.desc', 'Start with the one-command install and first-run steps.'),
    href: `/${locale}/docs/installation`,
  },
  {
    title: tr('CLI.quickLinks.ide.title', 'Set Up IDE Compatibility'),
    description: tr(
      'CLI.quickLinks.ide.desc',
      'See how Cursor, Claude Code, VS Code, and more are configured automatically.',
    ),
    href: `/${locale}/integrations`,
  },
  {
    title: tr('CLI.quickLinks.commands.title', 'Read CLI Commands'),
    description: tr(
      'CLI.quickLinks.commands.desc',
      'Jump straight into commands, sync behavior, and configuration details.',
    ),
    href: `/${locale}/docs/cli/commands`,
  },
  {
    title: tr('CLI.quickLinks.templates.title', 'Browse Workflow Templates'),
    description: tr(
      'CLI.quickLinks.templates.desc',
      'Move from installation into reusable automation and template flows.',
    ),
    href: `/${locale}/collections`,
  },
];

const getDocContent = (slug: string) => {
  const page = (docsCache as any).pages.find((p: any) => p.slug === slug);
  return page?.content[typedLocale] || page?.content['en'] || '';
};

const commandsContent = getDocContent('cli/commands');
const configContent = getDocContent('cli/configuration');
const faqItems = [
  {
    question: tr('CLI.faq1Q', 'What is the Killer-Skills CLI?'),
    answer: tr(
      'CLI.faq1A',
      'It is a skills-first CLI for installing, syncing, and managing AI agent skills across 19+ IDEs and AI coding assistants.',
    ),
  },
  {
    question: tr('CLI.faq2Q', 'How do I install a skill with the CLI?'),
    answer: tr(
      'CLI.faq2A',
      `Run \`${installInstruction}\` in your terminal. The CLI detects your IDE automatically and writes the correct IDE-native skill file.`,
    ),
  },
  {
    question: tr('CLI.faq3Q', 'Do I need to install the CLI globally?'),
    answer: tr('CLI.faq3A', 'No. You can run it through npx, so there is no need for a global installation.'),
  },
  {
    question: tr('CLI.faq4Q', 'Which IDEs does the CLI support?'),
    answer: tr(
      'CLI.faq4A',
      'The CLI supports Cursor, Claude Code, VS Code, Windsurf, JetBrains, and 19+ other IDE and agent environments.',
    ),
  },
];
---

<Layout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  customCanonical={canonicalUrl}
>
  {/* BreadcrumbList JSON-LD */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('Common.home'), item: `https://killer-skills.com/${locale}` },
        { '@type': 'ListItem', position: 2, name: 'CLI', item: canonicalUrl },
      ],
    })}
  />
  {/* FAQ JSON-LD for CLI page */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    })}
  />
  {/* SoftwareApplication JSON-LD for CLI */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      name: 'Killer-Skills CLI',
      operatingSystem: 'Windows, macOS, Linux',
      applicationCategory: 'DeveloperApplication',
      description: pageDescription,
      url: canonicalUrl,
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'USD',
      },
      softwareVersion: '1.7.0',
    })}
  />
  {/* Speakable Schema for AI citation */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: pageTitle,
      description: pageDescription,
      url: canonicalUrl,
      speakable: {
        '@type': 'SpeakableSpecification',
        cssSelector: ['h1', '.seo-intro-paragraph', 'h2'],
      },
    })}
  />

  <div class="bg-[var(--background)] min-h-screen overflow-hidden">
    {/* Hero Section - Neo-Brutalist Redesign */}
    <div class="relative pt-20 pb-12 md:pt-28 md:pb-20 border-b-4 border-[var(--border)] bg-[var(--background)]">
      <div
        class="absolute inset-0 opacity-5 pointer-events-none"
        style="background-image: radial-gradient(var(--border) 1px, transparent 1px); background-size: 24px 24px;"
      >
      </div>

      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
        <div
          class="inline-flex items-center gap-2 px-4 py-1.5 bg-[var(--primary)] text-[var(--primary-foreground)] text-xs font-black tracking-widest uppercase mb-8 border-2 border-[var(--border)] shadow-[4px_4px_0px_0px_var(--foreground)]"
        >
          <span class="w-2 h-2 rounded-full bg-red-600 animate-ping"></span>
          {t('CLI.features.autoInvoke.title')}
        </div>

        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-black text-[var(--foreground)] mb-6 tracking-tighter uppercase leading-[0.9] animate-slide-up"
        >
          {t('CLI.heroTitle')}
          <br />
          <span class="text-gradient drop-shadow-[4px_4px_var(--border)]">
            {t('CLI.heroSubtitle')}
          </span>
        </h1>

        <p class="text-xl md:text-2xl text-[var(--foreground)] font-bold max-w-3xl mx-auto mb-12 leading-tight">
          <span class="seo-intro-paragraph">{pageDescription}</span>
          <span class="block text-sm font-mono mt-4 text-[var(--muted-foreground)]">
            // {t('CLI.optionalNote')}
          </span>
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-6 mb-8">
          <div
            class="relative group cursor-pointer"
            data-copy-command={primaryCommand}
            data-copy-success={t('CLI.copied') || 'Copied!'}
            role="button"
            tabindex="0"
          >
            <div
              class="relative px-8 py-5 bg-[var(--background)] border-4 border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] group-hover:translate-x-[-2px] group-hover:translate-y-[-2px] group-hover:shadow-[10px_10px_0px_0px_var(--primary)] transition-all flex items-center gap-6"
            >
              <div class="font-mono text-lg flex items-center gap-4">
                <span class="text-[var(--primary)] font-black select-none">$</span>
                <span class="text-[var(--foreground)] font-black"
                  >npx killer-skills <span class="text-[var(--muted-foreground)]">add</span> owner/repo</span
                >
              </div>
              <div
                class="pl-6 border-l-2 border-[var(--border)] text-[var(--muted-foreground)] group-hover:text-[var(--primary)] transition-colors"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="3"
                  stroke-linecap="square"
                  stroke-linejoin="miter"
                  ><rect width="14" height="14" x="8" y="8" rx="0" ry="0"></rect><path
                    d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg
                >
              </div>
            </div>
          </div>

          <a
            href={`/${locale}/docs`}
            class="px-8 py-5 bg-[var(--foreground)] text-[var(--background)] border-4 border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] font-bold uppercase hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[10px_10px_0px_0px_var(--primary)] transition-all text-lg"
          >
            {t('CLI.viewDocs')}
          </a>
        </div>
      </div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-10">
      <section class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
        {
          quickLinks.map((item) => (
            <a
              href={item.href}
              class="border-[4px] border-[var(--border)] bg-[var(--background)] p-5 shadow-[6px_6px_0px_0px_var(--border)] transition-all hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[10px_10px_0px_0px_var(--primary)]"
            >
              <h2 class="text-lg font-black uppercase tracking-tight text-[var(--foreground)] mb-2">{item.title}</h2>
              <p class="text-sm font-bold leading-6 text-[var(--muted-foreground)]">{item.description}</p>
            </a>
          ))
        }
      </section>
    </div>

    {/* Terminal Showcase & Comparison Grid - Brutalist Overhaul */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-12 mb-32 relative z-20">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-stretch">
        {/* Comparison Table */}
        <div
          class="h-full flex flex-col border-[4px] border-[var(--border)] bg-[var(--background)] shadow-[12px_12px_0px_0px_var(--border)] overflow-hidden"
        >
          <div class="flex items-center gap-2 px-6 py-4 bg-[var(--foreground)] border-b-4 border-[var(--border)]">
            <h2 class="text-sm font-black text-[var(--background)] tracking-widest uppercase">
              {t('CLI.comparison.title')}
            </h2>
          </div>

          <div class="flex-1 overflow-x-auto">
            <table class="w-full text-left text-sm h-full border-collapse">
              <thead class="border-b-4 border-[var(--border)]">
                <tr>
                  <th
                    class="p-5 font-black uppercase tracking-tighter text-[var(--foreground)] border-r-2 border-[var(--border)] bg-[var(--muted)]"
                    >{t('CLI.comparison.feature')}</th
                  >
                  <th
                    class="p-5 font-black uppercase text-[var(--foreground)] border-r-2 border-[var(--border)] bg-[var(--muted)]/30 text-center relative overflow-hidden"
                  >
                    <div class="absolute top-0 left-0 w-full h-1 bg-[var(--primary)]"></div>
                    {t('CLI.comparison.ks')}
                  </th>
                  <th class="p-5 font-black uppercase text-[var(--foreground)] bg-[var(--muted)] text-center"
                    >{t('CLI.comparison.others')}</th
                  >
                </tr>
              </thead>
              <tbody class="divide-y-2 divide-[var(--border)] font-bold">
                <tr class="hover:bg-[var(--primary)]/5 transition-colors">
                  <td class="p-5 text-[var(--foreground)] uppercase border-r-2 border-[var(--border)]"
                    >{t('CLI.comparison.row1')}</td
                  >
                  <td
                    class="p-5 text-emerald-800 dark:text-emerald-400 border-r-2 border-[var(--border)] bg-[var(--muted)]/10"
                  >
                    <div class="flex justify-center"><Check className="w-6 h-6 stroke-[4]" /></div>
                  </td>
                  <td class="p-5 text-[var(--foreground)]">
                    <div class="flex justify-center"><X className="w-6 h-6 stroke-[3] opacity-30" /></div>
                  </td>
                </tr>
                <tr class="hover:bg-[var(--primary)]/5 transition-colors">
                  <td class="p-5 text-[var(--foreground)] uppercase border-r-2 border-[var(--border)]"
                    >{t('CLI.comparison.row2')}</td
                  >
                  <td
                    class="p-5 text-emerald-800 dark:text-emerald-400 border-r-2 border-[var(--border)] bg-[var(--muted)]/10"
                  >
                    <div class="flex justify-center"><Check className="w-6 h-6 stroke-[4]" /></div>
                  </td>
                  <td class="p-5 text-[var(--foreground)]">
                    <div class="flex justify-center"><X className="w-6 h-6 stroke-[3] opacity-30" /></div>
                  </td>
                </tr>
                <tr class="hover:bg-[var(--primary)]/5 transition-colors">
                  <td class="p-5 text-[var(--foreground)] uppercase border-r-2 border-[var(--border)]"
                    >{t('CLI.comparison.row3')}</td
                  >
                  <td
                    class="p-5 text-emerald-800 dark:text-emerald-400 border-r-2 border-[var(--border)] bg-[var(--muted)]/10"
                  >
                    <div class="flex justify-center"><Check className="w-6 h-6 stroke-[4]" /></div>
                  </td>
                  <td class="p-5 text-[var(--foreground)]">
                    <div class="flex justify-center"><X className="w-6 h-6 stroke-[3] opacity-30" /></div>
                  </td>
                </tr>
                <tr class="hover:bg-[var(--primary)]/5 transition-colors">
                  <td class="p-5 text-[var(--foreground)] uppercase border-r-2 border-[var(--border)]"
                    >{t('CLI.comparison.row4')}</td
                  >
                  <td
                    class="p-5 text-emerald-800 dark:text-emerald-400 border-r-2 border-[var(--border)] bg-[var(--muted)]/10"
                  >
                    <div class="flex justify-center"><Check className="w-6 h-6 stroke-[4]" /></div>
                  </td>
                  <td class="p-5 text-[var(--foreground)]">
                    <div class="flex justify-center"><Minus className="w-6 h-6 stroke-[3] opacity-30" /></div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </div>

        {/* Terminal Window */}
        <div
          class="h-full flex flex-col border-[4px] border-[var(--border)] bg-[var(--background)] dark:bg-black shadow-[12px_12px_0px_0px_var(--primary)] overflow-hidden"
        >
          <div class="flex items-center gap-3 px-4 py-3 bg-[var(--border)] border-b-2 border-[var(--border)]">
            <div class="flex gap-2">
              <div class="w-3 h-3 bg-red-500 border border-black shadow-[1px_1px_0px_0px_black]"></div>
              <div class="w-3 h-3 bg-yellow-500 border border-black shadow-[1px_1px_0px_0px_black]"></div>
              <div class="w-3 h-3 bg-green-500 border border-black shadow-[1px_1px_0px_0px_black]"></div>
            </div>
            <div
              class="flex-1 text-center font-mono text-[10px] text-[var(--foreground)] font-black tracking-[0.2em] uppercase"
            >
              CLI_ENGINE — STABLE_v1.7.0
            </div>
          </div>
          <div class="p-6 md:p-8 font-mono text-sm leading-relaxed">
            <div class="mb-8">
              <span class="text-emerald-900 dark:text-emerald-400 font-black">➜</span>
              <span class="text-[var(--foreground)] font-black underline decoration-[var(--primary)] underline-offset-4"
                >~/projects/my-agent</span
              >
              <span class="text-[var(--foreground)] font-black">$</span>
              <span class="text-[var(--foreground)] font-black ml-2 uppercase tracking-tight"
                >npx killer-skills add anthropics/skills/pdf</span
              >
              <div class="mt-3 pl-4 border-l-4 border-emerald-900 dark:border-emerald-400 bg-emerald-500/5 py-2">
                <span class="text-emerald-900 dark:text-emerald-400 font-black uppercase tracking-tighter"
                  >INSTALL_READY</span
                >
                <span class="text-[var(--foreground)] font-bold ml-2"
                  >:: detected IDE target and prepared IDE-native skill file</span
                >
              </div>
            </div>

            <div class="mb-8">
              <span class="text-emerald-900 dark:text-emerald-400 font-black">➜</span>
              <span class="text-[var(--foreground)] font-black">~/projects/my-agent</span>
              <span class="text-[var(--foreground)] font-black">$</span>
              <span class="text-[var(--foreground)] font-black ml-2 uppercase tracking-tight"
                >npx killer-skills sync</span
              >
              <div class="mt-4 text-[var(--foreground)] font-black italic tracking-widest text-[10px] uppercase">
                [INIT] checking installed skill targets...
              </div>
              <div class="space-y-2.5 mt-4">
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 bg-emerald-900 dark:bg-emerald-400 shadow-[2px_2px_0px_0px_var(--border)]"></div>
                  <span class="text-[var(--foreground)] font-black tracking-tighter">CURSOR</span>
                  <span class="text-[var(--foreground)] ml-auto font-mono text-xs font-bold">.cursorrules</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 bg-emerald-900 dark:bg-emerald-400 shadow-[2px_2px_0px_0px_var(--border)]"></div>
                  <span class="text-[var(--foreground)] font-black tracking-tighter">CLAUDE</span>
                  <span class="text-[var(--foreground)] ml-auto font-mono text-xs font-bold">CLAUDE.md</span>
                </div>
                <div class="flex items-center gap-3">
                  <div class="w-3 h-3 bg-emerald-900 dark:bg-emerald-400 shadow-[2px_2px_0px_0px_var(--border)]"></div>
                  <span class="text-[var(--foreground)] font-black tracking-tighter">VSCODE</span>
                  <span class="text-[var(--foreground)] ml-auto font-mono text-xs font-bold"
                    >copilot-instructions.md</span
                  >
                </div>
              </div>
              <div
                class="mt-6 p-4 bg-emerald-500/10 dark:bg-emerald-500/5 border-2 border-emerald-900 dark:border-emerald-400 backdrop-blur-sm"
              >
                <span class="text-emerald-900 dark:text-emerald-400 font-black tracking-tighter uppercase text-base"
                  >21_SKILLS_SYNCED</span
                >
                <span class="text-[var(--foreground)] font-bold ml-2 text-xs">across detected IDE targets</span>
              </div>
            </div>

            <div class="mt-10">
              <span class="text-emerald-900 dark:text-emerald-400 font-black">➜</span>
              <span class="text-[var(--foreground)] font-black">~/projects/my-agent</span>
              <span class="text-[var(--foreground)] font-black">$</span>
              <span class="text-[var(--foreground)] font-black ml-2 uppercase tracking-tight"
                >npx killer-skills do "generate pdf"</span
              >
              <div
                class="mt-4 p-4 border-2 border-dashed border-purple-900 dark:border-purple-400 bg-purple-500/5 flex items-center gap-4"
              >
                <span
                  class="bg-purple-900 dark:bg-purple-600 text-white text-[10px] font-black px-2 py-1 uppercase shadow-[3px_3px_0px_0px_rgba(0,0,0,1)]"
                  >Intelligent Match</span
                >
                <span class="text-purple-900 dark:text-purple-300 font-black tracking-tight uppercase"
                  >AUTO_INVOKED: <span class="underline decoration-emerald-900 dark:decoration-emerald-400"
                    >pdf.skill</span
                  ></span
                >
              </div>
              <div class="mt-4 text-emerald-900 dark:text-emerald-400 font-black animate-pulse tracking-widest text-xs">
                >>> [PROC] EXECUTING SKILL INSTRUCTIONS...
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    {/* Bento Grid Features - Brutalist Redesign */}
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-32">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {/* Large Card */}
        <div
          class="md:col-span-2 bg-[var(--background)] border-[4px] border-[var(--border)] p-8 shadow-[8px_8px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[12px_12px_0px_0px_var(--primary)] transition-all relative overflow-hidden"
        >
          <div
            class="absolute top-0 right-0 w-32 h-32 bg-[var(--primary)] opacity-5 rotate-45 translate-x-16 -translate-y-16"
          >
          </div>
          <div
            class="w-16 h-16 bg-[var(--foreground)] border-2 border-[var(--border)] flex items-center justify-center text-[var(--primary)] mb-8 shadow-[4px_4px_0px_0px_var(--primary)]"
          >
            <Sparkles className="w-8 h-8" />
          </div>
          <h3 class="text-3xl font-black text-[var(--foreground)] uppercase tracking-tighter mb-4">
            {t('CLI.features.autoInvoke.title')}
          </h3>
          <p class="text-[var(--foreground)] font-bold text-lg opacity-80 leading-snug">
            {t('CLI.features.autoInvoke.desc')}
          </p>
        </div>

        {/* Small Card */}
        <div
          class="bg-[var(--background)] border-[4px] border-[var(--border)] p-8 shadow-[8px_8px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[12px_12px_0px_0px_var(--primary)] transition-all"
        >
          <div
            class="w-14 h-14 bg-[var(--primary)] border-2 border-[var(--border)] flex items-center justify-center text-[var(--foreground)] mb-8 shadow-[4px_4px_0px_0px_var(--border)]"
          >
            <RefreshCw className="w-7 h-7" />
          </div>
          <h3 class="text-xl font-black text-[var(--foreground)] uppercase tracking-tight mb-4">
            {t('CLI.features.syncAll.title')}
          </h3>
          <p class="text-[var(--foreground)] font-bold opacity-70 leading-tight">{t('CLI.features.syncAll.desc')}</p>
        </div>

        {/* Small Card */}
        <div
          class="bg-[var(--background)] border-[4px] border-[var(--border)] p-8 shadow-[8px_8px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[12px_12px_0px_0px_var(--primary)] transition-all"
        >
          <div
            class="w-14 h-14 bg-[var(--primary)] border-2 border-[var(--border)] flex items-center justify-center text-[var(--foreground)] mb-8 shadow-[4px_4px_0px_0px_var(--border)]"
          >
            <Bot className="w-7 h-7" />
          </div>
          <h3 class="text-xl font-black text-[var(--foreground)] uppercase tracking-tight mb-4">
            {t('CLI.features.mcp.title')}
