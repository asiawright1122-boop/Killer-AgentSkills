---
import Layout from '../../../layouts/Layout.astro';
import MarketplaceSimplePage from '../../../components/MarketplaceSimplePage.astro';
import { SUPPORTED_LOCALES, type Locale } from '../../../i18n';

const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const isZhCopy = locale.startsWith('zh');
const title = 'Killer-Skills CLI';
const description = isZhCopy
  ? '用一条命令把 Skill 写入当前 IDE 的原生配置。'
  : 'Install a skill into the current IDE native format with one command.';
---

<Layout locale={locale} title={title} description={description} appendBrand={false}>
  <MarketplaceSimplePage title={title} description={description}>
    <div class="marketplace-card-grid">
      <div class="marketplace-card-link">
        <h3>{isZhCopy ? '安装 Skill' : 'Install a skill'}</h3>
        <code>npx killer-skills add owner/repo</code>
      </div>
      <a class="marketplace-card-link" href={`/${locale}/skills`}>
        <h3>Skills</h3>
        <p>
          {isZhCopy ? '先找到合适的 Skill，再复制安装命令。' : 'Find a skill first, then copy its install command.'}
        </p>
      </a>
      <a class="marketplace-card-link" href={`/${locale}/safe`}>
        <h3>{isZhCopy ? '审核政策' : 'Review Policy'}</h3>
        <p>
          {isZhCopy ? '公开目录只展示通过基础准入的 Skills。' : 'Public listings only show baseline-admitted skills.'}
        </p>
      </a>
    </div>
  </MarketplaceSimplePage>
</Layout>
