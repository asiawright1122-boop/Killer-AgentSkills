---
import Layout from '../../../layouts/Layout.astro';
import { CATEGORY_DEFS, getCategoryLabel, normalizeCategoryId } from '../../../lib/category-taxonomy';
import { SUPPORTED_LOCALES, loadMessages, useTranslations, type Locale } from '../../../i18n';
import { getLightweightSkills } from '../../../lib/skills';
import { buildKeywordString, getCategoryKeywordClusters } from '../../../lib/seo-keywords';
import type { Env } from '../../../lib/kv';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=3600');

// Validate locale
const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const isZh = typedLocale === 'zh';
const canonicalUrl = `https://killer-skills.com/${locale}/categories`;

// Get env from Cloudflare runtime
const env = Astro.locals.runtime?.env as Env;

// Use lightweight listing query to avoid full JSON scan on category landing pages.
const skills = await getLightweightSkills(env).catch(() => []);

// Load translations
const messages = await loadMessages(typedLocale);
const t = useTranslations(messages);

const categoryColors: Record<string, string> = {
  cyan: 'text-cyan-600 dark:text-cyan-400',
  blue: 'text-blue-600 dark:text-blue-400',
  sky: 'text-sky-600 dark:text-sky-400',
  violet: 'text-violet-600 dark:text-violet-400',
  orange: 'text-orange-600 dark:text-orange-400',
  pink: 'text-pink-600 dark:text-pink-400',
  amber: 'text-amber-600 dark:text-amber-400',
  indigo: 'text-indigo-600 dark:text-indigo-400',
  emerald: 'text-emerald-600 dark:text-emerald-400',
  rose: 'text-rose-600 dark:text-rose-400',
  teal: 'text-teal-600 dark:text-teal-400',
};

// Count skills per category
const categoryCounts: Record<string, number> = {};
for (const skill of skills) {
  const cat = normalizeCategoryId(skill.category) || 'other';
  categoryCounts[cat] = (categoryCounts[cat] || 0) + 1;
}

// Build category data with counts
const categories = CATEGORY_DEFS.map((def) => ({
  ...def,
  name: getCategoryLabel(def.id, t),
  count: categoryCounts[def.id] || 0,
})).filter((category) => category.count > 0);

const pageTitle = isZh ? 'AI Agent Skills 分类目录' : 'AI Agent Skill Categories by Use Case';
const pageDescription = isZh
  ? `按开发、数据、AI、设计等分类浏览 ${skills.length}+ 个 AI Agent Skills，快速找到适合 Claude Code、Cursor、Windsurf 的可安装工具。`
  : `Browse ${skills.length}+ AI agent skills by category, from developer tools to data, AI, and design workflows for Claude Code, Cursor, and Windsurf.`;
const topCategoryIds = [...categories]
  .sort((a, b) => b.count - a.count)
  .slice(0, 4)
  .map((category) => category.id);
const pageKeywords = buildKeywordString(
  typedLocale,
  'core',
  'ideCompat',
  ...topCategoryIds.flatMap((id) => getCategoryKeywordClusters(id)),
  isZh ? 'AI Agent Skills 分类' : 'AI agent skill categories',
  isZh ? '技能使用场景' : 'skill use cases',
  'Killer-Skills',
);
const topCategoryNames = [...categories]
  .sort((a, b) => b.count - a.count)
  .slice(0, 3)
  .map((category) => category.name);
const heroTitle = isZh ? '按场景浏览 AI Agent Skills' : 'Browse AI Agent Skills by Use Case';
const heroIntro = isZh
  ? `最常被浏览的分类包括 ${topCategoryNames.join('、')}。从开发到数据，再到 AI 自动化，你可以直接进入分类页筛选可安装技能。`
  : `Popular starting points include ${topCategoryNames.join(', ')}. Jump straight into the category that matches your workflow and find installable skills faster.`;
const faqItems = [
  {
    question: isZh ? '这里有哪些 AI Agent Skills 分类？' : 'What AI agent skill categories can I browse here?',
    answer: isZh
      ? `当前可以浏览 ${categories.length} 个分类，包括 ${categories.map((c) => c.name).join('、')}。每个分类都聚合了对应场景下的可安装技能。`
      : `You can browse ${categories.length} categories here, including ${categories.map((c) => c.name).join(', ')}. Each category groups installable skills for a specific workflow.`,
  },
  {
    question: isZh ? 'Killer-Skills 一共有多少技能？' : 'How many skills are indexed on Killer-Skills?',
    answer: isZh
      ? `目前平台已收录 ${skills.length}+ 个 AI Agent Skills，热门分类集中在 ${topCategoryNames.join('、')}。`
      : `Killer-Skills currently indexes ${skills.length}+ AI agent skills, with the most active categories including ${topCategoryNames.join(', ')}.`,
  },
  {
    question: isZh ? '如何按分类查找适合我的技能？' : 'How do I find the right skills by category?',
    answer: isZh
      ? '先进入与你当前任务最接近的分类，再在技能目录里继续按关键词、官方仓库或精选视图筛选。这样通常比直接搜索宽泛词更快找到结果。'
      : 'Start with the category closest to your current task, then narrow further in the skills directory using keywords, official repositories, or featured filters. That is usually faster than searching a broad term.',
  },
];
---

<Layout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  customCanonical={canonicalUrl}
>
  {/* BreadcrumbList JSON-LD */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: t('Common.home'), item: `https://killer-skills.com/${locale}` },
        { '@type': 'ListItem', position: 2, name: pageTitle, item: canonicalUrl },
      ],
    })}
  />
  {/* ItemList JSON-LD for categories */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      name: pageTitle,
      description: pageDescription,
      numberOfItems: categories.length,
      itemListElement: categories.map((cat, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: cat.name,
        url: `https://killer-skills.com/${locale}/skills?category=${cat.id}`,
      })),
    })}
  />
  {/* FAQ Schema for AI citation */}
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    })}
  />
  <div class="bg-slate-50/50 dark:bg-slate-950/50 min-h-screen">
    <!-- Header Section -->
    <div
      class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 pt-12 pb-8 md:pt-16 md:pb-12"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl">
          <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4 tracking-tight">
            <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-blue-600">
              {heroTitle}
            </span>
          </h1>
          <p class="seo-intro-paragraph text-lg text-slate-600 dark:text-slate-400 leading-relaxed">
            {pageDescription}
          </p>
          <p class="mt-3 text-sm text-slate-500 dark:text-slate-400 max-w-2xl">{heroIntro}</p>
        </div>
      </div>
    </div>

    <!-- Categories Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {
          categories.map((cat) => (
            <a
              href={`/${locale}/skills?category=${cat.id}`}
              class="group bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm hover:shadow-md hover:border-cyan-300 dark:hover:border-cyan-700 transition-all duration-200"
            >
              <div class={`mb-4 ${categoryColors[cat.color]}`}>
                {cat.icon === 'code' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"
                    />
                  </svg>
                )}
                {cat.icon === 'globe' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"
                    />
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M3.6 9h16.8M3.6 15h16.8M12 3a15.3 15.3 0 010 18M12 3a15.3 15.3 0 000 18"
                    />
                  </svg>
                )}
                {cat.icon === 'credit-card' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="2" y="5" width="20" height="14" rx="2" stroke-width="2" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2 10h20" />
                  </svg>
                )}
                {cat.icon === 'bar-chart' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                    />
                  </svg>
                )}
                {cat.icon === 'cpu' && (
                  <svg
                    class="w-8 h-8"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4.5 3h15" />
                    <path d="M6 3v16a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V3" />
                    <path d="M6 14h12" />
                  </svg>
                )}
                {cat.icon === 'cloud' && (
                  <svg
                    class="w-8 h-8"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M17.5 19A5.5 5.5 0 0 0 18 8.02a7 7 0 1 0-11.66 6.77" />
                    <path d="M12 13v9" />
                    <path d="m9 19 3 3 3-3" />
                  </svg>
                )}
                {cat.icon === 'pen-tool' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                    />
                  </svg>
                )}
                {cat.icon === 'book' && (
                  <svg
                    class="w-8 h-8"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                  </svg>
                )}
                {cat.icon === 'zap' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"
                    />
                  </svg>
                )}
                {cat.icon === 'server' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <rect x="3" y="4" width="18" height="6" rx="1" stroke-width="2" />
                    <rect x="3" y="14" width="18" height="6" rx="1" stroke-width="2" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 17h.01" />
                  </svg>
                )}
                {cat.icon === 'shield' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M12 3l7 4v5c0 5-3.5 7.5-7 9-3.5-1.5-7-4-7-9V7l7-4z"
                    />
                  </svg>
                )}
                {cat.icon === 'message-circle' && (
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.6-5.2a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8z"
                    />
                  </svg>
                )}
              </div>
              <h2 class="text-lg font-semibold text-slate-900 dark:text-white mb-1 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
                {cat.name}
              </h2>
              <p class="text-sm text-slate-500 dark:text-slate-400">
                {cat.count} {t('Marketplace.availableSkills').toLowerCase()}
              </p>
            </a>
          ))
        }
      </div>

      <!-- Total skills summary -->
      <div class="mt-12 text-center">
        <p class="text-slate-500 dark:text-slate-400 text-sm">
          {skills.length}
          {t('Marketplace.availableSkills').toLowerCase()}
        </p>
        <a
          href={`/${locale}/skills`}
          class="inline-flex items-center mt-4 px-6 py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white font-medium rounded-xl transition-colors text-sm shadow-lg shadow-cyan-500/20"
        >
          {t('Marketplace.viewAll')} →
        </a>
      </div>

      <section class="mt-12 grid gap-4 md:grid-cols-3">
        {
          faqItems.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
              <h2 class="mb-3 text-lg font-semibold text-slate-900 dark:text-white">{item.question}</h2>
              <p class="text-sm leading-6 text-slate-600 dark:text-slate-400">{item.answer}</p>
            </article>
          ))
        }
      </section>
    </div>
  </div>
</Layout>
