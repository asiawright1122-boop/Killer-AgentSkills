---
import Layout from '../../../layouts/Layout.astro';
import MarketplaceHero from '../../../components/MarketplaceHero.astro';
import MarketplaceSection from '../../../components/MarketplaceSection.astro';
import { SUPPORTED_LOCALES, loadMessages, useTranslations, type Locale } from '../../../i18n';
import type { Env } from '../../../lib/kv';
import { getMarketplaceOverview } from '../../../lib/marketplace-overview';
import { getMarketplaceSkills, sortSkillsPopular } from '../../../lib/marketplace-filters';
import { buildOccupationSummaries } from '../../../lib/occupations';
import { filterByCategory } from '../../../lib/search';
import { getLightweightSkillsTop, type UnifiedSkill } from '../../../lib/public-skill-catalog';
import { getRuntimeEnv } from '../../../lib/runtime-env';
import { buildKeywordString } from '../../../lib/seo-keywords';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=3600');

const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const isZhCopy = typedLocale.startsWith('zh');
const env = (await getRuntimeEnv<Env>(Astro.locals)) as Env;
const [messages, skillsFetched] = await Promise.all([
  loadMessages(typedLocale),
  getLightweightSkillsTop(env, 480).catch(() => [] as UnifiedSkill[]),
]);
const t = useTranslations(messages);
const marketplaceSkills = getMarketplaceSkills(skillsFetched);
const overview = await getMarketplaceOverview(env, typedLocale, t, {
  includeEmptyCategories: true,
  includeOtherCategory: false,
  topCategoryLimit: 12,
});
const occupations = buildOccupationSummaries(marketplaceSkills, typedLocale).filter((item) => item.skillCount > 0);
const categories = overview.categories.map((category) => {
  const skills = sortSkillsPopular(filterByCategory(marketplaceSkills, category.id));
  const relatedOccupations = occupations
    .filter((occupation) => occupation.skills.some((skill) => filterByCategory([skill], category.id).length > 0))
    .slice(0, 3);
  return {
    ...category,
    count: skills.length,
    skills: skills.slice(0, 3),
    relatedOccupations,
  };
});

const pageTitle = isZhCopy ? '分类' : 'Categories';
const pageDescription = isZhCopy
  ? '按能力类型浏览通过基础审查的 AI Agent Skills。'
  : 'Browse baseline-reviewed AI agent skills by capability type.';
const pageKeywords = buildKeywordString(t, 'core', 'ideCompat', 'developerExperience', 'categories');
---

<Layout locale={locale} title={pageTitle} description={pageDescription} keywords={pageKeywords} appendBrand={false}>
  <main>
    <MarketplaceHero
      locale={locale}
      eyebrow={isZhCopy ? '分类' : 'Categories'}
      title={pageTitle}
      description={pageDescription}
      searchPlaceholder={isZhCopy ? '搜索分类内 Skills' : 'Search skills by category'}
      searchAction={`/${locale}/search`}
      countLabel={isZhCopy ? `${categories.length} 个分类` : `${categories.length} categories`}
      actions={[
        { href: `/${locale}/skills`, label: 'Skills' },
        { href: `/${locale}/occupations`, label: isZhCopy ? '职业' : 'Occupations' },
      ]}
    />

    <MarketplaceSection
      title={isZhCopy ? '全部分类' : 'All Categories'}
      description={isZhCopy
        ? '分类用于能力范围；官方/社区是来源属性。'
        : 'Categories describe capability; official/community remains a source attribute.'}
    >
      <div class="marketplace-card-grid">
        {
          categories.map((category) => (
            <a class="marketplace-card-link" href={`/${locale}/categories/${category.id}`}>
              <div class="marketplace-meta-row">
                <span>{isZhCopy ? `${category.count} 个 Skills` : `${category.count} skills`}</span>
              </div>
              <h3>{category.label}</h3>
              <p>{category.seoDescription}</p>
              <div class="marketplace-pill-list">
                {category.relatedOccupations.map((occupation) => (
                  <span class="market-chip px-2 py-1">{occupation.label}</span>
                ))}
              </div>
            </a>
          ))
        }
      </div>
    </MarketplaceSection>
  </main>
</Layout>
