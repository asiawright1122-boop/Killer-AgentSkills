---
import Layout from '../../../layouts/Layout.astro';
import MarketplaceSimplePage from '../../../components/MarketplaceSimplePage.astro';
import { SUPPORTED_LOCALES, type Locale } from '../../../i18n';
import docsCache from '../../../../data/docs-cache.json';

type DocsCachePage = {
  slug?: string;
  title?: Partial<Record<Locale | string, string>>;
  content?: Partial<Record<Locale | string, string>>;
};

const INDEXABLE_DOCS_LOCALES = ['en', 'zh'] as const;
const LOCALIZED_DOCS_LINK_PREFIXES = [
  'blog',
  'cli',
  'collections',
  'docs',
  'occupations',
  'popular',
  'safe',
  'skills',
  'solutions',
] as const;

const docsPages = ((docsCache as { pages?: DocsCachePage[] }).pages || []).filter(
  (page) => page && typeof page === 'object',
);
const normalizedDocsPages = docsPages
  .map((page) => ({
    ...page,
    normalizedSlug: typeof page.slug === 'string' ? page.slug.trim().toLowerCase() : '',
  }))
  .filter((page) => page.normalizedSlug);

const validDocsSlugs = new Set(
  normalizedDocsPages
    .map((page) => (typeof page.slug === 'string' ? page.slug.trim().toLowerCase() : ''))
    .filter(Boolean),
);

function localizeDocsContentLinks(content: string | undefined, targetLocale: string): string | undefined {
  if (!content) return content;
  const routePrefixPattern = LOCALIZED_DOCS_LINK_PREFIXES.join('|');
  return content.replace(new RegExp(`href="/(${routePrefixPattern})([^"]*)"`, 'g'), `href="/${targetLocale}/$1$2"`);
}

const { locale, slug } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const isZhCopy = locale.startsWith('zh');
const indexableDocsLocale = INDEXABLE_DOCS_LOCALES.includes(locale as (typeof INDEXABLE_DOCS_LOCALES)[number]);
const slugLabel = Array.isArray(slug) ? slug.join('/') : slug || 'index';
const normalizedSlug = slugLabel
  .split('/')
  .map((segment) => segment.trim())
  .filter(Boolean)
  .join('/')
  .toLowerCase();
const isKnownDocsSlug = normalizedSlug === 'index' || validDocsSlugs.has(normalizedSlug);
const robotsContent = !isKnownDocsSlug ? 'noindex, nofollow' : !indexableDocsLocale ? 'noindex, follow' : undefined;
const docsPage = normalizedDocsPages.find((page) => page.normalizedSlug === normalizedSlug);
const docsPageTitle =
  docsPage?.title?.[locale] || docsPage?.title?.[locale.split('-')[0]] || docsPage?.title?.en || undefined;
const rawDocsPageContent =
  docsPage?.content?.[locale] || docsPage?.content?.[locale.split('-')[0]] || docsPage?.content?.en || undefined;
const docsPageContent = localizeDocsContentLinks(rawDocsPageContent, locale);
const canonicalPagePath = normalizedSlug === 'index' ? '/docs' : `/docs/${normalizedSlug}`;
const canonicalUrl = `https://killer-skills.com/${indexableDocsLocale ? locale : 'en'}${canonicalPagePath}`;

if (!isKnownDocsSlug) {
  Astro.response.status = 404;
  Astro.response.statusText = 'Not Found';
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
} else if (!indexableDocsLocale) {
  Astro.response.headers.set('X-Robots-Tag', 'noindex, follow');
}

const docsDisplayTitle =
  docsPageTitle || (normalizedSlug === 'index' ? (isZhCopy ? '文档首页' : 'Docs Home') : isZhCopy ? '文档' : 'Docs');
const docsSeoTitle = isZhCopy ? `${docsDisplayTitle} | Killer-Skills 文档` : `${docsDisplayTitle} | Killer-Skills Docs`;
const docsSeoDescription = isZhCopy
  ? '阅读 Killer-Skills 文档，了解安装、CLI 命令、目录审核政策和 AI agent skill 工作流。'
  : 'Read the Killer-Skills docs for installation, CLI commands, directory review policy, and AI agent skill workflows.';
const title = isKnownDocsSlug ? docsSeoTitle : isZhCopy ? '404 - 页面不存在' : '404 - Page Not Found';
const description = isKnownDocsSlug
  ? docsSeoDescription
  : isZhCopy
    ? '这个文档页面不存在。'
    : 'This documentation page does not exist.';
const bridgeDescription = isKnownDocsSlug
  ? docsSeoDescription
  : isZhCopy
    ? '这个文档页面不存在。'
    : 'This documentation page does not exist.';
---

<Layout
  locale={locale}
  title={title}
  description={description}
  appendBrand={false}
  customCanonical={isKnownDocsSlug ? canonicalUrl : undefined}
  availableLocales={INDEXABLE_DOCS_LOCALES}
  xDefaultLocale="en"
  noindex={!indexableDocsLocale || !isKnownDocsSlug}
  robots={robotsContent}
>
  {
    isKnownDocsSlug ? (
      <MarketplaceSimplePage title={docsDisplayTitle} description={bridgeDescription}>
        {docsPageContent && (
          <article class="prose prose-lg dark:prose-invert max-w-none prose-headings:text-[var(--foreground)] prose-p:text-[var(--muted-foreground)] prose-li:text-[var(--muted-foreground)] prose-a:text-[var(--accent)] prose-a:font-bold prose-a:underline prose-a:decoration-2 prose-a:underline-offset-4 prose-strong:text-[var(--foreground)] prose-code:text-[var(--foreground)] prose-pre:bg-[var(--muted)] prose-pre:border prose-pre:border-[var(--border)]">
            <Fragment set:html={docsPageContent} />
          </article>
        )}
        <div class="marketplace-card-grid">
          <a class="marketplace-card-link" href={`/${locale}/skills`}>
            <span class="marketplace-route-label">{slugLabel}</span>
            <h3>Skills</h3>
            <p>{isZhCopy ? '打开完整目录和筛选器。' : 'Open the complete directory and filters.'}</p>
          </a>
          <a class="marketplace-card-link" href={`/${locale}/safe`}>
            <h3>{isZhCopy ? '审核政策' : 'Review Policy'}</h3>
            <p>{isZhCopy ? '查看公开展示的基础准入规则。' : 'See the public listing admission rules.'}</p>
          </a>
          <a class="marketplace-card-link" href={`/${locale}/cli`}>
            <h3>CLI</h3>
            <p>{isZhCopy ? '查看一行安装命令。' : 'View the one-command install path.'}</p>
          </a>
        </div>
      </MarketplaceSimplePage>
    ) : (
      <div class="min-h-[70vh] flex flex-col items-center justify-center text-center px-6 relative py-20">
        <div class="skill-detail-surface p-8 md:p-12 max-w-xl w-full">
          <p class="market-chip px-3 py-1 mb-6">404</p>
          <h1 class="text-4xl md:text-5xl font-bold text-[var(--foreground)] mb-4">
            {isZhCopy ? '页面不存在' : 'Page Not Found'}
          </h1>
          <p class="text-base text-[var(--muted-foreground)] font-medium mb-8 max-w-md mx-auto leading-relaxed">
            {isZhCopy
              ? '这个文档页面已经不可用。回到首页，或进入 Skills 目录继续筛选。'
              : 'This documentation page is no longer available. Start from home or continue in the Skills directory.'}
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a href={`/${locale}`} class="market-button w-full sm:w-auto px-5 py-3">
              {isZhCopy ? '返回首页' : 'Return home'}
            </a>
            <a
              href={`/${locale}/skills`}
              class="w-full sm:w-auto px-5 py-3 rounded-md border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] font-bold hover:bg-[var(--muted)] transition-colors"
            >
              {isZhCopy ? '进入 Skills' : 'Open Skills'}
            </a>
          </div>
        </div>
      </div>
    )
  }
</Layout>
