---
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { SUPPORTED_LOCALES, loadMessages, translateOr, useTranslations, type Locale } from '../../../i18n';
import { getAuthoritySurfaceEntries } from '../../../lib/authority-surfaces';
import { buildKeywordString } from '../../../lib/seo-keywords';
import type { Env } from '../../../lib/kv';
import docsCache from '../../../../data/docs-cache.json';

type DocPage = {
  slug: string;
  title: Record<string, string>;
  section: string;
  content: Record<string, string>;
};

type DocsCache = {
  lastUpdated?: string;
  pages: DocPage[];
  sidebar: Record<string, { title: Record<string, string>; items: string[] }>;
};

// Type assertion for imported JSON
const localDocsCache = docsCache as DocsCache;
import { FileText, Book, Menu, X, Rocket } from 'lucide-react';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=86400');

// Validate locale
const { locale, slug } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const isZhCopy = typedLocale.startsWith('zh');

const env = Astro.locals.runtime?.env as Env;

// Load translations
let messages: any;
let t: (key: string) => string = (k: string) => k;
try {
  messages = await loadMessages(typedLocale);
  t = useTranslations(messages);
} catch (e) {
  console.error('[Docs] Error loading translations:', e);
}
const tr = (key: string, fallback: string) => translateOr(messages || {}, key, fallback);

// Determine if this is the docs index or a specific doc page
const isIndex = !slug;
const currentSlug = isIndex ? 'index' : slug;
const currentPath = `/${locale}/docs${slug ? `/${slug}` : ''}`;
const isCliDoc = currentSlug.includes('cli');
const isInstallDoc = currentSlug.includes('installation') || currentSlug.includes('getting-started');
const isInstallationPage = currentSlug === 'installation';
const isWorkflowDoc = currentSlug.includes('workflows') || currentSlug.includes('templates');
const isApiDoc = currentSlug.includes('api');
const isSecurityDoc = currentSlug.includes('security');
const docsNavigationLabel = tr('Docs.navLabel', 'Documentation navigation');
const toggleDocsSidebarLabel = tr('Docs.toggleSidebar', 'Toggle documentation sidebar');
const closeDocsSidebarLabel = tr('Docs.closeSidebar', 'Close sidebar');
const docsBadgeLabel = isIndex ? tr('Common.documentation', 'Documentation') : tr('Docs.guide', 'Guide');
const returnToIntroductionLabel = tr('Docs.returnToIntro', 'Return to Introduction');

interface DocData {
  title: string;
  content: string;
}

let docContent: string | null = null;
let docTitle = '';

if (env?.SKILLS_CACHE) {
  try {
    // Try locale-specific key first, then fallback to English
    const kvKey = `doc:${locale}:${currentSlug}`;
    const rawData = await env.SKILLS_CACHE.get(kvKey, 'text');

    if (rawData) {
      const docData: DocData = JSON.parse(rawData);
      docContent = docData.content;
      docTitle = docData.title;
    } else if (locale !== 'en') {
      // Fallback to English
      const enData = await env.SKILLS_CACHE.get(`doc:en:${currentSlug}`, 'text');
      if (enData) {
        const docData: DocData = JSON.parse(enData);
        docContent = docData.content;
        docTitle = docData.title;
      }
    }
  } catch (e) {
    console.error('[Docs] Error reading doc from KV:', e);
  }
}

// Helper to get doc from cache object
const getDocFromCache = (cache: DocsCache, slug: string, lang: string) => {
  const page = cache.pages.find((p) => p.slug === slug);
  if (!page) return null;

  return {
    title: page.title[lang] || page.title['en'] || '',
    content: page.content[lang] || page.content['en'] || '',
  };
};

function localizeDocHtmlLinks(html: string, locale: string): string {
  return html.replace(
    /href="\/(docs|cli|collections|solutions|blog|integrations)(\/[^"]*)?"/g,
    (_match, section: string, rest: string | undefined) => `href="/${locale}/${section}${rest || ''}"`,
  );
}

// Fallback to local JSON cache (Local Dev / Build w/o KV)
if (!docContent) {
  const localDoc = getDocFromCache(localDocsCache, currentSlug, typedLocale);
  if (localDoc) {
    docTitle = localDoc.title;
    docContent = localDoc.content;
  }
}

if (docContent) {
  docContent = localizeDocHtmlLinks(docContent, typedLocale);
}

// Important for crawl hygiene:
// unknown docs slugs must be hard 404s, not soft "coming soon" 200 pages.
if (!isIndex && !docContent) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Fallback title if not loaded from KV
if (!docTitle) {
  if (isIndex) {
    docTitle = tr('Docs.gettingStarted', 'Getting Started');
  } else {
    const segments = slug!.split('/');
    docTitle = segments[segments.length - 1].replace(/-/g, ' ').replace(/\b\w/g, (c: string) => c.toUpperCase());
  }
}

const pageTitle = isIndex
  ? tr('Docs.indexTitle', 'AI Agent Skills Docs for Install, Setup & Workflow Templates')
  : isInstallationPage
    ? `${docTitle} | Cursor, Claude Code & VS Code Setup`
    : `${docTitle} | ${tr('Docs.titleSuffix', 'AI Agent Skills Docs')}`;
const pageDescription = isIndex
  ? tr(
      'Docs.indexDescription',
      'Read Killer-Skills docs for installation, setup, CLI commands, IDE compatibility, and workflow templates to get started with AI agent skills.',
    )
  : isInstallationPage
    ? isZhCopy
      ? '用 npx 安装 AI Agent Skills，验证 Cursor、Claude Code、VS Code 等环境中的原生文件写入，并继续进入可信合集与工作流方案页。'
      : 'Install AI agent skills with npx, verify IDE-native files for Cursor, Claude Code, VS Code, and move into trusted collections and workflow solutions.'
    : isCliDoc
      ? `${docTitle}: ${tr('Docs.cliDesc', 'learn AI agent skills CLI commands, sync behavior, and setup details for automation workflows.')}`
      : isInstallDoc
        ? `${docTitle}: ${tr('Docs.installDesc', 'follow step-by-step installation for AI agent skills in Cursor, Claude Code, VS Code, and more.')}`
        : isWorkflowDoc
          ? `${docTitle}: ${tr('Docs.workflowDesc', 'learn reusable AI agent skill patterns for workflow automation, process automation, and templates.')}`
          : isApiDoc
            ? `${docTitle}: ${tr('Docs.apiDesc', 'understand MCP, API integration, and scalable AI agent workflow implementation.')}`
            : isSecurityDoc
              ? `${docTitle}: ${tr('Docs.securityDesc', 'cover skill security, risk controls, and production-ready deployment practices.')}`
              : `${docTitle}: ${tr('Docs.defaultDesc', 'Killer-Skills documentation for setup, configuration, and practical automation usage.')}`;
const pageKeywords = buildKeywordString(
  t,
  'docs',
  'core',
  'workflowAutomation',
  isIndex ? 'processAutomation' : undefined,
  isIndex ? 'documentAutomation' : undefined,
  isIndex ? 'cli' : undefined,
  isIndex ? 'installSetup' : undefined,
  isIndex ? 'compatibility' : undefined,
  isIndex ? 'templates' : undefined,
  isIndex ? 'ideCompat' : undefined,
  isCliDoc ? 'cli' : undefined,
  isCliDoc ? 'compatibility' : undefined,
  isWorkflowDoc ? 'workflowAutomation' : undefined,
  isWorkflowDoc ? 'processAutomation' : undefined,
  isWorkflowDoc ? 'templates' : undefined,
  isInstallDoc ? 'ideCompat' : undefined,
  isInstallDoc ? 'installSetup' : undefined,
  currentSlug.includes('creating-skills') ? 'developerExperience' : undefined,
  isApiDoc ? 'mcp' : undefined,
  isApiDoc ? 'dataWorkflow' : undefined,
  isSecurityDoc ? 'developerExperience' : undefined,
  isIndex ? ['workflow automation', 'process automation'] : [docTitle],
);
const canonicalUrl = `https://killer-skills.com${currentPath}`;
const docsLastUpdated = localDocsCache.lastUpdated
  ? new Intl.DateTimeFormat(typedLocale, { year: 'numeric', month: 'short', day: 'numeric' }).format(
      new Date(localDocsCache.lastUpdated),
    )
  : '';
const breadcrumbItems = [
  { label: tr('Common.home', 'Home'), href: `/${locale}` },
  { label: tr('Footer.docs', 'Docs'), href: `/${locale}/docs` },
  ...(!isIndex ? [{ label: docTitle }] : []),
];
const docsEntryLinks = isIndex
  ? [
      {
        title: tr('Docs.entry.install.title', 'Install AI Agent Skills'),
        description: tr(
          'Docs.entry.install.desc',
          'Start from zero with install, initialization, and first-run steps.',
        ),
        href: `/${locale}/docs/installation`,
      },
      {
        title: tr('Docs.entry.ide.title', 'Set Up Cursor / Claude Code'),
        description: tr('Docs.entry.ide.desc', 'See how each IDE gets its native skill format automatically.'),
        href: `/${locale}/integrations`,
      },
      {
        title: tr('Docs.entry.cli.title', 'CLI Commands & Sync'),
        description: tr('Docs.entry.cli.desc', 'Review commands, sync behavior, and configuration options.'),
        href: `/${locale}/docs/cli/commands`,
      },
      {
        title: tr('Docs.entry.templates.title', 'Workflow Template Entry Points'),
        description: tr('Docs.entry.templates.desc', 'Move from docs into automation and template workflows.'),
        href: `/${locale}/collections`,
      },
    ]
  : [];
const docsFaqItems = isIndex
  ? [
      {
        question: tr('Docs.faq1Q', 'How do I install AI agent skills?'),
        answer: tr(
          'Docs.faq1A',
          'Start with the installation docs and run `npx killer-skills add owner/repo` to add a skill. The CLI auto-detects your IDE and writes the correct format.',
        ),
      },
      {
        question: tr('Docs.faq2Q', 'What setup information is covered in the docs?'),
        answer: tr(
          'Docs.faq2A',
          'The docs cover installation, CLI commands, configuration, workflow concepts, and compatibility entry points for Cursor, Claude Code, VS Code, and more.',
        ),
      },
      {
        question: tr('Docs.faq3Q', 'Where can I find workflow templates and automation ideas?'),
        answer: tr(
          'Docs.faq3A',
          'Start with the workflows concept docs, then move into collections and skills pages for reusable automation and template scenarios.',
        ),
      },
    ]
  : [];
const installFaqItems = isInstallationPage
  ? [
      {
        question: isZhCopy ? '必须先全局安装吗？' : 'Do I need a global install first?',
        answer: isZhCopy
          ? '不用。推荐路径是 `npx`，因为它更轻、更稳，也更适合团队复现和新机器接入。'
          : 'No. The recommended path is `npx`, because it stays lightweight, current, and easy to repeat across teams and machines.',
      },
      {
        question: isZhCopy ? '怎样确认写入的是正确的 IDE 文件？' : 'How do I verify the right IDE files were written?',
        answer: isZhCopy
          ? '先运行 `npx killer-skills list`，再检查 `.cursorrules`、`.claude/skills/`、`.github/copilot-instructions.md` 或 `.windsurf/rules/` 等目标位置。'
          : 'Run `npx killer-skills list`, then confirm the CLI updated the expected targets such as `.cursorrules`, `.claude/skills/`, `.github/copilot-instructions.md`, or `.windsurf/rules/`.',
      },
      {
        question: isZhCopy ? '第一次安装成功后下一步去哪里？' : 'What should I do after the first successful install?',
        answer: isZhCopy
          ? '继续进入 CLI 总览、官方可信工具合集或 Agent 工作流方案页，把一次安装推进成可复用的操作路径。'
          : 'Continue into the CLI overview, the official trusted tools collection, or the agent workflows solution page so installation becomes a repeatable operating path.',
      },
    ]
  : [];
const installHowToSteps = isInstallationPage
  ? [
      {
        name: isZhCopy ? '打开项目终端' : 'Open your project terminal',
        text: isZhCopy
          ? '进入你希望 AI 助手获得新能力的项目目录。'
          : 'Open the project where your AI assistant should gain a new capability.',
      },
      {
        name: isZhCopy ? '运行安装命令' : 'Run the install command',
        text: isZhCopy
          ? '执行 `npx killer-skills add owner/repo`，让 CLI 自动识别当前 IDE 并写入对应格式。'
          : 'Run `npx killer-skills add owner/repo` and let the CLI detect your IDE and write the matching skill format.',
      },
      {
        name: isZhCopy ? '完成安装验证' : 'Validate the installation',
        text: isZhCopy
          ? '检查 `npx killer-skills list` 的输出，并确认目标 IDE 文件已经写入。'
          : 'Check `npx killer-skills list` and confirm the expected IDE-native files were written.',
      },
    ]
  : [];
const installBridgeSurfaces = isInstallDoc
  ? getAuthoritySurfaceEntries(typedLocale, {
      ids: [
        'collection-official-trusted-tools',
        'collection-agent-workflows',
        'solution-agent-workflows',
        'blog-how-to-install-ai-agent-skills',
      ],
    })
  : [];
const installBridgeCards = isInstallDoc
  ? [
      {
        href: `/${locale}/cli`,
        title: tr('Docs.installBridge.cli.title', 'Open CLI Control Center'),
        description: tr(
          'Docs.installBridge.cli.desc',
          'Move straight from install docs into the CLI page for commands, sync behavior, and operator-safe setup paths.',
        ),
        badge: 'CLI',
      },
      {
        href: `/${locale}/docs/cli/overview`,
        title: tr('Docs.installBridge.overview.title', 'Review CLI Overview'),
        description: tr(
          'Docs.installBridge.overview.desc',
          'Use the docs overview to confirm install flow, compatibility behavior, and what happens after the first command.',
        ),
        badge: 'DOCS',
      },
      ...installBridgeSurfaces.map((surface) => ({
        href: surface.href,
        title: surface.title,
        description: surface.description,
        badge: isZhCopy ? '下一步' : 'NEXT',
      })),
    ]
  : [];
const installValidationSteps = isInstallDoc
  ? [
      tr(
        'Docs.installBridge.validate1',
        'Run `npx killer-skills add owner/repo` and confirm the CLI writes the IDE-native skill format instead of a generic fallback.',
      ),
      tr(
        'Docs.installBridge.validate2',
        'Use `npx killer-skills list` or the CLI page to verify the skill is now present in your environment.',
      ),
      tr(
        'Docs.installBridge.validate3',
        'Open one trusted collection or workflow page to decide what to install next instead of browsing the full directory blindly.',
      ),
    ]
  : [];
const installReviewMeta = isInstallDoc
  ? {
      reviewedAt: '2026-04-19',
      maintainedBy: isZhCopy ? 'Killer-Skills 团队' : 'Killer-Skills Team',
      verification: isZhCopy
        ? '命令路径、IDE 原生文件写入、CLI 承接路径与可信下一步入口'
        : 'Command path, IDE-native file writes, CLI handoff, and trusted next-step routes',
      scope: isZhCopy
        ? '这页优先服务于“先安装、再验证、再决定下一步”的高意图用户。'
        : 'This page serves high-intent users who need to install, validate, and then choose the next trusted step.',
    }
  : null;
const installReviewSignals = isInstallDoc
  ? [
      isZhCopy
        ? '先确认安装命令，再确认 CLI 会把内容写入正确的 IDE 原生文件。'
        : 'Confirm the install command first, then confirm the CLI writes to the correct IDE-native files.',
      isZhCopy
        ? '把安装后的验证作为主流程，而不是让用户继续回到仓库列表里盲逛。'
        : 'Treat post-install validation as a primary step instead of sending users back into blind repository browsing.',
      isZhCopy
        ? '每个安装路径都要继续连向 CLI、可信合集或工作流方案页。'
        : 'Every install path should continue into CLI docs, trusted collections, or workflow solution pages.',
    ]
  : [];
const installDecisionTracks = isInstallDoc
  ? [
      {
        badge: isZhCopy ? 'TRUST' : 'TRUST',
        title: isZhCopy ? '先走最低风险的首装路径' : 'Take the Lowest-Risk First Install Path',
        description: isZhCopy
          ? '如果你当前最在意的是“先装对、别踩空”，就先回到官方可信工具合集，再从那里进入安装。这样最容易把团队默认起步路径先跑顺。'
          : 'If the main goal is to get the first install right without guessing, return to the official trusted collection first and enter installation from there. That keeps the team baseline clear and repeatable.',
        whenToUse: isZhCopy
          ? '适合第一次安装、共享团队默认方案，或需要先确认工具归属和文档是否可信的时候。'
          : 'Use it for the first install, a shared team default, or whenever ownership and docs trust need to be confirmed before rollout.',
        checkpoints: isZhCopy
          ? [
              '先确认你选的是官方或高可信生态工具，而不是随意继续刷仓库。',
              '完成安装后，马上验证 IDE 原生文件是否写入正确位置。',
              '只有首条可信安装路径跑通后，再决定是否继续扩栈。',
            ]
          : [
              'Confirm the tool is official or strongly trusted before you keep browsing repos.',
              'Validate the IDE-native file writes immediately after installation.',
              'Only expand the stack after the first trusted install path works cleanly.',
            ],
        primaryHref: `/${locale}/collections/top-official-ai-skills-trusted-tools`,
        primaryLabel: isZhCopy ? '回到官方可信工具合集' : 'Open Official Trusted Tools',
      },
      {
        badge: isZhCopy ? 'CLI' : 'CLI',
        title: isZhCopy ? '把安装变成可验证的操作链路' : 'Turn Installation Into a Verifiable Operator Path',
        description: isZhCopy
          ? '如果命令已经准备好，下一步就不该再靠感觉判断。继续进入 CLI 总览，确认会写入什么、如何同步、以及操作者应该验证哪些检查点。'
          : 'Once the command is ready, the next step should not rely on intuition. Continue into the CLI overview to confirm what gets written, how sync behaves, and which checkpoints operators should verify.',
        whenToUse: isZhCopy
          ? '适合已经接近执行阶段，或已经完成首装但需要确认写入、同步和验证行为的时候。'
          : 'Use it when execution is imminent, or after the first install succeeds but write, sync, and validation behavior still need to be checked.',
        checkpoints: isZhCopy
          ? [
              '运行 `npx killer-skills list`，确认当前环境里已经能看见刚装的技能。',
              '核对 `.cursorrules`、`.claude/skills/`、`.github/copilot-instructions.md` 或 `.windsurf/rules/` 等目标文件。',
              '把“命令成功”与“环境真正可用”拆开验证。',
            ]
          : [
              'Run `npx killer-skills list` and confirm the installed skill is visible in the environment.',
              'Check the target files such as `.cursorrules`, `.claude/skills/`, `.github/copilot-instructions.md`, or `.windsurf/rules/`.',
              'Treat “the command passed” and “the environment is actually usable” as separate validations.',
            ],
        primaryHref: `/${locale}/docs/cli/overview`,
        primaryLabel: isZhCopy ? '打开 CLI 总览' : 'Open CLI Overview',
      },
      {
        badge: isZhCopy ? 'WORKFLOW' : 'WORKFLOW',
        title: isZhCopy ? '把一次安装推进成团队工作流' : 'Move a One-Off Install Into a Team Workflow',
        description: isZhCopy
          ? '安装成功后，下一步不该回到随机浏览。继续进入工作流合集或方案页，把这次安装映射到路由、审批、交接和可复用落地链路。'
          : 'After installation succeeds, the next move should not be random browsing again. Continue into workflow collections or solution pages to map the install into routing, approvals, handoff, and repeatable rollout.',
        whenToUse: isZhCopy
          ? '适合安装已经验证完成，但你还需要决定它在团队执行链路里应该扮演什么角色的时候。'
          : 'Use it when installation is already validated, but you still need to decide what role the tool should play in the team workflow lane.',
        checkpoints: isZhCopy
          ? [
              '先决定它服务的是工作流骨架、操作者护栏，还是场景型方案。',
              '避免再次回到全量目录，把下一次点击限制在高意图承接面内。',
              '把这次安装沉淀成团队可复用的默认动作。',
            ]
          : [
              'Decide whether the tool serves workflow scaffolding, operator guardrails, or a scenario-specific solution.',
              'Do not reset back to the full directory; keep the next click inside high-intent surfaces.',
              'Turn the install into a repeatable default for the team instead of a one-off action.',
            ],
        primaryHref: `/${locale}/collections/top-agent-workflow-building-tools`,
        primaryLabel: isZhCopy ? '进入工作流合集' : 'Open Workflow Collection',
      },
    ]
  : [];
const installNextStepCards = isInstallationPage
  ? [
      {
        href: `/${locale}/collections`,
        badge: isZhCopy ? 'HUB' : 'HUB',
        title: isZhCopy
          ? '还不确定下一步装什么？返回精选 Collections'
          : 'Not Sure What to Install Next? Return to Collections',
        description: isZhCopy
          ? '先回到精选合集总入口，再按可信度和任务意图选择下一批技能。'
          : 'Return to the curated collections hub before you choose the next skills by trust level and job to be done.',
      },
      {
        href: `/${locale}/collections/top-official-ai-skills-trusted-tools`,
        badge: isZhCopy ? 'TRUST' : 'TRUST',
        title: isZhCopy
          ? '想要安全默认选型？回到官方可信工具合集'
          : 'Need the safest defaults? Go to Official Trusted Tools',
        description: isZhCopy
          ? '优先查看官方和高可信生态维护的技能与工具。'
          : 'Prioritize official and strongly trusted ecosystem tools before you standardize a shared stack.',
      },
      {
        href: `/${locale}/collections/top-agent-workflow-building-tools`,
        badge: isZhCopy ? 'WORKFLOW' : 'WORKFLOW',
        title: isZhCopy
          ? '想搭团队工作流栈？回到 Agent Workflow Building Tools'
          : 'Building a Team Workflow Stack? Return to Agent Workflow Tools',
        description: isZhCopy
          ? '从工作流角度继续挑选路由、审批、交接和执行骨架。'
          : 'Continue from a workflow perspective to choose routing, approvals, handoff, and execution scaffolds.',
      },
      {
        href: `/${locale}/solutions/agent-workflows`,
        badge: isZhCopy ? 'SOLUTION' : 'SOLUTION',
        title: isZhCopy
          ? '想按场景选组合？进入 Agent Workflows 方案页'
          : 'Need a Scenario-Based Stack? Open Agent Workflows',
        description: isZhCopy
          ? '如果你的问题已经是具体场景，就直接进入方案页而不是继续逛仓库。'
          : 'If your next step is a concrete workflow problem, move into the solution page instead of browsing more repositories.',
      },
    ]
  : [];

// CLI Components
import TerminalWindow from '../../../components/cli/TerminalWindow.astro';
import ComparisonTable from '../../../components/cli/ComparisonTable.astro';

// Navigation Structure
const sidebarNav = [
  {
    title: t('DocsSidebar.platformOverview'),
    items: [
      { title: t('DocsSidebar.introduction'), href: `/${locale}/docs` }, // Index points here
      { title: t('DocsSidebar.architecture'), href: `/${locale}/docs/architecture` },
      { title: t('DocsSidebar.skills'), href: `/${locale}/docs/concepts/skills` },
      { title: t('DocsSidebar.workflows'), href: `/${locale}/docs/concepts/workflows` },
    ],
  },
  {
    title: t('DocsSidebar.gettingStarted'),
    items: [
      { title: t('DocsSidebar.quickStart'), href: `/${locale}/docs/getting-started` },
      { title: t('DocsSidebar.installation'), href: `/${locale}/docs/installation` },
    ],
  },
  {
    title: t('DocsSidebar.cliTooling'),
    items: [
      { title: t('DocsSidebar.overview'), href: `/${locale}/docs/cli/overview` }, // New CLI Overview
      { title: t('DocsSidebar.commands'), href: `/${locale}/docs/cli/commands` }, // Updated link style
      { title: t('DocsSidebar.configuration'), href: `/${locale}/docs/cli/configuration` }, // Updated link style
    ],
  },
  {
    title: t('DocsSidebar.guides'),
    items: [
      { title: t('DocsSidebar.creatingSkills'), href: `/${locale}/docs/creating-skills` },
      { title: t('DocsSidebar.security'), href: `/${locale}/docs/security` },
    ],
  },
  {
    title: t('DocsSidebar.apiReference'),
    items: [
      { title: t('DocsSidebar.restApi'), href: `/${locale}/docs/api-reference` },
      { title: t('DocsSidebar.authentication'), href: `/${locale}/docs/api/auth` },
    ],
  },
];

// Helper to check active state
const isActive = (href: string) => {
  if (href === `/${locale}/docs` && isIndex) return true;
  return currentPath === href;
};
---

<Layout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  customCanonical={canonicalUrl}
  showFooter={false}
>
  <script
    is:inline
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: tr('Common.home', 'Home'),
          item: `https://killer-skills.com/${locale}`,
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: tr('Footer.docs', 'Docs'),
          item: `https://killer-skills.com/${locale}/docs`,
        },
        ...(!isIndex ? [{ '@type': 'ListItem', position: 3, name: docTitle, item: canonicalUrl }] : []),
      ],
    })}
    slot="head"
  />
  {
    isIndex && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: docsFaqItems.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: {
              '@type': 'Answer',
              text: item.answer,
            },
          })),
        })}
        slot="head"
      />
    )
  }
  {
    isInstallationPage && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: installFaqItems.map((item) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: {
              '@type': 'Answer',
              text: item.answer,
            },
          })),
        })}
        slot="head"
      />
    )
  }
  {
    isInstallationPage && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'HowTo',
          name: isZhCopy ? '如何安装 AI Agent Skills' : 'How to Install AI Agent Skills',
          description: pageDescription,
          totalTime: 'PT2M',
          tool: {
            '@type': 'HowToTool',
            name: isZhCopy ? '终端 / 命令行' : 'Terminal / Command Line',
          },
          step: installHowToSteps.map((step, index) => ({
            '@type': 'HowToStep',
            position: index + 1,
            name: step.name,
            text: step.text,
          })),
        })}
        slot="head"
      />
    )
  }
  {
    isInstallationPage && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify({
          '@context': 'https://schema.org',
          '@type': 'WebPage',
          name: pageTitle,
          description: pageDescription,
          url: canonicalUrl,
          speakable: {
            '@type': 'SpeakableSpecification',
            cssSelector: ['h1', '.prose .lead', '.prose h2'],
          },
        })}
        slot="head"
      />
    )
  }
  <div class="bg-[var(--background)] text-[var(--foreground)] min-h-screen flex flex-col md:flex-row font-sans">
    {/* Mobile Toggle (Visible only on small screens) */}
    <div
      class="md:hidden bg-[var(--card)] border-b-4 border-[var(--foreground)] p-4 sticky top-0 z-20 flex items-center justify-between shadow-[0px_4px_0px_0px_var(--foreground)] mb-6"
    >
      <span class="font-black uppercase flex items-center gap-2">
        <Book className="w-5 h-5" strokeWidth={3} />
        {tr('Common.documentation', 'Documentation')}
      </span>
      <button
        id="mobile-menu-btn"
        aria-label={toggleDocsSidebarLabel}
        class="hover:bg-[var(--foreground)] hover:text-[var(--background)] p-1 transition-colors border-2 border-transparent hover:border-[var(--foreground)]"
      >
        <Menu className="w-6 h-6" strokeWidth={3} />
      </button>
    </div>

    {/* Sidebar Navigation */}
    <aside
      id="docs-sidebar"
      aria-label={docsNavigationLabel}
      class="fixed inset-y-0 left-0 z-30 w-72 bg-[var(--card)] border-r-4 border-[var(--foreground)] transform -translate-x-full transition-transform duration-300 ease-in-out
      md:translate-x-0 md:static md:h-[calc(100vh-64px)] md:sticky md:top-16 overflow-y-auto"
    >
      <div class="p-6 md:pt-10 space-y-10">
        {/* Mobile Close Button */}
        <div class="flex md:hidden justify-end mb-4">
          <button
            id="close-sidebar-btn"
            aria-label={closeDocsSidebarLabel}
            class="border-2 border-[var(--foreground)] p-1 hover:bg-[var(--foreground)] hover:text-[var(--background)] transition-colors"
          >
            <X className="w-6 h-6" strokeWidth={3} />
          </button>
        </div>

        {
          sidebarNav.map((section) => (
            <div>
              <h3 class="text-xs font-black text-[var(--foreground)] uppercase tracking-widest mb-4 px-3 border-b-2 border-[var(--border)] pb-2 flex items-center">
                <span class="w-1.5 h-1.5 bg-[var(--primary)] mr-2 border border-[var(--foreground)]" />
                {section.title}
              </h3>
              <ul class="space-y-2">
                {section.items.map((item) => {
                  const active = isActive(item.href);
                  return (
                    <li>
                      <a
                        href={item.href}
                        class:list={[
                          'block px-3 py-2 text-sm font-bold transition-all border-l-4',
                          active
                            ? 'bg-[var(--primary)] text-[var(--primary-foreground)] border-[var(--foreground)] hover:translate-x-[2px] shadow-[2px_2px_0px_0px_var(--foreground)]' // Active Style
                            : 'border-transparent text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:border-[var(--primary)] hover:bg-[var(--muted)] hover:translate-x-1', // Inactive Style
                        ]}
                      >
                        {item.title}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </div>
    </aside>

    {/* Main Content Area */}
    <main class="flex-1 w-full max-w-4xl min-w-0 px-4 py-8 md:px-12 xl:px-16 md:py-16">
      <Breadcrumb items={breadcrumbItems} />

      {/* Content Header */}
      <div class="mb-12 border-b-4 border-[var(--foreground)] pb-8">
        <p
          class="inline-flex items-center px-2 py-1 bg-[var(--primary)] text-[var(--primary-foreground)] font-mono text-xs font-bold uppercase tracking-widest border-2 border-[var(--foreground)] shadow-[2px_2px_0px_0px_var(--foreground)] mb-6"
        >
          {docsBadgeLabel}
        </p>
        {
          isIndex && (
            <div class="space-y-6">
              <h1 class="max-w-4xl text-4xl font-black uppercase tracking-tight text-[var(--foreground)] md:text-6xl">
                {tr('Docs.indexTitle', 'AI Agent Skills Docs for Install, Setup & Workflow Templates')}
              </h1>
              <p class="max-w-3xl text-lg font-bold leading-8 text-[var(--foreground)]">{pageDescription}</p>
              <div class="grid grid-cols-1 gap-4 md:grid-cols-2 not-prose">
                {docsEntryLinks.map((item) => (
                  <a
                    href={item.href}
                    class="block border-4 border-[var(--foreground)] bg-[var(--card)] p-5 transition-all hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_var(--foreground)]"
                  >
                    <h2 class="mb-2 text-xl font-black uppercase tracking-tight">{item.title}</h2>
                    <p class="text-sm font-bold leading-6 opacity-80">{item.description}</p>
                  </a>
                ))}
              </div>
            </div>
          )
        }
        {
          !isIndex && (
            <div class="space-y-4">
              <h1 class="max-w-4xl text-4xl font-black uppercase tracking-tight text-[var(--foreground)] md:text-6xl">
                {docTitle}
              </h1>
              <p class="max-w-3xl text-lg font-bold leading-8 text-[var(--foreground)]">{pageDescription}</p>
              {docsLastUpdated && (
                <p class="text-xs font-black uppercase tracking-widest text-[var(--muted-foreground)]">
                  {tr('Docs.lastUpdated', 'Last updated')}: {docsLastUpdated}
                </p>
              )}
            </div>
          )
        }
      </div>

      {
        isInstallDoc && installReviewMeta && (
          <section class="mb-12 border-[4px] border-[var(--foreground)] bg-[var(--background)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--foreground)]">
            <div class="max-w-3xl mb-6">
              <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                {isZhCopy ? '页面级审查标准' : 'Page-Level Review Standard'}
              </div>
              <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight text-[var(--foreground)] mb-3">
                {isZhCopy ? '这页聚焦安装与验证，而不只是展示命令' : 'This Page Focuses On Installation And Validation'}
              </h2>
              <p class="text-base md:text-lg leading-8 font-medium text-[var(--muted-foreground)]">
                {isZhCopy
                  ? '安装页的职责是帮你完成安装、验证结果，并顺着清晰的下一步继续，而不是把页面变成内部策略说明。'
                  : 'The installation page should help you install, verify the result, and continue into a clear next step instead of exposing internal process language.'}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-8 not-prose">
              <div class="border-4 border-[var(--foreground)] bg-[var(--card)] p-4">
                <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-2">
                  {isZhCopy ? '最近复核' : 'Reviewed On'}
                </div>
                <div class="text-sm font-black leading-6">{installReviewMeta.reviewedAt}</div>
              </div>
              <div class="border-4 border-[var(--foreground)] bg-[var(--card)] p-4">
                <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-2">
                  {isZhCopy ? '维护方式' : 'Maintained By'}
                </div>
                <div class="text-sm font-black leading-6">{installReviewMeta.maintainedBy}</div>
              </div>
              <div class="border-4 border-[var(--foreground)] bg-[var(--card)] p-4">
                <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-2">
                  {isZhCopy ? '验证范围' : 'Verification Scope'}
                </div>
                <div class="text-sm font-black leading-6">{installReviewMeta.verification}</div>
              </div>
              <div class="border-4 border-[var(--foreground)] bg-[var(--card)] p-4">
                <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-2">
                  {isZhCopy ? '适用对象' : 'Primary Audience'}
                </div>
                <div class="text-sm font-black leading-6">{installReviewMeta.scope}</div>
              </div>
            </div>

            <div class="border-t-4 border-[var(--foreground)] pt-6">
              <h3 class="text-xl font-black uppercase tracking-tight text-[var(--foreground)] mb-4">
                {isZhCopy ? '这页的 3 条最低交付标准' : 'Three Minimum Standards For This Guide'}
              </h3>
              <ul class="space-y-3">
                {installReviewSignals.map((item) => (
                  <li class="text-sm md:text-base leading-7 font-medium text-[var(--muted-foreground)]">- {item}</li>
                ))}
              </ul>
            </div>
          </section>
        )
      }

      {
        isInstallDoc && installDecisionTracks.length > 0 && (
          <section class="mb-12 border-[4px] border-[var(--foreground)] bg-[var(--background)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--foreground)]">
            <div class="max-w-3xl mb-6">
              <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                {isZhCopy ? '安装轨道' : 'Installation Tracks'}
              </div>
              <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight text-[var(--foreground)] mb-3">
                {isZhCopy ? '先判断你现在处在哪一种安装阶段' : 'Start With the Installation Stage You Are Actually In'}
              </h2>
              <p class="text-base md:text-lg leading-8 font-medium text-[var(--muted-foreground)]">
                {isZhCopy
                  ? '安装页不该只给一个命令，然后把用户重新送回随机浏览。先确认你现在是来做首装、做 CLI 验证，还是要把这次安装推进成团队工作流，再沿着对应轨道往下走。'
                  : 'The install page should not dump one command and send users back into random browsing. Decide whether you are here for the first trusted install, CLI validation, or turning the install into a team workflow, then follow the matching lane.'}
              </p>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-5 not-prose">
              {installDecisionTracks.map((track) => (
                <article class="border-4 border-[var(--foreground)] bg-[var(--card)] p-5 shadow-[4px_4px_0px_0px_var(--foreground)]">
                  <div class="mb-3 text-[10px] font-black uppercase tracking-widest text-[var(--primary)]">
                    {track.badge}
                  </div>
                  <h3 class="mb-3 text-xl font-black uppercase tracking-tight text-[var(--foreground)]">
                    {track.title}
                  </h3>
                  <p class="mb-4 text-sm font-medium leading-6 text-[var(--muted-foreground)]">{track.description}</p>
                  <p class="mb-4 border-l-4 border-[var(--primary)] pl-3 text-xs font-bold leading-6 text-[var(--foreground)]/85">
                    {track.whenToUse}
                  </p>
                  <ul class="mb-5 space-y-2">
                    {track.checkpoints.map((item) => (
                      <li class="text-sm font-medium leading-6 text-[var(--muted-foreground)]">- {item}</li>
                    ))}
                  </ul>
                  <a
                    href={track.primaryHref}
                    class="inline-flex items-center border-2 border-[var(--foreground)] px-4 py-2 text-xs font-black uppercase tracking-widest text-[var(--foreground)] transition-all hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[4px_4px_0px_0px_var(--foreground)]"
                  >
                    {track.primaryLabel}
                  </a>
                </article>
              ))}
            </div>
          </section>
        )
      }

      {
        isInstallDoc && (
          <section class="mb-12 border-[4px] border-[var(--foreground)] bg-[var(--card)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--foreground)]">
            <div class="max-w-3xl mb-6">
              <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                {isZhCopy ? '安装桥梁' : 'Install Bridge'}
              </div>
              <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight text-[var(--foreground)] mb-3">
                {isZhCopy ? '从发现页继续进入 CLI 与验证' : 'Move From Discovery Into CLI Action and Validation'}
              </h2>
              <p class="text-base md:text-lg leading-8 font-medium text-[var(--muted-foreground)]">
                {isZhCopy
                  ? '安装文档不只是命令说明。它应该把你从精选发现页继续带到 CLI 执行、安装验证，以及下一批可信入口。'
                  : 'Installation docs should not stop at command syntax. They should carry users from curated discovery into CLI action, install validation, and the next trusted surfaces.'}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4 mb-8 not-prose">
              {installBridgeCards.map((item) => (
                <a
                  href={item.href}
                  class="block border-4 border-[var(--foreground)] bg-[var(--background)] p-5 transition-all hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_var(--foreground)]"
                >
                  <div class="mb-2 text-[10px] font-black uppercase tracking-widest opacity-70">{item.badge}</div>
                  <h3 class="mb-2 text-xl font-black uppercase tracking-tight">{item.title}</h3>
                  <p class="text-sm font-bold leading-6 opacity-80">{item.description}</p>
                </a>
              ))}
            </div>

            <div class="border-t-4 border-[var(--foreground)] pt-6">
              <h3 class="text-xl font-black uppercase tracking-tight text-[var(--foreground)] mb-4">
                {isZhCopy ? '安装后验证清单' : 'Post-Install Validation Checklist'}
              </h3>
              <ol class="space-y-3">
                {installValidationSteps.map((step, index) => (
                  <li class="text-sm md:text-base leading-7 font-medium text-[var(--muted-foreground)]">
                    {index + 1}. {step}
                  </li>
                ))}
              </ol>
            </div>
          </section>
        )
      }

      {
        currentSlug === 'cli/overview' && (
          <div class="mb-16 space-y-16 not-prose">
            <TerminalWindow locale={locale} t={t} />
            <ComparisonTable t={t} />
          </div>
        )
      }

      {
        docContent ? (
          /* Render markdown content from KV with Brutalist Typography */
          <article
            class="prose prose-lg max-w-none 
          dark:prose-invert
          
          prose-headings:font-black prose-headings:tracking-tighter prose-headings:uppercase
          prose-h1:text-[var(--foreground)] prose-h2:text-[var(--foreground)] prose-h3:text-[var(--foreground)]
          prose-h2:border-b-[3px] prose-h2:border-[var(--border)] prose-h2:pb-2 prose-h2:mt-12
          
          prose-p:text-[var(--muted-foreground)] prose-p:font-medium prose-p:leading-relaxed
          prose-strong:text-[var(--foreground)] prose-strong:font-black
          
          prose-a:text-[var(--foreground)] prose-a:font-bold prose-a:underline prose-a:decoration-[var(--primary)] prose-a:decoration-4 hover:prose-a:bg-[var(--primary)] hover:prose-a:text-[var(--primary-foreground)] hover:prose-a:no-underline transition-colors
          
          prose-blockquote:border-l-4 prose-blockquote:border-[var(--primary)] prose-blockquote:bg-[var(--card)] prose-blockquote:p-6 prose-blockquote:text-[var(--foreground)] prose-blockquote:font-mono prose-blockquote:font-bold prose-blockquote:shadow-[4px_4px_0px_0px_var(--border)]
          
          prose-ul:list-square prose-li:text-[var(--muted-foreground)] prose-li:font-medium
          
          prose-img:border-4 prose-img:border-[var(--foreground)] prose-img:shadow-[4px_4px_0px_0px_var(--foreground)] prose-img:rounded-none prose-img:mt-8 prose-img:mb-8
          
          prose-pre:rounded-none prose-pre:border-4 prose-pre:border-[var(--foreground)] prose-pre:shadow-[8px_8px_0px_0px_var(--foreground)] prose-pre:bg-white dark:prose-pre:bg-[#0a0a0a] prose-pre:text-[var(--foreground)] prose-pre:p-6 prose-pre:my-8 prose-pre:whitespace-pre-wrap prose-pre:break-words
          [&_p>code]:text-[var(--foreground)] [&_p>code]:bg-[var(--muted)] [&_p>code]:px-1.5 [&_p>code]:py-0.5 [&_p>code]:font-bold [&_p>code]:border-2 [&_p>code]:border-[var(--border)]
          [&_li>code]:text-[var(--foreground)] [&_li>code]:bg-[var(--muted)] [&_li>code]:px-1.5 [&_li>code]:py-0.5 [&_li>code]:font-bold [&_li>code]:border-2 [&_li>code]:border-[var(--border)]
        "
            set:html={docContent}
          />
        ) : isIndex ? (
          /* Index Default Content (Simulating 'Getting Started') */
          <article
            class="prose prose-lg max-w-none 
          dark:prose-invert
          prose-headings:font-black prose-headings:tracking-tighter prose-headings:uppercase
          prose-h2:text-[var(--foreground)] prose-h2:border-b-[3px] prose-h2:border-[var(--border)] prose-h2:pb-2
          prose-p:text-[var(--muted-foreground)] prose-p:font-medium
        "
          >
            <p class="text-xl font-bold text-[var(--foreground)] leading-relaxed mb-10">
              {tr(
                'Docs.welcomeText',
                'Welcome to the Killer-Skills docs. Learn how to install AI agent skills, configure your IDE, and bring reusable workflows into daily development.',
              )}
            </p>

            <div class="my-10 p-8 bg-[var(--card)] border-4 border-[var(--foreground)] shadow-[8px_8px_0px_0px_var(--foreground)] not-prose">
              <h3 class="text-2xl font-black text-[var(--foreground)] uppercase mb-4 flex items-center gap-3">
                <Rocket className="w-8 h-8 text-[var(--primary)]" strokeWidth={3} />
                {tr('Docs.startFirstSkill', 'Start with Your First Skill')}
              </h3>
              <p class="text-[var(--muted-foreground)] font-bold mb-6 text-lg">
                {tr(
                  'Docs.addFirstSkill',
                  'Add your first AI agent skill to your development environment with one command.',
                )}
              </p>
              <div class="flex gap-2 relative">
                <code class="flex-1 bg-black text-[#00ffcc] border-4 border-black px-6 py-4 font-mono font-bold text-lg overflow-x-auto shadow-[4px_4px_0px_0px_var(--primary)]">
                  npx killer-skills add owner/repo
                </code>
              </div>
            </div>

            <h2 class="mt-16 mb-8 text-4xl">{tr('Docs.keyConcepts', 'Key Concepts')}</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 not-prose">
              <a
                href={`/${locale}/docs/concepts/skills`}
                class="block p-6 bg-[var(--card)] border-4 border-[var(--foreground)] hover:bg-[var(--primary)] group transition-all hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_var(--foreground)]"
              >
                <h3 class="text-2xl font-black uppercase tracking-tight text-[var(--foreground)] group-hover:text-[var(--primary-foreground)] mb-2">
                  {tr('Docs.skills', 'Skills')}
                </h3>
                <p class="font-mono font-bold text-sm text-[var(--muted-foreground)] group-hover:text-[var(--primary-foreground)] opacity-90 uppercase">
                  {tr('Docs.skillsDesc', 'Reusable instruction units for AI agents')}
                </p>
              </a>
              <a
                href={`/${locale}/docs/concepts/workflows`}
                class="block p-6 bg-[var(--card)] border-4 border-[var(--foreground)] hover:bg-[var(--primary)] group transition-all hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_var(--foreground)]"
              >
                <h3 class="text-2xl font-black uppercase tracking-tight text-[var(--foreground)] group-hover:text-[var(--primary-foreground)] mb-2">
                  {tr('Docs.workflows', 'Workflows')}
                </h3>
                <p class="font-mono font-bold text-sm text-[var(--muted-foreground)] group-hover:text-[var(--primary-foreground)] opacity-90 uppercase">
                  {tr('Docs.workflowsDesc', 'Repeatable multi-step automation patterns')}
                </p>
              </a>
            </div>
          </article>
        ) : (
          /* Content Not Found / Coming Soon */
          <div class="py-20">
            <div class="p-12 bg-[var(--muted)] border-4 border-dashed border-[var(--foreground)] text-center shadow-[12px_12px_0px_0px_var(--border)]">
              <FileText className="w-16 h-16 text-[var(--foreground)] mx-auto mb-6" strokeWidth={1} />
              <h3 class="text-3xl font-black text-[var(--foreground)] uppercase tracking-tighter mb-4">
                Content Coming Soon
              </h3>
              <p class="text-[var(--muted-foreground)] font-bold mb-8 text-lg px-4">
                This section "{docTitle}" is currently being engraved into stone.
              </p>
              <a
                href={`/${locale}/docs`}
                class="inline-flex items-center px-6 py-3 bg-[var(--foreground)] text-[var(--background)] font-black uppercase tracking-widest hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-colors border-2 border-[var(--foreground)]"
              >
                {returnToIntroductionLabel}
              </a>
            </div>
          </div>
        )
      }

      {
        isIndex && (
          <section class="mt-16 grid grid-cols-1 gap-4 md:grid-cols-3">
            {docsFaqItems.map((item) => (
              <article class="border-4 border-[var(--foreground)] bg-[var(--card)] p-5 shadow-[4px_4px_0px_0px_var(--foreground)]">
                <h2 class="mb-3 text-lg font-black uppercase tracking-tight text-[var(--foreground)]">
                  {item.question}
                </h2>
                <p class="text-sm font-bold leading-6 text-[var(--muted-foreground)]">{item.answer}</p>
              </article>
            ))}
          </section>
        )
      }
      {
        isInstallationPage && (
          <section class="mt-16 border-[4px] border-[var(--foreground)] bg-[var(--card)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--foreground)]">
            <div class="max-w-3xl mb-6">
              <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                {isZhCopy ? '下一步路径' : 'Next-Step Paths'}
              </div>
              <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight text-[var(--foreground)] mb-3">
                {isZhCopy
                  ? '安装不是终点，而是进入可信使用路径的入口'
                  : 'Installation Is the Start of a Trusted Usage Path'}
              </h2>
              <p class="text-base md:text-lg leading-8 font-medium text-[var(--muted-foreground)]">
                {isZhCopy
                  ? '当安装完成后，下一步不应该重新回到随机浏览。你应该沿着合集、方案页和 CLI 说明，把一次性安装变成可复用的团队路径。'
                  : 'After installation, the next move should not be random browsing again. Continue into collections, solution pages, and CLI guidance so a one-off install becomes a reusable team path.'}
              </p>
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-2 not-prose">
              {installNextStepCards.map((item) => (
                <a
                  href={item.href}
                  class="block border-4 border-[var(--foreground)] bg-[var(--background)] p-5 transition-all hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_var(--foreground)]"
                >
                  <div class="mb-2 text-[10px] font-black uppercase tracking-widest opacity-70">{item.badge}</div>
                  <h3 class="mb-2 text-xl font-black uppercase tracking-tight">{item.title}</h3>
                  <p class="text-sm font-bold leading-6 opacity-80">{item.description}</p>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {/* Footer inside content area */}
      <div class="mt-24 pt-8 border-t-4 border-[var(--foreground)]">
        <Footer locale={locale} messages={messages || {}} compact />
      </div>
    </main>

    {/* Mobile Overlay */}
    <div
      id="repo-overlay"
      class="fixed inset-0 z-20 bg-black/80 opacity-0 pointer-events-none transition-opacity duration-300 md:hidden backdrop-blur-sm"
    >
    </div>
  </div>
</Layout>

<script is:inline>
  // Mobile menu logic
  const mobileBtn = document.getElementById('mobile-menu-btn');
  const closeBtn = document.getElementById('close-sidebar-btn');
  const sidebar = document.getElementById('docs-sidebar');
  const overlay = document.getElementById('repo-overlay');

  function toggleMenu() {
    const isClosed = sidebar?.classList.contains('-translate-x-full');
    if (isClosed) {
      sidebar?.classList.remove('-translate-x-full');
      overlay?.classList.remove('opacity-0', 'pointer-events-none');
    } else {
      sidebar?.classList.add('-translate-x-full');
      overlay?.classList.add('opacity-0', 'pointer-events-none');
    }
  }

  mobileBtn?.addEventListener('click', toggleMenu);
  closeBtn?.addEventListener('click', toggleMenu);
  overlay?.addEventListener('click', toggleMenu);

  // Copy Code Block Logic
  function addCopyButtons() {
    const preBlocks = document.querySelectorAll('article pre');

    preBlocks.forEach((pre) => {
      // Prevent duplicate processing
      if (pre.closest('.code-block-wrapper')) return;

      // Create wrapper
      const wrapper = document.createElement('div');
      wrapper.className = 'code-block-wrapper relative group my-6';

      // Insert wrapper before pre
      if (pre.parentNode) {
        pre.parentNode.insertBefore(wrapper, pre);

        // Remove margins from pre to avoid double spacing
        style.marginTop = '0';
        style.marginBottom = '0';

        // Move pre into wrapper
        wrapper.appendChild(pre);

        // Create Button
        const btn = document.createElement('button');
        // Visible by default (opacity-60), full opacity on hover
        btn.className =
          'copy-btn absolute top-3 right-3 w-8 h-8 flex items-center justify-center rounded-lg bg-white/70 dark:bg-slate-800/60 text-slate-500 dark:text-slate-400 hover:bg-white hover:text-cyan-600 dark:hover:bg-slate-700 dark:hover:text-cyan-400 border border-slate-200/60 dark:border-slate-700/60 backdrop-blur-md transition-all duration-200 shadow-sm opacity-0 group-hover:opacity-100 focus:opacity-100 z-10';
        btn.setAttribute('aria-label', 'Copy to clipboard');

        // Clean, thin stroke Icon
        const copyIcon = `
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"/>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/>
          </svg>
        `;

        const checkIcon = `
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="text-emerald-500 dark:text-emerald-400">
            <polyline points="20 6 9 17 4 12"/>
          </svg>
        `;

        btn.innerHTML = copyIcon;

        btn.addEventListener('click', async () => {
          try {
            const code = innerText || innerText;

            // Success State (Synchronous visual feedback for better INP)
            btn.innerHTML = checkIcon;
            btn.classList.add('border-emerald-500/30', 'bg-emerald-50/50', 'dark:bg-emerald-900/20');

            await navigator.clipboard.writeText(code);

            setTimeout(() => {
              btn.innerHTML = copyIcon;
              btn.classList.remove('border-emerald-500/30', 'bg-emerald-50/50', 'dark:bg-emerald-900/20');
            }, 2000);
          } catch (err) {
            console.error('Failed to copy!', err);
            // Revert state on error
            btn.innerHTML = copyIcon;
            btn.classList.remove('border-emerald-500/30', 'bg-emerald-50/50', 'dark:bg-emerald-900/20');
          }
        });

        // Append button to wrapper (sibling of pre)
        wrapper.appendChild(btn);
      }
    });
  }

  // Initialize on load and after Astro swaps (if using view transitions)
  addCopyButtons();
  document.addEventListener('astro:page-load', addCopyButtons);
</script>

<style>
  @reference "../../../styles/global.css";

  /* Fix code block styling by resetting prose-code styles inside pre */
  article :global(pre code) {
    background-color: transparent !important;
    color: inherit !important;
    padding: 0 !important;
    border-radius: 0 !important;
    font-weight: inherit !important;
  }

  article :global(.lead) {
    color: var(--foreground);
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.8;
  }

  /* Show copy button on hover */
  article :global(pre):hover .copy-btn,
  article :global(pre) .copy-btn:focus {
    opacity: 1;
  }
</style>
