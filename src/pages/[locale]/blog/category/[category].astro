---
import { getCollection } from 'astro:content';
import Layout from '../../../../layouts/Layout.astro';
import BlogCard from '../../../../components/blog/BlogCard.astro';
import { SUPPORTED_LOCALES, loadMessages, translateOr, useTranslations, type Locale } from '../../../../i18n';
import { buildKeywordString, type KeywordClusterId } from '../../../../lib/seo-keywords';
import { getBlogIntentLinks } from '../../../../lib/blog-seo-intent';
import { ArrowLeft, Tags, Palette, FileText, Building2, Terminal } from 'lucide-react';

export const prerender = true;

export function getStaticPaths() {
  const BLOG_CATEGORIES = ['document-automation', 'developer-experience', 'enterprise-solutions', 'creative-tools'];
  return SUPPORTED_LOCALES.flatMap((locale) => BLOG_CATEGORIES.map((category) => ({ params: { locale, category } })));
}

const categoryIcons = {
  'creative-tools': Palette,
  'document-automation': FileText,
  'enterprise-solutions': Building2,
  'developer-experience': Terminal,
};

const { locale, category } = Astro.params;

if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale) || !category) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Get posts for current locale and category
let posts = await getCollection('blog', ({ data }) => {
  return data.lang === locale && data.category === category && !data.draft;
});

// Fallback to English if no posts found
if (posts.length === 0 && locale !== 'en') {
  posts = await getCollection('blog', ({ data }) => {
    return data.lang === 'en' && data.category === category && !data.draft;
  });
}

if (posts.length === 0) {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

// Sort by date desc
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const messages = await loadMessages(locale as Locale);
const t = useTranslations(messages);
const tr = (key: string, fallback: string) => translateOr(messages, key, fallback);

const categoryName = tr(`Blog.categories.${category}`, category || '');
const categorySeoTitles: Record<string, { en: string; zh: string }> = {
  'document-automation': {
    en: 'Document Automation Guides for PDF, Excel & Templates',
    zh: 'PDF、Excel 与模板文档自动化指南',
  },
  'developer-experience': {
    en: 'Developer Workflow Guides for Cursor & Claude Code',
    zh: 'Cursor 与 Claude Code 开发工作流指南',
  },
  'enterprise-solutions': {
    en: 'Process Automation & Team Workflow Guides',
    zh: '流程自动化与团队工作流指南',
  },
  'creative-tools': {
    en: 'Creative Workflow & Design Automation Guides',
    zh: '创意工作流与设计自动化指南',
  },
};
const categorySeoDescriptions: Record<string, { en: string; zh: string }> = {
  'document-automation': {
    en: 'Explore document automation guides for PDF, Excel, DOCX, and reusable templates with practical AI agent skills and workflow patterns.',
    zh: '浏览 PDF、Excel、DOCX 与模板自动化指南，获取可直接落地的 AI Agent Skills 与工作流实践。',
  },
  'developer-experience': {
    en: 'Explore developer workflow guides for Cursor, Claude Code, and installable AI agent skills with practical setup steps.',
    zh: '浏览面向 Cursor、Claude Code 的开发工作流指南，获取可安装 AI Agent Skills 的配置与实战步骤。',
  },
  'enterprise-solutions': {
    en: 'Explore process automation and team workflow guides for enterprise use cases, repeatable operations, and deployable AI agent skills.',
    zh: '浏览流程自动化与团队协作工作流指南，获取适合企业场景的可复用 AI Agent Skills 与部署实践。',
  },
  'creative-tools': {
    en: 'Explore creative workflow and design automation guides with practical AI agent skills for content, assets, and visual production.',
    zh: '浏览创意工作流与设计自动化指南，获取适合内容生产与视觉创作的 AI Agent Skills 实战用法。',
  },
};
const pageTitle = categorySeoTitles[category || '']
  ? tr(`BlogCategory.seoTitle.${category}`, categorySeoTitles[category || ''].en)
  : `${categoryName}: ${tr('BlogCategory.guideSuffix', 'AI Agent Skill Guides')}`;
const pageDescription = categorySeoDescriptions[category || '']
  ? tr(`BlogCategory.seoDesc.${category}`, categorySeoDescriptions[category || ''].en)
  : tr(
      `Blog.categories.${category}-desc`,
      `Explore ${categoryName} articles about AI agent skills, with practical tutorials and implementation guides.`,
    );
const categoryKeywordClusters: Record<string, KeywordClusterId[]> = {
  'document-automation': ['documentAutomation', 'workflowAutomation'],
  'developer-experience': ['developerExperience', 'workflowAutomation'],
  'enterprise-solutions': ['enterpriseWorkflows', 'processAutomation'],
  'creative-tools': ['creativeWorkflows', 'workflowAutomation'],
};
const pageKeywords = buildKeywordString(
  t,
  'core',
  'ideCompat',
  ...(categoryKeywordClusters[category || ''] || ['workflowAutomation']),
  categoryName,
  `${categoryName} ai agent`,
  ...[tr('BlogCategory.implementGuide', 'implementation guide')],
);
const canonicalUrl = `https://killer-skills.com/${locale}/blog/category/${category}`;
const CategoryIcon = categoryIcons[category as keyof typeof categoryIcons] || Tags;
const otherCategories = Object.keys(categoryIcons).filter((k) => k !== category);
const intentLinks = getBlogIntentLinks(locale || 'en', category, category || '', t);
const faqItems = [
  {
    question: tr('BlogCategory.faq1Q', `What does the ${categoryName} category cover?`),
    answer: pageDescription,
  },
  {
    question: tr('BlogCategory.faq2Q', 'Are these guides practical to implement?'),
    answer: tr(
      'BlogCategory.faq2A',
      'Yes. These guides prioritize installation, setup, templates, workflows, and concrete skill usage instead of abstract overviews.',
    ),
  },
  {
    question: tr('BlogCategory.faq3Q', 'Where should I go after reading these guides?'),
    answer: tr(
      'BlogCategory.faq3A',
      'You can continue into skills search results, installation docs, the CLI page, or workflow collections based on the task you want to solve.',
    ),
  },
];
---

<Layout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  customCanonical={canonicalUrl}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: tr('Common.home', 'Home'),
            item: `https://killer-skills.com/${locale}`,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: tr('Blog.title', 'Blog'),
            item: `https://killer-skills.com/${locale}/blog`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: categoryName,
            item: canonicalUrl,
          },
        ],
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: `${categoryName} — Killer-Skills Blog`,
        description: pageDescription,
        url: canonicalUrl,
        isPartOf: { '@type': 'WebSite', name: 'Killer-Skills', url: 'https://killer-skills.com' },
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: sortedPosts.length,
          itemListElement: sortedPosts.slice(0, 10).map((post, i) => {
            const slug = post.id.split('/').slice(1).join('/').replace(/\.md$/, '');
            return {
              '@type': 'ListItem',
              position: i + 1,
              url: `https://killer-skills.com/${locale}/blog/${slug}`,
            };
          }),
        },
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: pageTitle,
        description: pageDescription,
        url: canonicalUrl,
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['h1', '.seo-intro-paragraph', 'h2'],
        },
      })}
    />
  </Fragment>
  <div class="min-h-screen bg-[var(--background)] text-[var(--foreground)] font-sans">
    <main class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-24">
      {/* Breadcrumb / Back */}
      <a
        href={`/${locale}/blog`}
        class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--foreground)] text-[var(--background)] font-bold text-xs uppercase border-2 border-[var(--foreground)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[4px_4px_0px_0px_var(--foreground)] transition-all mb-12"
      >
        <ArrowLeft size={16} strokeWidth={3} />
        {tr('Common.back', 'Back')}
      </a>

      {/* Header */}
      <header
        class="mb-16 md:mb-24 text-center max-w-4xl mx-auto border-4 border-[var(--foreground)] bg-[var(--card)] p-8 md:p-16 shadow-[8px_8px_0px_0px_var(--foreground)]"
      >
        <div
          class="inline-flex items-center justify-center p-3 border-2 border-[var(--foreground)] bg-[var(--primary)] text-[var(--primary-foreground)] mb-6 shadow-[2px_2px_0px_0px_var(--foreground)]"
        >
          <CategoryIcon size={32} strokeWidth={2.5} />
        </div>
        <h1 class="text-4xl md:text-6xl font-black tracking-tighter mb-6 text-[var(--foreground)] uppercase">
          {categoryName}
        </h1>
        <p class="text-lg md:text-xl text-[var(--muted-foreground)] font-bold max-w-2xl mx-auto leading-relaxed">
          {pageDescription}
        </p>
      </header>

      <section class="mb-12 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          intentLinks.map((item) => (
            <a
              href={item.href}
              class="block border-4 border-[var(--foreground)] bg-[var(--card)] p-5 transition-all hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_var(--foreground)]"
            >
              <h2 class="mb-2 text-lg font-black uppercase tracking-tight">{item.title}</h2>
              <p class="text-sm font-bold leading-6 opacity-80">{item.description}</p>
            </a>
          ))
        }
      </section>

      {/* Post Grid */}
      {
        sortedPosts.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {sortedPosts.map((post) => (
              <div class="h-full">
                <BlogCard post={post} locale={locale || 'en'} />
              </div>
            ))}
          </div>
        ) : (
          <div class="text-center py-24 bg-[var(--muted)] border-4 border-[var(--border)] border-dashed">
            <p class="text-[var(--muted-foreground)] font-mono font-bold text-xl">
              {tr('Marketplace.noSkills', 'No articles found in this category.')}
            </p>
          </div>
        )
      }

      <section class="mt-16 grid grid-cols-1 gap-4 md:grid-cols-3">
        {
          faqItems.map((item) => (
            <article class="border-4 border-[var(--foreground)] bg-[var(--card)] p-5 shadow-[4px_4px_0px_0px_var(--foreground)]">
              <h2 class="mb-3 text-lg font-black uppercase tracking-tight text-[var(--foreground)]">{item.question}</h2>
              <p class="text-sm font-bold leading-6 text-[var(--muted-foreground)]">{item.answer}</p>
            </article>
          ))
        }
      </section>

      {/* Other Categories Cross-Linking */}
      {
        otherCategories.length > 0 && (
          <section class="mt-16">
            <h2 class="text-2xl font-black uppercase tracking-tight mb-6">
              {tr('BlogCategory.otherCategories', 'Explore Other Categories')}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {otherCategories.map((cat) => {
                const OtherIcon = categoryIcons[cat as keyof typeof categoryIcons] || Tags;
                const catName = tr(`Blog.categories.${cat}`, cat);
                return (
                  <a
                    href={`/${locale}/blog/category/${cat}`}
                    class="block border-2 border-[var(--border)] bg-[var(--card)] p-4 hover:-translate-y-1 hover:shadow-[4px_4px_0px_0px_var(--border)] transition-all"
                  >
                    <div class="flex items-center gap-2 mb-2">
                      <OtherIcon size={18} strokeWidth={2.5} />
                      <span class="font-black uppercase tracking-tight text-sm">{catName}</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </section>
        )
      }
    </main>
  </div>
</Layout>
