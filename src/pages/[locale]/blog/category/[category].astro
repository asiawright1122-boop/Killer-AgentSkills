---
import Layout from '../../../../layouts/Layout.astro';
import MarketplaceSimplePage from '../../../../components/MarketplaceSimplePage.astro';
import { SUPPORTED_LOCALES, loadMessages, translateOr, type Locale } from '../../../../i18n';

const { locale, category } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const isZhCopy = locale.startsWith('zh');
const messages = await loadMessages(locale as Locale);
const categoryLabel = translateOr(messages, `Blog.categories.${category}`, category || 'AI Agent Skills');
const title = translateOr(
  messages,
  `BlogCategory.seoTitle.${category}`,
  isZhCopy ? `${categoryLabel}：AI 智能体技能指南` : `${categoryLabel} AI Agent Skill Guides`,
);
const description = translateOr(
  messages,
  `BlogCategory.seoDesc.${category}`,
  isZhCopy
    ? `浏览${categoryLabel}相关的 AI 智能体技能、工作流和自动化指南。`
    : `Explore ${categoryLabel.toLowerCase()} guides with practical AI agent skills and workflow patterns.`,
);
---

<Layout locale={locale} title={title} description={description} appendBrand={false}>
  <MarketplaceSimplePage title={title} description={description}>
    <div class="marketplace-card-grid">
      <a class="marketplace-card-link" href={`/${locale}/article`}>
        <h3>{isZhCopy ? '文章列表' : 'Articles'}</h3>
        <p>{categoryLabel}</p>
      </a>
      <a class="marketplace-card-link" href={`/${locale}/skills?q=${encodeURIComponent(category || '')}`}>
        <h3>Skills</h3>
        <p>{isZhCopy ? '按分类关键词筛选 Skills。' : 'Filter skills by this category keyword.'}</p>
      </a>
    </div>
  </MarketplaceSimplePage>
</Layout>
