---
import Layout from '../../../../layouts/Layout.astro';
import MarketplaceSimplePage from '../../../../components/MarketplaceSimplePage.astro';
import { SUPPORTED_LOCALES, type Locale } from '../../../../i18n';

const { locale, category } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const isZhCopy = locale.startsWith('zh');
const title = isZhCopy ? '文章分类' : 'Article Category';
const description = isZhCopy ? '按关键词进入文章或 Skills。' : 'Use the keyword across articles or skills.';
---

<Layout locale={locale} title={title} description={description} appendBrand={false}>
  <MarketplaceSimplePage title={title} description={description}>
    <div class="marketplace-card-grid">
      <a class="marketplace-card-link" href={`/${locale}/article`}>
        <h3>{isZhCopy ? '文章列表' : 'Articles'}</h3>
        <p>{category}</p>
      </a>
      <a class="marketplace-card-link" href={`/${locale}/skills?q=${encodeURIComponent(category || '')}`}>
        <h3>Skills</h3>
        <p>{isZhCopy ? '按分类关键词筛选 Skills。' : 'Filter skills by this category keyword.'}</p>
      </a>
    </div>
  </MarketplaceSimplePage>
</Layout>
