---
import { getCollection, render } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { ArrowLeft, Calendar, User, Clock, Share2 } from 'lucide-react';
import { SUPPORTED_LOCALES, type Locale, loadMessages, useTranslations } from '../../../i18n';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  console.log('DEBUG: Blog posts found:', posts.length);
  if (posts.length > 0) {
      console.log('DEBUG: Sample post id:', posts[0].id);
      console.log('DEBUG: Sample post data:', JSON.stringify(posts[0].data));
  }
  return posts.map((post) => {
    const [lang, ...slugParts] = post.id.split('/');
    const slug = slugParts.join('/').replace(/\.md$/, '');

    return {
      params: { locale: lang, slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { locale } = Astro.params;
const { Content, headings } = await render(post);
const messages = await loadMessages(locale as Locale);
const t = useTranslations(messages);
const tb = messages.Blog;

const dateOptions: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};
const formattedDate = post.data.pubDate.toLocaleDateString(locale, dateOptions);

// Estimate read time (rough)
const wordCount = post.body.split(/\s+/g).length;
const readTime = Math.ceil(wordCount / 200);
// OG Image Generation (Dynamic V2)
const ogImageParams = new URLSearchParams({
  type: 'blog',
  title: post.data.title,
  description: post.data.description,
  author: post.data.author,
  date: formattedDate,
  readingTime: readTime.toString(),
});
const ogImage = `http://146.235.234.248:3000/?${ogImageParams.toString()}`;

// BlogPosting Structured Data (JSON-LD) for rich snippets
const blogSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": post.data.title,
  "description": post.data.description,
  "author": {
    "@type": "Person",
    "name": post.data.author,
  },
  "datePublished": post.data.pubDate.toISOString(),
  "image": post.data.heroImage || ogImage,
  "url": `https://killer-skills.com/${locale}/blog/${Astro.params.slug}`,
  "publisher": {
    "@type": "Organization",
    "name": "Killer-Skills",
    "url": "https://killer-skills.com",
  },
  "wordCount": wordCount,
  "inLanguage": locale,
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://killer-skills.com/${locale}/blog/${Astro.params.slug}`,
  },
};
---

<Layout 
    locale={locale || 'en'}
    title={post.data.title} 
    description={post.data.description}
    image={ogImage}
    ogType="article"
>
    <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} slot="head" />
    {/* Reading Progress Bar */}
    <div class="fixed top-0 left-0 w-full h-1 z-50 bg-transparent">
        <div id="progress-bar" class="h-full bg-gradient-to-r from-sky-500 to-cyan-500 dark:from-purple-500 dark:to-cyan-500 w-0 transition-all duration-100 ease-out"></div>
    </div>

    <div class="min-h-screen bg-[var(--background)] text-[var(--foreground)] font-sans">
        
        <main class="relative z-10 pt-12 md:pt-24 pb-20 border-b-[3px] border-[var(--border)]">
            <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-[1fr_300px] gap-12 items-start">
                
                {/* Article Content Column */}
                <article class="min-w-0 mx-auto w-full max-w-3xl">
                    
                    {/* Breadcrumb / Back */}
                    <a href={`/${locale}/blog`} class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--foreground)] text-[var(--background)] font-black text-xs uppercase tracking-widest border-2 border-[var(--foreground)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[4px_4px_0px_0px_var(--foreground)] transition-all mb-12">
                        <ArrowLeft size={16} strokeWidth={3} />
                        {t('Common.back') || 'Back'}
                    </a>

                    {/* Header */}
                    <header class="mb-12 border-b-4 border-[var(--foreground)] pb-12">
                        <div class="flex items-center gap-3 mb-8">
                            {post.data.tags && post.data.tags.map(tag => (
                                <span class="px-3 py-1 font-mono text-xs font-bold uppercase tracking-widest bg-[var(--foreground)] text-[var(--background)] border-2 border-[var(--foreground)]">
                                    [{tag}]
                                </span>
                            ))}
                        </div>

                        <div class="flex flex-wrap items-center gap-6 font-mono font-bold text-sm text-[var(--muted-foreground)] uppercase tracking-wider">
                            <div class="flex items-center gap-2">
                                <div class="w-8 h-8 flex items-center justify-center text-xs text-[var(--background)] bg-[var(--foreground)] font-black border-2 border-[var(--foreground)]">
                                    {post.data.author.charAt(0).toUpperCase()}
                                </div>
                                <span class="text-[var(--foreground)]">{post.data.author}</span>
                            </div>
                            <div class="flex items-center gap-2">
                                <Calendar size={18} strokeWidth={2.5} />
                                <time>{formattedDate}</time>
                            </div>
                             <div class="flex items-center gap-2">
                                <Clock size={18} strokeWidth={2.5} />
                                <span>{tb.readTime.replace('{n}', readTime.toString())}</span>
                            </div>
                        </div>
                    </header>

                    {/* Hero Image */}
                    {post.data.heroImage && (
                        <div class="mb-12 border-4 border-[var(--foreground)] bg-[var(--primary)] shadow-[8px_8px_0px_0px_var(--foreground)] aspect-video relative group overflow-hidden">
                            <img 
                                src={post.data.heroImage} 
                                alt={post.data.title} 
                                class="w-full h-full object-cover opacity-90 hover:opacity-100 transition-all duration-500 hover:scale-105"
                            />
                        </div>
                    )}

                    {/* Post Body (Typography Brutalist Overrides) */}
                    <div class="
                        prose prose-lg max-w-none 
                        dark:prose-invert
                        
                        prose-headings:font-black prose-headings:tracking-tighter prose-headings:uppercase
                        prose-h1:text-[var(--foreground)] prose-h2:text-[var(--foreground)] prose-h3:text-[var(--foreground)]
                        prose-h2:border-b-[3px] prose-h2:border-[var(--border)] prose-h2:pb-2
                        
                        prose-p:text-[var(--muted-foreground)] prose-p:font-medium prose-p:leading-relaxed
                        prose-strong:text-[var(--foreground)] prose-strong:font-black
                        
                        prose-a:text-[var(--foreground)] prose-a:font-bold prose-a:underline prose-a:decoration-[var(--primary)] prose-a:decoration-4 hover:prose-a:bg-[var(--primary)] hover:prose-a:text-[var(--primary-foreground)] hover:prose-a:no-underline transition-colors
                        
                        prose-blockquote:border-l-4 prose-blockquote:border-[var(--primary)] prose-blockquote:bg-[var(--card)] prose-blockquote:p-6 prose-blockquote:text-[var(--foreground)] prose-blockquote:font-mono prose-blockquote:font-bold prose-blockquote:shadow-[4px_4px_0px_0px_var(--border)]
                        
                        prose-ul:list-square prose-li:text-[var(--muted-foreground)] prose-li:font-medium
                        
                        prose-img:border-4 prose-img:border-[var(--foreground)] prose-img:shadow-[4px_4px_0px_0px_var(--foreground)] prose-img:rounded-none
                        
                        prose-pre:rounded-none prose-pre:border-4 prose-pre:border-[var(--foreground)] prose-pre:shadow-[8px_8px_0px_0px_var(--foreground)] prose-pre:bg-white dark:prose-pre:bg-[#0a0a0a] prose-pre:text-[var(--foreground)] prose-pre:p-6 prose-pre:my-8 prose-pre:whitespace-pre-wrap prose-pre:break-words
                        [&_p>code]:text-[var(--foreground)] [&_p>code]:bg-[var(--muted)] [&_p>code]:px-1.5 [&_p>code]:py-0.5 [&_p>code]:font-bold [&_p>code]:border-2 [&_p>code]:border-[var(--border)]
                        [&_li>code]:text-[var(--foreground)] [&_li>code]:bg-[var(--muted)] [&_li>code]:px-1.5 [&_li>code]:py-0.5 [&_li>code]:font-bold [&_li>code]:border-2 [&_li>code]:border-[var(--border)]
                    ">
                        <Content />
                    </div>

                    {/* Footer / Share */}
                    <div class="mt-20 pt-8 border-t-[3px] border-[var(--border)] flex items-center justify-between">
                         <div class="font-mono font-bold text-sm text-[var(--muted-foreground)] uppercase">
                            Published in <span class="text-[var(--foreground)] px-2 py-1 bg-[var(--primary)] border-2 border-[var(--border)]">{locale === 'en' ? 'English' : 'Chinese'}</span>
                         </div>
                         <button class="flex items-center gap-2 px-6 py-3 border-2 border-[var(--foreground)] bg-[var(--card)] text-[var(--foreground)] font-black uppercase tracking-widest hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:shadow-[4px_4px_0px_0px_var(--foreground)] hover:translate-x-[-2px] hover:translate-y-[-2px] transition-all">
                            <Share2 size={18} strokeWidth={2.5} />
                            {t('Aria.shareSkill') ? t('Aria.shareSkill').replace(' this skill', '') : 'Share'}
                         </button>
                    </div>

                </article>

                {/* Sidebar (TOC) */}
                <aside class="hidden lg:block sticky top-24 space-y-8">
                    
                    {/* Table of Contents */}
                    <div class="p-6 bg-[var(--card)] border-4 border-[var(--foreground)] shadow-[8px_8px_0px_0px_var(--foreground)]">
                        <h3 class="text-xl font-black uppercase tracking-tighter text-[var(--foreground)] mb-6 border-b-2 border-[var(--border)] pb-2">{t('Docs.tableOfContents')}</h3>
                        <nav>
                            <ul class="space-y-3 text-sm font-mono font-bold">
                                {headings.map(heading => (
                                    <li class={`pl-${(heading.depth - 1) * 3}`}>
                                        <a 
                                            href={`#${heading.slug}`} 
                                            class="block text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:translate-x-1 transition-transform line-clamp-1"
                                        >
                                            <span class="text-[var(--primary)] mr-2">></span>
                                            {heading.text}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </nav>
                    </div>

                </aside>
            </div>
        </main>
    </div>

    <script is:inline>
        // Reading Progress Bar
        const progressBar = document.getElementById('progress-bar');
        window.addEventListener('scroll', () => {
            const scrollTop = window.scrollY || document.documentElement.scrollTop;
            const scrollHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
            const scrolled = (scrollTop / scrollHeight) * 100;
            if (progressBar) {
                progressBar.style.width = scrolled + '%';
            }
        }, { passive: true });
    </script>
</Layout>
