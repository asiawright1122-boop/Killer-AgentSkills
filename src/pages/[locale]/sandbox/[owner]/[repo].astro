---
import { SUPPORTED_LOCALES, type Locale } from '../../../../i18n';
import { resolveSkillDetailLink } from '../../../../lib/skill-detail-link';
import WebTerminal from '../../../../islands/WebTerminal';

export const prerender = false;

// WebContainer requires Cross-Origin isolation.
Astro.response.headers.set('Cross-Origin-Embedder-Policy', 'require-corp');
Astro.response.headers.set('Cross-Origin-Opener-Policy', 'same-origin');
// Do not cache the sandbox execution environment
Astro.response.headers.set('Cache-Control', 'no-store, must-revalidate');
// Sandbox is a product utility surface, not an organic landing page.
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const { locale, owner, repo } = Astro.params;

if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (!owner || !repo) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const skillDetailLink = resolveSkillDetailLink({ owner, repo }, typedLocale);
const canonicalSkillPath =
  skillDetailLink?.href || `/${typedLocale}/skills/${encodeURIComponent(owner)}/${encodeURIComponent(repo)}`;
const canonicalSkillUrl = `https://killer-skills.com${canonicalSkillPath}`;
const pageTitle = `Sandbox: ${owner}/${repo} | Killer-Skills`;
const pageDescription = `Interactive sandbox for ${owner}/${repo}. Use the reviewed skill page as the primary landing page.`;

// Sandbox-only CSP relaxations: WebContainer (Stackblitz's in-browser Node)
// boots a service worker and runs user code from `blob:` URLs. Both are
// required for the sandbox to function and are scoped to this single route.
// Sandbox pages are X-Robots-Tag: noindex,nofollow so the wider attack
// surface is not advertised to crawlers, and the page is opt-in via a
// "Try in browser" button on detail pages, never auto-loaded.
Astro.csp?.insertScriptResource('blob:');
Astro.csp?.insertDirective("worker-src 'self' blob:");
Astro.csp?.insertDirective("frame-src 'self' https://*.webcontainer.io https://*.stackblitz.io");
---

<!doctype html>
<html lang={typedLocale} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonicalSkillUrl} />
    <meta name="description" content={pageDescription} />
    <title>{pageTitle}</title>
    <style>
      :root {
        --background: oklch(16% 0.018 245);
        --panel: oklch(20% 0.018 245);
        --border: oklch(33% 0.018 245);
        --foreground: oklch(96% 0.01 245);
        --muted: oklch(74% 0.012 245);
        --accent: oklch(70% 0.14 160);
      }
      body {
        margin: 0;
        background-color: var(--background);
        color: var(--foreground);
        font-family:
          ui-sans-serif,
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          sans-serif;
        height: 100vh;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }
      .sandbox-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 1.25rem;
        background: var(--panel);
        border-bottom: 1px solid var(--border);
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        min-width: 0;
        font-weight: 700;
      }
      .badge {
        flex: none;
        border: 1px solid var(--border);
        border-radius: 999px;
        background: oklch(25% 0.018 245);
        color: var(--accent);
        padding: 0.2rem 0.55rem;
        font-size: 0.72rem;
        font-weight: 700;
      }
      .return-link {
        flex: none;
        color: var(--muted);
        text-decoration: none;
        font-size: 0.86rem;
        font-weight: 700;
        transition: color 0.2s;
      }
      .return-link:hover {
        color: var(--accent);
      }
      .terminal-container {
        flex: 1;
        position: relative;
        background: oklch(12% 0.018 245);
      }
      /* xterm generic styling fixes */
      .xterm-viewport {
        overflow-y: auto !important;
      }
    </style>
  </head>
  <body>
    <header class="sandbox-header">
      <div class="brand">
        <span class="badge">LIVE ENV</span>
        {owner} / {repo}
      </div>
      <a href={canonicalSkillPath} class="return-link"> ← Exit Sandbox </a>
    </header>

    <main class="terminal-container">
      {/* React Island for the Terminal */}
      <WebTerminal client:only="react" owner={owner!} repo={repo!} />
    </main>
  </body>
</html>
