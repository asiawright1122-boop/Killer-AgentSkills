---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import CardOverlayLink from '../../../components/CardOverlayLink.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { ArrowRight, LayoutGrid, Layers } from 'lucide-react';
import { SUPPORTED_LOCALES, type Locale, loadMessages, translateOr, useTranslations } from '../../../i18n';
import { buildBreadcrumbTrail } from '../../../lib/site/breadcrumbs';
import { getCanonicalCollections, getCollectionCanonicalSlug } from '../../../lib/collection-slugs';
import { buildKeywordString } from '../../../lib/seo-keywords';
import { getSolutionIntents } from '../../../lib/solution-intents';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=3600');

const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const canonicalUrl = `https://killer-skills.com/${locale}/collections`;
const messages = await loadMessages(typedLocale);
const t = useTranslations(messages);
const tr = (key: string, fallback: string) => translateOr(messages, key, fallback);

// Load all collections
const collectionsCol = getCanonicalCollections(await getCollection('collections'));
collectionsCol.sort((a, b) => b.id.localeCompare(a.id)); // Simple sort by ID/Slug

// Extract localized text safely
const resolveLocalized = (field: string | Record<string, string> | undefined, fallback: string = '') => {
  if (!field) return fallback;
  if (typeof field === 'string') return field;
  return field[typedLocale] || field['en'] || fallback;
};

const collectionsSeoTitle = tr('Collections.seoTitle', 'AI Agent Skill Collections');
const collectionsSeoDescription = tr(
  'Collections.seoDescription',
  'Explore curated AI agent skill collections and workflow bundles.',
);
const collectionsSeoKeywords = buildKeywordString(
  t,
  'core',
  'templates',
  'developerExperience',
  'ideCompat',
  tr('Collections.seoKeyword1', 'AI agent skill collections'),
  tr('Collections.seoKeyword2', 'workflow skill bundles'),
  'Killer-Skills',
);
const workflowLinks = getSolutionIntents(typedLocale).slice(0, 3);
const faqItems = [
  {
    question: tr('Collections.faq1Q', 'What is a collection?'),
    answer: tr('Collections.faq1A', 'A collection groups related AI agent skills into one workflow-oriented bundle.'),
  },
  {
    question: tr('Collections.faq2Q', 'How do I use a collection?'),
    answer: tr('Collections.faq2A', 'Open a collection to browse the included skills and install the ones you need.'),
  },
  {
    question: tr('Collections.faq3Q', 'Who are collections for?'),
    answer: tr(
      'Collections.faq3A',
      'Collections help developers find sets of skills for a specific workflow or stack.',
    ),
  },
];
const breadcrumb = buildBreadcrumbTrail(
  [
    { label: translateOr(messages, 'Common.home', 'Home'), href: `/${locale}` },
    { label: translateOr(messages, 'Common.collections', 'Collections') },
  ],
  { currentUrl: canonicalUrl },
);
---

<Layout
  locale={locale}
  title={collectionsSeoTitle}
  description={collectionsSeoDescription}
  keywords={collectionsSeoKeywords}
  customCanonical={canonicalUrl}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb.jsonLd)} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: collectionsSeoTitle,
        description: collectionsSeoDescription,
        url: canonicalUrl,
        isPartOf: { '@type': 'WebSite', name: 'Killer-Skills', url: 'https://killer-skills.com' },
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: collectionsCol.length,
          itemListElement: collectionsCol.map((col, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: resolveLocalized(col.data.title, 'Untitled'),
            url: `https://killer-skills.com/${locale}/collections/${getCollectionCanonicalSlug(col)}`,
          })),
        },
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: collectionsSeoTitle,
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['h1', '.seo-intro-paragraph', 'h2'],
        },
        url: canonicalUrl,
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      })}
    />
  </Fragment>

  <div class="min-h-screen bg-[var(--background)] text-[var(--foreground)] font-sans">
    <main class="relative z-10 pt-12 md:pt-24 pb-32 border-b-[3px] border-[var(--border)]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
        <Breadcrumb items={breadcrumb.items} />

        {/* Header Section */}
        <div
          class="mb-16 border-b-4 border-[var(--border)] pb-12 flex flex-col md:flex-row md:items-end justify-between gap-6"
        >
          <div>
            <div class="flex items-center gap-3 mb-6">
              <span
                class="px-3 py-1 font-mono text-xs font-bold bg-[var(--primary)] text-[var(--primary-foreground)] border-2 border-[var(--primary)] flex items-center gap-2"
              >
                <LayoutGrid size={14} />
                {tr('Common.collections', 'Collections')}
              </span>
            </div>
            <h1
              class="text-5xl md:text-7xl font-black text-[var(--foreground)] tracking-tighter uppercase text-balance break-words"
            >
              {tr('Collections.heroTitle', 'Collections')}
            </h1>
          </div>
          <p
            class="seo-intro-paragraph text-lg md:text-xl text-[var(--muted-foreground)] font-mono font-bold max-w-lg mb-2"
          >
            {collectionsSeoDescription}
          </p>
        </div>

        <section class="mb-12 grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            workflowLinks.map((item) => (
              <a
                href={item.href}
                class="brut-card p-5 bg-white dark:bg-[#0a0a0a] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-all"
              >
                <div class="mb-3 text-xs font-mono font-black uppercase tracking-widest">{item.query}</div>
                <h2 class="text-xl font-black uppercase tracking-tight mb-2">{item.label}</h2>
                <p class="text-sm font-medium opacity-80 leading-6">{item.cardDescription}</p>
              </a>
            ))
          }
        </section>

        {/* Collections Grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            collectionsCol.map((col) => {
              const title = resolveLocalized(col.data.title, 'Untitled Collection');
              const description = resolveLocalized(col.data.description, '');
              const cleanSlug = getCollectionCanonicalSlug(col);

              return (
                <article
                  class="brut-card group relative flex min-h-[300px] flex-col bg-white p-6 dark:bg-[#0a0a0a]"
                  data-testid="collection-card"
                >
                  <CardOverlayLink
                    href={`/${locale}/collections/${cleanSlug}`}
                    ariaLabel={`${tr('Collections.view', 'View')} ${title}`}
                  />

                  {/* Icon / Category */}
                  <div class="relative z-0 mb-6 flex items-start justify-between pointer-events-none">
                    <div class="w-12 h-12 bg-[var(--foreground)] text-[var(--background)] border-2 border-[var(--foreground)] flex items-center justify-center shadow-[4px_4px_0px_0px_var(--foreground)] group-hover:bg-[var(--primary)] group-hover:border-[var(--primary)] group-hover:shadow-[4px_4px_0px_0px_var(--primary)] transition-all">
                      <Layers size={24} strokeWidth={2.5} />
                    </div>
                    {col.data.featured && (
                      <span class="shrink-0 inline-flex items-center px-2 py-1 text-[10px] font-black bg-[var(--primary)] text-[var(--primary-foreground)] border-2 border-[var(--primary)] uppercase tracking-widest">
                        [ {tr('Collections.featured', 'Featured')} ]
                      </span>
                    )}
                  </div>

                  {/* Content */}
                  <h3 class="relative z-0 mb-4 line-clamp-2 text-2xl font-black uppercase tracking-tight text-[var(--foreground)] pointer-events-none">
                    {title}
                  </h3>

                  <p class="relative z-0 mb-8 flex-grow line-clamp-3 text-sm font-bold leading-relaxed text-[var(--muted-foreground)] pointer-events-none">
                    {description}
                  </p>

                  {/* Footer */}
                  <div class="relative z-0 mt-auto flex items-center justify-between border-t-2 border-[var(--border)] pt-4 font-mono pointer-events-none">
                    <div class="text-xs font-bold text-[var(--foreground)]">
                      [{col.data.skills.length} {tr('Collections.items', 'items')}]
                    </div>
                    <div class="flex items-center gap-1 text-[var(--primary)] font-bold uppercase text-sm group-hover:translate-x-1 transition-transform">
                      {tr('Collections.view', 'View')} <ArrowRight size={16} strokeWidth={3} />
                    </div>
                  </div>
                </article>
              );
            })
          }

          {
            collectionsCol.length === 0 && (
              <div class="col-span-full py-20 text-center border-4 border-dashed border-[var(--border)] font-mono text-[var(--muted-foreground)] text-lg font-bold">
                {tr('Collections.noCollections', 'No collections available yet.')}
              </div>
            )
          }
        </div>

        <section class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            faqItems.map((item) => (
              <article class="brut-card p-6 bg-white dark:bg-[#0a0a0a]">
                <h2 class="text-lg font-black uppercase tracking-tight mb-3">{item.question}</h2>
                <p class="text-sm leading-6 text-[var(--muted-foreground)] font-medium">{item.answer}</p>
              </article>
            ))
          }
        </section>
      </div>
    </main>
  </div>
</Layout>
