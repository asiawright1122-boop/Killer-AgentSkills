---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import { ArrowRight, LayoutGrid, Layers } from 'lucide-react';
import { SUPPORTED_LOCALES, type Locale, loadMessages, useTranslations } from '../../../i18n';
import { buildKeywordString } from '../../../lib/seo-keywords';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=3600');

const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const isZh = typedLocale === 'zh';
const canonicalUrl = `https://killer-skills.com/${locale}/collections`;
const messages = await loadMessages(typedLocale);
const t = useTranslations(messages);

// Load all collections
const collectionsCol = await getCollection('collections');
collectionsCol.sort((a, b) => b.id.localeCompare(a.id)); // Simple sort by ID/Slug

// Extract localized text safely
const resolveLocalized = (field: string | Record<string, string> | undefined, fallback: string = '') => {
  if (!field) return fallback;
  if (typeof field === 'string') return field;
  return field[typedLocale] || field['en'] || fallback;
};

const collectionsSeoTitle = isZh
  ? '自动化工作流与流程化 AI Agent Skills 合集'
  : 'AI Agent Skill Collections for Automation Workflows';
const collectionsSeoDescription = isZh
  ? '按工作流浏览精选 AI Agent Skills 合集，覆盖流程自动化、文档自动化、浏览器自动化、数据提取与 MCP Servers 组合，适合 Claude Code、Cursor、Windsurf。'
  : 'Browse curated AI agent skill collections organized around workflow automation, process automation, document automation, browser automation, data extraction, and MCP server bundles for Claude Code, Cursor, and Windsurf.';
const collectionsSeoKeywords = buildKeywordString(
  typedLocale,
  'core',
  'workflowAutomation',
  'processAutomation',
  'documentAutomation',
  'browserAutomation',
  'dataWorkflow',
  'templates',
  'mcp',
  'ideCompat',
  isZh ? 'AI Agent Skills 合集' : 'AI agent skill collections',
  'Killer-Skills',
);
const workflowLinks = [
  {
    q: 'workflow automation',
    label: isZh ? '工作流自动化合集入口' : 'Workflow Automation Entry',
    description: isZh
      ? '查找多步骤执行和 agent 协作相关技能。'
      : 'Find multi-step execution and agent workflow bundles.',
  },
  {
    q: 'process automation',
    label: isZh ? '流程自动化合集入口' : 'Process Automation Entry',
    description: isZh ? '适合 SOP、交接和业务流程场景。' : 'Useful for SOPs, handoffs, and operations workflows.',
  },
  {
    q: 'document automation',
    label: isZh ? '文档自动化合集入口' : 'Document Automation Entry',
    description: isZh ? '聚焦报告、PDF、模板和内容流程。' : 'Focused on reports, PDFs, templates, and content ops.',
  },
];
const faqItems = [
  {
    question: isZh ? '这些合集适合哪些工作流？' : 'What workflows are these collections built for?',
    answer: isZh
      ? '这些合集主要围绕工作流自动化、流程自动化、文档自动化、数据处理和 MCP 工具链组合而设计。'
      : 'These collections are built around workflow automation, process automation, document operations, data workflows, and MCP tool stacks.',
  },
  {
    question: isZh ? '合集页和技能市场有什么区别？' : 'How is a collection different from the main skills marketplace?',
    answer: isZh
      ? '技能市场更适合逐个搜索和筛选，合集页更适合按完整工作流一次性找到互补技能组合。'
      : 'The marketplace is better for direct search and filtering, while collections help you find complementary skills bundled around a complete workflow.',
  },
  {
    question: isZh
      ? '这些合集能在 Claude Code 或 Cursor 中安装吗？'
      : 'Can I install these collections for Claude Code or Cursor?',
    answer: isZh
      ? '可以。合集里的技能通常都可在 Claude Code、Cursor、Windsurf 等环境中使用，并支持统一安装流程。'
      : 'Yes. Skills inside these collections generally work in Claude Code, Cursor, Windsurf, and other supported environments through a unified install flow.',
  },
];
---

<Layout
  locale={locale}
  title={collectionsSeoTitle}
  description={collectionsSeoDescription}
  keywords={collectionsSeoKeywords}
  customCanonical={canonicalUrl}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: t('Common.home') || 'Home',
            item: `https://killer-skills.com/${locale}`,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: t('Common.collections') || 'Collections',
            item: canonicalUrl,
          },
        ],
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: collectionsSeoTitle,
        description: collectionsSeoDescription,
        url: canonicalUrl,
        isPartOf: { '@type': 'WebSite', name: 'Killer-Skills', url: 'https://killer-skills.com' },
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: collectionsCol.length,
          itemListElement: collectionsCol.map((col, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            name: resolveLocalized(col.data.title, 'Untitled'),
            url: `https://killer-skills.com/${locale}/collections/${col.id.replace(/\.json$/, '')}`,
          })),
        },
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: collectionsSeoTitle,
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['h1', '.seo-intro-paragraph', 'h2'],
        },
        url: canonicalUrl,
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      })}
    />
  </Fragment>

  <div class="min-h-screen bg-[var(--background)] text-[var(--foreground)] font-sans">
    <main class="relative z-10 pt-12 md:pt-24 pb-32 border-b-[3px] border-[var(--border)]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
        {/* Header Section */}
        <div
          class="mb-16 border-b-4 border-[var(--border)] pb-12 flex flex-col md:flex-row md:items-end justify-between gap-6"
        >
          <div>
            <div class="flex items-center gap-3 mb-6">
              <span
                class="px-3 py-1 font-mono text-xs font-bold bg-[var(--primary)] text-[var(--primary-foreground)] border-2 border-[var(--primary)] flex items-center gap-2"
              >
                <LayoutGrid size={14} />
                {t('Common.collections')}
              </span>
            </div>
            <h1
              class="text-5xl md:text-7xl font-black text-[var(--foreground)] tracking-tighter uppercase text-balance break-words"
            >
              {isZh ? '自动化工作流合集' : 'Workflow Skill Bundles'}
            </h1>
          </div>
          <p
            class="seo-intro-paragraph text-lg md:text-xl text-[var(--muted-foreground)] font-mono font-bold max-w-lg mb-2"
          >
            {collectionsSeoDescription}
          </p>
        </div>

        <section class="mb-12 grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            workflowLinks.map((item) => (
              <a
                href={`/${locale}/skills?q=${encodeURIComponent(item.q)}`}
                class="brut-card p-5 bg-white dark:bg-[#0a0a0a] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-all"
              >
                <div class="mb-3 text-xs font-mono font-black uppercase tracking-widest">{item.q}</div>
                <h2 class="text-xl font-black uppercase tracking-tight mb-2">{item.label}</h2>
                <p class="text-sm font-medium opacity-80 leading-6">{item.description}</p>
              </a>
            ))
          }
        </section>

        {/* Collections Grid */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {
            collectionsCol.map((col) => {
              const title = resolveLocalized(col.data.title, 'Untitled Collection');
              const description = resolveLocalized(col.data.description, '');
              const cleanSlug = col.id.replace(/\.json$/, '');

              return (
                <article class="brut-card group p-6 flex flex-col relative bg-white dark:bg-[#0a0a0a] min-h-[300px]">
                  {/* Stretched Link */}
                  <a
                    href={`/${locale}/collections/${cleanSlug}`}
                    class="absolute inset-0 z-0 focus:outline-none focus:ring-4 focus:ring-[var(--primary)]"
                  />

                  {/* Icon / Category */}
                  <div class="relative z-1 flex justify-between items-start mb-6 pointer-events-none">
                    <div class="w-12 h-12 bg-[var(--foreground)] text-[var(--background)] border-2 border-[var(--foreground)] flex items-center justify-center shadow-[4px_4px_0px_0px_var(--foreground)] group-hover:bg-[var(--primary)] group-hover:border-[var(--primary)] group-hover:shadow-[4px_4px_0px_0px_var(--primary)] transition-all">
                      <Layers size={24} strokeWidth={2.5} />
                    </div>
                    {col.data.featured && (
                      <span class="shrink-0 inline-flex items-center px-2 py-1 text-[10px] font-black bg-[var(--primary)] text-[var(--primary-foreground)] border-2 border-[var(--primary)] uppercase tracking-widest">
                        [ {t('Collections.featured')} ]
                      </span>
                    )}
                  </div>

                  {/* Content */}
                  <h3 class="relative z-1 text-2xl font-black text-[var(--foreground)] tracking-tight uppercase mb-4 pointer-events-none line-clamp-2">
                    {title}
                  </h3>

                  <p class="relative z-1 text-[var(--muted-foreground)] font-bold text-sm leading-relaxed mb-8 flex-grow pointer-events-none line-clamp-3">
                    {description}
                  </p>

                  {/* Footer */}
                  <div class="relative z-1 mt-auto flex items-center justify-between border-t-2 border-[var(--border)] pt-4 pointer-events-none font-mono">
                    <div class="text-xs font-bold text-[var(--foreground)]">
                      [{col.data.skills.length} {t('Collections.items')}]
                    </div>
                    <div class="flex items-center gap-1 text-[var(--primary)] font-bold uppercase text-sm group-hover:translate-x-1 transition-transform">
                      {t('Collections.view')} <ArrowRight size={16} strokeWidth={3} />
                    </div>
                  </div>
                </article>
              );
            })
          }

          {
            collectionsCol.length === 0 && (
              <div class="col-span-full py-20 text-center border-4 border-dashed border-[var(--border)] font-mono text-[var(--muted-foreground)] text-lg font-bold">
                {t('Collections.noCollections')}
              </div>
            )
          }
        </div>

        <section class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-6">
          {
            faqItems.map((item) => (
              <article class="brut-card p-6 bg-white dark:bg-[#0a0a0a]">
                <h2 class="text-lg font-black uppercase tracking-tight mb-3">{item.question}</h2>
                <p class="text-sm leading-6 text-[var(--muted-foreground)] font-medium">{item.answer}</p>
              </article>
            ))
          }
        </section>
      </div>
    </main>
  </div>
</Layout>
