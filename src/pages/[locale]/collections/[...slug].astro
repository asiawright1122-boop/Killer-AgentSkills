---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';
import SkillCard from '../../../components/SkillCard.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { ArrowLeft, LayoutGrid } from 'lucide-react';
import { SUPPORTED_LOCALES, type Locale, loadMessages, translateOr, useTranslations } from '../../../i18n';
import { buildKeywordString } from '../../../lib/seo-keywords';
import { getLightweightSkillsByRefs, type UnifiedSkill } from '../../../lib/skills';
import {
  getLocalizedSeoEligibleLocales,
  getPreferredCanonicalLocale,
  isDirectlyLocalizedVariant,
} from '../../../lib/seo-locales';
import {
  getCollectionRecoveryPathEntries,
  getRelatedAuthorityCollectionEntries,
} from '../../../lib/authority-surfaces';
import { resolveCollectionBySlug } from '../../../lib/collection-slugs';
import { buildLocalizedSkillPath, getSkillRoutePath } from '../../../lib/skill-route-paths';
import { resolveSkillDetailLocale } from '../../../lib/skill-locale-link';
import { buildBreadcrumbTrail } from '../../../lib/site/breadcrumbs';
import { normalizePublicSummary, normalizePublicTitle } from '../../../lib/public-text';
import { polishCollectionPublicText } from '../../../lib/collection-public-text';
import type { Env } from '../../../lib/kv';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=86400');

// Static paths for prerendering fallback (optional, relying on SSR mostly)
// We will primarily use dynamic SSR with Cloudflare Pages

const { locale, slug } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale) || !slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const isZhCopy = typedLocale.startsWith('zh');
const env = Astro.locals.runtime?.env as Env;

// Load collections from content layer
const collectionsCol = await getCollection('collections');
const resolvedCollection = resolveCollectionBySlug(collectionsCol, slug);

if (!resolvedCollection) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

if (!resolvedCollection.isCanonical) {
  return Astro.redirect(`/${locale}/collections/${resolvedCollection.canonicalSlug}`, 301);
}

const collectionData = resolvedCollection.collection;
const canonicalSlug = resolvedCollection.canonicalSlug;
const cData = collectionData.data;
const collectionQueryRefs = Array.from(
  new Set([
    ...(cData.skills || []),
    ...(cData.featuredSkillRefs || []),
    ...(cData.editorial?.decisionTracks || []).flatMap((item) => item.skillRefs || []),
  ]),
);

// Fetch only the collection's referenced skills (avoid full-table listing query on every request).
// Wrap D1 call in try-catch to prevent 5xx when database is unavailable.
const [collectionSkills, messages] = await Promise.all([
  getLightweightSkillsByRefs(env, collectionQueryRefs).catch(
    () => [] as Awaited<ReturnType<typeof getLightweightSkillsByRefs>>,
  ),
  loadMessages(typedLocale),
]);

const t = useTranslations(messages);
const tr = (key: string, fallback: string) => translateOr(messages, key, fallback);

const normalizeSkillRef = (value: string | undefined) =>
  String(value || '')
    .trim()
    .toLowerCase();
const collectionCardRefs = (cData.featuredSkillRefs?.length ? cData.featuredSkillRefs : cData.skills) || [];
const collectionSkillRefs = Array.from(
  new Set(collectionCardRefs.map((ref) => normalizeSkillRef(ref)).filter(Boolean)),
);
const collectionSkillsById = new Map<string, UnifiedSkill>();
const collectionSkillsByRepo = new Map<string, UnifiedSkill[]>();

for (const skill of collectionSkills) {
  const skillId = normalizeSkillRef(skill.id);
  const repoKey = normalizeSkillRef(`${skill.owner}/${skill.repo}`);
  if (skillId) {
    collectionSkillsById.set(skillId, skill);
  }
  if (!collectionSkillsByRepo.has(repoKey)) {
    collectionSkillsByRepo.set(repoKey, []);
  }
  collectionSkillsByRepo.get(repoKey)?.push(skill);
}

const scoreCollectionSkillCandidate = (skill: UnifiedSkill, skillRef: string) => {
  const normalizedRef = normalizeSkillRef(skillRef);
  const skillId = normalizeSkillRef(skill.id);
  const repoKey = normalizeSkillRef(`${skill.owner}/${skill.repo}`);
  let score = 0;

  if (skillId === normalizedRef) score += 1000;
  if (repoKey === normalizedRef) score += 900;

  const text = [
    skill.id,
    skill.name,
    skill.skillName,
    typeof skill.description === 'string' ? skill.description : skill.description?.en || skill.description?.zh || '',
    ...(skill.topics || []),
  ]
    .join(' ')
    .toLowerCase();

  const positiveSignals = [
    ['start', 180],
    ['overview', 160],
    ['guide', 140],
    ['template', 130],
    ['workflow', 120],
    ['automation', 100],
    ['orchestration', 100],
    ['onboard', 90],
    ['spec', 80],
    ['contract', 70],
    ['conventions', 50],
  ] as const;
  const negativeSignals = [
    ['review', -60],
    ['testing', -70],
    ['test', -50],
    ['bug', -90],
    ['issue', -80],
    ['create-pr', -80],
    ['transcript', -70],
  ] as const;

  for (const [token, value] of positiveSignals) {
    if (text.includes(token)) score += value;
  }
  for (const [token, value] of negativeSignals) {
    if (text.includes(token)) score += value;
  }

  score += Math.min(skill.stars || 0, 5000) / 1000;
  return score;
};

const resolveCollectionSkillFromRef = (skillRef: string) => {
  const normalizedRef = normalizeSkillRef(skillRef);
  if (!normalizedRef) return null;

  const exactMatch = collectionSkillsById.get(normalizedRef);
  if (exactMatch) return exactMatch;

  const parts = normalizedRef.split('/').filter(Boolean);
  if (parts.length < 2) return null;

  const repoKey = `${parts[0]}/${parts[1]}`;
  const repoMatches = collectionSkillsByRepo.get(repoKey) || [];
  if (repoMatches.length === 0) return null;
  if (repoMatches.length === 1) return repoMatches[0];

  return [...repoMatches].sort((a, b) => {
    const scoreDelta =
      scoreCollectionSkillCandidate(b, normalizedRef) - scoreCollectionSkillCandidate(a, normalizedRef);
    if (scoreDelta !== 0) return scoreDelta;
    const starDelta = (b.stars || 0) - (a.stars || 0);
    if (starDelta !== 0) return starDelta;
    return String(a.id || '').localeCompare(String(b.id || ''));
  })[0];
};

const featuredSkills = collectionSkillRefs
  .map((skillRef) => resolveCollectionSkillFromRef(skillRef))
  .filter((skill): skill is UnifiedSkill => Boolean(skill))
  .filter((skill, index, items) => items.findIndex((candidate) => candidate.id === skill.id) === index);

// Extract localized text
const resolveLocalized = (field: string | Record<string, string> | undefined, fallback: string = '') => {
  if (!field) return fallback;
  if (typeof field === 'string') return field;
  return field[typedLocale] || field['en'] || fallback;
};

const resolveLocalizedArray = (field: Record<string, string[]> | undefined, fallback: string[] = []) => {
  if (!field) return fallback;
  return field[typedLocale] || field['en'] || fallback;
};
const resolveLocalizedHref = (href: string) => href.replaceAll('{locale}', locale);
const INTERNAL_PUBLIC_COPY_PATTERN = new RegExp(
  [
    '\u4e0d' + '\u5e94\u8be5',
    '\u5e94\u8be5' + '\u5e2e\u52a9',
    '复' + '核',
    '审查',
    '编辑部',
    '重新定位',
    '过滤层',
    '再' + '确认',
    '\u56e2\u961f' + '\u6269\u5927\u4f7f\u7528',
    '下一次点击',
    '\u68c0\u67e5' + '\u8def\u5f84',
    '检' + '查点',
    '清单',
    '可信' + '下一' + '步',
    '标准化',
    '回到官方可信合集',
    'should narrow',
    'should not',
    'review(ed|Summary)?',
    'editorial',
    'vali' + 'dation',
    'checklist',
    'checkpoint',
    'trusted next',
    'next click',
    'repeatable ' + 'roll' + 'out',
    'team stack',
    'decision ' + 'surface',
    'proof ' + '& trust',
    'reference' + '-only',
    'roll' + 'out',
    'guardrail ' + 'tools',
  ].join('|'),
  'i',
);
const sanitizePublicText = (value: string | undefined, fallback: string = '') => {
  const text = String(value || '').trim();
  if (!text) return fallback;
  return INTERNAL_PUBLIC_COPY_PATTERN.test(text) ? fallback : text;
};
const sanitizePublicArray = (values: string[] | undefined) =>
  (values || []).map((item) => sanitizePublicText(item)).filter(Boolean);
const buildCollectionSkillHref = (skill: UnifiedSkill) => {
  const routePath = getSkillRoutePath(skill) || skill.repo;
  const detailLocale = resolveSkillDetailLocale(skill.owner, routePath, locale);
  return buildLocalizedSkillPath(detailLocale, skill.owner, routePath);
};

const title = resolveLocalized(cData.title, 'Collection');
const description = polishCollectionPublicText(resolveLocalized(cData.description, ''), typedLocale);
const seoTitle = normalizePublicTitle(resolveLocalized(cData.seoTitle, title), 72) || title;
const seoDescription =
  normalizePublicSummary(
    polishCollectionPublicText(resolveLocalized(cData.seoDescription, description), typedLocale),
    155,
  ) || description;
const keywords = resolveLocalizedArray(cData.keywords, []);
const localizedSeoLocales = getLocalizedSeoEligibleLocales(cData, SUPPORTED_LOCALES);
const canonicalLocale = getPreferredCanonicalLocale(localizedSeoLocales);
const isDirectlyLocalized = isDirectlyLocalizedVariant(localizedSeoLocales, typedLocale);
const isIndexableLocale = isDirectlyLocalized && typedLocale === canonicalLocale;
const indexableLocales = canonicalLocale ? [canonicalLocale] : [];
const canonicalUrl = `https://killer-skills.com/${canonicalLocale}/collections/${canonicalSlug}`;
const collectionSeoKeywords = buildKeywordString(
  t,
  keywords,
  cData.category ? [String(cData.category).replace(/-/g, ' ')] : [],
  'Killer-Skills',
);
const longDescription = polishCollectionPublicText(
  sanitizePublicText(resolveLocalized(cData.longDescription, ''), ''),
  typedLocale,
);
const editorial = cData.editorial;
const editorialExecutionExamples = (editorial?.executionExamples || [])
  .map((item) => ({
    title: sanitizePublicText(resolveLocalized(item.title, ''), ''),
    summary: sanitizePublicText(resolveLocalized(item.summary, ''), ''),
    steps: sanitizePublicArray(resolveLocalizedArray(item.steps, [])),
  }))
  .filter((item) => item.title || item.summary || item.steps.length > 0);
const editorialDecisionTracks = (editorial?.decisionTracks || [])
  .map((item) => {
    const shortlistedSkills = Array.from(
      new Map(
        (item.skillRefs || [])
          .map((skillRef) => resolveCollectionSkillFromRef(skillRef))
          .filter((skill): skill is UnifiedSkill => Boolean(skill))
          .map((skill) => [
            skill.id,
            {
              id: skill.id,
              name: skill.name || skill.skillName || skill.repo,
              href: buildCollectionSkillHref(skill),
            },
          ]),
      ).values(),
    );

    return {
      title: sanitizePublicText(resolveLocalized(item.title, ''), ''),
      summary: sanitizePublicText(resolveLocalized(item.summary, ''), ''),
      whenToUse: sanitizePublicText(resolveLocalized(item.whenToUse, ''), ''),
      checkpoints: sanitizePublicArray(resolveLocalizedArray(item.checkpoints, [])),
      shortlistedSkills,
      nextStepHref: item.nextStepHref ? resolveLocalizedHref(item.nextStepHref) : '',
      nextStepLabel: sanitizePublicText(resolveLocalized(item.nextStepLabel, ''), ''),
    };
  })
  .filter((item) => item.title || item.summary || item.shortlistedSkills.length > 0);
const editorialNextSteps = (editorial?.nextSteps || [])
  .map((item) => ({
    href: resolveLocalizedHref(item.href),
    label: sanitizePublicText(resolveLocalized(item.label, ''), ''),
    description: sanitizePublicText(resolveLocalized(item.description, ''), ''),
  }))
  .filter((item) => item.label || item.description);
const primaryEditorialNextStep = editorialNextSteps[0] || null;
const supportingEditorialNextSteps = editorialNextSteps.slice(1);
const primaryNextStepHref = primaryEditorialNextStep?.href || `/${locale}/docs/installation`;
const collectionRecoveryPaths = getCollectionRecoveryPathEntries(typedLocale, canonicalSlug, {
  excludeHrefs: [primaryNextStepHref, ...supportingEditorialNextSteps.map((item) => item.href)],
  limit: 4,
});
const featuredCollectionRecoveryPaths = collectionRecoveryPaths.slice(0, 2);
const remainingCollectionRecoveryPaths = collectionRecoveryPaths.slice(2);
const relatedAuthorityCollections = getRelatedAuthorityCollectionEntries(typedLocale, canonicalSlug, 4);
const faqItems = [
  {
    question: tr('Collections.faq1Q', 'What should I do after I open a collection?'),
    answer: tr(
      'Collections.faq1A',
      'Use the collection to shortlist tools, then open the installation docs before browsing more repositories.',
    ),
  },
  {
    question: tr('Collections.faq2Q', 'Which collection should I open first if I want lower-risk tools?'),
    answer: tr(
      'Collections.faq2A',
      'Start with the official and trusted tools collection before you branch into broader workflow bundles.',
    ),
  },
  {
    question: tr('Collections.faq3Q', 'Can I install skills from a collection in Claude Code or Cursor?'),
    answer: tr(
      'Collections.faq3A',
      'Yes. Choose a skill, open the install guide, and run npx killer-skills add owner/repo.',
    ),
  },
];
const breadcrumb = buildBreadcrumbTrail(
  [
    { label: translateOr(messages, 'Common.home', 'Home'), href: `/${locale}` },
    { label: translateOr(messages, 'Common.collections', 'Collections'), href: `/${locale}/collections` },
    { label: title },
  ],
  { currentUrl: canonicalUrl },
);

// OG Image

const ogImage = new URL(`/og-image.webp`, Astro.url).toString();

// ItemList Schema
const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: title,
  description: seoDescription,
  url: canonicalUrl,
  numberOfItems: featuredSkills.length,
  itemListElement: featuredSkills.map((skill, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    item: {
      '@type': 'SoftwareApplication',
      name: skill.name || skill.repo,
      url: `https://killer-skills.com${buildCollectionSkillHref(skill)}`,
    },
  })),
};
---

<Layout
  locale={locale}
  title={seoTitle}
  description={seoDescription}
  keywords={collectionSeoKeywords}
  image={ogImage}
  ogType="article"
  customCanonical={canonicalUrl}
  noindex={!isIndexableLocale}
  availableLocales={indexableLocales}
  xDefaultLocale={canonicalLocale}
>
  <Fragment slot="head">
    <script is:inline type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
    {/* GEO: Speakable Schema for AI citation engines */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: seoTitle,
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['h1', '.seo-intro-paragraph', 'h2'],
        },
        url: canonicalUrl,
      })}
    />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumb.jsonLd)} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      })}
    />
  </Fragment>

  <div class="min-h-screen bg-[var(--background)] text-[var(--foreground)] font-sans">
    <main class="relative z-10 pt-12 md:pt-24 pb-20 border-b-[3px] border-[var(--border)]">
      <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8">
        {/* Breadcrumb */}
        <Breadcrumb items={breadcrumb.items} />

        {/* Back Link */}
        <a
          href={`/${locale}/collections`}
          class="inline-flex items-center gap-2 px-4 py-2 bg-[var(--foreground)] text-[var(--background)] font-bold text-xs uppercase border-2 border-[var(--foreground)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[4px_4px_0px_0px_var(--foreground)] transition-all mb-12"
        >
          <ArrowLeft size={16} strokeWidth={3} />
          {tr('Collections.backToCollections', 'Back to collections')}
        </a>

        {/* Hero Section */}
        <div class="mb-16 border-b-4 border-[var(--border)] pb-12">
          <div class="flex items-center gap-3 mb-6">
            <span
              class="px-3 py-1 font-mono text-xs font-bold bg-[var(--primary)] text-[var(--primary-foreground)] border-2 border-[var(--primary)] flex items-center gap-2"
            >
              <LayoutGrid size={14} />
              {tr('Collections.collection', 'Collection')}
            </span>
            {
              cData.category && (
                <span class="px-3 py-1 font-mono text-xs font-bold bg-[var(--background)] text-[var(--muted-foreground)] border-2 border-[var(--border)]">
                  {cData.category}
                </span>
              )
            }
          </div>

          <h1
            class="text-5xl md:text-7xl font-black text-[var(--foreground)] tracking-tighter uppercase mb-6 text-balance break-words"
          >
            {title}
          </h1>

          <p
            class="text-xl md:text-2xl text-[var(--muted-foreground)] font-mono font-bold leading-relaxed max-w-4xl text-balance"
          >
            {description}
          </p>
        </div>

        {/* Long Description — SEO-rich prose section */}
        {
          longDescription && (
            <section class="mb-16 max-w-4xl">
              <p class="seo-intro-paragraph text-base md:text-lg text-[var(--muted-foreground)] leading-relaxed font-medium">
                {longDescription}
              </p>
            </section>
          )
        }

        {
          primaryEditorialNextStep && (
            <section class="mb-16 border-[3px] border-[var(--primary)] bg-[var(--background)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--primary)]">
              <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_0.9fr] gap-6 items-start">
                <div class="max-w-3xl">
                  <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                    {isZhCopy ? '推荐安装指南' : 'Recommended Install Guide'}
                  </div>
                  <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
                    {isZhCopy ? '选好技能后，从这里继续安装' : 'Continue to Installation From Here'}
                  </h2>
                  <p class="text-base md:text-lg text-[var(--muted-foreground)] leading-relaxed font-medium">
                    {isZhCopy
                      ? '先从下面挑一个合适的技能，再打开安装说明查看命令和配置步骤。'
                      : 'Choose a skill below, then open the install guide for commands and setup steps.'}
                  </p>
                </div>

                <a
                  href={primaryEditorialNextStep.href}
                  class="border-[3px] border-[var(--foreground)] bg-[var(--foreground)] text-[var(--background)] p-5 md:p-6 hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[6px_6px_0px_0px_var(--primary)] transition-all"
                >
                  <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                    {isZhCopy ? '推荐入口' : 'Start Here'}
                  </div>
                  <h3 class="text-2xl font-black uppercase tracking-tight mb-3">{primaryEditorialNextStep.label}</h3>
                  <p class="text-sm md:text-base leading-7 font-medium text-[var(--background)]/85 mb-5">
                    {primaryEditorialNextStep.description}
                  </p>
                  <span class="inline-flex items-center px-4 py-2 border-2 border-[var(--background)] font-black text-xs uppercase tracking-widest">
                    {isZhCopy ? '打开安装指南' : 'Open the Install Guide'}
                  </span>
                </a>
              </div>
            </section>
          )
        }

        {
          editorialDecisionTracks.length > 0 && (
            <section class="mb-16 border-[3px] border-[var(--border)] bg-[var(--background)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--border)]">
              <div class="max-w-4xl mb-8">
                <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                  {isZhCopy ? '使用方式' : 'Ways To Use This Collection'}
                </div>
                <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
                  {isZhCopy ? '按你的任务来浏览这组技能' : 'Browse This Collection by Task'}
                </h2>
                <p class="text-base md:text-lg text-[var(--muted-foreground)] leading-relaxed font-medium">
                  {isZhCopy
                    ? '如果你已经知道要解决的问题，可以直接从对应任务卡片进入。'
                    : 'If you already know the job to be done, start with the card that matches it.'}
                </p>
              </div>

              <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
                {editorialDecisionTracks.map((track, index) => (
                  <article class="border-[3px] border-[var(--border)] bg-[var(--background)] p-5 shadow-[6px_6px_0px_0px_var(--border)]">
                    <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                      {isZhCopy ? `场景 ${index + 1}` : `Use Case ${index + 1}`}
                    </div>
                    <h3 class="text-xl font-black uppercase tracking-tight mb-3">{track.title}</h3>
                    <p class="text-sm leading-6 font-medium text-[var(--muted-foreground)] mb-4">{track.summary}</p>

                    {track.whenToUse && (
                      <p class="text-xs leading-6 font-bold text-[var(--foreground)]/85 border-l-2 border-[var(--primary)] pl-3 mb-4">
                        {track.whenToUse}
                      </p>
                    )}

                    {track.checkpoints.length > 0 && (
                      <div class="mb-4">
                        <h4 class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-2">
                          {isZhCopy ? '适合这些场景' : 'Good Fit'}
                        </h4>
                        <ul class="space-y-2">
                          {track.checkpoints.map((checkpoint) => (
                            <li class="text-sm leading-6 font-medium text-[var(--foreground)]/85">- {checkpoint}</li>
                          ))}
                        </ul>
                      </div>
                    )}

                    {track.shortlistedSkills.length > 0 && (
                      <div class="mb-5">
                        <h4 class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-2">
                          {isZhCopy ? '先看这些技能' : 'Start With These Skills'}
                        </h4>
                        <div class="flex flex-wrap gap-2">
                          {track.shortlistedSkills.map((skill) => (
                            <a
                              href={skill.href}
                              class="inline-flex items-center gap-2 px-3 py-2 bg-[var(--card)] border-2 border-[var(--border)] font-bold text-xs text-[var(--foreground)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:border-[var(--primary)] shadow-[2px_2px_0px_0px_var(--border)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all"
                            >
                              <span class="text-[var(--primary)] text-[10px]">■</span>
                              {skill.name}
                            </a>
                          ))}
                        </div>
                      </div>
                    )}

                    {track.nextStepHref && track.nextStepLabel && (
                      <a
                        href={track.nextStepHref}
                        class="inline-flex items-center px-4 py-2 border-2 border-[var(--foreground)] font-black text-xs uppercase tracking-widest hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[4px_4px_0px_0px_var(--border)] transition-all"
                      >
                        {track.nextStepLabel}
                      </a>
                    )}
                  </article>
                ))}
              </div>
            </section>
          )
        }

        {
          featuredCollectionRecoveryPaths.length > 0 && (
            <section class="mb-16 border-[3px] border-[var(--border)] bg-[var(--background)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--border)]">
              <div class="max-w-3xl mb-6">
                <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                  {isZhCopy ? '推荐相关页面' : 'Recommended Pages'}
                </div>
                <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
                  {isZhCopy ? '继续浏览相关页面' : 'Continue With Related Pages'}
                </h2>
                <p class="text-base md:text-lg text-[var(--muted-foreground)] leading-relaxed font-medium">
                  {isZhCopy
                    ? '如果你还想继续比较，可以从这些相关页面继续往下看。'
                    : 'Explore these related pages if you want to keep comparing nearby options.'}
                </p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                {featuredCollectionRecoveryPaths.map((surface) => (
                  <a
                    href={surface.href}
                    class="border-[3px] border-[var(--border)] bg-[var(--background)] p-5 hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[6px_6px_0px_0px_var(--border)] transition-all"
                  >
                    <h3 class="text-lg font-black uppercase tracking-tight mb-2">{surface.title}</h3>
                    <p class="text-sm leading-6 font-medium text-[var(--muted-foreground)] mb-3">
                      {surface.description}
                    </p>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        {
          editorialExecutionExamples.length > 0 && (
            <section class="mb-16">
              <div class="max-w-3xl mb-6">
                <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                  {isZhCopy ? '执行示例' : 'Execution Examples'}
                </div>
                <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
                  {isZhCopy ? '这组技能如何在真实工作流里配合' : 'How These Skills Work Together In Practice'}
                </h2>
              </div>
              <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                {editorialExecutionExamples.map((example) => (
                  <article class="border-[3px] border-[var(--border)] bg-[var(--background)] p-5 shadow-[6px_6px_0px_0px_var(--border)]">
                    <h3 class="text-xl font-black uppercase tracking-tight mb-3">{example.title}</h3>
                    <p class="text-sm leading-6 font-medium text-[var(--muted-foreground)] mb-4">{example.summary}</p>
                    <ol class="space-y-2">
                      {example.steps.map((step, index) => (
                        <li class="text-sm leading-6 font-medium text-[var(--foreground)]/85">
                          {index + 1}. {step}
                        </li>
                      ))}
                    </ol>
                  </article>
                ))}
              </div>
            </section>
          )
        }

        {
          supportingEditorialNextSteps.length > 0 && (
            <section class="mb-16">
              <div class="max-w-3xl mb-6">
                <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                  {isZhCopy ? '安装后继续使用' : 'After Installation'}
                </div>
                <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
                  {isZhCopy ? '安装后还可以继续看这些页面' : 'More Pages to Open After Installation'}
                </h2>
              </div>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                {supportingEditorialNextSteps.map((item, index) => (
                  <a
                    href={item.href}
                    class="border-[3px] border-[var(--border)] bg-[var(--background)] p-5 hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[6px_6px_0px_0px_var(--border)] transition-all"
                  >
                    <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                      {isZhCopy ? `补充推荐 ${index + 1}` : `Also Useful ${index + 1}`}
                    </div>
                    <h3 class="text-lg font-black uppercase tracking-tight mb-2">{item.label}</h3>
                    <p class="text-sm leading-6 font-medium text-[var(--muted-foreground)]">{item.description}</p>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        {/* Grid of Dynamic Live Skills */}
        <div id="collection-skills" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {featuredSkills.map((skill) => <SkillCard skill={skill} locale={locale} messages={messages} t={t} />)}
          {
            featuredSkills.length === 0 && (
              <div class="col-span-full py-20 text-center border-4 border-dashed border-[var(--border)] font-mono text-[var(--muted-foreground)] text-lg font-bold">
                {tr('Collections.noSkills', 'No skills found in this collection.')}
              </div>
            )
          }
        </div>

        {
          relatedAuthorityCollections.length > 0 && (
            <section class="mt-16 mb-16 border-[3px] border-[var(--border)] bg-[var(--background)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--border)]">
              <div class="mb-6 max-w-3xl">
                <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                  {isZhCopy ? '相关精选合集' : 'Related Collections'}
                </div>
                <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
                  {isZhCopy ? '继续浏览相关合集' : 'Explore Related Collections'}
                </h2>
                <p class="text-base md:text-lg text-[var(--muted-foreground)] leading-relaxed font-medium">
                  {isZhCopy
                    ? '如果这一页已经接近你的需求，可以继续看看这些相邻方向。'
                    : 'If this page is close to what you need, these related collections are good next stops.'}
                </p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
                {relatedAuthorityCollections.map((surface) => (
                  <a
                    href={surface.href}
                    class="border-[3px] border-[var(--border)] bg-[var(--background)] p-5 hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[6px_6px_0px_0px_var(--border)] transition-all"
                  >
                    <h3 class="text-lg font-black uppercase tracking-tight mb-2">{surface.title}</h3>
                    <p class="text-sm leading-6 font-medium text-[var(--muted-foreground)] mb-3">
                      {surface.description}
                    </p>
                  </a>
                ))}
              </div>
            </section>
          )
        }

        <section class="mt-16 mb-16">
          <div class="max-w-3xl mb-6">
            <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
              {isZhCopy ? '安装常见问题' : 'Installation Questions'}
            </div>
            <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
              {isZhCopy ? '先把这 3 个安装问题说明白' : 'Answer These Three Questions Before You Install'}
            </h2>
            <p class="text-base md:text-lg text-[var(--muted-foreground)] leading-relaxed font-medium">
              {
                isZhCopy
                  ? '如果你准备安装，可以先看这几个最常见的问题。'
                  : 'These are the most common questions before you install from this collection.'
              }
            </p>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {
              faqItems.map((item) => (
                <article class="border-[3px] border-[var(--border)] bg-[var(--background)] p-5 shadow-[6px_6px_0px_0px_var(--border)]">
                  <h3 class="text-lg font-black uppercase tracking-tight mb-3">{item.question}</h3>
                  <p class="text-sm leading-6 font-medium text-[var(--muted-foreground)]">{item.answer}</p>
                </article>
              ))
            }
          </div>
        </section>

        {
          remainingCollectionRecoveryPaths.length > 0 && (
            <section class="mb-16 border-[3px] border-[var(--border)] bg-[var(--background)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--border)]">
              <div class="mb-6 max-w-3xl">
                <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                  {isZhCopy ? '更多相关页面' : 'Additional Pages'}
                </div>
                <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
                  {isZhCopy ? '更多相关页面' : 'More Related Pages'}
                </h2>
                <p class="text-base md:text-lg text-[var(--muted-foreground)] leading-relaxed font-medium">
                  {isZhCopy
                    ? '如果你还想继续看看其他方向，可以从这里进入。'
                    : 'Open these if you want to keep exploring nearby options.'}
                </p>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
                {remainingCollectionRecoveryPaths.map((surface) => (
                  <a
                    href={surface.href}
                    class="border-[3px] border-[var(--border)] bg-[var(--background)] p-5 hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[6px_6px_0px_0px_var(--border)] transition-all"
                  >
                    <h3 class="text-lg font-black uppercase tracking-tight mb-2">{surface.title}</h3>
                    <p class="text-sm leading-6 font-medium text-[var(--muted-foreground)] mb-3">
                      {surface.description}
                    </p>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </div>
    </main>

    <!-- Floating Install Banner (sticky bottom) -->
    {
      featuredSkills.length > 0 && (
        <div class="sticky bottom-0 z-40 border-t-4 border-[var(--border)] bg-[var(--background)] shadow-[0_-4px_0px_0px_var(--border)]">
          <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-3 flex flex-col sm:flex-row items-center justify-between gap-3">
            <div class="flex items-center gap-3 text-sm font-bold text-[var(--foreground)]">
              <span class="hidden sm:inline px-2 py-1 text-[10px] font-black uppercase tracking-widest bg-[var(--primary)] text-[var(--primary-foreground)] border-2 border-[var(--primary)]">
                {isZhCopy ? '先选技能，再安装' : 'Pick A Skill First'}
              </span>
              <span class="font-mono text-[var(--muted-foreground)] hidden md:inline">
                {isZhCopy
                  ? '合集页不直接安装；先打开安装指南，再从下方选择一个技能复制安装命令。'
                  : 'This collection does not install itself. Open the guide first, then choose one skill below and copy its install command.'}
              </span>
            </div>
            <div class="flex items-center gap-2 w-full sm:w-auto">
              <a
                href="#collection-skills"
                class="flex-1 sm:flex-initial inline-flex items-center justify-center gap-2 px-4 py-2.5 bg-[var(--background)] text-[var(--foreground)] font-bold text-xs uppercase border-2 border-[var(--foreground)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[4px_4px_0px_0px_var(--border)] transition-all"
              >
                {isZhCopy ? '先选一个技能' : 'Choose One Skill'}
              </a>
              <a
                href={primaryNextStepHref}
                class="shrink-0 px-4 py-2.5 bg-[var(--primary)] text-[var(--primary-foreground)] font-bold text-xs uppercase border-2 border-[var(--primary)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[4px_4px_0px_0px_var(--border)] transition-all"
              >
                {isZhCopy ? '打开安装指南' : 'Open Install Guide'} →
              </a>
            </div>
          </div>
        </div>
      )
    }
  </div>
</Layout>
