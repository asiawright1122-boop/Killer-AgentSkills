---
import Layout from '../../../layouts/Layout.astro';
import { SUPPORTED_LOCALES, loadMessages, useTranslations, type Locale } from '../../../i18n';
import { buildKeywordString } from '../../../lib/seo-keywords';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400');

// Validate locale
const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const isZh = typedLocale === 'zh';
const canonicalUrl = `https://killer-skills.com/${locale}/integrations`;

// Load translations
const messages = await loadMessages(typedLocale);
const t = useTranslations(messages);

const pageTitle = isZh
  ? 'Cursor、Claude Code、VS Code 自动化工作流技能兼容与安装指南'
  : 'Cursor, Claude Code & VS Code AI Skill Setup for Automation Workflows';
const pageDescription = isZh
  ? '查看 Killer-Skills 对 Cursor、Claude Code、VS Code、Windsurf 等 15+ IDE 的兼容性，了解如何安装、配置并同步 AI Agent Skills，落地工作流自动化与流程自动化。'
  : 'See how Killer-Skills works with Cursor, Claude Code, VS Code, Windsurf, and 15+ IDEs to install, configure, and sync AI agent skills for workflow automation and process automation.';
const pageKeywords = buildKeywordString(
  typedLocale,
  'core',
  'ideCompat',
  'compatibility',
  'installSetup',
  'docs',
  'workflowAutomation',
  'processAutomation',
  'templates',
  ['Cursor skill setup', 'Claude Code install guide', 'VS Code AI skills', 'supported IDEs', 'Killer-Skills'],
);

const integrations = [
  {
    name: 'Cursor',
    desc: t('Integrations.cards.cursor.desc'),
    icon: '🖱️',
    link: 'https://cursor.sh',
  },
  {
    name: 'Windsurf',
    desc: t('Integrations.cards.windsurf.desc'),
    icon: '🏄',
    link: 'https://codeium.com/windsurf',
  },
  {
    name: 'Claude Code',
    desc: t('Integrations.cards.claude.desc'),
    icon: '🧠',
    link: 'https://claude.ai',
  },
  {
    name: 'Goose',
    desc: t('Integrations.cards.goose.desc'),
    icon: '🪿',
    link: 'https://github.com/block/goose',
  },
];
const heroTitle = isZh ? '你的 IDE 已经支持 AI Agent Skills' : 'Your IDE Already Supports AI Agent Skills';
const heroIntro = isZh
  ? '如果你在找“Cursor skills”“Claude Code skills”或“VS Code agent skills”，这里就是兼容性总览页。Killer-Skills 会自动识别 IDE 并写入正确格式。'
  : 'If you are searching for Cursor skills, Claude Code skills, or VS Code agent skills, this page is the compatibility overview. Killer-Skills auto-detects your IDE and writes the correct native format.';
const intentLinks = [
  {
    title: isZh ? '安装 AI Agent Skills' : 'Install AI Agent Skills',
    description: isZh ? '查看一条命令安装与首次配置步骤。' : 'See the one-command install and first-time setup flow.',
    href: `/${locale}/docs/installation`,
  },
  {
    title: isZh ? 'Cursor / Claude Code 配置' : 'Cursor / Claude Code Setup',
    description: isZh
      ? '了解不同 IDE 如何自动写入原生技能格式。'
      : 'Learn how each IDE gets its native skill format automatically.',
    href: `/${locale}/cli`,
  },
  {
    title: isZh ? '支持的 IDE 与兼容性' : 'Supported IDEs & Compatibility',
    description: isZh
      ? '快速查看当前支持的环境与适配范围。'
      : 'Review the supported environments and compatibility scope.',
    href: '#supported-ides',
  },
  {
    title: isZh ? '工作流与模板文档' : 'Workflow & Template Docs',
    description: isZh
      ? '从安装转到可复用流程与模板入口。'
      : 'Move from setup into reusable workflows and template entry points.',
    href: `/${locale}/docs`,
  },
];
const faqItems = [
  {
    question: isZh ? 'Killer-Skills 支持哪些 IDE？' : 'Which IDEs does Killer-Skills support?',
    answer: isZh
      ? 'Killer-Skills 支持 15+ AI 编程助手和 IDE，包括 Cursor、Windsurf、Claude Code、VS Code、JetBrains、Cline、Roo Code、Continue、Codex、Goose 等。'
      : 'Killer-Skills supports 15+ AI coding assistants and IDEs, including Cursor, Windsurf, Claude Code, VS Code, JetBrains, Cline, Roo Code, Continue, Codex, and Goose.',
  },
  {
    question: isZh ? '如何在 IDE 中安装 AI Agent Skill？' : 'How do I install an AI agent skill in my IDE?',
    answer: isZh
      ? '在终端运行 `npx killer-skills add owner/repo`。CLI 会自动识别当前 IDE，并写入对应的技能文件格式，无需手动配置。'
      : 'Run `npx killer-skills add owner/repo` in your terminal. The CLI auto-detects your IDE and writes the correct skill file format, so there is no manual setup.',
  },
  {
    question: isZh ? '同一个技能能否跨多个 IDE 使用？' : 'Can I use the same skill across multiple IDEs?',
    answer: isZh
      ? '可以。Killer-Skills 使用统一技能格式，在不同 IDE 中会自动转换为各自需要的配置文件。'
      : 'Yes. Killer-Skills uses a universal skill format and converts it into the native config each IDE expects.',
  },
];
---

<Layout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  customCanonical={canonicalUrl}
>
  <Fragment slot="head">
    {/* BreadcrumbList JSON-LD */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          { '@type': 'ListItem', position: 1, name: t('Common.home'), item: `https://killer-skills.com/${locale}` },
          {
            '@type': 'ListItem',
            position: 2,
            name: pageTitle,
            item: canonicalUrl,
          },
        ],
      })}
    />
    {/* ItemList JSON-LD for integrations */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'ItemList',
        name: pageTitle,
        description: pageDescription,
        numberOfItems: integrations.length,
        itemListElement: integrations.map((item, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          name: item.name,
          url: item.link,
        })),
      })}
    />
    {/* FAQ Schema — high-value for "Which IDEs support AI agent skills?" queries */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      })}
    />
    {/* Speakable Schema for AI citation */}
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: pageTitle,
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['h1', '.seo-intro-paragraph', 'h2'],
        },
        url: canonicalUrl,
      })}
    />
  </Fragment>
  <div class="bg-slate-50/50 dark:bg-slate-950/50 min-h-screen">
    <!-- Hero Section -->
    <div
      class="bg-white dark:bg-slate-900 border-b border-slate-200 dark:border-slate-800 pt-12 pb-8 md:pt-16 md:pb-12"
    >
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-3xl md:text-4xl font-bold text-slate-900 dark:text-white mb-4 tracking-tight">
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-600 to-blue-600">
            {heroTitle}
          </span>
        </h1>
        <p class="seo-intro-paragraph text-lg text-slate-600 dark:text-slate-400 leading-relaxed max-w-2xl">
          {pageDescription}
        </p>
        <p class="mt-3 max-w-2xl text-sm text-slate-500 dark:text-slate-400">{heroIntro}</p>
      </div>
    </div>

    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
      <section class="mb-10 grid gap-4 md:grid-cols-2">
        {
          intentLinks.map((item) => (
            <a
              href={item.href}
              class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:border-cyan-300 hover:shadow-md dark:border-slate-800 dark:bg-slate-900 dark:hover:border-cyan-700"
            >
              <h2 class="mb-2 text-lg font-semibold text-slate-900 dark:text-white">{item.title}</h2>
              <p class="text-sm leading-6 text-slate-600 dark:text-slate-400">{item.description}</p>
            </a>
          ))
        }
      </section>

      <!-- Integrations Grid -->
      <section id="supported-ides" class="mb-16 scroll-mt-24">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          {
            integrations.map((item) => (
              <a
                href={item.link}
                target="_blank"
                rel="noopener noreferrer"
                class="group bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-6 shadow-sm hover:shadow-md hover:border-cyan-300 dark:hover:border-cyan-700 transition-all duration-200"
              >
                <div class="flex items-center gap-4 mb-3">
                  <div class="text-3xl">{item.icon}</div>
                  <h2 class="text-lg font-semibold text-slate-900 dark:text-white group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">
                    {item.name}
                  </h2>
                </div>
                <p class="text-sm text-slate-500 dark:text-slate-400 mb-3">{item.desc}</p>
                <span class="text-sm text-cyan-600 dark:text-cyan-400 font-medium">
                  {t('Integrations.viewGuide')} →
                </span>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Protocol Section -->
      <section
        class="bg-white dark:bg-slate-900 rounded-2xl border border-slate-200 dark:border-slate-800 p-8 text-center"
      >
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">
          {t('Integrations.missingTool')}
        </h2>
        <p class="text-slate-600 dark:text-slate-400 mb-6 max-w-lg mx-auto">
          {t('Integrations.missingToolDesc')}
        </p>
        <a
          href={`/${locale}/docs`}
          class="inline-flex items-center px-6 py-2.5 bg-cyan-600 hover:bg-cyan-700 text-white font-medium rounded-xl transition-colors text-sm shadow-lg shadow-cyan-500/20"
        >
          {t('Integrations.learnProtocol')} →
        </a>
      </section>

      <section class="mt-10 grid gap-4 md:grid-cols-3">
        {
          faqItems.map((item) => (
            <article class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-800 dark:bg-slate-900">
              <h2 class="mb-3 text-lg font-semibold text-slate-900 dark:text-white">{item.question}</h2>
              <p class="text-sm leading-6 text-slate-600 dark:text-slate-400">{item.answer}</p>
            </article>
          ))
        }
      </section>
    </div>
  </div>
</Layout>
