---
import Layout from '../../../layouts/Layout.astro';
import SkillCard from '../../../components/SkillCard.astro';
import { SUPPORTED_LOCALES, loadMessages, translateOr, useTranslations, type Locale } from '../../../i18n';
import { getAuthoritySurfaceEntries } from '../../../lib/authority-surfaces';
import { buildKeywordString } from '../../../lib/seo-keywords';
import { getLightweightSkillsByRefs, getLightweightSkillsTop, type UnifiedSkill } from '../../../lib/skills';
import { getPreferredCanonicalLocale, isDirectlyLocalizedVariant } from '../../../lib/seo-locales';
import {
  getSolutionIntentBySlug,
  getSolutionIntents,
  getSolutionSeoEligibleLocales,
  matchSkillsForIntent,
  type SolutionSlug,
} from '../../../lib/solution-intents';
import { buildLocalizedSkillPath, getSkillRoutePath } from '../../../lib/skill-route-paths';
import { resolveSkillDetailLocale } from '../../../lib/skill-locale-link';
import type { Env } from '../../../lib/kv';

export const prerender = false;
Astro.response.headers.set('Cache-Control', 'public, s-maxage=86400, stale-while-revalidate=86400');

const { locale, topic } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const typedLocale = locale as Locale;
const isZhCopy = typedLocale.startsWith('zh');
const intent = getSolutionIntentBySlug(typedLocale, topic || '');
if (!intent) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const env = Astro.locals.runtime?.env as Env;
const SOLUTION_SKILL_SAMPLE_LIMIT = 240;

const solutionFeaturedSkillRefsBySlug: Partial<Record<SolutionSlug, string[]>> = {
  'agent-workflows': [
    'anthropics/skills/claude-api',
    'cloudflare/skills/building-mcp-server-on-cloudflare',
    'n8n-io/n8n/spec-driven-development',
    'getsentry/skills/security-review',
    'langgenius/dify/orpc-contract-first',
    'vercel-labs/skills/find-skills',
  ],
};
const solutionDecisionTrackSkillRefsBySlug: Partial<Record<SolutionSlug, string[]>> = {
  'agent-workflows': [
    'anthropics/skills/claude-api',
    'cloudflare/skills/building-mcp-server-on-cloudflare',
    'vercel-labs/skills/find-skills',
    'getsentry/skills/security-review',
    'n8n-io/n8n/spec-driven-development',
    'affaan-m/everything-claude-code/context-budget',
    'langgenius/dify/orpc-contract-first',
    'ComposioHQ/awesome-claude-skills',
    'expo/skills/expo-api-routes',
  ],
};
const solutionExactSkillRefs = Array.from(
  new Set([
    ...(solutionFeaturedSkillRefsBySlug[intent.slug] || []),
    ...(solutionDecisionTrackSkillRefsBySlug[intent.slug] || []),
  ]),
);

const [baseSkillsFetched, exactSkillsFetched, messages] = await Promise.all([
  getLightweightSkillsTop(env, SOLUTION_SKILL_SAMPLE_LIMIT).catch(() => [] as UnifiedSkill[]),
  solutionExactSkillRefs.length > 0
    ? getLightweightSkillsByRefs(env, solutionExactSkillRefs).catch(() => [] as UnifiedSkill[])
    : Promise.resolve([] as UnifiedSkill[]),
  loadMessages(typedLocale),
]);
const skillsFetched = Array.from(
  new Map([...baseSkillsFetched, ...exactSkillsFetched].map((skill) => [skill.id, skill])).values(),
);

const t = useTranslations(messages);
const tr = (key: string, fallback: string) => translateOr(messages, key, fallback);
const allIntents = getSolutionIntents(typedLocale).filter((item) => item.slug !== (topic as SolutionSlug));
const availableLocales = getSolutionSeoEligibleLocales(intent.slug);
const canonicalLocale = getPreferredCanonicalLocale(availableLocales);
const isDirectlyLocalized = isDirectlyLocalizedVariant(availableLocales, typedLocale);
const isIndexableLocale = isDirectlyLocalized && typedLocale === canonicalLocale;
const canonicalUrl = `https://killer-skills.com/${canonicalLocale}/solutions/${intent.slug}`;
const pageTitle = intent.pageTitle;
const pageDescription = intent.pageDescription;
const buildSkillDetailHref = (skill: UnifiedSkill) => {
  const routePath = getSkillRoutePath(skill) || skill.repo;
  const detailLocale = resolveSkillDetailLocale(skill.owner, routePath, locale);
  return buildLocalizedSkillPath(detailLocale, skill.owner, routePath);
};
const buildSkillDetailUrl = (skill: UnifiedSkill) => `https://killer-skills.com${buildSkillDetailHref(skill)}`;

const pageKeywords = buildKeywordString(
  t,
  'core',
  'ideCompat',
  ...intent.keywordClusters,
  intent.query,
  intent.queries,
  'Killer-Skills',
);

const displaySkills: UnifiedSkill[] = matchSkillsForIntent(skillsFetched, intent, typedLocale, 60);
const skillsById = new Map(skillsFetched.map((skill) => [skill.id, skill]));
const resolveSkillsByRefs = (refs: string[]) =>
  refs.map((ref) => skillsById.get(ref)).filter((skill): skill is UnifiedSkill => Boolean(skill));
const featuredSolutionSkills = (
  solutionFeaturedSkillRefsBySlug[intent.slug]?.length
    ? resolveSkillsByRefs(solutionFeaturedSkillRefsBySlug[intent.slug] || [])
    : displaySkills.slice(0, 6)
).slice(0, 6);
const featuredSolutionSkillIds = new Set(featuredSolutionSkills.map((skill) => skill.id));
const secondarySkillLimit = intent.slug === 'agent-workflows' ? 6 : 9;
const secondaryDisplaySkills = displaySkills
  .filter((skill) => !featuredSolutionSkillIds.has(skill.id))
  .slice(0, secondarySkillLimit);
const solutionReviewMeta = {
  reviewedAt: '2026-04-20',
  maintainedBy: isZhCopy
    ? '由 Killer-Skills 团队持续维护，并定期检查内容准确性、安装路径与可用性'
    : 'Maintained by the Killer-Skills team with recurring checks for accuracy, installation, and usability',
  verification: isZhCopy
    ? '场景说明、代表技能、安装入口、CLI 使用说明与相关资源'
    : 'Scenario overview, representative skills, installation links, CLI guidance, and related resources',
  audience: isZhCopy
    ? '适合已经知道自己要解决哪类工作流问题的团队。'
    : 'This page serves people who already know the workflow problem they need to solve.',
};
const solutionReviewSignals = [
  isZhCopy
    ? '先解释这组技能适合什么场景，再给出可安装的候选项。'
    : 'Start with the scenario, then show the installable skills that fit it.',
  isZhCopy
    ? '代表技能提供起点，安装文档和 CLI 指南帮助你继续完成设置。'
    : 'Representative skills provide a starting point, while installation docs and CLI guidance help you complete setup.',
  isZhCopy
    ? '如果你已经知道问题类型，就可以直接比较适合该场景的技能。'
    : 'Once the problem type is clear, compare skills that match that scenario directly.',
];
const solutionAuthorityBridgeIdsBySlug: Partial<Record<SolutionSlug, string[]>> = {
  'agent-workflows': [
    'docs-installation',
    'docs-cli-overview',
    'collection-official-trusted-tools',
    'collection-agent-workflows',
  ],
};
const solutionAuthorityBridges = getAuthoritySurfaceEntries(typedLocale, {
  ids: solutionAuthorityBridgeIdsBySlug[intent.slug] || [
    'docs-installation',
    'docs-cli-overview',
    'collection-official-trusted-tools',
    'collection-agent-workflows',
  ],
});
const solutionDecisionTracks =
  intent.slug === 'agent-workflows'
    ? [
        {
          badge: isZhCopy ? 'TRUST' : 'TRUST',
          title: isZhCopy ? '先选可信锚点，再扩到工作流' : 'Pick a Trusted Anchor Before You Expand the Workflow',
          description: isZhCopy
            ? '如果当前最重要的是先把第一条团队路径跑通，就从官方或高可信生态工具切入，再决定是否继续扩到更复杂的 workflow builder。'
            : 'If the immediate goal is to make the first team path work, start with official or strongly trusted ecosystem tools before you expand into broader workflow builders.',
          whenToUse: isZhCopy
            ? '适合团队刚开始标准化、或你还不想把第一次安装建立在不稳定社区信号上的时候。'
            : 'Use it when the team is just standardizing, or when you do not want the first install to depend on unstable community signals.',
          checkpoints: isZhCopy
            ? [
                '先确认归属、安装文档和发布姿态都足够清楚。',
                '让第一条安装路径先服务真实工作流，而不是继续做工具比较。',
                '安装完成后，用 CLI 指南确认环境配置是否可用。',
              ]
            : [
                'Confirm ownership, install docs, and release posture before you move.',
                'Make the first install serve a real workflow instead of another tool comparison loop.',
                'After installation, use the CLI guide to confirm the environment is ready.',
              ],
          skillRefs: [
            'anthropics/skills/claude-api',
            'cloudflare/skills/building-mcp-server-on-cloudflare',
            'vercel-labs/skills/find-skills',
          ],
          primaryHref: `/${locale}/collections/top-official-ai-skills-trusted-tools`,
          primaryLabel: isZhCopy ? '回到官方可信工具合集' : 'Open Official Trusted Tools',
        },
        {
          badge: isZhCopy ? 'OPS' : 'OPS',
          title: isZhCopy ? '补齐团队协作与执行规范' : 'Add Team Practices and Execution Discipline',
          description: isZhCopy
            ? '如果技术上已经能装起来，但团队执行仍然容易漂移，就先明确协作方式、上下文预算和日常使用方式。'
            : 'If the tools can already be installed technically but team execution still drifts, clarify collaboration, context budget, and spec discipline before you expand the stack.',
          whenToUse: isZhCopy
            ? '适合安装本身不是瓶颈，真正瓶颈是协作衔接、权限边界和失败处理的时候。'
            : 'Use it when installation is not the bottleneck, but coordination, access boundaries, and failure handling still are.',
          checkpoints: isZhCopy
            ? [
                '先明确谁负责安全评审、谁负责规范执行、谁负责上下文边界。',
                '不要把“装上了”误当成“团队已经可控”。',
                '把 CLI 行为和检查清单整理成可复用操作流程。',
              ]
            : [
                'Define who owns security review, spec discipline, and context boundaries first.',
                'Do not confuse “it installed” with “the team now has control”.',
                'Turn CLI behavior and setup checks into a reusable team workflow.',
              ],
          skillRefs: [
            'getsentry/skills/security-review',
            'n8n-io/n8n/spec-driven-development',
            'affaan-m/everything-claude-code/context-budget',
          ],
          primaryHref: `/${locale}/docs/cli/overview`,
          primaryLabel: isZhCopy ? '打开 CLI 总览' : 'Open CLI Overview',
        },
        {
          badge: isZhCopy ? 'BUILD' : 'BUILD',
          title: isZhCopy ? '把可信路径扩成可复用工作流栈' : 'Expand the Trusted Path Into a Reusable Workflow Stack',
          description: isZhCopy
            ? '当第一条可信安装路径和团队规范都清楚之后，再决定哪些 workflow builder、集成能力和 IDE 技能应进入下一条执行链路。'
            : 'After the trusted install path and team practices are clear, decide which workflow builders, integration layers, and IDE-native skills belong in the next execution lane.',
          whenToUse: isZhCopy
            ? '适合你已经不再选“第一条路径”，而是在决定“下一条可复用工作流栈”时。'
            : 'Use it when you are no longer choosing the first path, but the next reusable workflow stack.',
          checkpoints: isZhCopy
            ? [
                '下一项工具是在扩展现有可信栈，而不是重新推倒重选。',
                '要让每个新增能力都能映射回具体场景和关键检查步骤。',
                '安装之后，继续回到 collections 或 solution，而不是重新刷全量目录。',
              ]
            : [
                'Each added tool extends the trusted stack instead of resetting the choice from scratch.',
                'Map every new capability back to a concrete scenario and a clear setup check.',
                'After installation, continue through collections or solutions instead of the full directory.',
              ],
          skillRefs: [
            'langgenius/dify/orpc-contract-first',
            'ComposioHQ/awesome-claude-skills',
            'expo/skills/expo-api-routes',
          ],
          primaryHref: `/${locale}/collections/top-agent-workflow-building-tools`,
          primaryLabel: isZhCopy ? '进入工作流合集' : 'Open Workflow Collection',
        },
      ]
    : [];
const resolvedSolutionDecisionTracks = solutionDecisionTracks.map((track) => ({
  ...track,
  shortlistedSkills: resolveSkillsByRefs(track.skillRefs).map((skill) => ({
    id: skill.id,
    name: skill.name || skill.skillName || skill.repo,
    href: buildSkillDetailHref(skill),
  })),
}));

const faqItems = [
  {
    question: t('Solutions.faq1QTemplate').replace('{label}', intent.label),
    answer: intent.pageDescription,
  },
  { question: t('Solutions.faq2Q'), answer: t('Solutions.faq2A') },
  { question: t('Solutions.faq3Q'), answer: t('Solutions.faq3A') },
];
const solutionSignificantLinks = solutionAuthorityBridges
  .slice(0, 4)
  .map((surface) => `https://killer-skills.com${surface.href}`);
---

<Layout
  locale={locale}
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  customCanonical={canonicalUrl}
  noindex={!isIndexableLocale}
  availableLocales={availableLocales}
  xDefaultLocale={canonicalLocale}
>
  <Fragment slot="head">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: pageTitle,
        description: pageDescription,
        url: canonicalUrl,
        isPartOf: { '@type': 'WebSite', name: 'Killer-Skills', url: 'https://killer-skills.com' },
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: displaySkills.length,
          itemListElement: displaySkills.slice(0, 20).map((skill, index) => ({
            '@type': 'ListItem',
            position: index + 1,
            url: buildSkillDetailUrl(skill),
            name: skill.name || skill.repo,
          })),
        },
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        name: pageTitle,
        description: pageDescription,
        url: canonicalUrl,
        inLanguage: typedLocale,
        dateModified: solutionReviewMeta.reviewedAt,
        isPartOf: { '@type': 'WebSite', name: 'Killer-Skills', url: 'https://killer-skills.com' },
        about: {
          '@type': 'DefinedTerm',
          name: intent.label,
          description: intent.pageDescription,
        },
        speakable: {
          '@type': 'SpeakableSpecification',
          cssSelector: ['h1', '.seo-intro-paragraph', 'h2'],
        },
        significantLink: solutionSignificantLinks,
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [
          {
            '@type': 'ListItem',
            position: 1,
            name: tr('Common.home', 'Home'),
            item: `https://killer-skills.com/${locale}`,
          },
          {
            '@type': 'ListItem',
            position: 2,
            name: t('Solutions.solutions'),
            item: `https://killer-skills.com/${locale}/solutions`,
          },
          {
            '@type': 'ListItem',
            position: 3,
            name: intent.label,
            item: canonicalUrl,
          },
        ],
      })}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      })}
    />
  </Fragment>

  <div class="min-h-screen bg-[var(--background)] text-[var(--foreground)] font-sans">
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 md:py-20">
      <header class="mb-10 border-b-[3px] border-[var(--border)] pb-8">
        <a
          href={`/${locale}/solutions`}
          class="inline-flex items-center px-3 py-1.5 border-2 border-[var(--border)] text-xs font-black uppercase tracking-widest hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-colors"
        >
          {t('Solutions.backToSolutions')}
        </a>
        <div
          class="mt-4 inline-flex px-3 py-1 border-2 border-[var(--border)] bg-[var(--primary)] text-[var(--primary-foreground)] text-xs font-black uppercase tracking-widest"
        >
          {intent.query}
        </div>
        <h1 class="mt-4 text-4xl md:text-6xl font-black tracking-tight uppercase">{pageTitle}</h1>
        <p
          class="seo-intro-paragraph mt-4 max-w-3xl text-base md:text-lg font-medium text-[var(--muted-foreground)] leading-relaxed"
        >
          {pageDescription}
        </p>
      </header>

      <section
        class="mb-10 border-[3px] border-[var(--border)] bg-[var(--background)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--border)]"
      >
        <div class="max-w-3xl mb-6">
          <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
            {isZhCopy ? '如何选择' : 'How To Choose'}
          </div>
          <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight text-[var(--foreground)] mb-3">
            {isZhCopy ? '从场景出发，找到适合安装的技能' : 'Start From the Scenario, Then Pick Skills to Install'}
          </h2>
          <p class="text-base md:text-lg leading-8 font-medium text-[var(--muted-foreground)]">
            {
              isZhCopy
                ? '这个页面按具体问题组织技能，帮助你先理解当前场景，再选择代表技能、安装入口和相关资源。'
                : 'This page groups skills around a concrete problem so you can understand the scenario, pick a starting skill, and continue into installation resources.'
            }
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-4 mb-8">
          <div class="border-[3px] border-[var(--border)] bg-[var(--card)] p-4">
            <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-2">
              {isZhCopy ? '最近更新' : 'Updated On'}
            </div>
            <div class="text-sm font-black leading-6">{solutionReviewMeta.reviewedAt}</div>
          </div>
          <div class="border-[3px] border-[var(--border)] bg-[var(--card)] p-4">
            <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-2">
              {isZhCopy ? '维护方式' : 'Maintained By'}
            </div>
            <div class="text-sm font-black leading-6">{solutionReviewMeta.maintainedBy}</div>
          </div>
          <div class="border-[3px] border-[var(--border)] bg-[var(--card)] p-4">
            <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-2">
              {isZhCopy ? '覆盖内容' : 'What This Covers'}
            </div>
            <div class="text-sm font-black leading-6">{solutionReviewMeta.verification}</div>
          </div>
          <div class="border-[3px] border-[var(--border)] bg-[var(--card)] p-4">
            <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-2">
              {isZhCopy ? '适用对象' : 'Primary Audience'}
            </div>
            <div class="text-sm font-black leading-6">{solutionReviewMeta.audience}</div>
          </div>
        </div>

        <div class="border-t-[3px] border-[var(--border)] pt-6">
          <h3 class="text-xl font-black uppercase tracking-tight text-[var(--foreground)] mb-4">
            {isZhCopy ? '这页会帮你完成的 3 件事' : 'Three Things This Page Helps You Do'}
          </h3>
          <ul class="space-y-3">
            {
              solutionReviewSignals.map((item) => (
                <li class="text-sm md:text-base leading-7 font-medium text-[var(--muted-foreground)]">- {item}</li>
              ))
            }
          </ul>
        </div>
      </section>

      {
        resolvedSolutionDecisionTracks.length > 0 && (
          <section class="mb-10 border-[3px] border-[var(--border)] bg-[var(--background)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--border)]">
            <div class="max-w-4xl mb-8">
              <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                {isZhCopy ? '场景轨道' : 'Scenario Tracks'}
              </div>
              <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
                {isZhCopy
                  ? '先判断你当前卡在哪一条 Agent 工作流链路里'
                  : 'Start With the Agent Workflow Lane You Are Actually Blocked On'}
              </h2>
              <p class="text-base md:text-lg text-[var(--muted-foreground)] leading-relaxed font-medium">
                {isZhCopy
                  ? '先确认你当前卡在首次安装、团队协作规范，还是工作流扩展，再进入对应轨道。'
                  : 'First decide whether you are blocked on the first install, team practices, or workflow expansion, then move into the matching lane.'}
              </p>
            </div>

            <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
              {resolvedSolutionDecisionTracks.map((track) => (
                <article class="border-[3px] border-[var(--border)] bg-[var(--background)] p-5 shadow-[6px_6px_0px_0px_var(--border)]">
                  <div class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                    {track.badge}
                  </div>
                  <h3 class="text-xl font-black uppercase tracking-tight mb-3">{track.title}</h3>
                  <p class="text-sm leading-6 font-medium text-[var(--muted-foreground)] mb-4">{track.description}</p>
                  <p class="text-xs leading-6 font-bold text-[var(--foreground)]/85 border-l-2 border-[var(--primary)] pl-3 mb-4">
                    {track.whenToUse}
                  </p>
                  <ul class="space-y-2 mb-5">
                    {track.checkpoints.map((checkpoint) => (
                      <li class="text-sm leading-6 font-medium text-[var(--foreground)]/85">- {checkpoint}</li>
                    ))}
                  </ul>
                  {track.shortlistedSkills.length > 0 && (
                    <div class="mb-5">
                      <h4 class="text-[10px] font-black uppercase tracking-widest text-[var(--primary)] mb-2">
                        {isZhCopy ? '先看这组代表技能' : 'Start With These Representative Skills'}
                      </h4>
                      <div class="flex flex-wrap gap-2">
                        {track.shortlistedSkills.map((skill) => (
                          <a
                            href={skill.href}
                            class="inline-flex items-center gap-2 px-3 py-2 bg-[var(--card)] border-2 border-[var(--border)] font-bold text-xs text-[var(--foreground)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:border-[var(--primary)] shadow-[2px_2px_0px_0px_var(--border)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] transition-all"
                          >
                            <span class="text-[var(--primary)] text-[10px]">■</span>
                            {skill.name}
                          </a>
                        ))}
                      </div>
                    </div>
                  )}
                  <a
                    href={track.primaryHref}
                    class="inline-flex items-center px-4 py-2 border-2 border-[var(--foreground)] font-black text-xs uppercase tracking-widest hover:-translate-x-[2px] hover:-translate-y-[2px] hover:shadow-[4px_4px_0px_0px_var(--border)] transition-all"
                  >
                    {track.primaryLabel}
                  </a>
                </article>
              ))}
            </div>
          </section>
        )
      }

      {
        featuredSolutionSkills.length > 0 && (
          <section class="mb-10">
            <div class="max-w-3xl mb-6">
              <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                {isZhCopy ? '代表技能入口' : 'Representative Skill Entry Points'}
              </div>
              <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
                {isZhCopy ? '先从这组更像“起点”的技能开始' : 'Start With the Skills That Behave Like Real Entry Points'}
              </h2>
              <p class="text-base md:text-lg text-[var(--muted-foreground)] leading-relaxed font-medium">
                {isZhCopy
                  ? '这组技能不是为了覆盖一切，而是作为更适合当前场景的起点，帮助你更快进入安装、配置和实际使用。'
                  : 'These skills are not meant to cover everything. They are practical starting points for installation, setup, and real use in this scenario.'}
              </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
              {featuredSolutionSkills.map((skill) => (
                <SkillCard skill={skill} locale={locale} messages={messages} t={t} />
              ))}
            </div>
          </section>
        )
      }

      {
        solutionAuthorityBridges.length > 0 && (
          <section class="mb-10 border-[3px] border-[var(--border)] bg-[var(--background)] p-6 md:p-8 shadow-[8px_8px_0px_0px_var(--border)]">
            <div class="max-w-3xl mb-6">
              <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                {isZhCopy ? '推荐路径' : 'Recommended Paths'}
              </div>
              <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
                {isZhCopy ? '场景判断之后，继续进入更具体的执行入口' : 'Continue Into More Actionable Paths'}
              </h2>
              <p class="text-base md:text-lg text-[var(--muted-foreground)] leading-relaxed font-medium">
                {isZhCopy
                  ? '选定场景后，继续进入安装文档、CLI 总览、可信合集或工作流合集，把选择推进成可执行动作。'
                  : 'Once the scenario is clear, continue into installation docs, the CLI overview, trusted collections, or workflow collections so the choice becomes actionable.'}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-4 gap-5">
              {solutionAuthorityBridges.map((surface) => (
                <a
                  href={surface.href}
                  class="border-[3px] border-[var(--border)] bg-[var(--background)] p-5 hover:-translate-x-[3px] hover:-translate-y-[3px] hover:shadow-[6px_6px_0px_0px_var(--border)] transition-all"
                >
                  <h2 class="text-lg font-black uppercase tracking-tight mb-2">{surface.title}</h2>
                  <p class="text-sm leading-6 font-medium text-[var(--muted-foreground)] mb-3">{surface.description}</p>
                </a>
              ))}
            </div>
          </section>
        )
      }

      {
        secondaryDisplaySkills.length > 0 && (
          <section class="mb-10">
            <div class="max-w-3xl mb-6">
              <div class="text-xs font-black uppercase tracking-widest text-[var(--primary)] mb-3">
                {isZhCopy ? '补充兼容技能' : 'Additional Compatible Skills'}
              </div>
              <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-3">
                {isZhCopy
                  ? '当代表入口还不够时，再继续看这组补充候选'
                  : 'Use These Broader Candidates Only After the Entry Points Are Clear'}
              </h2>
              <p class="text-base md:text-lg text-[var(--muted-foreground)] leading-relaxed font-medium">
                {isZhCopy
                  ? '这组卡片是当前场景的补充候选。先用上方代表技能和相关资源缩小范围，再决定是否继续扩展。'
                  : 'These cards are supporting candidates for the scenario. Use the representative skills and related resources above to narrow the choice before you expand further.'}
              </p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6">
              {secondaryDisplaySkills.map((skill) => (
                <SkillCard skill={skill} locale={locale} messages={messages} t={t} />
              ))}
            </div>
          </section>
        )
      }

      {
        displaySkills.length === 0 && (
          <div class="mb-10 text-center py-16 border-4 border-dashed border-[var(--border)] bg-[var(--background)]">
            <p class="text-[var(--muted-foreground)] font-mono font-bold text-lg">{t('Solutions.noSkills')}</p>
          </div>
        )
      }

      <section class="grid grid-cols-1 md:grid-cols-3 gap-4">
        {
          allIntents.slice(0, 3).map((item) => (
            <a
              href={item.href}
              class="border-2 border-[var(--border)] p-5 hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-colors"
            >
              <div class="text-xs font-mono font-black uppercase tracking-widest mb-2">{item.query}</div>
              <h2 class="text-lg font-black uppercase tracking-tight mb-1">{item.label}</h2>
              <p class="text-sm font-medium opacity-80 leading-6">{item.cardDescription}</p>
            </a>
          ))
        }
      </section>
    </main>
  </div>
</Layout>
