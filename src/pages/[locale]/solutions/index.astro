---
import Layout from '../../../layouts/Layout.astro';
import MarketplaceSimplePage from '../../../components/MarketplaceSimplePage.astro';
import { SUPPORTED_LOCALES, type Locale } from '../../../i18n';

const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const isZhCopy = locale.startsWith('zh');
const title = isZhCopy ? '自动化解决方案' : 'Automation Solutions';
const description = isZhCopy
  ? '从职业、分类或榜单进入实际工作流，按任务场景找到可安装的 AI Agent Skills。'
  : 'Start from occupations, categories, or rankings to find installable AI agent skills for real automation workflows.';
---

<Layout locale={locale} title={title} description={description} appendBrand={false}>
  <MarketplaceSimplePage title={title} description={description}>
    <div class="marketplace-card-grid">
      <a class="marketplace-card-link" href={`/${locale}/occupations`}>
        <h3>{isZhCopy ? '职业' : 'Occupations'}</h3>
        <p>{isZhCopy ? '按岗位进入任务路径。' : 'Browse by role and task path.'}</p>
      </a>
      <a class="marketplace-card-link" href={`/${locale}/categories`}>
        <h3>{isZhCopy ? '分类' : 'Categories'}</h3>
        <p>{isZhCopy ? '按能力类型进入。' : 'Browse by capability type.'}</p>
      </a>
      <a class="marketplace-card-link" href={`/${locale}/popular`}>
        <h3>{isZhCopy ? '榜单' : 'Rankings'}</h3>
        <p>{isZhCopy ? '查看热门和最新。' : 'View popular and latest.'}</p>
      </a>
    </div>
  </MarketplaceSimplePage>
</Layout>
