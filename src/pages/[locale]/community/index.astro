---
import Layout from '../../../layouts/Layout.astro';
import MarketplaceSimplePage from '../../../components/MarketplaceSimplePage.astro';
import { SUPPORTED_LOCALES, type Locale } from '../../../i18n';

const { locale } = Astro.params;
if (!locale || !SUPPORTED_LOCALES.includes(locale as Locale)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const isZhCopy = locale.startsWith('zh');
const title = isZhCopy ? '社区 Skills' : 'Community Skills';
const description = isZhCopy
  ? '社区来源是来源属性，可在 Skills 目录中筛选。'
  : 'Community is a source attribute available in the Skills directory.';
---

<Layout locale={locale} title={title} description={description} appendBrand={false}>
  <MarketplaceSimplePage title={title} description={description}>
    <div class="marketplace-card-grid">
      <a class="marketplace-card-link" href={`/${locale}/skills?source=community`}>
        <h3>{isZhCopy ? '社区来源' : 'Community source'}</h3>
        <p>{isZhCopy ? '查看社区来源 Skills。' : 'View community-sourced skills.'}</p>
      </a>
      <a class="marketplace-card-link" href={`/${locale}/safe`}>
        <h3>{isZhCopy ? '审核政策' : 'Review Policy'}</h3>
        <p>{isZhCopy ? '社区来源同样需要通过基础准入。' : 'Community sources still pass baseline admission.'}</p>
      </a>
    </div>
  </MarketplaceSimplePage>
</Layout>
