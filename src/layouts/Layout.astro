---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CommandBar from '../components/CommandBar';
import { ClientRouter } from 'astro:transitions';
import { loadMessages, translateOr, useTranslations, type Locale } from '../i18n';
import { buildPageMetadata } from '../lib/site/metadata';
import { ADSENSE_SCRIPT_SRC } from '../lib/site-config';

interface Props {
  locale: string;
  title: string;
  description?: string;
  keywords?: string;
  image?: string;
  showFooter?: boolean;
  appendBrand?: boolean;
  noindex?: boolean;
  ogType?: 'website' | 'article' | 'book' | 'profile' | 'product';
  customCanonical?: string;
  availableLocales?: string[];
  xDefaultLocale?: string;
  brandSuffix?: 'full' | 'short';
  robots?: string;
  jsonLd?: string | Record<string, any>;
}

const SITE_URL = import.meta.env.SITE ?? 'https://killer-skills.com';
const buildSha = import.meta.env.PUBLIC_GITHUB_SHA;

const {
  locale,
  title,
  description = 'The ultimate directory of AI Development Skills for Agents.',
  keywords,
  image = '/og-image.webp',
  showFooter = true,
  appendBrand = true,
  noindex = false,
  ogType = 'website',
  customCanonical,
  availableLocales,
  xDefaultLocale: customXDefaultLocale,
  brandSuffix,
  robots,
  jsonLd,
} = Astro.props;

// RTL support for Arabic
const isRtl = locale === 'ar';

let messages;
// Removed unused t
try {
  messages = await loadMessages(locale as Locale);
  useTranslations(messages);
} catch (e) {
  console.error(`[Layout] Error loading translations for ${locale}:`, e);
}

// Build absolute image URL for OG/Twitter meta tags
const absoluteImage = image.startsWith('http') ? image : `${SITE_URL}${image}`;
const metadata = buildPageMetadata({
  pathname: Astro.url.pathname,
  locale,
  title,
  description,
  customCanonical,
  availableLocales,
  xDefaultLocale: customXDefaultLocale,
  appendBrand,
  brandSuffix,
  siteUrl: SITE_URL,
});
const robotsContent =
  robots ||
  (noindex ? 'noindex, nofollow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1');
---

<!doctype html>
<html lang={locale} dir={isRtl ? 'rtl' : 'ltr'} data-adsense={ADSENSE_SCRIPT_SRC}>
  <head>
    <meta charset="UTF-8" />
    {buildSha && <meta name="x-build-sha" content={buildSha} />}
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

    <!-- Preconnect to critical third-party origins (improves LCP/FCP) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://avatars.githubusercontent.com" crossorigin />
    <link rel="preconnect" href="https://pagead2.googlesyndication.com" crossorigin />
    <link rel="dns-prefetch" href="https://github.com" />
    <link rel="dns-prefetch" href="https://googleads.g.doubleclick.net" />

    <!--
      Font loading: `rel="preload" as="style"` starts the stylesheet download
      immediately without blocking the parser. A separate <script> below
      promotes it to a real stylesheet on load. We avoid inline `onload=`
      attributes so a strict CSP (no `'unsafe-inline'` for script-src) keeps
      working — the script tag itself is auto-hashed by Astro experimental
      CSP. The <noscript> fallback covers crawlers / no-JS.
    -->
    <link
      id="ks-fonts-preload"
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700;800&display=swap"
    />
    <script>
      (function () {
        const l = document.getElementById('ks-fonts-preload') as HTMLLinkElement | null;
        if (!l) return;
        const fontLink = l;
        function swap() {
          fontLink.rel = 'stylesheet';
        }
        // If already cached, fire immediately; otherwise wait for load.
        if (fontLink.sheet) swap();
        else fontLink.addEventListener('load', swap, { once: true });
      })();
    </script>
    <noscript
      ><link
        href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;700;800&display=swap"
        rel="stylesheet"
      /></noscript
    >

    <meta name="description" content={metadata.description} />
    <meta name="robots" content={robotsContent} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Canonical URL -->
    <link rel="canonical" href={metadata.canonicalUrl} />

    <!-- hreflang for multilingual SEO -->
    {metadata.alternates.map(({ locale: loc, href }) => <link rel="alternate" hreflang={loc} href={href} />)}
    <link rel="alternate" hreflang="x-default" href={metadata.xDefaultUrl} />

    {
      /*
        SEO keywords: Google and Bing have publicly ignored <meta name="keywords">
        for over a decade. Baidu and Yandex still read it. To avoid wasted bytes
        on every page (×10 locales) we only emit the tag for locales whose
        primary search engine still consumes it. Callers can still pass an
        explicit `keywords` prop to force-emit.
      */
    }
    {
      (keywords || locale === 'zh' || locale === 'ru') && (
        <meta
          name="keywords"
          content={keywords || translateOr(messages || {}, 'Metadata.keywords', 'Killer-Skills, AI agent skills')}
        />
      )
    }

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Killer-Skills" />
    <meta property="og:title" content={metadata.socialTitle} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={metadata.socialTitle} />
    <meta property="og:url" content={metadata.canonicalUrl} />
    <meta property="og:locale" content={metadata.ogLocale} />
    <ClientRouter fallback="swap" />
    {/* OG alternate locales for social sharing */}
    {
      metadata.ogAlternateLocales.map((alternateLocale) => (
        <meta property="og:locale:alternate" content={alternateLocale} />
      ))
    }

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@killerskills" />
    <meta name="twitter:creator" content="@killerskills" />
    <meta name="twitter:title" content={metadata.socialTitle} />
    <meta name="twitter:description" content={metadata.description} />
    <meta name="twitter:image" content={absoluteImage} />
    <meta name="twitter:image:alt" content={metadata.socialTitle} />

    <title>{metadata.documentTitle}</title>

    {
      jsonLd && (
        <script type="application/ld+json" set:html={typeof jsonLd === 'string' ? jsonLd : JSON.stringify(jsonLd)} />
      )
    }

    <!-- AdSense: deferred to reduce initial network contention -->
    <script is:inline>
      // Load AdSense only after first paint to avoid competing with critical resources
      requestIdleCallback
        ? requestIdleCallback(() => {
            const s = document.createElement('script');
            s.src = document.documentElement.dataset.adsense || '';
            s.async = true;
            s.crossOrigin = 'anonymous';
            document.head.appendChild(s);
          })
        : setTimeout(() => {
            const s = document.createElement('script');
            s.src = document.documentElement.dataset.adsense || '';
            s.async = true;
            s.crossOrigin = 'anonymous';
            document.head.appendChild(s);
          }, 2000);
    </script>

    <!-- Theme Toggle Script (No FOUC) -->
    <script>
      const applyTheme = () => {
        const theme = (() => {
          if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
            return localStorage.getItem('theme');
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        })();

        if (theme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        return theme;
      };

      // Initial load
      applyTheme();

      // Handle Astro View Transitions
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <!-- Named slot for child-injected head tags (e.g. rel prev/next) -->
    <slot name="head" />
  </head>
  <body
    class="min-h-screen flex flex-col bg-[var(--background)] text-[var(--foreground)] selection:bg-[var(--primary)] selection:text-[var(--primary-foreground)]"
  >
    <a href="#main-content" class="skip-nav">{translateOr(messages || {}, 'Common.skipToContent', 'Skip to content')}</a
    >
    <Header locale={locale} messages={messages || {}} />

    <div id="main-content" class="flex-1 relative" role="main">
      <!-- Global Astro Navigation Loader -->
      <div
        id="route-progress"
        class="fixed top-0 left-0 w-full h-[3px] bg-cyan-500 z-[9999] origin-left scale-x-0 transition-transform duration-300 ease-out"
      >
      </div>
      <slot />
    </div>
    {showFooter && <Footer locale={locale} messages={messages || {}} />}

    <!-- Native Router Progress Script -->
    <script>
      // Global click interceptor to provide INSTANT visual feedback for SPA routing
      document.addEventListener('click', (e) => {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        const link = target.closest('a');
        if (
          link &&
          link.href &&
          link.hostname === window.location.hostname &&
          !link.hasAttribute('download') &&
          link.target !== '_blank' &&
          !e.defaultPrevented
        ) {
          const bar = document.getElementById('route-progress');
          if (bar) {
            bar.style.transition = 'transform 8s cubic-bezier(0.1, 0.8, 0.2, 1)';
            bar.style.transform = 'scaleX(0.85)';
            bar.style.opacity = '1';
          }
          document.body.style.cursor = 'wait';
        }
      });

      document.addEventListener('astro:before-preparation', () => {
        const bar = document.getElementById('route-progress');
        if (bar) {
          bar.style.transition = 'transform 3s cubic-bezier(0.1, 0.8, 0.2, 1)';
          bar.style.transform = 'scaleX(0.95)';
          bar.style.opacity = '1';
        }
      });

      document.addEventListener('astro:after-swap', () => {
        document.body.style.cursor = '';
        const bar = document.getElementById('route-progress');
        if (bar) {
          bar.style.transition = 'transform 0.2s ease-out';
          bar.style.transform = 'scaleX(1)';
          setTimeout(() => {
            bar.style.opacity = '0';
            setTimeout(() => {
              if (bar.style.opacity === '0') {
                bar.style.transition = 'none';
                bar.style.transform = 'scaleX(0)';
              }
            }, 200);
          }, 200);
        }
      });
    </script>

    <!-- Global: SkillCard Install Copy + Detail page "Install Now" (event delegation for View Transitions) -->
    <script>
      document.addEventListener('click', function (e) {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        // Detail page: big "Install Now" button (data-install-command)
        const installNowBtn = target.closest('[data-install-command]');
        if (installNowBtn && installNowBtn.id === 'install-btn') {
          e.preventDefault();
          e.stopPropagation();
          var command = installNowBtn.getAttribute('data-install-command');
          if (!command) return;
          navigator.clipboard
            .writeText(command)
            .then(function () {
              var span = installNowBtn.querySelector('span');
              var originalText = span ? span.textContent : '';
              if (span) span.textContent = '\u2713 Copied!';
              installNowBtn.classList.add('bg-green-600', 'border-green-600');
              setTimeout(function () {
                var s = installNowBtn.querySelector('span');
                if (s) s.textContent = originalText;
                installNowBtn.classList.remove('bg-green-600', 'border-green-600');
              }, 2000);
              setTimeout(function () {
                alert('Command copied! Run it in your terminal to install the skill.\n\n' + command);
              }, 500);
            })
            .catch(function () {
              alert('Run this command in your terminal:\n\n' + command);
            });
          return;
        }
        // Detail page: small copy button next to command (id=install-copy-btn)
        var copyBtn = target.closest('#install-copy-btn');
        if (copyBtn) {
          e.preventDefault();
          e.stopPropagation();
          var installCmd = copyBtn.getAttribute('data-command');
          if (!installCmd) return;
          navigator.clipboard.writeText(installCmd).then(function () {
            if (!copyBtn) return;
            var orig = copyBtn.innerHTML;
            copyBtn.innerHTML =
              '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-green-500"><polyline points="20 6 9 17 4 12"></polyline></svg>';
            setTimeout(function () {
              if (copyBtn) copyBtn.innerHTML = orig;
            }, 2000);
          });
          return;
        }
        // SkillCard: install copy button
        const btn = target.closest('.install-copy-btn');
        if (!btn) return;
        e.preventDefault();
        e.stopPropagation();
        const skillCmd = (btn as HTMLElement).getAttribute('data-command');
        if (!skillCmd) return;
        navigator.clipboard.writeText(skillCmd).then(function () {
          const iconEl = btn.querySelector('.install-icon');
          const okEl = btn.querySelector('.install-ok');
          if (iconEl) iconEl.classList.add('hidden');
          if (okEl) okEl.classList.remove('hidden');
          (btn as HTMLElement).style.background = 'var(--primary)';
          (btn as HTMLElement).style.color = 'var(--primary-foreground)';
          setTimeout(function () {
            if (iconEl) iconEl.classList.remove('hidden');
            if (okEl) okEl.classList.add('hidden');
            (btn as HTMLElement).style.background = '';
            (btn as HTMLElement).style.color = '';
          }, 2000);
        });
      });
    </script>
    <CommandBar client:idle locale={locale} />
  </body>
</html>
