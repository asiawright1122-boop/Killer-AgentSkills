---
interface Props {
  href: string;
  ariaLabel: string;
  className?: string;
  testId?: string;
}

const { href, ariaLabel, className = '', testId } = Astro.props;
---

<a
  href={href}
  aria-label={ariaLabel}
  data-testid={testId}
  class:list={[
    'absolute inset-0 z-10 block focus:outline-none focus-visible:ring-4 focus-visible:ring-[var(--primary)]',
    className,
  ]}></a>
