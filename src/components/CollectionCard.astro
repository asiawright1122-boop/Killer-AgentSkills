---
import { OFFICIAL_REPOS } from '../lib/skills-config';

interface Props {
  owner: string;
  count: number;
  locale?: string;
}

const { owner, count, locale = 'en' } = Astro.props;

// Get vendor config if available
const vendorConfig = Object.values(OFFICIAL_REPOS).find(v => v.owner === owner);
const displayName = vendorConfig?.name || owner;
const isOfficial = vendorConfig?.type === 'official';

// GitHub avatar
const avatarUrl = `https://github.com/${owner}.png?size=200`;

// Link to filtered view
const link = `/${locale}/skills?view=official&owner=${owner}`;
---

<div class="brut-card group p-6 h-full flex flex-col relative bg-white dark:bg-[#0a0a0a]">
  <!-- Stretched Link -->
  <a href={link} class="absolute inset-0 z-0 focus:outline-none focus:ring-4 focus:ring-[var(--primary)]" aria-label={`View ${displayName} skills`}></a>

  <!-- Header: Avatar + Title -->
  <div class="relative z-1 flex items-center gap-5 mb-6 pointer-events-none">
    <div class="w-16 h-16 flex-shrink-0 overflow-hidden border-2 border-[var(--foreground)] bg-white">
      <img 
        src={avatarUrl} 
        alt={owner} 
        width="64"
        height="64"
        class="w-full h-full object-cover grayscale contrast-125"
        loading="lazy"
        decoding="async"
        onerror="this.style.display='none'"
      />
    </div>
    <div>
      <h3 class="text-2xl font-black text-[var(--foreground)] uppercase tracking-tight group-hover:text-[var(--primary)] transition-colors">
        {displayName}
      </h3>
      <p class="text-xs font-bold font-mono text-[var(--muted-foreground)] uppercase tracking-wider mt-1">
        {isOfficial ? 'Official Partner' : 'Community Vendor'}
      </p>
    </div>
  </div>
  
  <!-- Description/Stats -->
  <div class="relative z-1 mt-auto pointer-events-none border-t-2 border-[var(--border)] pt-4">
    <div class="flex items-center justify-between">
      <div class="inline-flex items-center px-2 py-1 bg-[var(--foreground)] text-[var(--background)] font-mono text-sm font-bold uppercase tracking-widest">
        <span class="text-[var(--primary)] mr-2">{count}</span> SKILLS
      </div>
      
      {isOfficial && (
        <span class="inline-flex items-center px-2 py-1 text-[10px] font-black bg-[var(--background)] text-[var(--foreground)] border-2 border-[var(--foreground)] uppercase tracking-widest">
          [ OFFICIAL ]
        </span>
      )}
    </div>
  </div>
</div>
