---
import { OFFICIAL_REPOS } from '../lib/skills-config';
import { loadMessages, useTranslations, type Locale } from '../i18n';
import CardOverlayLink from './CardOverlayLink.astro';

interface Props {
  owner: string;
  count: number;
  locale?: string;
  priority?: boolean;
}

const { owner, count, locale = 'en', priority = false } = Astro.props;

// Get vendor config if available
const vendorConfig = Object.values(OFFICIAL_REPOS).find((v) => v.owner === owner);
const displayName = vendorConfig?.name || owner;
const isOfficial = vendorConfig?.type === 'official';

// GitHub avatar
const avatarUrl = `https://github.com/${owner}.png?size=200`;

// Link to filtered view
const link = `/${locale}/skills?view=official&owner=${owner}`;

// Load translations
const messages = await loadMessages(locale as Locale);
const t = useTranslations(messages);
---

<article
  class="brut-card group relative flex h-full flex-col bg-[var(--background)] p-5 md:p-6 border-[3px] border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] transition-all duration-200 hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[10px_10px_0px_0px_var(--border)]"
  data-testid="vendor-collection-card"
>
  <CardOverlayLink href={link} ariaLabel={`${t('Common.viewAll')} ${displayName} skills`} />

  <!-- Header: Avatar + Title -->
  <div class="relative z-0 mb-6 flex items-center gap-5 pointer-events-none">
    <div class="w-16 h-16 flex-shrink-0 overflow-hidden border-2 border-[var(--foreground)] bg-white">
      <img
        data-collection-avatar
        src={avatarUrl}
        alt={`Logo of ${displayName}`}
        width="64"
        height="64"
        class="w-full h-full object-cover grayscale contrast-125"
        loading={priority ? 'eager' : 'lazy'}
        decoding={priority ? 'sync' : 'async'}
        fetchpriority={priority ? 'high' : 'auto'}
      />
    </div>
    <div>
      <h3
        class="text-2xl font-black text-[var(--foreground)] uppercase tracking-tight group-hover:bg-[var(--foreground)] group-hover:text-[var(--background)] transition-colors px-1 -ml-1"
      >
        {displayName}
      </h3>
      <p class="text-xs font-bold font-mono text-[var(--muted-foreground)] mt-1">
        {isOfficial ? t('Common.officialPartner') : t('Common.communityVendor')}
      </p>
    </div>
  </div>

  <!-- Description/Stats -->
  <div class="relative z-0 mt-auto border-t-2 border-[var(--border)] pt-4 pointer-events-none">
    <div class="flex items-center justify-between">
      <div
        class="inline-flex items-center px-2 py-1 bg-[var(--foreground)] text-[var(--background)] font-mono text-sm font-bold uppercase tracking-wider"
      >
        <span class="text-[var(--primary)] mr-2">{count}</span>
        {t('Common.skillsCount')}
      </div>

      {
        isOfficial && (
          <span class="inline-flex items-center px-2 py-1 text-[10px] font-black bg-[var(--background)] text-[var(--foreground)] border-2 border-[var(--foreground)] uppercase tracking-widest">
            [ {t('Common.official')} ]
          </span>
        )
      }
    </div>
  </div>
</article>

<script>
  // CSP-compatible image error handling: replaces inline `onerror=` so a
  // strict Content-Security-Policy works without `unsafe-inline`. Astro auto-
  // hashes this script tag under experimental CSP.
  document.querySelectorAll<HTMLImageElement>('img[data-collection-avatar]').forEach((img) => {
    if (img.complete && img.naturalWidth === 0) {
      img.style.display = 'none';
      return;
    }
    img.addEventListener(
      'error',
      () => {
        img.style.display = 'none';
      },
      { once: true },
    );
  });
</script>
