---
import type { BreadcrumbItem } from '../lib/site/breadcrumbs';

interface Props {
  items: BreadcrumbItem[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-6">
  <ol
    class="flex flex-wrap items-center gap-1 text-xs font-bold uppercase tracking-wide text-[var(--muted-foreground)]"
  >
    {
      items.map((item, index) => (
        <li class="flex items-center gap-1">
          {index > 0 && (
            <span class="select-none opacity-40" aria-hidden="true">
              /
            </span>
          )}
          {item.href ? (
            <a
              href={item.href}
              class="hover:text-[var(--foreground)] hover:underline decoration-2 underline-offset-2 transition-colors"
            >
              {item.label}
            </a>
          ) : (
            <span class="text-[var(--foreground)]" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
