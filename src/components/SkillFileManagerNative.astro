---
/**
 * SkillFileManagerNative – Astro‑native replacement for the SkillFileManager React island.
 *
 * Renders a VS‑Code‑style file explorer sidebar with collapsible project folder,
 * file icons, size badges, and a status bar. Uses nanostores' vanilla JS API
 * (subscribe / set) instead of React hooks.
 *
 * Props: files (File[]), selectedFile (default), labels (explorer/project)
 *
 * The @nanostores subscribe() API lets us react to store changes without React.
 */

import { FileText, Folder, ChevronRight, ChevronDown } from 'lucide-react';

interface File {
  name: string;
  size?: string;
  type: 'file' | 'folder';
}

interface Props {
  files: File[];
  selectedFile?: string;
  labels?: {
    explorer: string;
    project: string;
  };
}

const { files = [], selectedFile = 'SKILL.md', labels = { explorer: 'Explorer', project: 'Project' } } = Astro.props;
---

<div
  class="skill-file-manager"
  data-default-file={selectedFile}
  data-explorer-label={labels.explorer}
  data-project-label={labels.project}
>
  <div
    class="bg-white dark:bg-[#1e1e1e] rounded-xl overflow-hidden border border-gray-200 dark:border-white/5 shadow-lg dark:shadow-none flex flex-col h-[400px] transition-colors duration-300"
  >
    {/* Window Header */}
    <div
      class="h-10 bg-gray-100 dark:bg-[#252526] flex items-center justify-between px-4 border-b border-gray-200 dark:border-black/20 shrink-0 transition-colors duration-300"
    >
      <div class="flex items-center gap-4">
        <div class="flex gap-1.5 group">
          <div
            class="w-3 h-3 rounded-full bg-[#ff5f56] shadow-[inset_0_0_2px_rgba(0,0,0,0.2)] border border-[#e0443e] group-hover:brightness-90 transition-all"
          >
          </div>
          <div
            class="w-3 h-3 rounded-full bg-[#ffbd2e] shadow-[inset_0_0_2px_rgba(0,0,0,0.2)] border border-[#dea123] group-hover:brightness-90 transition-all"
          >
          </div>
          <div
            class="w-3 h-3 rounded-full bg-[#27c93f] shadow-[inset_0_0_2px_rgba(0,0,0,0.2)] border border-[#1aab29] group-hover:brightness-90 transition-all"
          >
          </div>
        </div>
        <span
          class="text-[10px] font-bold text-gray-400 dark:text-gray-500 uppercase tracking-widest hidden md:inline-block select-none"
        >
          {labels.explorer}
        </span>
      </div>
    </div>

    {/* Sidebar Content */}
    <div class="flex-1 bg-white dark:bg-[#1e1e1e] p-3 font-mono text-sm transition-colors duration-300">
      <div class="mb-4">
        <button
          type="button"
          class="fileman-toggle flex items-center gap-2 px-2 py-1 text-xs font-bold text-gray-400 dark:text-gray-500 uppercase tracking-wider w-full text-left hover:text-gray-600 dark:hover:text-gray-300 transition-colors"
          aria-expanded="true"
        >
          <ChevronDown class="fileman-chevron w-3 h-3" />
          <ChevronRight class="fileman-chevron-right w-3 h-3 hidden" />
          <span>{labels.project}</span>
        </button>
      </div>

      <div class="fileman-files space-y-0.5">
        {
          files.map((file) => (
            <button
              type="button"
              class={`fileman-file group flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer transition-all w-full text-left border ${
                file.name === selectedFile
                  ? 'bg-cyan-50 dark:bg-[#37373d] text-cyan-600 dark:text-cyan-400 font-medium border-cyan-100 dark:border-white/5'
                  : 'text-gray-600 dark:text-gray-400 hover:bg-gray-50 dark:hover:bg-[#2a2d2e] hover:text-black dark:hover:text-gray-200 border-transparent'
              }`}
              data-filename={file.name}
            >
              <span class="flex items-center gap-2.5 overflow-hidden">
                {file.type === 'folder' ? (
                  <Folder
                    size={15}
                    className={`fileman-folder-icon ${
                      file.name === selectedFile
                        ? 'fill-cyan-500/20 text-cyan-500 dark:fill-cyan-400/20 dark:text-cyan-400'
                        : 'fill-gray-400/20 text-gray-400 dark:fill-gray-500/20 dark:text-gray-500'
                    }`}
                  />
                ) : (
                  <FileText
                    size={15}
                    className={`fileman-file-icon ${
                      file.name === selectedFile
                        ? 'text-cyan-500 dark:text-cyan-400'
                        : 'text-gray-400 dark:text-gray-500'
                    }`}
                  />
                )}
                <span class="truncate">{file.name}</span>
              </span>
              {file.size && (
                <span
                  class={`text-[10px] font-mono ${file.name === selectedFile ? 'text-cyan-500/70 dark:text-cyan-400/70' : 'text-gray-400/50 dark:text-gray-600 group-hover:text-gray-500 dark:group-hover:text-gray-500'}`}
                >
                  {file.size}
                </span>
              )}
            </button>
          ))
        }
      </div>
    </div>

    {/* Status Bar */}
    <div
      class="h-7 bg-cyan-50 dark:bg-[#007acc] border-t border-cyan-100 dark:border-none px-3 flex items-center justify-between text-[10px] text-cyan-600 dark:text-white font-mono shrink-0 transition-colors duration-300"
    >
      <div class="flex items-center gap-2">
        <div class="w-1.5 h-1.5 rounded-full bg-cyan-500 dark:bg-white animate-pulse"></div>
        <span>Ready</span>
      </div>
      <span>UTF-8</span>
    </div>
  </div>
</div>

<script>
  import { currentFile, selectFile } from '../stores/skill-files';

  function initSkillFileManager() {
    document.querySelectorAll<HTMLElement>('.skill-file-manager').forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const defaultFile = container.dataset.defaultFile || 'SKILL.md';

      // Initialize the store with the default
      selectFile(defaultFile);

      const toggleBtn = container.querySelector<HTMLButtonElement>('.fileman-toggle')!;
      const chevronDown = container.querySelector<HTMLElement>('.fileman-chevron')!;
      const chevronRight = container.querySelector<HTMLElement>('.fileman-chevron-right')!;
      const filesContainer = container.querySelector<HTMLElement>('.fileman-files')!;
      let isOpen = true;

      toggleBtn.addEventListener('click', () => {
        isOpen = !isOpen;
        toggleBtn.ariaExpanded = String(isOpen);
        chevronDown.classList.toggle('hidden', !isOpen);
        chevronRight.classList.toggle('hidden', isOpen);
        filesContainer.classList.toggle('hidden', !isOpen);
      });

      // File click → update nanostore
      container.querySelectorAll<HTMLButtonElement>('.fileman-file').forEach((btn) => {
        btn.addEventListener('click', () => {
          const filename = btn.dataset.filename || defaultFile;
          selectFile(filename);
          updateSelectedVisual(container, filename);
        });
      });

      // Subscribe to nanostore for external updates (from SkillReadme)
      currentFile.listen((newFile) => {
        updateSelectedVisual(container, newFile);
      });
    });
  }

  function updateSelectedVisual(container: HTMLElement, filename: string) {
    container.querySelectorAll<HTMLButtonElement>('.fileman-file').forEach((btn) => {
      const isSelected = btn.dataset.filename === filename;
      // Update classes
      const fileIcon = btn.querySelector('.fileman-file-icon');
      const folderIcon = btn.querySelector('.fileman-folder-icon');
      const sizeSpan = btn.querySelector('span.text-\\[10px\\]');

      if (isSelected) {
        btn.classList.add(
          'bg-cyan-50',
          'dark:bg-[#37373d]',
          'text-cyan-600',
          'dark:text-cyan-400',
          'font-medium',
          'border-cyan-100',
          'dark:border-white/5',
        );
        btn.classList.remove(
          'text-gray-600',
          'dark:text-gray-400',
          'hover:bg-gray-50',
          'dark:hover:bg-[#2a2d2e]',
          'hover:text-black',
          'dark:hover:text-gray-200',
          'border-transparent',
        );
        if (fileIcon) {
          fileIcon.classList.add('text-cyan-500', 'dark:text-cyan-400');
          fileIcon.classList.remove('text-gray-400', 'dark:text-gray-500');
        }
        if (folderIcon) {
          folderIcon.classList.add('fill-cyan-500/20', 'text-cyan-500', 'dark:fill-cyan-400/20', 'dark:text-cyan-400');
          folderIcon.classList.remove(
            'fill-gray-400/20',
            'text-gray-400',
            'dark:fill-gray-500/20',
            'dark:text-gray-500',
          );
        }
        if (sizeSpan) {
          sizeSpan.classList.add('text-cyan-500/70', 'dark:text-cyan-400/70');
          sizeSpan.classList.remove(
            'text-gray-400/50',
            'dark:text-gray-600',
            'group-hover:text-gray-500',
            'dark:group-hover:text-gray-500',
          );
        }
      } else {
        btn.classList.remove(
          'bg-cyan-50',
          'dark:bg-[#37373d]',
          'text-cyan-600',
          'dark:text-cyan-400',
          'font-medium',
          'border-cyan-100',
          'dark:border-white/5',
        );
        btn.classList.add(
          'text-gray-600',
          'dark:text-gray-400',
          'hover:bg-gray-50',
          'dark:hover:bg-[#2a2d2e]',
          'hover:text-black',
          'dark:hover:text-gray-200',
          'border-transparent',
        );
        if (fileIcon) {
          fileIcon.classList.remove('text-cyan-500', 'dark:text-cyan-400');
          fileIcon.classList.add('text-gray-400', 'dark:text-gray-500');
        }
        if (folderIcon) {
          folderIcon.classList.remove(
            'fill-cyan-500/20',
            'text-cyan-500',
            'dark:fill-cyan-400/20',
            'dark:text-cyan-400',
          );
          folderIcon.classList.add('fill-gray-400/20', 'text-gray-400', 'dark:fill-gray-500/20', 'dark:text-gray-500');
        }
        if (sizeSpan) {
          sizeSpan.classList.remove('text-cyan-500/70', 'dark:text-cyan-400/70');
          sizeSpan.classList.add(
            'text-gray-400/50',
            'dark:text-gray-600',
            'group-hover:text-gray-500',
            'dark:group-hover:text-gray-500',
          );
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initSkillFileManager);
</script>
