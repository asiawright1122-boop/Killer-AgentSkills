---
/**
 * SkillFileManagerNative – Astro‑native replacement for the SkillFileManager React island.
 *
 * Renders a VS‑Code‑style file list with collapsible project folder,
 * file icons, size badges, and a status bar. Uses nanostores' vanilla JS API
 * (subscribe / set) instead of React hooks.
 *
 * Props: files (File[]), selectedFile (default), labels (files/project)
 *
 * The @nanostores subscribe() API lets us react to store changes without React.
 */

import { FileText, Folder, ChevronRight, ChevronDown } from 'lucide-react';

interface File {
  name: string;
  size?: string;
  type: 'file' | 'folder';
}

interface Props {
  files: File[];
  selectedFile?: string;
  labels?: {
    explorer: string;
    project: string;
  };
}

const { files = [], selectedFile = 'SKILL.md', labels = { explorer: 'Files', project: 'Project' } } = Astro.props;
---

<div
  class="skill-file-manager"
  data-default-file={selectedFile}
  data-explorer-label={labels.explorer}
  data-project-label={labels.project}
>
  <div class="skill-detail-card overflow-hidden flex flex-col min-h-[260px] transition-colors duration-300">
    {/* Window Header */}
    <div
      class="h-10 bg-[var(--muted)] flex items-center justify-between px-4 border-b border-[var(--border)] shrink-0 transition-colors duration-300"
    >
      <div class="flex items-center gap-4">
        <div class="flex gap-1.5 group">
          <div class="w-2.5 h-2.5 rounded-full bg-[var(--muted-foreground)]/35 transition-colors"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[var(--muted-foreground)]/25 transition-colors"></div>
          <div class="w-2.5 h-2.5 rounded-full bg-[var(--muted-foreground)]/20 transition-colors"></div>
        </div>
        <span class="hidden md:inline-block select-none text-xs font-semibold text-[var(--muted-foreground)]">
          {labels.explorer}
        </span>
      </div>
    </div>

    {/* Sidebar Content */}
    <div class="flex-1 bg-[var(--background)] p-3 font-mono text-sm transition-colors duration-300">
      <div class="mb-4">
        <button
          type="button"
          class="fileman-toggle flex items-center gap-2 px-2 py-1 text-xs font-semibold text-[var(--muted-foreground)] w-full text-left hover:text-[var(--foreground)] transition-colors"
          aria-expanded="true"
        >
          <ChevronDown className="fileman-chevron w-3 h-3" />
          <ChevronRight className="fileman-chevron-right w-3 h-3 hidden" />
          <span>{labels.project}</span>
        </button>
      </div>

      <div class="fileman-files space-y-0.5">
        {
          files.map((file) => (
            <button
              type="button"
              class={`fileman-file group flex items-center justify-between px-3 py-2 rounded-lg cursor-pointer transition-all w-full text-left border border-transparent text-[var(--muted-foreground)] hover:bg-[var(--muted)] hover:text-[var(--foreground)] ${file.name === selectedFile ? 'is-selected' : ''}`}
              data-filename={file.name}
            >
              <span class="flex items-center gap-2.5 overflow-hidden">
                {file.type === 'folder' ? (
                  <Folder size={15} className="fileman-icon fileman-folder-icon text-[var(--muted-foreground)]" />
                ) : (
                  <FileText size={15} className="fileman-icon fileman-file-icon text-[var(--muted-foreground)]" />
                )}
                <span class="truncate">{file.name}</span>
              </span>
              {file.size && (
                <span class="fileman-size text-[10px] font-mono text-[var(--muted-foreground)]/70">{file.size}</span>
              )}
            </button>
          ))
        }
      </div>
    </div>

    {/* Status Bar */}
    <div
      class="h-7 bg-[var(--muted)] border-t border-[var(--border)] px-3 flex items-center justify-between text-[10px] text-[var(--muted-foreground)] font-mono shrink-0 transition-colors duration-300"
    >
      <div class="flex items-center gap-2">
        <div class="w-1.5 h-1.5 rounded-full bg-[var(--accent)]"></div>
        <span>Ready</span>
      </div>
      <span>UTF-8</span>
    </div>
  </div>
</div>

<script>
  import { currentFile, selectFile } from '../stores/skill-files';

  function initSkillFileManager() {
    document.querySelectorAll<HTMLElement>('.skill-file-manager').forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const defaultFile = container.dataset.defaultFile || 'SKILL.md';

      // Initialize the store with the default
      selectFile(defaultFile);

      const toggleBtn = container.querySelector<HTMLButtonElement>('.fileman-toggle')!;
      const chevronDown = container.querySelector<HTMLElement>('.fileman-chevron')!;
      const chevronRight = container.querySelector<HTMLElement>('.fileman-chevron-right')!;
      const filesContainer = container.querySelector<HTMLElement>('.fileman-files')!;
      let isOpen = true;

      toggleBtn.addEventListener('click', () => {
        isOpen = !isOpen;
        toggleBtn.ariaExpanded = String(isOpen);
        chevronDown.classList.toggle('hidden', !isOpen);
        chevronRight.classList.toggle('hidden', isOpen);
        filesContainer.classList.toggle('hidden', !isOpen);
      });

      // File click updates the shared file store.
      container.querySelectorAll<HTMLButtonElement>('.fileman-file').forEach((btn) => {
        btn.addEventListener('click', () => {
          const filename = btn.dataset.filename || defaultFile;
          selectFile(filename);
          updateSelectedVisual(container, filename);
        });
      });

      // Subscribe to nanostore for external updates from the readme.
      currentFile.listen((newFile) => {
        updateSelectedVisual(container, newFile);
      });
    });
  }

  function updateSelectedVisual(container: HTMLElement, filename: string) {
    container.querySelectorAll<HTMLButtonElement>('.fileman-file').forEach((btn) => {
      const isSelected = btn.dataset.filename === filename;
      btn.classList.toggle('is-selected', isSelected);
    });
  }

  document.addEventListener('astro:page-load', initSkillFileManager);
</script>

<style>
  .skill-file-manager .fileman-file.is-selected {
    background: var(--muted);
    border-color: var(--accent);
    color: var(--foreground);
    font-weight: 700;
  }

  .skill-file-manager .fileman-file.is-selected .fileman-icon,
  .skill-file-manager .fileman-file.is-selected .fileman-size {
    color: var(--accent);
  }
</style>
