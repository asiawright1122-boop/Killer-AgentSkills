---
import { translateOr } from '../i18n';
import { getLocalizedDescription } from '../lib/skills';
import { OFFICIAL_REPOS } from '../lib/skills-config';
import { CATEGORY_GROUPS } from '../lib/search';
import { getCategoryDef, normalizeCategoryId } from '../lib/category-taxonomy';
import { buildLocalizedSkillPath, getSkillRoutePath } from '../lib/skill-route-paths';
import { resolveSkillDetailLocale } from '../lib/skill-locale-link';
import { sanitizePublicSkillCopy } from '../lib/public-skill-copy';
import CardOverlayLink from './CardOverlayLink.astro';

// Install command prefix
const INSTALL_PREFIX = 'npx killer-skills add';

interface Props {
  skill: {
    id?: string;
    name?: string;
    skillName?: string;
    owner: string;
    repo: string;
    description?: string | Record<string, string>;
    stars?: number;
    forks?: number;
    topics?: string[];
    category?: string;
    verified?: boolean;
    data?: {
      name?: string;
      description?: string | Record<string, string>;
      stars?: number;
      forks?: number;
      tags?: string[];
      owner?: string;
      repo?: string;
      verified?: boolean;
      logoPath?: string;
    };
    seo?: {
      definition: Record<string, string>;
      features?: Record<string, string[]>;
      keywords?: Record<string, string[]>;
    };
  };
  locale?: string;
  messages?: Record<string, any>;
  t?: (key: string, params?: Record<string, string>) => string;
}

const { skill, locale = 'en', messages, t } = Astro.props;

// Support both new UnifiedSkill format and legacy format
const name = skill.name || skill.skillName || skill.data?.name || skill.repo || 'Unknown';
const owner = skill.owner || skill.data?.owner || '';
const repo = skill.repo || skill.data?.repo || '';
const stars = skill.stars ?? skill.data?.stars ?? 0;
const forks = skill.forks ?? skill.data?.forks ?? 0;
const topics = skill.topics || skill.data?.tags || [];
const description = skill.description || skill.data?.description;

// Check if verified (official vendor) and determine badge type
const officialConfig = Object.values(OFFICIAL_REPOS).find((v) => v.owner === owner);
const isVerified = skill.verified ?? skill.data?.verified ?? officialConfig?.verified ?? false;
const badgeType: 'official' | 'featured' | null = isVerified ? officialConfig?.type || 'official' : null;

// Get localized description
const descText = skill.seo?.definition?.[locale] || getLocalizedDescription(description, locale);

// Format stars
const starsDisplay = stars > 1000 ? (stars / 1000).toFixed(1) + 'k' : String(stars);
const forksDisplay = forks > 1000 ? (forks / 1000).toFixed(1) + 'k' : String(forks);

// Build link - use id if available (handles sub-skills like anthropics/skills/algorithmic-art)
const skillRoutePath = getSkillRoutePath({ id: skill.id, owner, repo }) || repo;
const skillLinkLocale = resolveSkillDetailLocale(owner, skillRoutePath, locale);
const skillLink = buildLocalizedSkillPath(skillLinkLocale, owner, skillRoutePath);
const installPath = `${owner}/${skillRoutePath}`;

// GitHub avatar
const avatarUrl = `https://github.com/${owner}.png?size=40`;
const interpolate = (template: string, params: Record<string, string> = {}) =>
  Object.entries(params).reduce((value, [key, paramValue]) => value.replaceAll(`{${key}}`, paramValue), template);
const resolveCopy = (key: string, fallback: string, params?: Record<string, string>) => {
  const translated = messages
    ? translateOr(messages, key, fallback)
    : typeof t === 'function'
      ? t(key, params)
      : fallback;
  const resolved = translated && translated !== key ? translated : fallback;
  return params ? interpolate(resolved, params) : resolved;
};
const viewSkillLabel = resolveCopy('Aria.viewSkill', `View ${name}`, { name });
const officialLabel = resolveCopy('Common.official', 'OFFICIAL');
const featuredLabel = resolveCopy('Common.featured', 'FEATURED');
const noDescriptionLabel = resolveCopy('Common.noDescription', 'No description available');
const copyLabel = resolveCopy('Common.copy', 'COPY');
const copiedLabel = resolveCopy('Common.copied', 'OK');
const descriptionText = sanitizePublicSkillCopy(descText, noDescriptionLabel);
---

<article
  class="brut-card group relative flex h-full flex-col bg-[var(--background)] p-5 border-[3px] border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] transition-all duration-200 hover:-translate-x-[4px] hover:-translate-y-[4px] hover:shadow-[10px_10px_0px_0px_var(--border)]"
  data-testid="skill-card"
>
  <CardOverlayLink href={skillLink} ariaLabel={viewSkillLabel} testId="skill-card-link" />

  <!-- Header: Title + Verified Badge -->
  <div class="relative z-0 mb-4 flex items-start justify-between">
    <h3
      class="text-xl font-black text-[var(--foreground)] line-clamp-1 pr-2 group-hover:bg-[var(--foreground)] group-hover:text-[var(--background)] transition-colors tracking-tight uppercase px-1 -ml-1"
    >
      {name}
    </h3>
    {
      badgeType === 'official' && (
        <span class="shrink-0 inline-flex items-center px-2 py-1 text-[10px] font-black bg-[var(--foreground)] text-[var(--background)] border-2 border-[var(--foreground)] uppercase tracking-widest">
          [ {officialLabel} ]
        </span>
      )
    }
    {
      badgeType === 'featured' && (
        <span class="shrink-0 inline-flex items-center px-2 py-1 text-[10px] font-black bg-[var(--primary)] text-[var(--primary-foreground)] border-2 border-[var(--primary)] uppercase tracking-widest">
          [ {featuredLabel} ]
        </span>
      )
    }
  </div>

  <!-- Sub-header: Owner Info -->
  <div class="relative z-0 mb-4 flex items-center gap-3">
    <div class="w-6 h-6 border-2 border-[var(--foreground)] overflow-hidden bg-white relative">
      <img
        data-skill-avatar
        src={avatarUrl}
        alt={`Logo of ${owner}`}
        width="24"
        height="24"
        class="w-full h-full object-cover grayscale contrast-125 transition-all duration-300"
        loading="lazy"
        decoding="async"
      />
      <!-- Loading skeleton -->
      <div class="absolute inset-0 bg-[var(--muted)] animate-pulse opacity-100" id={`skeleton-${owner}-${repo}`}></div>
    </div>
    <span class="text-xs font-bold text-[var(--foreground)]">{owner}</span>
  </div>

  <script>
    // CSP-compatible avatar image lifecycle: replaces the previous
    // `onload=` / `onerror=` inline handlers (which require unsafe-inline) so
    // the page can ship a strict Content-Security-Policy with no hash escape
    // hatches. Astro's experimental CSP auto-hashes this script tag.
    document.querySelectorAll('img[data-skill-avatar]').forEach((node) => {
      const img = node as HTMLImageElement;
      const hideSkeleton = () => {
        const skeleton = img.closest('.relative')?.querySelector('.animate-pulse') as HTMLElement | null;
        if (skeleton) skeleton.style.display = 'none';
      };
      const onLoad = () => {
        img.classList.remove('opacity-0');
        hideSkeleton();
      };
      const onError = () => {
        img.style.display = 'none';
        hideSkeleton();
      };
      // Image may have decoded before the script runs; check `complete`.
      if (img.complete && img.naturalWidth > 0) onLoad();
      else if (img.complete) onError();
      else {
        img.addEventListener('load', onLoad, { once: true });
        img.addEventListener('error', onError, { once: true });
      }
    });
  </script>

  <!-- Description -->
  <p
    class="relative z-0 mb-6 flex-grow line-clamp-3 text-sm font-bold leading-relaxed text-[var(--foreground)] opacity-80"
  >
    {descriptionText}
  </p>

  <!-- 1-Click Install CTA (hover reveal) -->
  <div
    class="relative z-20 mb-3 opacity-0 max-h-0 overflow-hidden group-hover:opacity-100 group-hover:max-h-16 transition-all duration-200 ease-out pointer-events-none group-hover:pointer-events-auto"
  >
    <button
      class="install-copy-btn pointer-events-auto w-full cursor-pointer border-2 border-[var(--foreground)] bg-[var(--foreground)] px-3 py-2.5 font-mono text-xs font-black uppercase tracking-wider text-[var(--background)] shadow-[3px_3px_0px_0px_var(--border)] transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:border-[var(--primary)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:shadow-[1px_1px_0px_0px_var(--border)]"
      data-command={`${INSTALL_PREFIX} ${installPath}`}
      title={`${INSTALL_PREFIX} ${installPath}`}
      aria-label={`Copy install command for ${name}`}
    >
      <span class="shrink-0 text-[var(--primary)] bg-[var(--background)] px-1 text-[10px]">▶</span>
      <span class="truncate">{INSTALL_PREFIX} {installPath}</span>
      <span class="install-icon shrink-0 ml-auto text-[10px]">⧉ {copyLabel}</span>
      <span class="install-ok shrink-0 ml-auto text-[10px] hidden">✓ {copiedLabel}</span>
    </button>
  </div>

  <!-- Footer: Stats + Category Tag -->
  <div class="relative z-0 mt-auto flex items-center justify-between border-t-2 border-[var(--border)] pt-4">
    <!-- Left: Stats -->
    <div class="flex items-center gap-4 text-xs font-bold text-[var(--foreground)] font-mono">
      <div class="flex items-center gap-1.5">
        <span class="text-[var(--primary)] text-sm">★</span>
        <span>{starsDisplay}</span>
      </div>
      <div class="flex items-center gap-1.5">
        <span class="text-[var(--muted-foreground)] text-sm">⑂</span>
        <span>{forksDisplay}</span>
      </div>
    </div>

    <!-- Right: Category Tag -->
    {
      (() => {
        const normalizedExplicitCategory = normalizeCategoryId(skill.category);
        let matchedCategory = getCategoryDef(normalizedExplicitCategory) ? normalizedExplicitCategory : '';

        if (!matchedCategory && topics && topics.length > 0) {
          const normalizedTopicCategory = topics
            .map((topic) => normalizeCategoryId(topic))
            .find((topicCategory) => Boolean(getCategoryDef(topicCategory)));
          if (normalizedTopicCategory) {
            matchedCategory = normalizedTopicCategory;
          }
        }

        if (!matchedCategory) {
          for (const [groupName, keywords] of Object.entries(CATEGORY_GROUPS)) {
            const topicMatchCount = topics.filter((topic) =>
              keywords.some((keyword) => topic.toLowerCase().includes(keyword)),
            ).length;
            if (topicMatchCount >= 2) {
              matchedCategory = groupName;
              break;
            }
          }
        }

        const displayCat = matchedCategory || 'developer';

        let displayLabel = displayCat.charAt(0).toUpperCase() + displayCat.slice(1).replace(/-/g, ' ');

        // Attempt category translation
        if (t) {
          const transKey = `Sidebar.categories.${displayCat.toLowerCase()}`;
          const translated = t(transKey);
          // Our t fallback returns the key itself if no match
          if (translated !== transKey) {
            displayLabel = translated;
          } else {
            // Fallback handle known acronyms if translation missing
            if (displayCat.toLowerCase() === 'ai') displayLabel = 'AI';
            if (displayCat.toLowerCase() === 'ui') displayLabel = 'UI';
            if (displayCat.toLowerCase() === 'ux') displayLabel = 'UX';
            if (displayCat.toLowerCase() === 'cli') displayLabel = 'CLI';
          }
        } else {
          // Fallback handle acronyms
          if (displayCat.toLowerCase() === 'ai') displayLabel = 'AI';
          if (displayCat.toLowerCase() === 'ui') displayLabel = 'UI';
          if (displayCat.toLowerCase() === 'ux') displayLabel = 'UX';
          if (displayCat.toLowerCase() === 'cli') displayLabel = 'CLI';
        }

        const categoryLink = `/${locale}/skills?category=${displayCat}`;

        return (
          <a
            href={categoryLink}
            class="pointer-events-auto relative z-20 border-2 border-[var(--border)] bg-[var(--background)] px-2 py-1 text-[10px] font-bold text-[var(--foreground)] transition-colors hover:bg-[var(--primary)]"
          >
            {displayLabel}
          </a>
        );
      })()
    }
  </div>
</article>
