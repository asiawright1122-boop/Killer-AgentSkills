---
/**
 * SkillFaq — FAQ questions + HowTo installation steps.
 * Mirrors structured data for rich search results.
 */
interface FaqItem {
  question: string;
  answer: string;
}

interface HowToStep {
  name: string;
  text: string;
}

interface Props {
  locale: string;
  faqInstallTitle: string;
  faqTitle: string;
  howToInstallTitle: string;
  faqItems: FaqItem[];
  howToSteps: HowToStep[];
}

const { locale, faqInstallTitle, faqTitle, howToInstallTitle, faqItems, howToSteps } = Astro.props;
---

<section
  class="border-[3px] border-[var(--border)] bg-[var(--background)] shadow-[6px_6px_0px_0px_var(--border)] p-5 md:p-6"
>
  <div class="flex items-end justify-between gap-3 mb-5 border-b-4 border-[var(--border)] pb-3 flex-wrap">
    <div class="min-w-0">
      <h2 class="text-xl md:text-2xl font-black text-[var(--foreground)] uppercase tracking-tight leading-tight">
        {faqInstallTitle}
      </h2>
      <p class="text-[11px] md:text-xs font-mono text-[var(--muted-foreground)] mt-1">
        {
          locale === 'zh'
            ? '与页面结构化数据保持一致，便于搜索引擎理解。'
            : 'Mirrors the structured data on this page for better search understanding.'
        }
      </p>
    </div>
  </div>

  {/* Installation Steps — horizontal rail (3-col on lg) placed first as primary action path */}
  <div class="mb-6">
    <h3
      class="text-[11px] font-black text-[var(--foreground)] uppercase tracking-widest mb-3 font-mono flex items-center gap-2"
    >
      <span class="text-[var(--primary)] bg-[var(--foreground)] px-1">↓</span>
      <span>{howToInstallTitle}</span>
    </h3>
    <ol class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {
        howToSteps.map((step, index) => (
          <li class="border-2 border-[var(--border)] bg-[var(--background)] flex items-stretch hover:shadow-[3px_3px_0px_0px_var(--border)] hover:-translate-y-0.5 transition-all">
            <div class="shrink-0 w-9 flex items-center justify-center bg-[var(--foreground)] text-[var(--primary)] font-black text-base border-r-2 border-[var(--border)]">
              {index + 1}
            </div>
            <div class="p-3 min-w-0 flex-1">
              <p class="font-black text-sm text-[var(--foreground)] mb-1 leading-snug">{step.name}</p>
              <p class="text-sm text-[var(--foreground)]/85 leading-relaxed">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  {/* FAQ — full-width section with 2-col grid on lg */}
  <div>
    <h3
      class="text-[11px] font-black text-[var(--foreground)] uppercase tracking-widest mb-3 font-mono flex items-center gap-2"
    >
      <span class="text-[var(--primary)] bg-[var(--foreground)] px-1">?</span>
      <span>{faqTitle}</span>
    </h3>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-2.5">
      {
        faqItems.map((item, index) => (
          <details
            open={index < 2}
            class="group border-2 border-[var(--border)] bg-[var(--background)] hover:shadow-[3px_3px_0px_0px_var(--border)] transition-all [&[open]]:shadow-[3px_3px_0px_0px_var(--border)] self-start"
          >
            <summary class="cursor-pointer list-none p-3.5 flex items-start justify-between gap-3 font-black text-sm text-[var(--foreground)] leading-snug select-none">
              <span class="flex-1 min-w-0">{item.question}</span>
              <span
                class="shrink-0 mt-0.5 inline-flex items-center justify-center w-5 h-5 border-2 border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] font-black text-xs leading-none transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="px-3.5 pb-3.5 -mt-1 text-sm text-[var(--foreground)]/85 leading-relaxed border-t-2 border-dashed border-[var(--border)] pt-2.5">
              {item.answer}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
