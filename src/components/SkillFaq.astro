---
/**
 * SkillFaq — FAQ questions + HowTo installation steps.
 * Mirrors structured data for rich search results.
 */
interface FaqItem {
  question: string;
  answer: string;
}

interface HowToStep {
  name: string;
  text: string;
}

interface Props {
  locale: string;
  faqInstallTitle: string;
  faqTitle: string;
  howToInstallTitle: string;
  faqItems: FaqItem[];
  howToSteps: HowToStep[];
}

const { locale, faqInstallTitle, faqTitle, howToInstallTitle, faqItems, howToSteps } = Astro.props;
---

<section class="skill-detail-surface p-5 md:p-6">
  <div class="flex items-end justify-between gap-3 mb-5 border-b border-[var(--border)] pb-3 flex-wrap">
    <div class="min-w-0">
      <h2 class="text-xl md:text-2xl font-bold text-[var(--foreground)] leading-tight">
        {faqInstallTitle}
      </h2>
      <p class="text-[11px] md:text-xs font-mono text-[var(--muted-foreground)] mt-1">
        {locale === 'zh' ? '安装步骤与常见问题。' : 'Install steps and common questions.'}
      </p>
    </div>
  </div>

  {/* Installation Steps — horizontal rail (3-col on lg) placed first as primary action path */}
  <div class="mb-6">
    <h3 class="text-[11px] font-bold text-[var(--muted-foreground)] mb-3 font-mono flex items-center gap-2">
      <span>{howToInstallTitle}</span>
    </h3>
    <ol class="grid grid-cols-1 md:grid-cols-3 gap-3">
      {
        howToSteps.map((step, index) => (
          <li class="skill-detail-card skill-detail-card-hover flex items-stretch">
            <div class="shrink-0 w-9 flex items-center justify-center bg-[var(--foreground)] text-[var(--background)] font-bold text-base border-r border-[var(--border)]">
              {index + 1}
            </div>
            <div class="p-3 min-w-0 flex-1">
              <p class="font-bold text-sm text-[var(--foreground)] mb-1 leading-snug">{step.name}</p>
              <p class="text-sm text-[var(--foreground)]/85 leading-relaxed">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>

  {/* FAQ — full-width section with 2-col grid on lg */}
  <div>
    <h3 class="text-[11px] font-bold text-[var(--muted-foreground)] mb-3 font-mono flex items-center gap-2">
      <span>{faqTitle}</span>
    </h3>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-2.5">
      {
        faqItems.map((item, index) => (
          <details open={index < 2} class="skill-detail-card group self-start">
            <summary class="cursor-pointer list-none p-3.5 flex items-start justify-between gap-3 font-bold text-sm text-[var(--foreground)] leading-snug select-none">
              <span class="flex-1 min-w-0">{item.question}</span>
              <span
                class="shrink-0 mt-0.5 inline-flex items-center justify-center w-5 h-5 rounded-full border border-[var(--border)] bg-[var(--background)] text-[var(--foreground)] font-bold text-xs leading-none transition-transform group-open:rotate-45"
                aria-hidden="true"
              >
                +
              </span>
            </summary>
            <div class="px-3.5 pb-3.5 -mt-1 text-sm text-[var(--foreground)]/85 leading-relaxed border-t border-[var(--border)] pt-2.5">
              {item.answer}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>
