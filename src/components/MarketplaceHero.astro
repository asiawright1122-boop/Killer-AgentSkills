---
interface Action {
  href: string;
  label: string;
}

interface EvidenceItem {
  label: string;
  value: string;
  href?: string;
}

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  locale: string;
  searchPlaceholder?: string;
  searchAction?: string;
  actions?: Action[];
  countLabel?: string;
  evidenceItems?: EvidenceItem[];
}

const {
  eyebrow,
  title,
  description,
  locale,
  searchPlaceholder,
  searchAction = `/${locale}/search`,
  actions = [],
  countLabel,
  evidenceItems = [],
} = Astro.props;
const fallbackPlaceholder = locale.startsWith('zh') ? '搜索 Skills' : 'Search skills';
---

<section class="marketplace-hero" aria-labelledby="marketplace-hero-title">
  <div class="marketplace-shell marketplace-hero-grid">
    <div class="marketplace-hero-copy">
      {eyebrow && <p class="marketplace-route-label">{eyebrow}</p>}
      <h1 id="marketplace-hero-title">{title}</h1>
      {description && <p>{description}</p>}
    </div>
    <div class="marketplace-hero-panel">
      {countLabel && <strong>{countLabel}</strong>}
      <form action={searchAction} method="get" role="search">
        <label class="sr-only" for="marketplace-hero-search">{searchPlaceholder || fallbackPlaceholder}</label>
        <input
          id="marketplace-hero-search"
          name="q"
          type="search"
          placeholder={searchPlaceholder || fallbackPlaceholder}
        />
        <button type="submit">{locale.startsWith('zh') ? '搜索' : 'Search'}</button>
      </form>
      {
        actions.length > 0 && (
          <div class="marketplace-hero-actions">
            {actions.map((action) => (
              <a href={action.href}>{action.label}</a>
            ))}
          </div>
        )
      }
      {
        evidenceItems.length > 0 && (
          <dl class="marketplace-hero-receipt">
            {evidenceItems.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>
                  {item.href ? (
                    <a href={item.href} class="break-anywhere">
                      {item.value}
                    </a>
                  ) : (
                    <span class="break-anywhere">{item.value}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        )
      }
    </div>
  </div>
</section>
