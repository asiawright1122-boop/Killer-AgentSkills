---
import { OFFICIAL_REPOS } from '../lib/skills-config';
import { CATEGORY_DEFS } from '../lib/category-taxonomy';
import { getLangFromUrl, useTranslations, loadMessages } from '../i18n';

interface Props {
  activeCategory?: string;
  activeView?: string;
}

const { activeCategory = 'all', activeView = '' } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const messages = await loadMessages(locale);
const t = useTranslations(messages);

// View options
const views = [
  {
    id: 'official',
    name: t('Sidebar.views.official'),
    icon: 'verified',
    count: Object.values(OFFICIAL_REPOS).filter((v) => v.type === 'official').length,
  },
  { id: 'community', name: locale === 'zh' ? '社区来源' : 'Community', icon: 'star' },
  { id: 'latest', name: t('Sidebar.views.latest'), icon: 'clock' },
];

const categories = [
  { id: 'all', name: t('Sidebar.categories.all'), icon: 'grid' },
  ...CATEGORY_DEFS.map((category) => ({
    id: category.id,
    name: t(category.labelKey),
    icon: category.icon,
  })),
];

const frameworks = [
  { id: 'langchain', name: 'LangChain' },
  { id: 'autogen', name: 'AutoGen' },
  { id: 'crewai', name: 'CrewAI' },
  { id: 'openai', name: 'OpenAI' },
];

// Determine current display label for mobile toggle
let currentFilterLabel = t('Sidebar.categories.all');
if (activeView) {
  const view = views.find((v) => v.id === activeView);
  if (view) currentFilterLabel = view.name;
} else if (activeCategory && activeCategory !== 'all') {
  const cat = categories.find((c) => c.id === activeCategory);
  if (cat) currentFilterLabel = cat.name;
}
---

<aside class="w-full md:w-72 shrink-0 md:sticky md:top-24 h-fit z-30">
  <nav class="skill-detail-surface p-3 overflow-hidden">
    <!-- Mobile Toggle Header -->
    <div
      class="md:hidden p-3 flex items-center justify-between cursor-pointer rounded-md bg-[var(--foreground)] text-[var(--background)] mb-3"
      id="sidebar-toggle"
    >
      <div class="flex items-center gap-3 font-bold">
        <svg
          class="w-6 h-6 text-[var(--primary)]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="3"
          aria-hidden="true"
        >
          <path stroke-linecap="square" stroke-linejoin="miter" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
        <span>{currentFilterLabel}</span>
      </div>
      <svg
        id="sidebar-arrow"
        class="w-6 h-6 text-[var(--primary)] transition-transform duration-100"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="3"
        aria-hidden="true"
      >
        <path stroke-linecap="square" stroke-linejoin="miter" d="M19 9l-7 7-7-7"></path>
      </svg>
    </div>

    <!-- Collapsible Content -->
    <div id="sidebar-content" class="hidden md:block space-y-6">
      <!-- Discover Section -->
      <div>
        <h3 class="px-2 text-xs font-bold mb-3 text-[var(--muted-foreground)] flex items-center gap-2">
          {t('Sidebar.discover')}
        </h3>
        <div class="space-y-1.5">
          {
            views.map((view) => (
              <a
                href={`/${locale}/skills?${view.id === 'latest' ? 'sort=latest' : `source=${view.id}&sort=popular`}`}
                class:list={[
                  'flex items-center justify-between rounded-md px-3 py-2.5 border transition-all font-bold text-sm group',
                  activeView === view.id
                    ? 'bg-[var(--foreground)] text-[var(--background)] border-[var(--foreground)]'
                    : 'bg-transparent text-[var(--foreground)] border-transparent hover:border-[var(--border)] hover:bg-[var(--card-hover)]',
                ]}
              >
                <div class="flex items-center gap-3">
                  {view.icon === 'verified' && <span class="h-2 w-2 rounded-full bg-[var(--success)]" />}
                  {view.icon === 'star' && <span class="h-2 w-2 rounded-full bg-[var(--primary)]" />}
                  {view.icon === 'clock' && <span class="h-2 w-2 rounded-full bg-[var(--accent)]" />}
                  <span>{view.name}</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Quick filters -->
      <div>
        <h3 class="px-2 text-xs font-bold mb-3 text-[var(--muted-foreground)] flex items-center gap-2">
          {locale === 'zh' ? '快捷筛选' : 'Quick filters'}
        </h3>
        <div class="space-y-1.5">
          <a
            href={`/${locale}/skills?source=official`}
            class="flex items-center justify-between rounded-md px-3 py-2.5 border border-transparent hover:border-[var(--border)] hover:bg-[var(--card-hover)] transition-all font-bold text-sm"
          >
            <div class="flex items-center gap-3">
              <span class="h-2 w-2 rounded-full bg-[var(--success)]"></span>
              <span>{locale === 'zh' ? '官方可信工具' : 'Official AI Skills'}</span>
            </div>
          </a>
          <a
            href={`/${locale}/skills?q=cursor`}
            class="flex items-center justify-between rounded-md px-3 py-2.5 border border-transparent hover:border-[var(--border)] hover:bg-[var(--card-hover)] transition-all font-bold text-sm"
          >
            <div class="flex items-center gap-3">
              <span class="h-2 w-2 rounded-full bg-[var(--accent)]"></span>
              <span>{locale === 'zh' ? 'Cursor 兼容工具' : 'Cursor Compatible'}</span>
            </div>
          </a>
        </div>
      </div>

      <!-- Separator -->
      <div class="mx-2 border-t border-[var(--border)]"></div>

      <!-- Categories Section -->
      <div>
        <h3 class="px-2 text-xs font-bold mb-3 text-[var(--muted-foreground)] flex items-center gap-2">
          {t('Sidebar.categories.title')}
        </h3>
        <div class="space-y-1.5">
          {
            categories.map((category) => (
              <a
                href={`/${locale}/categories${category.id === 'all' ? '' : `/${category.id}`}`}
                class:list={[
                  'flex items-center gap-3 rounded-md px-3 py-2.5 border transition-all font-bold text-sm group',
                  activeCategory === category.id
                    ? 'bg-[var(--foreground)] text-[var(--background)] border-[var(--foreground)]'
                    : 'bg-transparent text-[var(--foreground)] border-transparent hover:border-[var(--border)] hover:bg-[var(--card-hover)]',
                ]}
              >
                <span>{category.name}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Separator -->
      <div class="mx-2 border-t border-[var(--border)]"></div>

      <!-- Frameworks Section -->
      <div>
        <h3 class="px-2 text-xs font-bold mb-3 text-[var(--muted-foreground)] flex items-center gap-2">
          {t('Sidebar.frameworks')}
        </h3>
        <div class="flex flex-wrap gap-2 px-2">
          {
            frameworks.map((fw) => (
              <a
                href={`/${locale}/skills?q=${fw.id}`}
                class="market-chip px-2.5 py-1 font-bold text-xs hover:border-[var(--accent)]"
              >
                {fw.name}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </nav>

  <script>
    const toggle = document.getElementById('sidebar-toggle');
    const content = document.getElementById('sidebar-content');
    const arrow = document.getElementById('sidebar-arrow');

    if (toggle && content && arrow) {
      toggle.addEventListener('click', () => {
        content.classList.toggle('hidden');
        arrow.classList.toggle('rotate-180');
      });
    }
  </script>
</aside>
