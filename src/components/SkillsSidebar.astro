---
import { OFFICIAL_REPOS } from '../lib/skills-config';
import { CATEGORY_DEFS } from '../lib/category-taxonomy';
import { getLangFromUrl, useTranslations, loadMessages } from '../i18n';

interface Props {
  activeCategory?: string;
  activeView?: string;
}

const { activeCategory = 'all', activeView = '' } = Astro.props;
const locale = getLangFromUrl(Astro.url);
const messages = await loadMessages(locale);
const t = useTranslations(messages);

// View options
const views = [
  {
    id: 'official',
    name: t('Sidebar.views.official'),
    icon: 'verified',
    count: Object.values(OFFICIAL_REPOS).filter((v) => v.type === 'official').length,
  },
  { id: 'featured', name: t('Sidebar.views.featured'), icon: 'star' },
  { id: 'latest', name: t('Sidebar.views.latest'), icon: 'clock' },
];

const categories = [
  { id: 'all', name: t('Sidebar.categories.all'), icon: 'grid' },
  ...CATEGORY_DEFS.map((category) => ({
    id: category.id,
    name: t(category.labelKey),
    icon: category.icon,
  })),
];

const frameworks = [
  { id: 'langchain', name: 'LangChain' },
  { id: 'autogen', name: 'AutoGen' },
  { id: 'crewai', name: 'CrewAI' },
  { id: 'openai', name: 'OpenAI' },
];

// Determine current display label for mobile toggle
let currentFilterLabel = t('Sidebar.categories.all');
if (activeView) {
  const view = views.find((v) => v.id === activeView);
  if (view) currentFilterLabel = view.name;
} else if (activeCategory && activeCategory !== 'all') {
  const cat = categories.find((c) => c.id === activeCategory);
  if (cat) currentFilterLabel = cat.name;
}
---

<aside class="w-full md:w-72 shrink-0 md:sticky md:top-24 h-fit z-30">
  <!-- Navigation Card -->
  <nav
    class="bg-[var(--background)] border-[3px] border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] p-4 overflow-hidden"
  >
    <!-- Mobile Toggle Header -->
    <div
      class="md:hidden p-4 flex items-center justify-between cursor-pointer border-b-4 border-[var(--border)] bg-[var(--foreground)] text-[var(--background)] mb-4"
      id="sidebar-toggle"
    >
      <div class="flex items-center gap-3 font-bold uppercase">
        <svg
          class="w-6 h-6 text-[var(--primary)]"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          stroke-width="3"
          aria-hidden="true"
        >
          <path stroke-linecap="square" stroke-linejoin="miter" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
        <span>{currentFilterLabel}</span>
      </div>
      <svg
        id="sidebar-arrow"
        class="w-6 h-6 text-[var(--primary)] transition-transform duration-100"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        stroke-width="3"
        aria-hidden="true"
      >
        <path stroke-linecap="square" stroke-linejoin="miter" d="M19 9l-7 7-7-7"></path>
      </svg>
    </div>

    <!-- Collapsible Content -->
    <div id="sidebar-content" class="hidden md:block space-y-8">
      <!-- Discover Section -->
      <div>
        <h3
          class="px-2 text-sm font-black uppercase tracking-widest mb-4 font-mono text-[var(--foreground)] flex items-center gap-2"
        >
          <span class="text-[var(--primary)] bg-[var(--foreground)] px-1">↓</span>
          {t('Sidebar.discover')}
        </h3>
        <div class="space-y-2">
          {
            views.map((view) => (
              <a
                href={`/${locale}/skills?view=${view.id}`}
                class:list={[
                  'flex items-center justify-between px-4 py-3 border-2 transition-all font-bold uppercase text-[15px] group',
                  activeView === view.id
                    ? 'bg-[var(--primary)] text-[var(--primary-foreground)] border-[var(--border)] shadow-[6px_6px_0px_0px_var(--border)] translate-x-[-2px] translate-y-[-2px]'
                    : 'bg-[var(--background)] text-[var(--foreground)] border-[3px] border-transparent hover:border-[var(--border)] hover:bg-[var(--foreground)] hover:text-[var(--background)] hover:shadow-[6px_6px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px]',
                ]}
              >
                <div class="flex items-center gap-3">
                  {view.icon === 'verified' && <span class="font-mono text-lg">[O]</span>}
                  {view.icon === 'star' && <span class="font-mono text-lg">[*]</span>}
                  {view.icon === 'clock' && <span class="font-mono text-lg">[+]</span>}
                  <span>{view.name}</span>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Separator -->
      <div class="h-1 mx-2 bg-[var(--border)]"></div>

      <!-- Categories Section -->
      <div>
        <h3
          class="px-2 text-sm font-black uppercase tracking-widest mb-4 font-mono text-[var(--foreground)] flex items-center gap-2"
        >
          <span class="text-[var(--primary)] bg-[var(--foreground)] px-1">↓</span>
          {t('Sidebar.categories.title')}
        </h3>
        <div class="space-y-2">
          {
            categories.map((category) => (
              <a
                href={`/${locale}/skills?category=${category.id}`}
                class:list={[
                  'flex items-center gap-3 px-4 py-3 border-2 transition-all font-bold uppercase text-[14px] group',
                  activeCategory === category.id
                    ? 'bg-[var(--foreground)] text-[var(--background)] border-[var(--foreground)] shadow-[6px_6px_0px_0px_var(--primary)] translate-x-[-2px] translate-y-[-2px]'
                    : 'bg-[var(--background)] text-[var(--foreground)] border-[var(--border)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:shadow-[6px_6px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px]',
                ]}
              >
                <span>{category.name}</span>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Separator -->
      <div class="h-1 mx-2 bg-[var(--border)]"></div>

      <!-- Frameworks Section -->
      <div>
        <h3
          class="px-2 text-sm font-black uppercase tracking-widest mb-4 font-mono text-[var(--foreground)] flex items-center gap-2"
        >
          <span class="text-[var(--primary)] bg-[var(--foreground)] px-1">↓</span>
          {t('Sidebar.frameworks')}
        </h3>
        <div class="flex flex-wrap gap-2 px-2">
          {
            frameworks.map((fw) => (
              <a
                href={`/${locale}/skills?tag=${fw.id}`}
                class="px-2.5 py-1 font-mono font-bold text-xs border-2 border-[var(--border)] hover:bg-[var(--foreground)] hover:text-[var(--background)] transition-colors text-[var(--foreground)]"
              >
                [{fw.name}]
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </nav>

  <script>
    const toggle = document.getElementById('sidebar-toggle');
    const content = document.getElementById('sidebar-content');
    const arrow = document.getElementById('sidebar-arrow');

    if (toggle && content && arrow) {
      toggle.addEventListener('click', () => {
        content.classList.toggle('hidden');
        arrow.classList.toggle('rotate-180');
      });
    }
  </script>
</aside>
