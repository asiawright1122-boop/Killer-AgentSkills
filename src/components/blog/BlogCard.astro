---
import { loadMessages, type Locale } from '../../i18n';
import type { CollectionEntry } from 'astro:content';
import { Calendar } from 'lucide-react';
import { getBlogMetaOverride } from '../../lib/blog-seo-intent';
import { normalizePublicSummary } from '../../lib/public-text';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: string;
}

const { post, locale } = Astro.props;
const messages = await loadMessages(locale as Locale);

const tb = messages.Blog;
const slug = post.id.split('/').pop()?.replace(/\.md$/, '') || '';
const t = (key: string) => {
  const parts = key.replace(/^Seo\./, '').split('.');
  let current: unknown = messages;
  for (const part of parts) {
    current = current && typeof current === 'object' ? (current as Record<string, unknown>)[part] : undefined;
  }
  return typeof current === 'string' ? current : key;
};
const metaOverride = getBlogMetaOverride(slug, t);
const displayDescription = normalizePublicSummary(metaOverride?.description || post.data.description, 150);

const dateOptions: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};
const formattedDate = post.data.pubDate.toLocaleDateString(locale, dateOptions);

// Use translated category if available
const displayCategory = post.data.category
  ? tb.categories?.[post.data.category as keyof typeof tb.categories] || post.data.category.replace('-', ' ')
  : null;
---

<a
  href={`/${locale}/blog/${post.id.split('/').pop()}`}
  class="skill-list-card skill-list-card-hover group relative flex flex-col h-full w-full overflow-hidden"
>
  {/* Image Section */}
  <div
    class="aspect-video w-full overflow-hidden relative border-b border-[var(--border)] bg-[var(--muted)] flex-shrink-0"
  >
    {
      post.data.heroImage ? (
        <img
          src={post.data.heroImage}
          alt={post.data.title}
          width="640"
          height="360"
          class="h-full w-full object-cover transition-all duration-500 opacity-90 group-hover:opacity-100 group-hover:scale-105"
          loading="lazy"
          decoding="async"
        />
      ) : (
        <div class="w-full h-full bg-[var(--muted)] flex items-center justify-center font-bold text-sm text-[var(--muted-foreground)]">
          Preview
        </div>
      )
    }

    {/* Category/Tag Badge */}
    {
      (post.data.category || (post.data.tags && post.data.tags.length > 0)) && (
        <div class="absolute top-4 left-4 flex gap-2 z-10">
          {post.data.category && <span class="market-chip px-2 py-1 text-xs">{displayCategory}</span>}
          {!post.data.category && post.data.tags && post.data.tags.length > 0 && (
            <span class="market-chip px-2 py-1 text-xs">{post.data.tags[0]}</span>
          )}
        </div>
      )
    }
  </div>

  {/* Content Section */}
  <div class="flex-1 p-6 relative flex flex-col justify-between">
    <div>
      {/* Title */}
      <h3
        class="text-xl font-bold text-[var(--foreground)] mb-4 leading-tight group-hover:text-[var(--accent)] transition-colors line-clamp-3"
      >
        {post.data.title}
      </h3>

      {/* Description */}
      <p class="text-sm font-bold text-[var(--muted-foreground)] line-clamp-2 mb-6 leading-relaxed">
        {displayDescription}
      </p>
    </div>

    <div>
      {/* Author */}
      <div class="flex items-center gap-2 mb-4">
        <div
          class="w-6 h-6 rounded-md flex items-center justify-center text-[10px] bg-[var(--foreground)] text-[var(--background)] font-bold"
        >
          {post.data.author.charAt(0).toUpperCase()}
        </div>
        <span class="text-xs font-bold text-[var(--foreground)]">
          {post.data.author}
        </span>
      </div>

      {/* Footer Meta */}
      <div class="flex items-center justify-between border-t border-[var(--border)] pt-4">
        <div class="flex items-center gap-4 text-xs font-mono font-bold text-[var(--muted-foreground)]">
          <div class="flex items-center gap-1.5">
            <Calendar size={14} strokeWidth={2.5} />
            <time datetime={post.data.pubDate.toISOString()}>
              {formattedDate}
            </time>
          </div>
        </div>
      </div>
    </div>
  </div>
</a>
