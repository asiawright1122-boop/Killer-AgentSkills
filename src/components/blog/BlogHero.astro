---
import { getMessages } from '../../i18n';
import type { CollectionEntry } from 'astro:content';
import { SUPPORTED_LOCALES, loadMessages, useTranslations, type Locale } from '../../i18n';
import { ArrowRight, Calendar, User, ArrowUpRight } from 'lucide-react';

interface Props {
  post: CollectionEntry<'blog'>;
  locale: string;
}

const { post, locale } = Astro.props;
const messages = await loadMessages(locale as Locale);
const t = useTranslations(messages);
const tb = messages.Blog;

const dateOptions: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};
const formattedDate = post.data.pubDate.toLocaleDateString(locale, dateOptions);

// Use translated category if available
const displayCategory = post.data.category ? (tb.categories?.[post.data.category as keyof typeof tb.categories] || post.data.category.replace('-', ' ')) : null;
---

<a 
  href={`/${locale}/blog/${post.id.split('/').pop()}`}
  aria-label={t.readArticle + ' - ' + post.data.title}
  class="brut-card group relative block w-full bg-[var(--card)] flex flex-col md:flex-row h-auto md:h-[400px]"
>
  {/* Image Section */}
  <div class="relative w-full md:w-1/2 h-[300px] md:h-full border-b-4 md:border-b-0 md:border-r-4 border-[var(--foreground)] overflow-hidden bg-[var(--primary)] flex-shrink-0">
    {post.data.heroImage ? (
      <img 
        src={post.data.heroImage} 
        alt={post.data.title} 
        class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
      />
    ) : (
      <div class="w-full h-full bg-[var(--foreground)] opacity-10 flex border-4 items-center justify-center font-black text-6xl tracking-tighter mix-blend-overlay">IMAGE MISSING</div>
    )}
  </div>

  {/* Content Section */}
  <div class="p-8 md:p-12 flex flex-col justify-center w-full md:w-1/2">
    
    <div class="flex flex-wrap items-center gap-3 mb-6">
        <span class="inline-flex items-center px-2 py-1 bg-[var(--foreground)] text-[var(--background)] font-mono text-xs font-bold uppercase tracking-widest">
            [{tb.featured}]
        </span>
        {post.data.category && (
            <span class="inline-flex items-center px-2 py-1 bg-[var(--primary)] text-[var(--primary-foreground)] font-mono text-xs font-bold uppercase tracking-widest border-2 border-[var(--foreground)] shadow-[2px_2px_0px_0px_var(--foreground)]">
                {displayCategory}
            </span>
        )}
    </div>

    <h2 class="text-3xl md:text-4xl font-black text-[var(--foreground)] mb-6 leading-tight tracking-tighter uppercase px-1 -ml-1 group-hover:bg-[var(--foreground)] group-hover:text-[var(--background)] transition-colors w-fit">
        {post.data.title}
    </h2>

    <p class="text-lg text-[var(--muted-foreground)] mb-8 line-clamp-2 font-bold leading-relaxed">
        {post.data.description}
    </p>

    <div class="flex items-center gap-6 mt-auto border-t-[3px] border-[var(--border)] pt-6">
        <div class="flex items-center gap-2">
            <div class="w-8 h-8 flex items-center justify-center text-xs text-[var(--background)] bg-[var(--foreground)] font-black border-2 border-[var(--foreground)]">
                {post.data.author.charAt(0).toUpperCase()}
            </div>
            <span class="font-bold text-[var(--foreground)] uppercase text-sm tracking-wider">{post.data.author}</span>
        </div>
        <div class="flex items-center gap-2 text-[var(--muted-foreground)] font-mono font-bold text-sm uppercase">
            <Calendar size={16} strokeWidth={2.5} />
            <time datetime={post.data.pubDate.toISOString()}>
                {formattedDate}
            </time>
        </div>
    </div>
  </div>
</a>
