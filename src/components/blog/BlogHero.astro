---
import { loadMessages, useTranslations, type Locale } from '../../i18n';
import { Calendar } from 'lucide-react';
import type { BlogGlobEntry } from '../../lib/blog-glob-loader';

interface Props {
  post: BlogGlobEntry;
  locale: string;
}

const { post, locale } = Astro.props;
const messages = await loadMessages(locale as Locale);
const t = useTranslations(messages);
const tb = messages.Blog;

const dateOptions: Intl.DateTimeFormatOptions = {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
};
const formattedDate = post.data.pubDate.toLocaleDateString(locale, dateOptions);

// Use translated category if available
const displayCategory = post.data.category
  ? tb.categories?.[post.data.category as keyof typeof tb.categories] || post.data.category.replace('-', ' ')
  : null;
---

<a
  href={`/${locale}/blog/${post.id.split('/').pop()}`}
  aria-label={t('Blog.readArticle') + ' - ' + post.data.title}
  class="skill-list-card skill-list-card-hover group relative block w-full flex flex-col md:flex-row h-auto md:min-h-[420px] overflow-hidden"
>
  {/* Image Section */}
  <div
    class="relative w-full md:w-1/2 h-[300px] md:h-auto border-b md:border-b-0 md:border-r border-[var(--border)] overflow-hidden bg-[var(--muted)] flex-shrink-0"
  >
    {
      post.data.heroImage ? (
        <img
          src={post.data.heroImage}
          alt={post.data.title}
          width="800"
          height="450"
          class="w-full h-full object-cover opacity-90 group-hover:opacity-100 group-hover:scale-105 transition-all duration-500"
          fetchpriority="high"
          decoding="async"
        />
      ) : (
        <div class="w-full h-full bg-[var(--muted)] flex items-center justify-center font-bold text-sm text-[var(--muted-foreground)]">
          Preview unavailable
        </div>
      )
    }
  </div>

  {/* Content Section */}
  <div class="p-8 md:p-12 flex flex-col justify-center w-full md:w-1/2">
    <div class="flex flex-wrap items-center gap-3 mb-6">
      <span
        class="market-chip px-2 py-1 text-xs bg-[var(--foreground)] text-[var(--background)] border-[var(--foreground)]"
      >
        {tb.featured}
      </span>
      {post.data.category && <span class="market-chip px-2 py-1 text-xs">{displayCategory}</span>}
    </div>

    <h2
      class="text-3xl md:text-4xl font-bold text-[var(--foreground)] mb-6 leading-snug group-hover:text-[var(--accent)] transition-colors"
    >
      {post.data.title}
    </h2>

    <p class="text-lg text-[var(--muted-foreground)] mb-8 line-clamp-2 font-bold leading-relaxed">
      {post.data.description}
    </p>

    <div class="flex items-center gap-6 mt-auto border-t border-[var(--border)] pt-6">
      <div class="flex items-center gap-2">
        <div
          class="w-8 h-8 rounded-md flex items-center justify-center text-xs text-[var(--background)] bg-[var(--foreground)] font-bold"
        >
          {post.data.author.charAt(0).toUpperCase()}
        </div>
        <span class="font-bold text-[var(--foreground)] text-sm">{post.data.author}</span>
      </div>
      <div class="flex items-center gap-2 text-[var(--muted-foreground)] font-mono font-bold text-sm">
        <Calendar size={16} strokeWidth={2.5} />
        <time datetime={post.data.pubDate.toISOString()}>
          {formattedDate}
        </time>
      </div>
    </div>
  </div>
</a>
