---
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string; // Base URL including locale and path, e.g. /zh/skills
  searchParams: Record<string, string>;
  t: (key: any) => string;
  tr?: (key: string, fallback: string) => string;
}

const { currentPage, totalPages, baseUrl, searchParams, t, tr } = Astro.props;
const resolveLabel =
  tr ??
  ((key: string, fallback: string) => {
    const value = t(key);
    return value === key ? fallback : value;
  });

// Logic to calculate the range of page numbers to show
const getPageNumbers = () => {
  const pages = [];
  const sidePages = 2; // Number of pages to show on each side of current page

  // Always show first page
  pages.push(1);

  if (currentPage > sidePages + 2) {
    pages.push('...');
  }

  // Range around current page
  const start = Math.max(2, currentPage - sidePages);
  const end = Math.min(totalPages - 1, currentPage + sidePages);

  for (let i = start; i <= end; i++) {
    pages.push(i);
  }

  if (currentPage < totalPages - sidePages - 1) {
    pages.push('...');
  }

  // Always show last page if more than 1 page
  if (totalPages > 1) {
    pages.push(totalPages);
  }

  return pages;
};

const getUrlForPage = (p: number) => {
  const params = new URLSearchParams(searchParams);
  if (p > 1) {
    params.set('page', String(p));
  } else {
    params.delete('page');
  }

  const serialized = params.toString();
  return serialized ? `${baseUrl}?${serialized}` : baseUrl;
};

const pages = getPageNumbers();
---

<nav class="flex flex-col items-center gap-5 mt-12 w-full" aria-label="Pagination">
  <div class="skill-detail-surface flex items-center justify-center gap-2 flex-wrap p-2">
    <!-- Previous Button -->
    {
      currentPage > 1 ? (
        <a
          href={getUrlForPage(currentPage - 1)}
          class="px-4 py-2.5 rounded-md border border-[var(--border)] bg-[var(--card)] text-[var(--foreground)] font-bold hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-all flex items-center gap-1 min-h-11"
        >
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="3"
            aria-hidden="true"
          >
            <path stroke-linecap="square" stroke-linejoin="miter" d="M15 19l-7-7 7-7" />
          </svg>
          <span class="hidden sm:inline">{t('Common.prev')}</span>
        </a>
      ) : (
        <span class="px-4 py-2.5 rounded-md bg-[var(--muted)] border border-[var(--border)] text-[var(--muted-foreground)] font-bold opacity-50 cursor-not-allowed flex items-center gap-1 min-h-11">
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="3"
            aria-hidden="true"
          >
            <path stroke-linecap="square" stroke-linejoin="miter" d="M15 19l-7-7 7-7" />
          </svg>
          <span class="hidden sm:inline">{t('Common.prev')}</span>
        </span>
      )
    }

    <!-- Page Numbers -->
    <div class="flex items-center gap-2">
      {
        pages.map((p) => {
          if (p === '...') {
            return (
              <span class="w-10 h-10 flex items-center justify-center font-bold text-[var(--muted-foreground)]">
                ...
              </span>
            );
          }

          const isCurrent = p === currentPage;
          return (
            <a
              href={getUrlForPage(p as number)}
              aria-label={`Page ${p}`}
              aria-current={isCurrent ? 'page' : undefined}
              class:list={[
                'w-11 h-11 rounded-md flex items-center justify-center border font-bold font-mono transition-all',
                isCurrent
                  ? 'bg-[var(--foreground)] border-[var(--foreground)] text-[var(--background)]'
                  : 'bg-[var(--card)] border-[var(--border)] text-[var(--foreground)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)]',
              ]}
            >
              {p}
            </a>
          );
        })
      }
    </div>

    <!-- Next Button -->
    {
      currentPage < totalPages ? (
        <a
          href={getUrlForPage(currentPage + 1)}
          class="px-4 py-2.5 rounded-md border border-[var(--border)] bg-[var(--card)] text-[var(--foreground)] font-bold hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-all flex items-center gap-1 min-h-11"
        >
          <span class="hidden sm:inline">{t('Common.next')}</span>
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="3"
            aria-hidden="true"
          >
            <path stroke-linecap="square" stroke-linejoin="miter" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      ) : (
        <span class="px-4 py-2.5 rounded-md bg-[var(--muted)] border border-[var(--border)] text-[var(--muted-foreground)] font-bold opacity-50 cursor-not-allowed flex items-center gap-1 min-h-11">
          <span class="hidden sm:inline">{t('Common.next')}</span>
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="3"
            aria-hidden="true"
          >
            <path stroke-linecap="square" stroke-linejoin="miter" d="M9 5l7 7-7 7" />
          </svg>
        </span>
      )
    }
  </div>

  <!-- Jump to Page -->
  <div class="flex items-center gap-3">
    <div class="relative group">
      <label for="jump-page" class="sr-only">{resolveLabel('Common.page', 'Page number')}</label>
      <input
        id="jump-page"
        type="number"
        min="1"
        max={totalPages}
        placeholder={resolveLabel('Common.page', 'Page')}
        aria-label={resolveLabel('Common.page', 'Page number')}
        class="jump-page-input w-20 rounded-md bg-[var(--card)] border border-[var(--border)] px-3 py-2 font-mono font-bold text-[var(--foreground)] focus:ring-0 focus:border-[var(--accent)] transition-all"
      />
    </div>
    <button
      aria-label={resolveLabel('Common.goToPage', 'Go to page')}
      class="jump-page-button market-button px-4 py-2 text-sm"
    >
      {resolveLabel('Common.go', 'Go')}
    </button>
  </div>

  <div
    class="pagination-data hidden"
    data-base-url={baseUrl}
    data-search-params={JSON.stringify(searchParams)}
    data-total-pages={totalPages}
    data-error-msg={resolveLabel('Common.pageJumpError', 'Please enter a valid page number between 1 and {max}')}
  >
  </div>
</nav>

<script>
  function setupPagination() {
    // Find all pagination components on the page
    const paginationNavs = document.querySelectorAll('nav[aria-label="Pagination"]');

    paginationNavs.forEach((nav) => {
      const input = nav.querySelector('.jump-page-input') as HTMLInputElement;
      const button = nav.querySelector('.jump-page-button');
      const dataEl = nav.querySelector('.pagination-data') as HTMLElement;

      if (!input || !button || !dataEl) return;

      const { baseUrl, searchParams, totalPages, errorMsg } = dataEl.dataset;
      const parsedParams = JSON.parse(searchParams || '{}');
      const maxPages = parseInt(totalPages || '1');

      const handleJump = () => {
        const val = input.value.trim();
        if (!val) return;

        const page = parseInt(val);
        if (page >= 1 && page <= maxPages) {
          const params = new URLSearchParams();
          for (const [key, value] of Object.entries(parsedParams)) {
            if (value) params.set(key, String(value));
          }
          if (page > 1) {
            params.set('page', page.toString());
          } else {
            params.delete('page');
          }

          const serialized = params.toString();
          window.location.href = serialized ? `${baseUrl}?${serialized}` : String(baseUrl || '');
        } else {
          const msg = (errorMsg || 'Please enter a page between 1 and {max}').replace('{max}', String(maxPages));
          alert(msg);
        }
      };

      // Use a fresh listener to avoid issues with double binding if astro:page-load handles it
      // But standard event listeners on DOM elements that are replaced should be fine.
      button.addEventListener('click', handleJump);
      input.addEventListener('keypress', (e) => {
        if (e.key === 'Enter') handleJump();
      });
    });
  }

  // Initialize on initial load and after View Transitions
  document.addEventListener('astro:page-load', setupPagination);
</script>
