---
/**
 * HeaderActionsNative – Astro-native replacement for the HeaderActions React island.
 *
 * Renders: search, language dropdown, submit-skill button, favorites link,
 * theme toggle (desktop), and mobile hamburger + fullscreen overlay.
 *
 * Interactivity: vanilla JS in a component-local <script> using
 * astro:page-load lifecycle. No React runtime needed.
 *
 * The mobile overlay is rendered with this component, then hoisted to
 * document.body so sticky/transformed header wrappers cannot clip it.
 */

import SubmitSkillModalNative from './SubmitSkillModalNative.astro';
import type { SiteNavItem } from '../lib/site-ia';

interface Props {
  locale: string;
  localeNames: Record<string, string>;
  primaryNavItems: SiteNavItem[];
  labels: {
    language: string;
    favorites: string;
    switchLanguage: string;
    toggleTheme: string;
    toggleMenu: string;
    favoritesAria: string;
    darkMode?: string;
    lightMode?: string;
    submitSkill: string;
    search: string;
  };
}

const { locale, localeNames, primaryNavItems, labels } = Astro.props;
const navItems = primaryNavItems;

// Inline SVG icons for mobile nav (build-time, zero client JS)
const navSvg: Record<string, string> = {
  home: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 11 9-8 9 8"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/></svg>',
  sparkles:
    '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.94 14.5 8.5 18.75 7.06 14.5 2.75 13l4.31-1.5L8.5 7.25l1.44 4.25L14.25 13z"/><path d="M18 8.5 17.25 11 16.5 8.5 14 7.75 16.5 7 17.25 4.5 18 7l2.5.75z"/></svg>',
  layers:
    '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83Z"/><path d="m22 12.65-9.17 4.16a2 2 0 0 1-1.66 0L2 12.65"/><path d="m22 18.65-9.17 4.16a2 2 0 0 1-1.66 0L2 18.65"/></svg>',
  grid: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>',
  book: '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>',
  users:
    '<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M17 7a4 4 0 0 0-1.49 7.69"/></svg>',
};

const iconSvg: Record<string, string> = {
  search:
    '<svg xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>',
  globe:
    '<svg xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 0 20"/><path d="M12 2a15.3 15.3 0 0 0 0 20"/></svg>',
  chevronDown:
    '<svg xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>',
  rocket:
    '<svg xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>',
  heart:
    '<svg xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19.5 12.6 12 20l-7.5-7.4A5 5 0 0 1 12 6a5 5 0 0 1 7.5 6.6z"/></svg>',
  sun: '<svg xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>',
  moon: '<svg xmlns="http://www.w3.org/2000/svg" style="width:100%;height:100%;display:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3a6 6 0 0 0 9 7 9 9 0 1 1-9-7z"/></svg>',
  menu: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" style="display:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16"/><path d="M4 12h16"/><path d="M4 18h16"/></svg>',
  x: '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" style="display:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>',
};
---

<div
  class="header-actions flex items-center gap-2 md:gap-4"
  data-locale={locale}
  data-dark-label={labels.darkMode || 'Dark Mode'}
  data-light-label={labels.lightMode || 'Light Mode'}
>
  {/* ── Search Button (Desktop) ─────────────────────────────────────── */}
  <button
    class="header-search-btn hidden md:flex items-center gap-2 px-3 py-1.5 rounded-md border border-transparent hover:border-[var(--border)] hover:bg-[var(--card)] text-[var(--foreground)] transition-colors font-semibold text-sm shrink-0 whitespace-nowrap"
    aria-label={labels.search}
  >
    <span class="w-4 h-4" aria-hidden="true" set:html={iconSvg.search} />
    <span class="hidden xl:inline">{labels.search}</span>
    <kbd
      class="hidden xl:inline px-1.5 ml-1 py-0.5 text-[10px] bg-[var(--foreground)] text-[var(--background)] rounded-sm"
      >⌘K</kbd
    >
  </button>

  {/* ── Language Selector (Desktop) ──────────────────────────────────── */}
  <div class="relative hidden md:block header-lang-dropdown">
    <button
      class="header-lang-toggle px-3 py-1.5 rounded-md border border-transparent hover:border-[var(--border)] hover:bg-[var(--card)] text-[var(--foreground)] transition-colors flex items-center gap-2 font-semibold text-sm shrink-0 whitespace-nowrap"
      aria-label={labels.switchLanguage}
      aria-expanded="false"
    >
      <span class="w-4 h-4" aria-hidden="true" set:html={iconSvg.globe} />
      <span class="hidden md:inline">{localeNames[locale] || locale}</span>
      <span
        class="w-4 h-4 hidden md:inline header-lang-chevron transition-transform duration-100"
        aria-hidden="true"
        set:html={iconSvg.chevronDown}
      />
    </button>

    <div
      class="header-lang-menu absolute right-0 top-full mt-2 w-[340px] rounded-lg bg-[var(--card)] border border-[var(--border)] shadow-lg z-50 p-3 font-semibold text-xs sm:text-sm grid grid-cols-2 gap-2 hidden"
    >
      {
        Object.entries(localeNames).map(([code, name]) => (
          <button
            type="button"
            class={`header-lang-option w-full text-left px-3 py-2 border-2 transition-all flex items-center justify-between ${
              code === locale
                ? 'bg-[var(--tag-bg)] text-[var(--tag-text)] border-[var(--tag-border)]'
                : 'bg-[var(--background)] text-[var(--foreground)] border-[var(--border)] hover:bg-[var(--muted)]'
            }`}
            data-locale-code={code}
          >
            <span class="truncate">{name}</span>
          </button>
        ))
      }
    </div>
  </div>

  {/* ── Submit Skill Button (Desktop) ───────────────────────────────── */}
  <button
    class="header-submit-btn hidden md:flex items-center gap-2 px-3 py-2 rounded-md border border-[var(--accent)] bg-[var(--accent)] text-[var(--accent-foreground)] hover:brightness-95 transition-all font-bold text-sm whitespace-nowrap shrink-0"
    aria-label={labels.submitSkill}
  >
    <span class="w-4 h-4" aria-hidden="true" set:html={iconSvg.rocket} />
    <span>{labels.submitSkill}</span>
  </button>

  {/* ── Favorites Link (Desktop) ────────────────────────────────────── */}
  <a
    href={`/${locale}/favorites`}
    class="hidden md:flex items-center justify-center p-2 rounded-md border border-transparent hover:border-[var(--border)] hover:bg-[var(--card)] text-[var(--foreground)] transition-colors"
    aria-label={labels.favoritesAria}
  >
    <span class="w-5 h-5" aria-hidden="true" set:html={iconSvg.heart} />
  </a>

  {/* ── Theme Toggle (Desktop) ───────────────────────────────────────── */}
  <button
    class="header-theme-btn hidden md:inline-flex h-9 w-9 items-center justify-center rounded-md border border-transparent hover:border-[var(--border)] hover:bg-[var(--card)] text-[var(--foreground)] transition-colors"
    aria-label={labels.toggleTheme}
  >
    <span class="block w-5 h-5 header-theme-icon-light" aria-hidden="true" set:html={iconSvg.sun} />
    <span class="block w-5 h-5 header-theme-icon-dark hidden" aria-hidden="true" set:html={iconSvg.moon} />
  </button>

  {/* ── Mobile Menu Toggle ──────────────────────────────────────────── */}
  <button
    class="header-mobile-toggle md:hidden inline-flex h-11 w-11 items-center justify-center rounded-md border border-[var(--border)] hover:bg-[var(--card)] text-[var(--foreground)] transition-colors"
    style="width:44px;height:44px;min-width:44px"
    aria-label={labels.toggleMenu}
    aria-expanded="false"
  >
    <span class="block w-6 h-6 header-menu-icon-open" aria-hidden="true" set:html={iconSvg.menu} />
    <span class="block w-6 h-6 header-menu-icon-close hidden" aria-hidden="true" set:html={iconSvg.x} />
  </button>
</div>

{/* ── Mobile Overlay ────────────────────────────────────────────────────── */}
<div
  class="header-mobile-overlay hidden fixed inset-0 z-[60] md:hidden overflow-hidden transition-all duration-150 ease-out invisible opacity-0 pointer-events-none"
  aria-hidden="true"
>
  {/* Backdrop */}
  <div class="header-mobile-backdrop absolute inset-0 bg-[var(--background)] opacity-95"></div>

  {/* Panel */}
  <div
    class="header-mobile-panel absolute inset-y-4 right-4 left-4 sm:left-auto sm:w-[420px] rounded-lg border border-[var(--border)] bg-[var(--card)] flex flex-col transition-transform duration-200 ease-out translate-x-full translate-y-4 overflow-hidden"
  >
    {/* Panel Header */}
    <div
      class="flex items-center justify-between px-6 h-16 shrink-0 border-b border-[var(--border)] bg-[var(--background)]"
    >
      <a href={`/${locale}`} class="flex items-center gap-3 group">
        <div
          class="w-8 h-8 rounded-lg flex items-center justify-center bg-[var(--secondary)] border border-[var(--border)] text-[var(--secondary-foreground)] font-bold text-xs"
        >
          KS
        </div>
        <span class="font-display font-extrabold text-xl tracking-tight text-[var(--foreground)]"> Killer-Skills </span>
      </a>
      <button
        class="header-mobile-close inline-flex h-11 w-11 items-center justify-center rounded-md border border-transparent hover:border-[var(--border)] hover:bg-[var(--muted)] text-[var(--foreground)] transition-colors"
        style="width:44px;height:44px;min-width:44px"
        aria-label={labels.toggleMenu}
      >
        <span class="block w-6 h-6" aria-hidden="true" set:html={iconSvg.x} />
      </button>
    </div>

    {/* Nav items */}
    <div class="flex-1 overflow-y-auto bg-[var(--background)] flex flex-col">
      <nav class="flex flex-col border-b border-[var(--border)]">
        {
          navItems.map(({ href, label, icon }) => (
            <a
              href={href}
              class="header-mobile-nav-link flex items-center gap-4 px-6 py-4 text-[16px] font-semibold text-[var(--foreground)] border-b last:border-b-0 border-[var(--border)] hover:bg-[var(--muted)] transition-colors"
            >
              <Fragment set:html={navSvg[icon]} />
              {label}
            </a>
          ))
        }
      </nav>

      {/* Quick actions */}
      <div class="flex flex-col border-b border-[var(--border)] bg-[var(--card)]">
        <button
          class="header-mobile-submit flex items-center gap-4 px-6 py-4 text-[16px] font-bold text-[var(--accent-foreground)] bg-[var(--accent)] rounded-lg border border-[var(--accent)] hover:brightness-95 transition-all m-4 mt-2"
        >
          <span class="w-5 h-5 flex-shrink-0" aria-hidden="true" set:html={iconSvg.rocket} />
          {labels.submitSkill}
        </button>
        <button
          type="button"
          class="header-mobile-search flex items-center gap-4 px-6 py-4 text-[16px] font-semibold text-[var(--foreground)] border-b border-[var(--border)] hover:bg-[var(--muted)] transition-colors w-full text-left"
        >
          <span class="w-5 h-5 flex-shrink-0" aria-hidden="true" set:html={iconSvg.search} />
          {labels.search}
        </button>
        <a
          href={`/${locale}/favorites`}
          class="header-mobile-fav flex items-center gap-4 px-6 py-4 text-[16px] font-semibold text-[var(--foreground)] border-b border-[var(--border)] hover:bg-[var(--muted)] transition-colors"
        >
          <span class="w-5 h-5 flex-shrink-0" aria-hidden="true" set:html={iconSvg.heart} />
          {labels.favorites}
        </a>
        <button
          type="button"
          class="header-mobile-theme flex items-center gap-4 px-6 py-4 text-[16px] font-semibold text-[var(--foreground)] hover:bg-[var(--muted)] transition-colors w-full text-left"
        >
          <span class="w-5 h-5 flex-shrink-0 header-theme-icon-light" aria-hidden="true" set:html={iconSvg.sun} />
          <span
            class="w-5 h-5 flex-shrink-0 header-theme-icon-dark hidden"
            aria-hidden="true"
            set:html={iconSvg.moon}
          />
          <span class="header-theme-label">{labels.lightMode || 'Light Mode'}</span>
        </button>
      </div>

      {/* Language Selector (Mobile) */}
      <div class="p-6 bg-[var(--background)] flex-1">
        <span class="text-xs font-bold text-[var(--muted-foreground)] mb-4 block font-mono">
          // {labels.language}
        </span>
        <div class="grid grid-cols-2 gap-3">
          {
            Object.entries(localeNames).map(([code, name]) => (
              <button
                type="button"
                class={`header-mobile-lang text-left px-4 py-3 text-sm font-semibold rounded-md border transition-all ${
                  code === locale
                    ? 'bg-[var(--tag-bg)] text-[var(--tag-text)] border-[var(--tag-border)]'
                    : 'bg-[var(--background)] text-[var(--foreground)] border-[var(--border)] hover:bg-[var(--muted)]'
                }`}
                data-locale-code={code}
              >
                {name}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</div>

{/* ── Submit Skill Modal (native dialog) ────────────────────────────────── */}
<SubmitSkillModalNative locale={locale} />

<script>
  function initHeaderActions() {
    document.querySelectorAll<HTMLElement>('.header-actions').forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const locale = container.dataset.locale || 'en';
      const darkLabel = container.dataset.darkLabel || 'Dark Mode';
      const lightLabel = container.dataset.lightLabel || 'Light Mode';

      // ── Search dispatch ─────────────────────────────────────────────
      const openSearch = () => {
        window.dispatchEvent(new CustomEvent('ks:open-search'));
        closeMobileMenu();
      };

      container.querySelectorAll('.header-search-btn').forEach((btn) => {
        btn.addEventListener('click', openSearch);
      });

      // ── Theme toggle ───────────────────────────────────────────────
      function updateThemeIcons() {
        const isDark = document.documentElement.classList.contains('dark');
        container.querySelectorAll('.header-theme-icon-light').forEach((el) => {
          el.classList.toggle('hidden', isDark);
        });
        container.querySelectorAll('.header-theme-icon-dark').forEach((el) => {
          el.classList.toggle('hidden', !isDark);
        });
        container.querySelectorAll('.header-theme-label').forEach((el) => {
          el.textContent = isDark ? darkLabel : lightLabel;
        });
      }

      updateThemeIcons();
      document.addEventListener('astro:after-swap', updateThemeIcons);

      function toggleTheme() {
        const isDark = document.documentElement.classList.contains('dark');
        const newTheme = isDark ? 'light' : 'dark';
        localStorage.setItem('theme', newTheme);
        if (newTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
        updateThemeIcons();
      }

      container.querySelectorAll('.header-theme-btn').forEach((btn) => {
        btn.addEventListener('click', toggleTheme);
      });
      container.querySelectorAll('.header-mobile-theme').forEach((btn) => {
        btn.addEventListener('click', toggleTheme);
      });

      // ── Language selector ───────────────────────────────────────────
      const langToggle = container.querySelector<HTMLButtonElement>('.header-lang-toggle');
      const langMenu = container.querySelector<HTMLElement>('.header-lang-menu');
      const langChevron = container.querySelector<HTMLElement>('.header-lang-chevron');
      let langOpen = false;

      function toggleLangMenu(open?: boolean) {
        langOpen = open ?? !langOpen;
        langMenu?.classList.toggle('hidden', !langOpen);
        langChevron?.classList.toggle('rotate-180', langOpen);
        if (langToggle) langToggle.ariaExpanded = String(langOpen);
      }

      langToggle?.addEventListener('click', () => toggleLangMenu());

      // Close on click outside
      document.addEventListener('mousedown', (e) => {
        if (langOpen) {
          const dropdown = container.querySelector('.header-lang-dropdown');
          if (dropdown && !dropdown.contains(e.target as Node)) {
            toggleLangMenu(false);
          }
        }
      });

      // Language switching
      function switchLanguage(code: string) {
        if (code === locale) {
          toggleLangMenu(false);
          closeMobileMenu();
          return;
        }
        toggleLangMenu(false);
        closeMobileMenu();
        document.cookie = `locale=${code};path=/;max-age=31536000;SameSite=Lax`;
        const currentPath = window.location.pathname;
        const newPath = currentPath.replace(new RegExp(`^/${locale}(/|$)`), `/${code}$1`);
        window.location.href = newPath;
      }

      container.querySelectorAll('.header-lang-option').forEach((btn) => {
        btn.addEventListener('click', () => {
          const code = (btn as HTMLElement).dataset.localeCode || '';
          switchLanguage(code);
        });
      });

      container.querySelectorAll('.header-mobile-lang').forEach((btn) => {
        btn.addEventListener('click', () => {
          const code = (btn as HTMLElement).dataset.localeCode || '';
          switchLanguage(code);
        });
      });

      // ── Mobile menu ────────────────────────────────────────────────
      let overlay = container.parentElement?.querySelector<HTMLElement>('.header-mobile-overlay');
      if (overlay && overlay.parentElement !== document.body) {
        document.body.appendChild(overlay);
      }
      const panel = overlay?.querySelector<HTMLElement>('.header-mobile-panel');
      const menuIconOpen = container.querySelector<HTMLElement>('.header-menu-icon-open');
      const menuIconClose = container.querySelector<HTMLElement>('.header-menu-icon-close');
      let menuOpen = false;

      function openMobileMenu() {
        menuOpen = true;
        overlay?.classList.remove('hidden', 'invisible', 'opacity-0', 'pointer-events-none');
        overlay?.classList.add('visible', 'opacity-100', 'pointer-events-auto');
        overlay?.setAttribute('aria-hidden', 'false');
        panel?.classList.remove('translate-x-full', 'translate-y-4');
        panel?.classList.add('translate-x-0', 'translate-y-0');
        menuIconOpen?.classList.add('hidden');
        menuIconClose?.classList.remove('hidden');
        const toggle = container.querySelector<HTMLButtonElement>('.header-mobile-toggle');
        if (toggle) toggle.ariaExpanded = 'true';
        document.body.style.overflow = 'hidden';
      }

      function closeMobileMenu() {
        menuOpen = false;
        overlay?.classList.add('hidden', 'invisible', 'opacity-0', 'pointer-events-none');
        overlay?.classList.remove('visible', 'opacity-100', 'pointer-events-auto');
        overlay?.setAttribute('aria-hidden', 'true');
        panel?.classList.add('translate-x-full', 'translate-y-4');
        panel?.classList.remove('translate-x-0', 'translate-y-0');
        menuIconOpen?.classList.remove('hidden');
        menuIconClose?.classList.add('hidden');
        const toggle = container.querySelector<HTMLButtonElement>('.header-mobile-toggle');
        if (toggle) toggle.ariaExpanded = 'false';
        document.body.style.overflow = '';
      }

      container.querySelectorAll('.header-mobile-toggle').forEach((btn) => {
        btn.addEventListener('click', () => (menuOpen ? closeMobileMenu() : openMobileMenu()));
      });

      overlay?.querySelector('.header-mobile-backdrop')?.addEventListener('click', closeMobileMenu);
      overlay?.querySelector('.header-mobile-close')?.addEventListener('click', closeMobileMenu);

      // Close on navigation (View Transitions)
      document.addEventListener('astro:after-swap', () => {
        closeMobileMenu();
        toggleLangMenu(false);
      });

      // Close mobile nav links on click
      overlay?.querySelectorAll('.header-mobile-nav-link, .header-mobile-fav').forEach((link) => {
        link.addEventListener('click', closeMobileMenu);
      });

      // Mobile quick actions
      overlay?.querySelector('.header-mobile-search')?.addEventListener('click', openSearch);

      // ── Submit Skill Modal ──────────────────────────────────────────
      const submitDialog = container.parentElement?.querySelector<HTMLDialogElement>('.submit-skill-dialog');

      container.querySelectorAll('.header-submit-btn').forEach((btn) => {
        btn.addEventListener('click', () => submitDialog?.showModal());
      });

      overlay?.querySelector('.header-mobile-submit')?.addEventListener('click', () => {
        closeMobileMenu();
        setTimeout(() => submitDialog?.showModal(), 300);
      });
    });
  }

  document.addEventListener('astro:page-load', initHeaderActions);
</script>
