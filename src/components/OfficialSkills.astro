---
import CollectionCard from './CollectionCard.astro';
import { OFFICIAL_REPOS } from '../lib/skills-config';
import { getOfficialSkillCounts } from '../lib/public-skill-catalog';
import { loadMessages, useTranslations, type Locale } from '../i18n';
import type { Env } from '../lib/kv';
import { getRuntimeEnv } from '../lib/runtime-env';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const env = (await getRuntimeEnv<Env>(Astro.locals)) as Env;

// Load translations
const messages = await loadMessages(locale as Locale);
const t = useTranslations(messages);
const isZhCopy = locale.startsWith('zh');

// Get official repo owners from config
const officialRepoOwners = [
  ...new Set(
    Object.values(OFFICIAL_REPOS)
      .filter((r) => r.type === 'official')
      .map((r) => r.owner),
  ),
];

// Use optimized GROUP BY query — no full table scan
const sortedOwners = await getOfficialSkillCounts(env, officialRepoOwners, 6);
---

<section class="py-16 md:py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between mb-10">
    <div>
      <div class="flex flex-wrap items-center gap-3 mb-3">
        <h2 class="text-3xl md:text-4xl font-display font-bold text-[var(--foreground)] tracking-tight">
          {t('OfficialSkills.title')}
        </h2>
        <span
          class="rounded-full px-3 py-1 bg-[var(--tag-bg)] text-[var(--tag-text)] border border-[var(--tag-border)] font-bold text-xs"
        >
          {t('OfficialSkills.verified')}
        </span>
      </div>
      <p class="text-[var(--muted-foreground)] text-base leading-7 max-w-2xl">
        {t('OfficialSkills.subtitle')}
      </p>
    </div>
    <a
      href={`/${locale}/search?source=official`}
      class="hidden md:flex items-center gap-2 rounded-lg px-5 py-3 border border-[var(--border)] bg-[var(--card)] text-[var(--foreground)] font-bold hover:border-[var(--accent)] transition-all"
    >
      {isZhCopy ? '浏览官方技能' : 'Browse official skills'}
      <span class="font-mono ml-1">→</span>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {
      sortedOwners.length > 0 ? (
        sortedOwners.map(({ owner, count }, index) => (
          <CollectionCard owner={owner} count={count} locale={locale} priority={index < 3} />
        ))
      ) : (
        <div class="col-span-full text-center py-12 text-[var(--muted-foreground)]">
          <p>{t('Skills.noResults')}</p>
        </div>
      )
    }
  </div>
</section>
