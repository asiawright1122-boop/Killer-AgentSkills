---
import CollectionCard from './CollectionCard.astro';
import { OFFICIAL_REPOS } from '../lib/skills-config';
import { getOfficialSkillCounts } from '../lib/skills';
import { loadMessages, useTranslations, type Locale } from '../i18n';
import type { Env } from '../lib/kv';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const env = (Astro.locals as any).runtime?.env as Env;

// Load translations
const messages = await loadMessages(locale as Locale);
const t = useTranslations(messages);

// Get official repo owners from config
const officialRepoOwners = [...new Set(
  Object.values(OFFICIAL_REPOS)
    .filter(r => r.type === 'official')
    .map(r => r.owner)
)];

// Use optimized GROUP BY query — no full table scan
const sortedOwners = await getOfficialSkillCounts(env, officialRepoOwners, 6);
---

<section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between mb-12">
    <div>
      <div class="flex items-center gap-4 mb-3">
        <h2 class="text-4xl font-black text-[var(--foreground)] uppercase tracking-tight">{t('OfficialSkills.title')}</h2>
        <span class="px-2 py-1 bg-[var(--foreground)] text-[var(--background)] font-black text-[10px] uppercase tracking-widest">
          [ {t('OfficialSkills.verified')} ]
        </span>
      </div>
      <p class="text-[var(--muted-foreground)] font-mono text-sm max-w-xl">
        {t('OfficialSkills.subtitle')}
      </p>
    </div>
    <a href={`/${locale}/skills?view=official`} class="hidden md:flex items-center gap-2 px-6 py-3 border-2 border-[var(--border)] bg-transparent text-[var(--foreground)] font-bold uppercase hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[4px_4px_0px_0px_var(--border)] transition-all">
      {t('Common.viewAll')}
      <span class="font-mono ml-2">→</span>
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {sortedOwners.length > 0 ? (
      sortedOwners.map(({owner, count}, index) => (
        <CollectionCard owner={owner} count={count} locale={locale} priority={index < 3} />
      ))
    ) : (
      <div class="col-span-full text-center py-12 text-slate-500">
        <p>{t('Skills.noResults')}</p>
      </div>
    )}
  </div>
</section>

