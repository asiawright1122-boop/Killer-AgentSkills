---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<div class="tutorial-shell grid grid-cols-1 md:grid-cols-4 gap-8 max-w-7xl mx-auto px-6 py-12">
  <aside class="col-span-1 hidden md:block">
    <div
      class="sticky top-24 bg-[var(--card)] border-4 border-[var(--border)] shadow-[8px_8px_0px_0px_var(--border)] p-6"
    >
      <h3 class="font-black text-lg uppercase tracking-widest border-b-4 border-[var(--border)] pb-4 mb-4">
        Table of Contents
      </h3>
      <nav class="flex flex-col gap-3 font-bold text-[var(--muted-foreground)]">
        <a href="#overview" class="hover:text-[var(--foreground)] hover:translate-x-1 transition-transform uppercase"
          >Overview</a
        >
        <a href="#usage" class="hover:text-[var(--foreground)] hover:translate-x-1 transition-transform uppercase"
          >Usage & Setup</a
        >
        <a
          href="#architecture"
          class="hover:text-[var(--foreground)] hover:translate-x-1 transition-transform uppercase">Architecture</a
        >
        <a href="#features" class="hover:text-[var(--foreground)] hover:translate-x-1 transition-transform uppercase"
          >Key Features</a
        >
      </nav>
    </div>
  </aside>

  <main
    class="col-span-1 md:col-span-3 prose prose-invert max-w-none bg-[var(--background)] border-4 border-[var(--border)] shadow-[8px_8px_0px_0px_var(--border)] p-8 md:p-12 neo-markdown"
  >
    <h1
      id="overview"
      class="text-4xl md:text-5xl font-black uppercase tracking-tight border-b-4 border-[var(--border)] pb-6"
    >
      {title}
    </h1>
    <p class="text-xl font-bold text-[var(--muted-foreground)] mb-12">{description}</p>
    <slot />
  </main>
</div>

<style is:global>
  .neo-markdown h2 {
    @apply text-3xl font-black uppercase tracking-widest border-b-4 border-[var(--border)] pb-4 mt-16 mb-8 text-[var(--foreground)];
  }
  .neo-markdown h3 {
    @apply text-xl font-bold uppercase tracking-wide mt-10 mb-4 text-[var(--foreground)];
  }
  .neo-markdown pre {
    @apply bg-[var(--card)] border-4 border-[var(--border)] shadow-[6px_6px_0px_0px_var(--primary)] p-6 my-8 overflow-x-auto;
  }
  .neo-markdown code {
    @apply font-mono text-emerald-500 dark:text-emerald-400 font-bold bg-[var(--card)] px-1 relative;
  }
  .neo-markdown p {
    @apply text-lg leading-relaxed mb-6 font-medium text-[var(--foreground)] opacity-90;
  }
  .neo-markdown a {
    @apply text-[var(--primary)] underline decoration-4 underline-offset-4 hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] hover:no-underline transition-all;
  }
</style>
