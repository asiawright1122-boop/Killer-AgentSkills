---
/**
 * SkillReadmeNative – Astro‑native replacement for the SkillReadme React island.
 *
 * Strategy: SSR all markdown/file content to HTML in the Astro frontmatter using
 * Astro's built-in `createMarkdownProcessor`. Vanilla JS handles file switching
 * (via nanostores), copy button, and the "Preview/Raw" toggle.
 *
 * This eliminates react-markdown, react-syntax-highlighter, and all React hooks.
 * Code blocks are rendered as plain pre/code HTML to keep the Worker bundle
 * below Cloudflare's free-tier limit; zero client-side JS is needed for rendering.
 *
 * Props: initialContent, initialFiles, headerTitle, headerDescription, headerBadge,
 *        sourceRepositoryOwner, sourceRepositoryRepo, sourceFilePath
 */

import { unified } from 'unified';
import remarkParse from 'remark-parse';
import remarkGfm from 'remark-gfm';
import remarkSmartypants from 'remark-smartypants';
import remarkRehype from 'remark-rehype';
import rehypeRaw from 'rehype-raw';
import rehypeStringify from 'rehype-stringify';
import { FileText, Copy, Check, Eye } from 'lucide-react';
import { slugifyHeading } from '../lib/markdown-headings';
import { resolveRepositoryMarkdownImage, resolveRepositoryMarkdownLink } from '../lib/markdown-source-links';

interface Props {
  initialContent: string;
  initialFiles?: Record<string, string>;
  headerTitle?: string;
  headerDescription?: string;
  headerBadge?: string;
  sourceRepositoryOwner?: string;
  sourceRepositoryRepo?: string;
  sourceFilePath?: string;
}

const {
  initialContent,
  initialFiles = {},
  headerTitle,
  headerDescription,
  headerBadge,
  sourceRepositoryOwner,
  sourceRepositoryRepo,
  sourceFilePath,
} = Astro.props;

// --- SSR markdown rendering ---
const markdownContext =
  sourceRepositoryOwner && sourceRepositoryRepo
    ? {
        owner: sourceRepositoryOwner,
        repo: sourceRepositoryRepo,
        sourceFilePath,
      }
    : null;

const getTextContent = (node: any): string => {
  if (!node || typeof node !== 'object') return '';
  if (node.type === 'text') return String(node.value || '');
  if (!Array.isArray(node.children)) return '';
  return node.children.map(getTextContent).join('');
};

function rehypeReadmeLinksAndHeadings() {
  return (tree: any) => {
    const walk = (node: any) => {
      if (!node || typeof node !== 'object') return;

      if (node.type === 'element') {
        node.properties ||= {};

        if (node.tagName === 'h1') {
          node.tagName = 'h2';
        }

        if (/^h[1-6]$/.test(node.tagName || '') && !node.properties.id) {
          const id = slugifyHeading(getTextContent(node));
          if (id) node.properties.id = id;
        }

        if (markdownContext && node.tagName === 'a' && typeof node.properties.href === 'string') {
          const target = resolveRepositoryMarkdownLink(node.properties.href, markdownContext);
          node.properties.href = target.href;
          if (target.isExternal) {
            node.properties.target = '_blank';
            node.properties.rel = 'noopener noreferrer';
          }
        }

        if (markdownContext && node.tagName === 'img' && typeof node.properties.src === 'string') {
          node.properties.src = resolveRepositoryMarkdownImage(node.properties.src, markdownContext).href;
        }
      }

      if (Array.isArray(node.children)) {
        for (const child of node.children) walk(child);
      }
    };

    walk(tree);
  };
}

const processor = unified()
  .use(remarkParse)
  .use(remarkGfm)
  .use(remarkSmartypants)
  .use(remarkRehype, { allowDangerousHtml: true })
  .use(rehypeRaw)
  .use(rehypeReadmeLinksAndHeadings)
  .use(rehypeStringify, { allowDangerousHtml: true });

const renderMarkdown = async (content: string): Promise<string> => String(await processor.process(content));

// Render all files through the markdown pipeline
// Markdown files go through the full processor; raw files get code-block html
const renderedFiles: Record<string, string> = {};

for (const [filename, content] of Object.entries({ 'SKILL.md': initialContent, ...initialFiles })) {
  if (filename.endsWith('.md')) {
    renderedFiles[filename] = await renderMarkdown(content);
  } else {
    // Non-markdown files: render as raw code block (plaintext)
    renderedFiles[filename] = await renderMarkdown(
      '```' + (filename.endsWith('.json') ? 'json' : '') + '\n' + content + '\n```',
    );
  }
}

// Store rendered content as data attributes for vanilla JS to access
import { setFileContent } from '../stores/skill-files';
// Initialize the stores
setFileContent('SKILL.md', initialContent);
for (const [f, c] of Object.entries(initialFiles)) {
  setFileContent(f, c);
}
---

<div
  class="skill-readme skill-detail-card overflow-hidden transition-colors duration-300"
  data-initial-file="SKILL.md"
  data-source-owner={sourceRepositoryOwner}
  data-source-repo={sourceRepositoryRepo}
  data-source-file-path={sourceFilePath}
>
  {/* ── Header ───────────────────────────────────────────────────────────── */}
  <div
    class="h-12 bg-[var(--card)] border-b border-[var(--border)] flex items-center justify-between gap-2 px-3 sm:px-4 transition-colors duration-300"
  >
    <div class="flex min-w-0 items-center gap-2 sm:gap-3">
      <div class="flex gap-1.5 group" aria-hidden="true">
        <div class="w-2.5 h-2.5 rounded-full bg-[var(--danger)]"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-[var(--primary)]"></div>
        <div class="w-2.5 h-2.5 rounded-full bg-[var(--success)]"></div>
      </div>
      <div class="h-4 w-px bg-[var(--border)] mx-0.5 sm:mx-1"></div>
      <div class="flex min-w-0 items-center gap-2 text-[var(--muted-foreground)] text-sm font-mono">
        <FileText size={14} className="shrink-0" />
        <span class="readme-filename truncate text-[var(--foreground)] font-medium">SKILL.md</span>
      </div>
      <span class="market-chip hidden px-1.5 py-0.5 text-[10px] sm:inline-flex">Readonly</span>
    </div>

    <div class="flex shrink-0 items-center gap-1 sm:gap-2">
      <button
        type="button"
        class="readme-preview-btn flex items-center gap-1.5 px-2 sm:px-3 py-1.5 rounded-lg bg-[var(--muted)] hover:bg-[var(--card-hover)] text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-all text-xs font-medium border border-[var(--border)]"
      >
        <Eye size={14} />
        <span class="hidden sm:inline">Preview</span>
      </button>
      <button
        type="button"
        class="readme-copy-btn p-2 hover:bg-[var(--muted)] rounded-lg text-[var(--muted-foreground)] hover:text-[var(--foreground)] transition-colors relative"
        title="Copy content"
      >
        <Copy size={16} className="readme-copy-icon-copy" />
        <Check size={16} className="readme-copy-icon-check hidden text-green-500" />
      </button>
    </div>
  </div>

  {/* ── Skill metadata banner ───────────────────────────────────────────── */}
  {
    (headerTitle || headerDescription || headerBadge) && (
      <div class="border-b border-[var(--border)] bg-[var(--muted)] px-4 py-3 transition-colors duration-300">
        <div class="flex items-start justify-between gap-3 flex-wrap">
          <div class="min-w-0">
            {headerTitle && <div class="text-sm font-bold text-[var(--foreground)]">{headerTitle}</div>}
            {headerDescription && (
              <div class="text-xs font-mono font-bold text-[var(--muted-foreground)] mt-1 leading-relaxed">
                {headerDescription}
              </div>
            )}
          </div>
          {headerBadge && <span class="market-chip px-2 py-1 text-[10px] font-bold">{headerBadge}</span>}
        </div>
      </div>
    )
  }

  {/* ── Content Area ────────────────────────────────────────────────────── */}
  <div class="relative min-h-[320px] max-h-[560px] group/scroll">
    {/* Initial content: SKILL.md rendered markdown */}
    {
      renderedFiles['SKILL.md'] ? (
        <div class="p-8 relative z-10 min-h-[320px] max-h-[560px] overflow-y-auto custom-scrollbar readme-content">
          <article class="prose prose-zinc dark:prose-invert max-w-3xl mx-auto prose-headings:font-bold prose-h1:text-2xl prose-h1:mt-0 prose-h1:tracking-normal prose-a:text-[var(--accent)] prose-img:rounded-xl prose-pre:bg-[var(--muted)] prose-pre:border prose-pre:border-[var(--border)] prose-pre:text-[var(--foreground)]">
            <Fragment set:html={renderedFiles['SKILL.md']} />
          </article>
        </div>
      ) : (
        <div class="rounded-lg overflow-hidden bg-[var(--background)] border border-[var(--border)] transition-colors duration-300 h-full">
          <Fragment set:html={renderedFiles['SKILL.md'] || '<pre><code>Loading…</code></pre>'} />
        </div>
      )
    }
  </div>
</div>

{/* ── Hidden rendered file storage for JS switching ───────────────────── */}
<div class="rendered-files-data hidden" data-files={JSON.stringify(renderedFiles)}></div>

<script>
  import { currentFile } from '../stores/skill-files';

  function initSkillReadme() {
    document.querySelectorAll<HTMLElement>('.skill-readme').forEach((container) => {
      if (container.dataset.initialized) return;
      container.dataset.initialized = 'true';

      const renderedFilesEl = container.querySelector<HTMLElement>('.rendered-files-data');
      if (!renderedFilesEl) return;
      const renderedFiles: Record<string, string> = JSON.parse(renderedFilesEl.dataset.files || '{}');

      const filenameEl = container.querySelector<HTMLElement>('.readme-filename')!;
      const contentArea = container.querySelector<HTMLElement>('.readme-content')!;
      const copyBtn = container.querySelector<HTMLButtonElement>('.readme-copy-btn')!;
      const copyIconCopy = container.querySelector<HTMLElement>('.readme-copy-icon-copy')!;
      const copyIconCheck = container.querySelector<HTMLElement>('.readme-copy-icon-check')!;

      // Switch file content when nanostore changes
      function switchToFile(filename: string) {
        if (!renderedFiles[filename]) return;

        // Update header filename display
        filenameEl!.textContent = filename;

        // Replace content
        const html = renderedFiles[filename];
        if (filename.endsWith('.md')) {
          contentArea!.innerHTML = `<article class="prose prose-zinc dark:prose-invert max-w-3xl mx-auto prose-headings:font-bold prose-h1:text-2xl prose-h1:mt-0 prose-h1:tracking-normal prose-a:text-[var(--accent)] prose-img:rounded-xl prose-pre:bg-[var(--muted)] prose-pre:border prose-pre:border-[var(--border)] prose-pre:text-[var(--foreground)]">${html}</article>`;
        } else {
          contentArea!.innerHTML = `<div class="rounded-lg overflow-hidden bg-[var(--background)] border border-[var(--border)] transition-colors duration-300 h-full">${html}</div>`;
        }
      }

      // Subscribe to nanostore
      currentFile.listen((newFile) => {
        switchToFile(newFile);
      });

      // Copy button
      copyBtn.addEventListener('click', () => {
        // Find the text content of the currently displayed file
        const text = contentArea?.textContent || '';
        navigator.clipboard.writeText(text).then(() => {
          copyIconCopy.classList.add('hidden');
          copyIconCheck.classList.remove('hidden');
          setTimeout(() => {
            copyIconCopy.classList.remove('hidden');
            copyIconCheck.classList.add('hidden');
          }, 2000);
        });
      });
    });
  }

  document.addEventListener('astro:page-load', initSkillReadme);
</script>
