---
import HeaderActionsNative from '../components/HeaderActionsNative.astro';
import { LOCALE_NAMES, translateOr } from '../i18n';
import { getPrimaryNavItems } from '../lib/site-ia';

interface Props {
  locale: string;
  messages: Record<string, any>;
}

const { locale, messages } = Astro.props;
const tr = (key: string, fallback: string) => translateOr(messages, key, fallback);
const primaryNavItems = getPrimaryNavItems(locale);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || `/${locale}`;
const isActiveNav = (href: string) => {
  const normalizedHref = href.replace(/\/$/, '') || `/${locale}`;
  if (normalizedHref === `/${locale}`) return currentPath === normalizedHref;
  return currentPath === normalizedHref || currentPath.startsWith(`${normalizedHref}/`);
};
---

<header
  class="sticky top-0 z-50 w-full border-b border-[var(--border)] bg-[var(--background)]/88 backdrop-blur-xl transition-all safe-area-px"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={`/${locale}`} class="flex items-center gap-3 group">
      <div
        class="relative w-9 h-9 rounded-lg flex items-center justify-center bg-[var(--secondary)] text-[var(--secondary-foreground)] border border-[var(--border)] transition-all group-hover:border-[var(--accent)]"
      >
        <span class="font-display font-extrabold tracking-tight text-xs">KS</span>
      </div>
      <span class="font-display font-extrabold text-lg tracking-tight text-[var(--foreground)] whitespace-nowrap">
        Killer-Skills
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav
      aria-label="Main navigation"
      class="hidden lg:flex items-center gap-1 xl:gap-4 text-sm font-bold text-[var(--foreground)] whitespace-nowrap shrink-0"
    >
      {
        primaryNavItems.map((item) => (
          <a
            href={item.href}
            class={`px-2.5 py-1.5 rounded-md border transition-all shrink-0 ${
              isActiveNav(item.href)
                ? 'border-[var(--accent)] bg-[var(--tag-bg)] text-[var(--tag-text)]'
                : 'border-transparent hover:border-[var(--border)] hover:bg-[var(--card)]'
            }`}
            aria-current={isActiveNav(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <!-- Rights/Actions -->
    <HeaderActionsNative
      locale={locale}
      localeNames={LOCALE_NAMES}
      primaryNavItems={primaryNavItems}
      labels={{
        language: tr('Common.language', 'Language'),
        favorites: tr('Navigation.favorites', 'Favorites'),
        switchLanguage: tr('Aria.switchLanguage', 'Switch language'),
        toggleTheme: tr('Aria.toggleTheme', 'Toggle theme'),
        toggleMenu: tr('Aria.toggleMenu', 'Toggle menu'),
        favoritesAria: tr('Navigation.favorites', 'Favorites'),
        darkMode: tr('Common.darkMode', 'Dark Mode'),
        submitSkill: tr('Navigation.submitSkill', 'Submit Skill'),
        search: tr('Common.search', 'Search'),
      }}
    />
  </div>
</header>
