---
import HeaderActions from '../islands/HeaderActions';
import { LOCALE_NAMES, translateOr } from '../i18n';

interface Props {
  locale: string;
  messages: Record<string, any>;
}

const { locale, messages } = Astro.props;
const tr = (key: string, fallback: string) => translateOr(messages, key, fallback);
---

<header
  class="sticky top-0 z-50 w-full border-b-[3px] border-[var(--border)] bg-[var(--background)]/80 backdrop-blur-md transition-all safe-area-px"
>
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <!-- Logo -->
    <a href={`/${locale}`} class="flex items-center gap-3 group">
      <div
        class="relative w-8 h-8 flex items-center justify-center bg-[var(--primary)] border-2 border-[var(--border)] shadow-[2px_2px_0px_0px_var(--border)] group-hover:translate-x-[-1px] group-hover:translate-y-[-1px] group-hover:shadow-[3px_3px_0px_0px_var(--border)] transition-all"
      >
        <span class="font-black text-[var(--primary-foreground)] tracking-tighter text-xs">KS</span>
      </div>
      <span class="font-black text-xl tracking-tight uppercase text-[var(--foreground)]"> Killer-Skills </span>
    </a>

    <!-- Desktop Nav -->
    <nav
      aria-label="Main navigation"
      class="hidden lg:flex items-center gap-1 xl:gap-5 text-sm font-bold uppercase tracking-wide text-[var(--foreground)] whitespace-nowrap shrink-0"
    >
      <a
        href={`/${locale}`}
        class="px-2 py-1 border-2 border-transparent hover:border-[var(--border)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-all shrink-0"
        >{tr('Common.home', 'Home')}</a
      >
      <a
        href={`/${locale}/skills`}
        class="px-2 py-1 border-2 border-transparent hover:border-[var(--border)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-all shrink-0"
        >{tr('Common.skillsMarket', 'Skills')}</a
      >
      <a
        href={`/${locale}/collections`}
        class="px-2 py-1 border-2 border-transparent hover:border-[var(--border)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-all shrink-0"
        >{tr('Common.collections', 'Collections')}</a
      >
      <a
        href={`/${locale}/blog`}
        class="px-2 py-1 border-2 border-transparent hover:border-[var(--border)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-all shrink-0"
        >{tr('Navigation.blog', 'Blog')}</a
      >
      <a
        href={`/${locale}/docs`}
        class="px-2 py-1 border-2 border-transparent hover:border-[var(--border)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-all shrink-0"
        >{tr('Footer.docs', 'Docs')}</a
      >
      <a
        href={`/${locale}/cli`}
        class="px-2 py-1 border-2 border-transparent hover:border-[var(--border)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] transition-all shrink-0"
        >{tr('Footer.cli', 'CLI')}</a
      >
    </nav>

    <!-- Rights/Actions -->
    <HeaderActions
      client:load
      locale={locale}
      localeNames={LOCALE_NAMES}
      labels={{
        home: tr('Navigation.home', 'Home'),
        skills: tr('Navigation.marketplace', 'Skills'),
        categories: tr('Navigation.categories', 'Categories'),
        blog: tr('Navigation.blog', 'Blog'),
        docs: tr('Navigation.docs', 'Docs'),
        cli: tr('Footer.cli', 'CLI'),
        community: tr('Footer.community', 'Community'),
        collections: tr('Common.collections', 'Collections'),
        language: tr('Common.language', 'Language'),
        theme: tr('Common.theme', 'Theme'),
        favorites: tr('Navigation.favorites', 'Favorites'),
        github: tr('Navigation.github', 'GitHub'),
        switchLanguage: tr('Aria.switchLanguage', 'Switch language'),
        toggleTheme: tr('Aria.toggleTheme', 'Toggle theme'),
        toggleMenu: tr('Aria.toggleMenu', 'Toggle menu'),
        favoritesAria: tr('Navigation.favorites', 'Favorites'),
        darkMode: tr('Common.darkMode', 'Dark Mode'),
        submitSkill: tr('Navigation.submitSkill', 'Submit Skill'),
        search: tr('Navigation.search', 'Search...'),
      }}
    />
  </div>
</header>
