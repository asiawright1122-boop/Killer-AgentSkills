---
interface Props {
  locale: string;
  t: (key: string) => string;
}

const { locale: _locale, t: _t } = Astro.props;
---

<div class="skill-detail-card h-full flex flex-col overflow-hidden transition-colors duration-300">
  <div class="flex items-center gap-2 px-4 py-3 bg-[var(--muted)] border-b border-[var(--border)]">
    <div class="flex gap-2 group">
      <div class="w-3 h-3 rounded-full bg-red-500/80 group-hover:bg-red-500 shadow-sm transition-colors"></div>
      <div class="w-3 h-3 rounded-full bg-yellow-500/80 group-hover:bg-yellow-500 shadow-sm transition-colors"></div>
      <div class="w-3 h-3 rounded-full bg-green-500/80 group-hover:bg-green-500 shadow-sm transition-colors"></div>
    </div>
    <div class="flex-1 text-center mr-16 font-mono text-xs text-[var(--muted-foreground)] font-medium">
      killer-skills — v1.7.0
    </div>
  </div>
  <div class="p-6 md:p-8 font-mono text-sm leading-relaxed text-[var(--muted-foreground)]">
    <div class="mb-6">
      <span class="text-green-600 dark:text-green-400">➜</span>
      <span class="text-[var(--accent)]">~</span>
      <div class="inline-block text-[var(--muted-foreground)] select-none mx-2">$</div>
      <span class="text-[var(--foreground)] font-medium typing-effect">npx killer-skills login</span><br />
      <div class="mt-2 rounded-lg bg-green-500/5 px-4 py-2">
        <span class="text-green-600 dark:text-green-400 font-bold">✓</span>
        <span class="text-[var(--foreground)]">Login successful via GitHub Device Flow</span>
      </div>
    </div>

    <div class="mb-6">
      <span class="text-green-600 dark:text-green-400">➜</span>
      <span class="text-[var(--accent)]">~</span>
      <div class="inline-block text-[var(--muted-foreground)] select-none mx-2">$</div>
      <span class="text-[var(--foreground)] font-medium">npx killer-skills sync</span><br />
      <div class="mt-2 text-[var(--muted-foreground)]">Syncing skills across detected IDE targets...</div>
      <div class="space-y-1 mt-1">
        <div>
          <span class="text-green-600 dark:text-green-400">✔</span>
          <span class="text-[var(--foreground)] font-medium">Cursor</span>
          <span class="text-[var(--muted-foreground)] text-xs ml-2">→ .cursorrules</span>
        </div>
        <div>
          <span class="text-green-600 dark:text-green-400">✔</span>
          <span class="text-[var(--foreground)] font-medium">Claude</span>
          <span class="text-[var(--muted-foreground)] text-xs ml-2">→ CLAUDE.md</span>
        </div>
        <div>
          <span class="text-green-600 dark:text-green-400">✔</span>
          <span class="text-[var(--foreground)] font-medium">VSCode</span>
          <span class="text-[var(--muted-foreground)] text-xs ml-2">→ .github/copilot-instructions.md</span>
        </div>
      </div>
      <div class="mt-2 rounded-lg bg-green-500/5 px-4 py-2 text-[var(--foreground)]">
        <span class="text-green-600 dark:text-green-400 font-bold">✓</span> Synced 21 skills to 3 IDEs
      </div>
    </div>

    <div>
      <span class="text-green-600 dark:text-green-400">➜</span>
      <span class="text-[var(--accent)]">~</span>
      <div class="inline-block text-[var(--muted-foreground)] select-none mx-2">$</div>
      <span class="text-[var(--foreground)] font-medium">npx killer-skills do "create a PDF from images"</span><br />
      <div class="mt-2">
        <span class="text-[var(--accent)]">Auto-matched local skill: </span><span
          class="bg-yellow-100 dark:bg-yellow-900/30 text-yellow-700 dark:text-yellow-400 px-1.5 py-0.5 rounded text-xs font-bold ring-1 ring-yellow-500/20"
          >pdf</span
        >
      </div>
      <div class="text-[var(--muted-foreground)] animate-pulse">Executing skill instructions...</div>
    </div>
  </div>
</div>
