---
import { Check, X, Minus } from 'lucide-react';

interface Props {
  t: (key: string) => string;
}

const { t } = Astro.props;
---

<div class="skill-detail-card h-full flex flex-col overflow-hidden transition-colors duration-300">
  <div class="flex items-center gap-2 px-6 py-4 bg-[var(--muted)] border-b border-[var(--border)]">
    <h2 class="text-sm font-mono font-bold text-[var(--foreground)]">
      {t('CLI.comparison.title')}
    </h2>
  </div>

  <div class="flex-1 p-0 bg-[var(--card)] overflow-x-auto">
    <table class="w-full text-left text-sm h-full min-w-[400px]">
      <thead class="bg-[var(--muted)] border-b border-[var(--border)]">
        <tr>
          <th class="p-4 font-medium text-[var(--muted-foreground)]">Feature</th>
          <th class="p-4 font-bold text-[var(--accent)]">{t('CLI.comparison.ks')}</th>
          <th class="p-4 font-medium text-[var(--muted-foreground)]">{t('CLI.comparison.others')}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--border)] bg-[var(--card)]">
        <tr>
          <td class="p-4 text-[var(--foreground)] font-medium">{t('CLI.comparison.row1')}</td>
          <td class="p-4"><Check className="w-5 h-5 text-[var(--accent)]" /></td>
          <td class="p-4"><X className="w-5 h-5 text-[var(--muted-foreground)]" /></td>
        </tr>
        <tr>
          <td class="p-4 text-[var(--foreground)] font-medium">{t('CLI.comparison.row2')}</td>
          <td class="p-4"><Check className="w-5 h-5 text-[var(--accent)]" /></td>
          <td class="p-4"><X className="w-5 h-5 text-[var(--muted-foreground)]" /></td>
        </tr>
        <tr>
          <td class="p-4 text-[var(--foreground)] font-medium">{t('CLI.comparison.row3')}</td>
          <td class="p-4"><Check className="w-5 h-5 text-[var(--accent)]" /></td>
          <td class="p-4"><X className="w-5 h-5 text-[var(--muted-foreground)]" /></td>
        </tr>
        <tr>
          <td class="p-4 text-[var(--foreground)] font-medium">{t('CLI.comparison.row4')}</td>
          <td class="p-4"><Check className="w-5 h-5 text-[var(--accent)]" /></td>
          <td class="p-4"><Minus className="w-5 h-5 text-[var(--muted-foreground)]" /></td>
        </tr>
      </tbody>
    </table>
  </div>
</div>
