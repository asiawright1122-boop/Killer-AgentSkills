---
/**
 * SkillInstall — Installation card with CLI command, copy button, and platform badges.
 * Extracted from [...repo].astro for reuse and readability.
 */
import { Terminal, Copy, Download, Monitor, Bot, Laptop, Code, Sparkles } from 'lucide-react';

interface Props {
  installCommand: string;
  installationLabel: string;
  installNowLabel: string;
  universalInstallLabel: string;
  platformSupportLabel: string;
  plusMoreLabel: string;
  compact?: boolean;
}

const {
  installCommand,
  installationLabel,
  installNowLabel,
  universalInstallLabel,
  platformSupportLabel,
  plusMoreLabel,
  compact = false,
} = Astro.props;
---

<div
  class:list={[
    'overflow-hidden flex flex-col',
    compact ? 'rounded-md border border-[var(--border)] bg-[var(--background)]' : 'skill-detail-card',
  ]}
>
  <div
    class:list={[
      'bg-[var(--foreground)] text-[var(--background)] flex items-center justify-between',
      compact ? 'px-3 py-2' : 'px-4 py-3',
    ]}
  >
    <div class="flex items-center gap-3">
      <Terminal size={18} strokeWidth={3} className="text-[var(--primary)]" />
      <span class="text-sm font-bold font-mono">{installationLabel}</span>
    </div>
  </div>

  <div class:list={['relative bg-[var(--background)]', compact ? 'p-3' : 'p-6']}>
    {/* Install Button & Deep Links */}
    <div class="mb-5 space-y-3">
      <button
        id="install-btn"
        class="market-button w-full px-4 py-3 bg-[var(--primary)] text-[var(--primary-foreground)] border-[var(--primary)]"
        data-install-command={installCommand}
      >
        <Download size={18} strokeWidth={3} />
        <span>{installNowLabel}</span>
      </button>

      <div class="grid grid-cols-2 gap-3">
        <button
          class="ide-deep-link-btn flex items-center justify-center gap-2 rounded-md px-3 py-2.5 bg-[var(--card)] text-[var(--foreground)] hover:bg-[var(--foreground)] hover:text-[var(--background)] border border-[var(--border)] font-bold text-xs transition-all"
          data-command={installCommand}
          data-scheme="cursor://"
          title="Open in Cursor IDE"
        >
          <Monitor size={14} strokeWidth={3} />
          <span>Cursor</span>
        </button>
        <button
          class="ide-deep-link-btn flex items-center justify-center gap-2 rounded-md px-3 py-2.5 bg-[var(--card)] text-[var(--foreground)] hover:bg-[var(--foreground)] hover:text-[var(--background)] border border-[var(--border)] font-bold text-xs transition-all"
          data-command={installCommand}
          data-scheme="windsurf://"
          title="Open in Windsurf IDE"
        >
          <Laptop size={14} strokeWidth={3} />
          <span>Windsurf</span>
        </button>
      </div>
    </div>

    <div class="rounded-lg border border-[var(--border)] p-4 font-mono text-sm relative group/code bg-[var(--muted)]">
      <div
        class="flex items-center text-[var(--muted-foreground)] select-none mb-3 justify-between border-b border-[var(--border)] pb-2"
      >
        <div class="flex items-center font-bold text-xs">
          <span class="market-chip px-2 py-1 mr-2 text-[10px]">CLI</span>
          <span>{universalInstallLabel}</span>
        </div>
      </div>
      <div
        class="text-[var(--foreground)] break-all select-all flex items-start gap-3 font-bold group/cmd relative mt-2 text-base"
      >
        <span class="text-[var(--accent)] font-bold select-none">&gt;</span>
        <span>{installCommand}</span>

        <button
          id="install-copy-btn"
          class="absolute right-2 top-2 rounded-md p-2 bg-[var(--foreground)] text-[var(--background)] hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)] border border-[var(--foreground)] transition-all opacity-0 group-hover/cmd:opacity-100"
          data-command={installCommand}
        >
          <Copy size={16} strokeWidth={3} />
        </button>
      </div>
    </div>

    {/* Supported Platforms */}
    <div class="mt-4 pt-4 border-t border-[var(--border)]">
      <div class="text-xs font-bold text-[var(--muted-foreground)] mb-3">
        {platformSupportLabel}
      </div>
      <div class="flex flex-wrap gap-2">
        <div class="market-chip px-2 py-1 text-xs" title="Cursor">
          <Monitor size={12} strokeWidth={3} /> Cursor
        </div>
        <div class="market-chip px-2 py-1 text-xs" title="Windsurf">
          <Laptop size={12} strokeWidth={3} /> Windsurf
        </div>
        <div class="market-chip px-2 py-1 text-xs" title="VS Code">
          <Code size={12} strokeWidth={3} /> VS Code
        </div>
        <div class="market-chip px-2 py-1 text-xs" title="Trae">
          <Sparkles size={12} strokeWidth={3} /> Trae
        </div>
        <div class="market-chip px-2 py-1 text-xs" title="Claude Code">
          <Bot size={12} strokeWidth={3} /> Claude
        </div>
        <div class="market-chip px-2 py-1 text-xs" title="OpenClaw">
          <Bot size={12} strokeWidth={3} /> OpenClaw
        </div>
        <div class="market-chip px-2 py-1 text-xs text-[var(--muted-foreground)]" title={plusMoreLabel}>
          {plusMoreLabel}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Setup Deep Link behavior
  const bindDeepLinks = () => {
    document.querySelectorAll('.ide-deep-link-btn').forEach((btn) => {
      // Remove any previously attached listeners on client-side navigation
      const newBtn = btn.cloneNode(true) as HTMLButtonElement;
      if (btn.parentNode) btn.parentNode.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', async (e) => {
        const target = e.currentTarget as HTMLButtonElement;
        const command = target.dataset.command;
        const scheme = target.dataset.scheme;

        if (command && scheme) {
          try {
            await navigator.clipboard.writeText(command);

            // Visual feedback loop
            const originalContent = target.innerHTML;
            target.innerHTML = '<span class="font-bold text-[10px]">Copied, opening IDE...</span>';
            target.style.backgroundColor = 'var(--primary)';
            target.style.color = 'var(--primary-foreground)';
            target.style.borderColor = 'var(--foreground)';

            setTimeout(() => {
              window.location.href = scheme;
            }, 300);

            setTimeout(() => {
              target.innerHTML = originalContent;
              target.style.backgroundColor = '';
              target.style.color = '';
              target.style.borderColor = '';
            }, 2500);
          } catch (err) {
            console.error('Clipboard write failed, trying fallback launch', err);
            window.location.href = scheme;
          }
        }
      });
    });
  };

  // Run on initial load and Astro view transitions
  bindDeepLinks();
  document.addEventListener('astro:page-load', bindDeepLinks);
</script>
