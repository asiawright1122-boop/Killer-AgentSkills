---
/**
 * SkillInstall — Installation card with CLI command, copy button, and platform badges.
 * Extracted from [...repo].astro for reuse and readability.
 */
import Terminal from 'lucide-react/dist/esm/icons/terminal';
import Copy from 'lucide-react/dist/esm/icons/copy';
import Download from 'lucide-react/dist/esm/icons/download';
import Monitor from 'lucide-react/dist/esm/icons/monitor';
import Bot from 'lucide-react/dist/esm/icons/bot';
import Laptop from 'lucide-react/dist/esm/icons/laptop';
import Code from 'lucide-react/dist/esm/icons/code';
import Sparkles from 'lucide-react/dist/esm/icons/sparkles';

interface Props {
  installCommand: string;
  installationLabel: string;
  installNowLabel: string;
  universalInstallLabel: string;
  platformSupportLabel: string;
  plusMoreLabel: string;
}

const {
  installCommand,
  installationLabel,
  installNowLabel,
  universalInstallLabel,
  platformSupportLabel,
  plusMoreLabel,
} = Astro.props;
---

<div
  class="brut-card border-[3px] border-[var(--border)] shadow-[8px_8px_0px_0px_var(--border)] bg-[var(--background)] overflow-hidden flex flex-col"
>
  <div
    class="bg-[var(--foreground)] text-[var(--background)] px-4 py-3 border-b-4 border-[var(--border)] flex items-center justify-between"
  >
    <div class="flex items-center gap-3">
      <Terminal size={18} strokeWidth={3} className="text-[var(--primary)]" />
      <span class="text-sm font-black uppercase tracking-widest font-mono">{installationLabel}</span>
    </div>
  </div>

  <div class="p-6 relative bg-[var(--background)]">
    {/* Install Button */}
    <button
      id="install-btn"
      class="w-full mb-4 flex items-center justify-center gap-2 px-4 py-3 bg-[var(--primary)] text-[var(--primary-foreground)] border-2 border-[var(--border)] font-black uppercase tracking-widest shadow-[4px_4px_0px_0px_var(--border)] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_0px_var(--border)] transition-all"
      data-install-command={installCommand}
    >
      <Download size={18} strokeWidth={3} />
      <span>{installNowLabel}</span>
    </button>

    <div class="border-4 border-[var(--border)] p-4 font-mono text-sm relative group/code bg-[var(--background)]">
      <div
        class="flex items-center text-[var(--muted-foreground)] select-none mb-3 justify-between border-b-2 border-dotted border-[var(--border)] pb-2"
      >
        <div class="flex items-center font-bold uppercase tracking-wider text-xs">
          <span class="text-[var(--primary)] bg-[var(--foreground)] px-1 mr-2">SYS</span>
          <span>{universalInstallLabel}</span>
        </div>
      </div>
      <div
        class="text-[var(--foreground)] break-all select-all flex items-start gap-3 font-bold group/cmd relative mt-2 text-base"
      >
        <span class="text-[var(--primary)] bg-[var(--foreground)] px-2 font-black select-none">&gt;</span>
        <span class="tracking-widest">{installCommand}</span>

        <button
          id="install-copy-btn"
          class="absolute right-0 top-0 p-2 bg-[var(--foreground)] text-[var(--background)] hover:bg-[var(--primary)] hover:text-[var(--foreground)] border-2 border-[var(--foreground)] transition-all opacity-0 group-hover/cmd:opacity-100 shadow-[2px_2px_0px_0px_var(--border)] translate-x-4 -translate-y-4"
          data-command={installCommand}
        >
          <Copy size={16} strokeWidth={3} />
        </button>
      </div>
    </div>

    {/* Supported Platforms */}
    <div class="mt-4 pt-4 border-t-2 border-dotted border-[var(--border)]">
      <div class="text-xs font-bold uppercase tracking-wider text-[var(--muted-foreground)] mb-3">
        {platformSupportLabel}
      </div>
      <div class="flex flex-wrap gap-2">
        <div
          class="flex items-center gap-1 px-2 py-1 bg-[var(--background)] border border-[var(--border)] text-xs font-bold"
          title="Cursor"
        >
          <Monitor size={12} strokeWidth={3} /> Cursor
        </div>
        <div
          class="flex items-center gap-1 px-2 py-1 bg-[var(--background)] border border-[var(--border)] text-xs font-bold"
          title="Windsurf"
        >
          <Laptop size={12} strokeWidth={3} /> Windsurf
        </div>
        <div
          class="flex items-center gap-1 px-2 py-1 bg-[var(--background)] border border-[var(--border)] text-xs font-bold"
          title="VS Code"
        >
          <Code size={12} strokeWidth={3} /> VS Code
        </div>
        <div
          class="flex items-center gap-1 px-2 py-1 bg-[var(--background)] border border-[var(--border)] text-xs font-bold"
          title="Trae"
        >
          <Sparkles size={12} strokeWidth={3} /> Trae
        </div>
        <div
          class="flex items-center gap-1 px-2 py-1 bg-[var(--background)] border border-[var(--border)] text-xs font-bold"
          title="Claude Code"
        >
          <Bot size={12} strokeWidth={3} /> Claude
        </div>
        <div
          class="flex items-center gap-1 px-2 py-1 bg-[var(--background)] border border-[var(--border)] text-xs font-bold"
          title="OpenClaw"
        >
          <Bot size={12} strokeWidth={3} /> OpenClaw
        </div>
        <div
          class="flex items-center gap-1 px-2 py-1 bg-[var(--background)] border border-[var(--border)] text-xs font-bold text-[var(--muted-foreground)]"
          title={plusMoreLabel}
        >
          {plusMoreLabel}
        </div>
      </div>
    </div>
  </div>
</div>
