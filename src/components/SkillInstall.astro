---
import { Bot, Code, Copy, Download, Laptop, Monitor, Sparkles, Terminal } from 'lucide-react';

interface Props {
  skillRef: string;
  locale: string;
  installationLabel: string;
  installNowLabel: string;
  universalInstallLabel: string;
  platformSupportLabel: string;
  plusMoreLabel: string;
  compact?: boolean;
}

const {
  skillRef,
  locale,
  installationLabel,
  installNowLabel,
  universalInstallLabel,
  platformSupportLabel,
  plusMoreLabel,
  compact = false,
} = Astro.props;

const autoCommand = `npx killer-skills add ${skillRef}`;
const claudeCommand = `npx killer-skills add ${skillRef} --ide claude`;
const codexCommand = `npx killer-skills add ${skillRef} --ide codex`;
const cursorCommand = `npx killer-skills add ${skillRef} --ide cursor`;
const panelId = `install-command-${skillRef.replace(/[^A-Za-z0-9_-]/g, '-')}`;
---

<div
  class:list={[
    'overflow-hidden flex flex-col',
    compact ? 'rounded-md border border-[var(--border)] bg-[var(--background)]' : 'skill-detail-card',
  ]}
  data-install-mode-root
>
  <div
    class:list={[
      'bg-[var(--foreground)] text-[var(--background)] flex items-center justify-between',
      compact ? 'px-3 py-2' : 'px-4 py-3',
    ]}
  >
    <div class="flex items-center gap-3">
      <Terminal size={18} strokeWidth={3} className="text-[var(--primary)]" />
      <span class="text-sm font-bold font-mono">{installationLabel}</span>
    </div>
  </div>

  <div class:list={['relative bg-[var(--background)]', compact ? 'p-3' : 'p-6']}>
    <div class="mb-3 grid grid-cols-2 gap-2 sm:grid-cols-4" role="tablist" aria-label="Install platform">
      <button
        type="button"
        role="tab"
        aria-selected="true"
        aria-controls={panelId}
        class="install-mode-tab market-button min-h-11 px-2 py-2 text-[11px]"
        data-install-command-value={autoCommand}
        data-install-platform="auto"
        data-install-label={universalInstallLabel}
      >
        <Sparkles size={14} strokeWidth={3} />
        <span>Auto</span>
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls={panelId}
        tabindex="-1"
        class="install-mode-tab market-button min-h-11 px-2 py-2 text-[11px] bg-[var(--card)] text-[var(--foreground)]"
        data-install-command-value={claudeCommand}
        data-install-platform="claude"
        data-install-label="Claude Code"
      >
        <Bot size={14} strokeWidth={3} />
        <span>Claude Code</span>
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls={panelId}
        tabindex="-1"
        class="install-mode-tab market-button min-h-11 px-2 py-2 text-[11px] bg-[var(--card)] text-[var(--foreground)]"
        data-install-command-value={codexCommand}
        data-install-platform="codex"
        data-install-label="Codex"
      >
        <Code size={14} strokeWidth={3} />
        <span>Codex</span>
      </button>
      <button
        type="button"
        role="tab"
        aria-selected="false"
        aria-controls={panelId}
        tabindex="-1"
        class="install-mode-tab market-button min-h-11 px-2 py-2 text-[11px] bg-[var(--card)] text-[var(--foreground)]"
        data-install-command-value={cursorCommand}
        data-install-platform="cursor"
        data-install-label="Cursor"
      >
        <Monitor size={14} strokeWidth={3} />
        <span>Cursor</span>
      </button>
    </div>

    <div
      id={panelId}
      role="tabpanel"
      class="relative min-h-32 rounded-md border border-[var(--border)] bg-[var(--muted)] p-4 font-mono"
    >
      <div
        class="mb-3 flex items-center border-b border-[var(--border)] pb-2 text-xs font-bold text-[var(--muted-foreground)]"
      >
        <span class="market-chip mr-2 px-2 py-1 text-[10px]">CLI</span>
        <span data-install-mode-label>{universalInstallLabel}</span>
      </div>
      <div
        class="group/cmd relative flex min-w-0 items-start gap-3 text-sm font-bold leading-6 text-[var(--foreground)]"
      >
        <span class="shrink-0 select-none font-bold text-[var(--accent)]">&gt;</span>
        <code
          class="block min-w-0 max-w-full break-all whitespace-normal pr-12 font-mono text-[0.86rem] sm:text-sm"
          data-testid="install-command"
          data-install-command-text
        >
          {autoCommand}
        </code>
        <button
          type="button"
          class="install-command-copy-btn absolute right-1 top-1 rounded-md border border-[var(--foreground)] bg-[var(--foreground)] p-2 text-[var(--background)] transition-all hover:bg-[var(--primary)] hover:text-[var(--primary-foreground)]"
          data-command={autoCommand}
          data-skill-ref={skillRef}
          data-install-event="platform_copy"
          data-install-surface="detail"
          data-install-platform="auto"
          data-install-locale={locale}
          aria-label="Copy install command"
          title="Copy install command"
        >
          <Copy size={16} strokeWidth={3} />
        </button>
      </div>
    </div>

    <button
      type="button"
      class="install-primary-btn market-button mt-3 w-full border-[var(--primary)] bg-[var(--primary)] px-4 py-3 text-[var(--primary-foreground)]"
      data-command={autoCommand}
      data-skill-ref={skillRef}
      data-install-event="platform_copy"
      data-install-surface="detail"
      data-install-platform="auto"
      data-install-locale={locale}
    >
      <Download size={18} strokeWidth={3} />
      <span>{installNowLabel}</span>
    </button>

    <div class="mt-4 border-t border-[var(--border)] pt-4">
      <div class="mb-3 text-xs font-bold text-[var(--muted-foreground)]">{platformSupportLabel}</div>
      <div class="flex flex-wrap gap-2">
        <div class="market-chip px-2 py-1 text-xs" title="Cursor"><Monitor size={12} strokeWidth={3} /> Cursor</div>
        <div class="market-chip px-2 py-1 text-xs" title="Windsurf"><Laptop size={12} strokeWidth={3} /> Windsurf</div>
        <div class="market-chip px-2 py-1 text-xs" title="Claude Code"><Bot size={12} strokeWidth={3} /> Claude</div>
        <div class="market-chip px-2 py-1 text-xs" title="Codex"><Code size={12} strokeWidth={3} /> Codex</div>
        <div class="market-chip px-2 py-1 text-xs text-[var(--muted-foreground)]" title={plusMoreLabel}>
          {plusMoreLabel}
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  function initInstallModes(root: ParentNode = document) {
    root.querySelectorAll<HTMLElement>('[data-install-mode-root]').forEach((installRoot) => {
      if (installRoot.dataset.installModeInitialized === 'true') return;
      installRoot.dataset.installModeInitialized = 'true';

      const tabs = Array.from(installRoot.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
      const commandText = installRoot.querySelector<HTMLElement>('[data-install-command-text]');
      const commandLabel = installRoot.querySelector<HTMLElement>('[data-install-mode-label]');
      const actions = installRoot.querySelectorAll<HTMLElement>('.install-primary-btn, .install-command-copy-btn');

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const command = tab.dataset.installCommandValue;
          const platform = tab.dataset.installPlatform;
          if (!command || !platform) return;

          tabs.forEach((candidate) => {
            const selected = candidate === tab;
            candidate.setAttribute('aria-selected', String(selected));
            candidate.tabIndex = selected ? 0 : -1;
            candidate.classList.toggle('bg-[var(--card)]', !selected);
            candidate.classList.toggle('text-[var(--foreground)]', !selected);
          });
          if (commandText) commandText.textContent = command;
          if (commandLabel) commandLabel.textContent = tab.dataset.installLabel || platform;
          actions.forEach((action) => {
            action.dataset.command = command;
            action.dataset.installPlatform = platform;
          });
        });
      });
    });
  }

  initInstallModes();
  document.addEventListener('astro:page-load', () => initInstallModes());
</script>
