---
import { translateOr } from '../i18n';
import { getPrimaryNavItems } from '../lib/site-ia';

interface Props {
  locale: string;
  messages: Record<string, any>;
  compact?: boolean;
}

const { locale, messages, compact = false } = Astro.props;
const currentYear = new Date().getFullYear();
const tr = (key: string, fallback: string) => translateOr(messages, key, fallback);
const primaryNavItems = getPrimaryNavItems(locale);
const isZhCopy = locale.startsWith('zh');
const trustLinks = [
  {
    href: `/${locale}/safe`,
    label: isZhCopy ? '审核政策' : 'Review policy',
  },
  {
    href: `/${locale}/skills?source=official`,
    label: isZhCopy ? '官方来源' : 'Official sources',
  },
  {
    href: `/${locale}/docs/installation`,
    label: isZhCopy ? '安装文档' : 'Install guide',
  },
  {
    href: `/${locale}/docs/cli/overview`,
    label: isZhCopy ? 'CLI 总览' : 'CLI overview',
  },
];
---

<footer
  class={`border-t border-white/10 bg-[oklch(15%_0.035_245)] text-white ${compact ? 'py-8' : 'pt-16 pb-8'} ${compact ? 'mt-0' : ''} safe-area-px safe-area-pb`}
>
  <div class="max-w-7xl mx-auto px-6">
    {
      !compact && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 mb-16">
          {/* Brand */}
          <div class="space-y-4">
            <a href={`/${locale}`} class="flex items-center gap-2 group">
              <span class="font-bold text-2xl text-white">Killer-Skills</span>
            </a>
            <p class="text-white/70 leading-relaxed text-sm font-medium">
              {tr('Footer.desc', 'Open-source directory for AI agent skills and IDE workflows.')}
            </p>
            <div class="flex gap-4">
              <a
                href="https://x.com/killerskills"
                aria-label="Follow us on X (Twitter)"
                target="_blank"
                rel="noopener noreferrer"
                class="text-white/50 hover:text-[var(--accent)] transition-colors"
              >
                <svg aria-hidden="true" focusable="false" class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z" />
                </svg>
              </a>
            </div>
          </div>

          {/* Discover */}
          <nav aria-label="Product">
            <h4 class="font-bold text-white mb-4">{isZhCopy ? '发现' : 'Discover'}</h4>
            <ul class="space-y-3 text-sm text-white/65 font-bold">
              {primaryNavItems.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="hover:text-[var(--accent)] hover:underline decoration-2 underline-offset-4 transition-all"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          {/* Trust & Install */}
          <nav aria-label="Trust and install">
            <h4 class="font-bold text-white mb-4">{isZhCopy ? '信任与安装' : 'Trust & Install'}</h4>
            <ul class="space-y-3 text-sm text-white/65 font-bold">
              {trustLinks.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="hover:text-[var(--accent)] hover:underline decoration-2 underline-offset-4 transition-all"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          {/* Newsletter */}
          <div>
            <h4 class="font-bold text-white mb-4">{tr('Footer.stayUpdated', 'Stay Updated')}</h4>
            <p class="text-sm text-white/65 mb-4 font-medium">
              {tr('Footer.subscribeDesc', 'Get updates about new skills and workflow guides.')}
            </p>
            <div class="flex gap-2">
              <label for="footer-email" class="sr-only">
                {tr('Footer.emailPlaceholder', 'Email')}
              </label>
              <input
                id="footer-email"
                type="email"
                autocomplete="email"
                placeholder={tr('Footer.emailPlaceholder', 'Email')}
                class="bg-white/8 border border-white/15 rounded-md px-3 py-2 text-sm text-white placeholder:text-white/45 w-full focus:outline-none focus:ring-2 focus:ring-[var(--accent)]/20 focus:border-[var(--accent)] transition-all"
              />
              <button
                aria-label={tr('Footer.subscribeBtn', 'Subscribe')}
                class="bg-[var(--accent)] hover:brightness-95 text-[var(--accent-foreground)] px-3 py-2 rounded-md text-sm font-bold transition-colors"
              >
                →
              </button>
            </div>
          </div>
        </div>
      )
    }

    {/* Bottom */}
    <div
      class={`flex flex-col md:flex-row items-center justify-between gap-4 ${compact ? '' : 'pt-8 border-t border-white/10'}`}
    >
      <div class="text-xs text-white/45">
        © {currentYear} Killer-Skills Inc. {tr('Footer.rights', 'All rights reserved.')}
      </div>
      <nav aria-label="Legal" class="flex gap-6 text-xs text-white/45">
        <a href={`/${locale}/privacy`} class="hover:text-white transition-colors">{tr('Footer.privacy', 'Privacy')}</a>
        <a href={`/${locale}/terms`} class="hover:text-white transition-colors">{tr('Footer.terms', 'Terms')}</a>
        <a href={`/${locale}/cookies`} class="hover:text-white transition-colors">{tr('Footer.cookie', 'Cookies')}</a>
      </nav>
    </div>
  </div>
</footer>
