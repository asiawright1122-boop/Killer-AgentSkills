---
export interface Props {
  title?: string;
}

const { title = 'Information' } = Astro.props;
---

<div class="skill-detail-surface my-8 p-6">
  <div class="flex items-center gap-3 mb-4">
    <div
      class="flex h-8 w-8 items-center justify-center rounded-md bg-[var(--accent)] text-[var(--accent-foreground)] font-bold"
    >
      !
    </div>
    <h4 class="text-xl font-bold text-[var(--foreground)] m-0">{title}</h4>
  </div>

  <div class="text-[var(--muted-foreground)] font-medium prose-p:my-2 prose-ul:my-2 prose-li:my-1">
    <slot />
  </div>
</div>
