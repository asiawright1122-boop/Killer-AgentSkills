---
/**
 * SkillRelated — Related skills grid, collections, and guided next steps.
 * Extracted from [...repo].astro for readability.
 */
import SkillCard from './SkillCard.astro';
import { Layers, ChevronRight } from 'lucide-react';
import type { Locale } from '../i18n';
import type { UnifiedSkill } from '../lib/public-skill-catalog';

interface Props {
  locale: string;
  typedLocale: Locale;
  relatedSkills: UnifiedSkill[];
  skillName: string;
  repo: string;
  category: string;
  messages: any;
  t: (key: string, params?: Record<string, string>) => string;
  tr: (key: string, fallback?: string) => string;
}

const { locale, typedLocale, relatedSkills, skillName, repo, category, messages, t, tr } = Astro.props;

function getRelevantAuthoritySurfaces(
  category: string,
): { id: string; title: string; description: string; href: string; icon: string }[] {
  const cat = (category || '').toLowerCase();
  const surfaces: { id: string; title: string; description: string; href: string; icon: string }[] = [];
  const query = encodeURIComponent(repo || skillName || cat || '');

  surfaces.push({
    id: 'skills',
    title: typedLocale === 'zh' ? '相似 Skills' : 'Similar Skills',
    description: typedLocale === 'zh' ? '按名称、来源和分类继续筛选。' : 'Filter by name, source, and category.',
    href: query ? `/${locale}/skills?q=${query}` : `/${locale}/skills`,
    icon: 'grid',
  });

  surfaces.push({
    id: 'review-policy',
    title: typedLocale === 'zh' ? '审核政策' : 'Review Policy',
    description: typedLocale === 'zh' ? '查看公开目录的准入规则。' : 'Review public listing admission rules.',
    href: `/${locale}/safe`,
    icon: 'shield',
  });

  if (cat.includes('claude') || cat.includes('ai-agent') || cat.includes('workflow') || cat.includes('productivity')) {
    surfaces.push({
      id: 'articles',
      title: typedLocale === 'zh' ? '文章' : 'Articles',
      description:
        typedLocale === 'zh' ? '阅读同类工作流和选型文章。' : 'Read adjacent workflow and selection articles.',
      href: `/${locale}/article`,
      icon: 'book',
    });
  }

  if (cat.includes('cursor') || cat.includes('ide') || cat.includes('editor') || cat.includes('completion')) {
    surfaces.push({
      id: 'popular',
      title: typedLocale === 'zh' ? '热门榜单' : 'Popular Ranking',
      description: typedLocale === 'zh' ? '对比近期更常被使用的技能。' : 'Compare skills with stronger current demand.',
      href: `/${locale}/popular`,
      icon: 'grid',
    });
  }

  surfaces.push({
    id: 'rankings',
    title: typedLocale === 'zh' ? '榜单' : 'Rankings',
    description: typedLocale === 'zh' ? '查看热门和最新 Skills。' : 'View popular and latest skills.',
    href: `/${locale}/popular`,
    icon: 'grid',
  });

  // Deduplicate by id
  const seen = new Set<string>();
  return surfaces.filter((s) => {
    if (seen.has(s.id)) return false;
    seen.add(s.id);
    return true;
  });
}

const relevantSurfaces = getRelevantAuthoritySurfaces(category);
---

{
  relatedSkills.length > 0 && (
    <section class="border-t border-[var(--border)] bg-[var(--background)] py-16 relative overflow-hidden">
      <div class="max-w-7xl mx-auto px-6 relative z-10">
        <div class="flex items-center justify-between mb-10 pb-4 border-b border-[var(--border)]">
          <div class="flex flex-col gap-2">
            <h2 class="text-3xl font-bold text-[var(--foreground)] flex items-center gap-3">
              <Layers className="text-[var(--primary)]" strokeWidth={3} />
              {tr('Detail.relatedSkills', typedLocale === 'zh' ? '相关技能' : 'Related Skills')}
            </h2>
            <p class="text-[var(--muted-foreground)] text-sm max-w-2xl font-medium">
              {locale === 'zh'
                ? `继续查看与 ${skillName || repo} 接近、可替代或可搭配使用的技能。`
                : `Continue with skills that are similar, complementary, or useful alternatives to ${skillName || repo}.`}
            </p>
          </div>
          <a
            href={`/${locale}/search`}
            class="text-sm font-bold text-[var(--muted-foreground)] hover:text-[var(--foreground)] hover:translate-x-1 transition-all flex items-center gap-2 mt-1 md:mt-0"
          >
            {t('Common.viewAll')} <ChevronRight size={18} strokeWidth={3} />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {relatedSkills.map((skill) => (
            <div class="h-full">
              <SkillCard skill={skill} locale={locale} messages={messages} t={t} />
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}

{
  relevantSurfaces.length > 0 && (
    <section class="py-12 border-t border-[var(--border)] bg-[var(--foreground)]/5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-xl font-bold text-[var(--foreground)] mb-3">{typedLocale === 'zh' ? '下一步' : 'Next'}</h2>
        <p class="text-sm text-[var(--muted-foreground)] font-medium mb-6 max-w-2xl">
          {typedLocale === 'zh'
            ? '继续筛选、对比或核对安全信息。'
            : 'Continue searching, comparing, or checking safety.'}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relevantSurfaces.map((surface) => (
            <a href={surface.href} class="skill-detail-card skill-detail-card-hover group p-5">
              <h3 class="font-bold text-sm text-[var(--foreground)] group-hover:text-[var(--accent)] mb-2">
                {surface.title}
              </h3>
              <p class="text-xs leading-5 text-[var(--muted-foreground)] font-medium">{surface.description}</p>
              <div class="mt-3 text-xs font-bold text-[var(--accent)] opacity-0 group-hover:opacity-100 transition-opacity">
                {typedLocale === 'zh' ? '查看' : 'Open'}
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )
}
