# =============================================================================
# Killer-Skills — environment variable template
#
# Copy this file to `.env.local` (gitignored) for local development, or
# configure the equivalent values via `wrangler pages secret put` in
# production. Anything prefixed with PUBLIC_ would be exposed to the browser
# at build time — currently the project does not require any.
# =============================================================================

# -----------------------------------------------------------------------------
# Admin auth (production: use `wrangler pages secret put`, never put real values here)
# -----------------------------------------------------------------------------
# ADMIN_USER=
# ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Third-party API credentials (use real values only in .env.local / secrets)
# -----------------------------------------------------------------------------
# GITHUB_TOKEN=replace-with-github-token           # repo metadata fetcher (scope: public_repo + read:org)
# NVIDIA_API_KEYS=nvapi-xxx,...  # comma-separated; LLM translation pool
# OPENROUTER_API_KEYS=replace-with-openrouter-api-keys
# SILICONFLOW_API_KEY=replace-with-siliconflow-api-key

# -----------------------------------------------------------------------------
# Cloudflare account bindings (only needed for management scripts; runtime
# bindings are declared in wrangler.toml and exposed via locals.runtime.env)
# -----------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_SKILLS_CACHE_NAMESPACE_ID=

# -----------------------------------------------------------------------------
# Google Search Console reporter (offline scripts only)
# -----------------------------------------------------------------------------
# GSC_CLIENT_EMAIL=
# GSC_PRIVATE_KEY=
# GSC_SITE_URL=sc-domain:killer-skills.com

# -----------------------------------------------------------------------------
# Operational tuning (sensible defaults are baked into code; override here)
# -----------------------------------------------------------------------------
# AI_CONCURRENCY_LIMIT=3
# AI_LOCALE_BATCH_SIZE=3
# WORKERS_AI_MODE=free-only
# WORKERS_AI_FREE_MAX_CALLS=60
# WORKERS_AI_FREE_DAILY_MAX_CALLS=60
# WORKERS_AI_FREE_MAX_TOKENS=800
# NVIDIA_KEY_QUARANTINE_CONSECUTIVE_FAILURES=3
# NVIDIA_KEY_QUARANTINE_ON_429=1
# SSR_PAGE_SLOW_LOG_MS=1200
