/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' https://avatars.githubusercontent.com https://raw.githubusercontent.com data:; connect-src 'self' https://api.github.com https://raw.githubusercontent.com; frame-ancestors 'self'

# Aggressive caching for static assets
/images/*
  Cache-Control: public, max-age=31536000, immutable

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/favicon.svg
  Cache-Control: public, max-age=86400

/icons/*
  Cache-Control: public, max-age=31536000, immutable

/blog/*
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=31536000, immutable

/robots.txt
  Cache-Control: public, max-age=3600

/og-image.png
  Cache-Control: public, max-age=604800

# Cache fonts for a year
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/sitemap*.xml
  Cache-Control: public, max-age=3600
